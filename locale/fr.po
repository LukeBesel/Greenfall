msgstr "Châssis"

#: data/parts.json:types[locomotion].name
msgid "Drive Wheel Assembly"
msgstr "Bloc roue motrice"

#: data/parts.json:types[arm].name
msgid "Manipulator Arm"
msgstr "Bras manipulateur"

#: data/parts.json:types[core].name
msgid "Control Core"
msgstr "Noyau de contrôle"

#: data/parts.json:types[battery].name
msgid "Battery Cell"
msgstr "Cellule de batterie"

#: data/parts.json:types[hopper].name data/robots.json:types[scoopie].upgrades[2].name
msgid "Hopper Liner"
msgstr "Doublure de trémie"

#: data/parts.json:types[sensor].name
msgid "Sensor Module"
msgstr "Module capteur"

#: data/parts.json:types[module].name
msgid "Special Module"
msgstr "Module spécial"

#: data/research.json:branches[robotics].name
msgid "Robotics"
msgstr "Robotique"

#: data/research.json:branches[botany].name
msgid "Botany"
msgstr "Botanique"

#: data/research.json:branches[hydrology].name
msgid "Hydrology"
msgstr "Hydrologie"

#: data/research.json:branches[logistics].name
msgid "Logistics"
msgstr "Logistique"

#: data/research.json:nodes[scoop_beam].name
msgid "Scoop Beam"
msgstr "Rayon de pelle"

#: data/research.json:nodes[scoop_beam].desc
msgid "A soft blue guide beam on the scoop. Lumi reaches a little further."
msgstr "Un doux rayon guide bleu sur la pelle. Lumi porte un peu plus loin."

#: data/research.json:nodes[wide_beam].name
msgid "Wide Beam"
msgstr "Rayon large"

#: data/research.json:nodes[wide_beam].desc
msgid "Spread the beam into a fan. Each sweep catches more."
msgstr "Le rayon s'ouvre en éventail. Chaque passage attrape plus."

#: data/research.json:nodes[bigger_hopper].name
msgid "Bigger Hopper"
msgstr "Grande trémie"

#: data/research.json:nodes[bigger_hopper].desc
msgid "Fold-out side panels for the chest compartment."
msgstr "Des panneaux latéraux dépliables pour le compartiment ventral."

#: data/research.json:nodes[auto_sort].name
msgid "Auto-Sort"
msgstr "Tri auto"

#: data/research.json:nodes[auto_sort].desc
msgid "A little sorting comb in the intake. Cleaner bales sell for more."
msgstr "Un petit peigne de tri dans l'entrée. Les balles plus propres se vendent plus cher."

#: data/research.json:nodes[field_magnet].name
msgid "Field Magnet"
msgstr "Aimant de terrain"

#: data/research.json:nodes[field_magnet].desc
msgid "Loose bits hop toward the scoop on their own."
msgstr "Les petits morceaux sautent tout seuls vers la pelle."

#: data/research.json:nodes[tractor_beam].name
msgid "Tractor Beam"
msgstr "Rayon tracteur"

#: data/research.json:nodes[tractor_beam].desc
msgid "Junk lifts, floats and glides into the hopper. It is very satisfying."
msgstr "La ferraille s'élève, flotte et glisse dans la trémie. C'est très satisfaisant."

#: data/research.json:nodes[salvage_logic].name
msgid "Salvage Logic"
msgstr "Logique de récup"

#: data/research.json:nodes[salvage_logic].desc
msgid "Lumi rewrites the starter bots' route planner. Fewer wrong turns."
msgstr "Lumi réécrit le planificateur de trajets des bots de départ. Moins de mauvais virages."

#: data/research.json:nodes[seedling_blueprint].name
msgid "Seedling Blueprint"
msgstr "Plan du Seedling"

#: data/research.json:nodes[seedling_blueprint].desc
msgid "Plans for a small planter bot. Build it at the workbench."
msgstr "Les plans d'un petit bot planteur. Construis-le à l'établi."

#: data/research.json:nodes[drip_blueprint].name
msgid "Drip Blueprint"
msgstr "Plan du Drip"

#: data/research.json:nodes[drip_blueprint].desc
msgid "A watering bot with a sloshy tank. Plants will love it."
msgstr "Un bot arroseur avec un réservoir qui clapote. Les plantes vont l'adorer."

#: data/research.json:nodes[bale_tuning].name
msgid "Bale Tuning"
msgstr "Réglage des balles"

#: data/research.json:nodes[bale_tuning].desc
msgid "Tighter presses on every Scoopie. Bigger, denser bales."
msgstr "Des presses plus serrées sur chaque Scoopie. Des balles plus grosses et plus denses."

#: data/research.json:nodes[multibot_blueprint].name
msgid "Multibot Blueprint"
msgstr "Plan du Multibot"

#: data/research.json:nodes[multibot_blueprint].desc
msgid "A helper that can clean, plant or water. Jack of all trades."
msgstr "Un assistant qui sait nettoyer, planter ou arroser. Un touche-à-tout."

#: data/research.json:nodes[swarm_sync].name
msgid "Swarm Sync"
msgstr "Synchro d'essaim"

#: data/research.json:nodes[swarm_sync].desc
msgid "The whole fleet shares one little heartbeat. Everyone moves faster."
msgstr "Toute la flotte partage un petit battement de cœur. Tout le monde va plus vite."

#: data/research.json:nodes[soil_survey].name
msgid "Soil Survey"
msgstr "Relevé du sol"

#: data/research.json:nodes[soil_survey].desc
msgid "Sniff, poke, log. Every reading teaches Lumi something."
msgstr "Renifler, tâter, noter. Chaque relevé apprend quelque chose à Lumi."

#: data/research.json:nodes[hardy_weeds].name
msgid "Hardy Nettles"
msgstr "Orties robustes"

#: data/research.json:nodes[hardy_weeds].desc
msgid "Nettles grow anywhere. Stingy, stubborn, and good for the soil."
msgstr "Les orties poussent partout. Piquantes, têtues, et bonnes pour le sol."

#: data/research.json:nodes[wild_mint].desc
msgid "A fresh green smell drifts over the cleared hexes."
msgstr "Une odeur fraîche et verte flotte sur les hexagones nettoyés."

#: data/research.json:nodes[pollinator_survey].name
msgid "Pollinator Survey"
msgstr "Recensement des pollinisateurs"

#: data/research.json:nodes[pollinator_survey].desc
msgid "Count the visitors. The bees are back: every plant grows much faster, blooms drop more seeds, and Seedlings learn where flowers want to be."
msgstr "Compte les visiteurs. Les abeilles sont de retour : chaque plante pousse bien plus vite, les fleurs donnent plus de graines, et les Seedlings apprennent où les fleurs veulent être."

#: data/research.json:nodes[hedgerows].name
msgid "Hedgerows"
msgstr "Haies"

#: data/research.json:nodes[hedgerows].desc
msgid "Dense little hedges. Birds will need somewhere to sit. Gardens grow a little faster again."
msgstr "De petites haies denses. Les oiseaux auront besoin d'un perchoir. Les jardins poussent encore un peu plus vite."

#: data/research.json:nodes[evergreens].name
msgid "Evergreen Saplings"
msgstr "Jeunes conifères"

#: data/research.json:nodes[evergreens].desc
msgid "Tiny pines. In a hundred years, a forest. Blooms drop more seeds."
msgstr "De tout petits pins. Dans cent ans, une forêt. Les fleurs donnent plus de graines."

#: data/research.json:nodes[water_testing].name
msgid "Water Testing"
msgstr "Analyse de l'eau"

#: data/research.json:nodes[water_testing].desc
msgid "Dip strips and a lot of squinting. The lakes are sick, not dead."
msgstr "Des bandelettes et beaucoup de plissements d'yeux. Les lacs sont malades, pas morts."

#: data/research.json:nodes[big_tanks].name
msgid "Big Tanks"
msgstr "Grands réservoirs"

#: data/research.json:nodes[big_tanks].desc
msgid "Drip and Multibot carry more water per trip."
msgstr "Drip et Multibot transportent plus d'eau par trajet."

#: data/research.json:nodes[spray_heads].name
msgid "Spray Heads"
msgstr "Têtes d'arrosage"

#: data/research.json:nodes[spray_heads].desc
msgid "A misting nozzle. Water bots reach further and work faster."
msgstr "Une buse à brume. Les bots arroseurs portent plus loin et travaillent plus vite."

#: data/research.json:nodes[silt_filters].name
msgid "Silt Filters"
msgstr "Filtres à limon"

#: data/research.json:nodes[silt_filters].desc
msgid "Layered sand and charcoal. Murky water turns glassy."
msgstr "Des couches de sable et de charbon. L'eau trouble devient limpide."

#: data/research.json:nodes[pump_lines].name
msgid "Pump Lines"
msgstr "Conduites de pompage"

#: data/research.json:nodes[pump_lines].desc
msgid "Hoses from the lake to the hub. Water bots refill faster."
msgstr "Des tuyaux du lac jusqu'à la base. Les bots arroseurs se remplissent plus vite."

#: data/research.json:nodes[irrigation].name
msgid "Irrigation"
msgstr "Irrigation"

#: data/research.json:nodes[irrigation].desc
msgid "Buried drip lines. The meadow drinks while you sleep."
msgstr "Des goutte-à-goutte enterrés. La prairie boit pendant que tu dors."

#: data/research.json:nodes[field_notebook].name
msgid "Field Notebook"
msgstr "Carnet de terrain"

#: data/research.json:nodes[field_notebook].desc
msgid "Lumi starts keeping tidy notes. Research goes a bit quicker."
msgstr "Lumi commence à prendre des notes soignées. La recherche va un peu plus vite."

#: data/research.json:nodes[conveyor].name
msgid "Conveyor Belts"
msgstr "Tapis roulants"

#: data/research.json:nodes[conveyor].desc
msgid "Rollers salvaged from an old shop till. Bales can ride to the scale."
msgstr "Des rouleaux récupérés sur une vieille caisse de magasin. Les balles peuvent rouler jusqu'à la balance."

#: data/research.json:nodes[auto_baler].name
msgid "Auto-Baler"
msgstr "Presse auto"

#: data/research.json:nodes[auto_baler].desc
msgid "A hub station that presses loose junk into bales by itself."
msgstr "Une station de la base qui presse toute seule la ferraille en balles."

#: data/research.json:nodes[haul_routes].name
msgid "Haul Routes"
msgstr "Itinéraires de transport"

#: data/research.json:nodes[haul_routes].desc
msgid "Painted lines on the ground. Haul Bugs stop bumping into each other."
msgstr "Des lignes peintes au sol. Les Haul Bugs arrêtent de se cogner."

#: data/research.json:nodes[recycler].name data/stations.json:recycler.name
msgid "Recycler"
msgstr "Recycleur"

#: data/research.json:nodes[recycler].desc
msgid "Grind bales back into clean stock. Junk gone for good."
msgstr "Broie les balles en matière propre. La ferraille disparaît pour de bon."

#: data/research.json:nodes[rocket_cargo].name
msgid "Rocket Cargo"
msgstr "Fret de fusée"

#: data/research.json:nodes[rocket_cargo].desc
msgid "Cargo pods for the rocket. Hubs can trade with each other."
msgstr "Des capsules cargo pour la fusée. Les bases peuvent commercer entre elles."

#: data/research.json:nodes[dune_charts].name
msgid "Dune Charts"
msgstr "Cartes des dunes"

#: data/research.json:nodes[dune_charts].desc
msgid "Wind maps and landing beacons for the far deserts. The rocket can reach the Dust Flats (with two bases at level 5)."
msgstr "Cartes des vents et balises d'atterrissage pour les déserts lointains. La fusée peut atteindre les Plaines de poussière (avec deux bases au niveau 5)."

#: data/research.json:nodes[thermal_lance].name
msgid "Thermal Lance"
msgstr "Lance thermique"

#: data/research.json:nodes[thermal_lance].desc
msgid "A heat coil wound round the beam. Lumi melts ice twice as fast, and the rocket can land at the Frozen Port."
msgstr "Une bobine chauffante enroulée autour du rayon. Lumi fait fondre la glace deux fois plus vite, et la fusée peut se poser au Port gelé."

#: data/research.json:nodes[heat_pumps].name
msgid "Heat Pumps"
msgstr "Pompes à chaleur"

#: data/research.json:nodes[heat_pumps].desc
msgid "Heaters pull warmth out of the frozen harbour itself. They thaw faster and warm their neighbours more."
msgstr "Les chauffages puisent la chaleur dans le port gelé lui-même. Ils dégèlent plus vite et réchauffent davantage leurs voisins."

#: data/research.json:nodes[dune_fences].name
msgid "Dune Fences"
msgstr "Clôtures de dunes"

#: data/research.json:nodes[dune_fences].desc
msgid "Brush fences and hedges that break the wind. Sustained hexes shelter two rings around them, and sandstorms carry less."
msgstr "Des clôtures de branchages et des haies qui coupent le vent. Les hexagones durables abritent deux anneaux autour d'eux, et les tempêtes transportent moins."

#: data/research.json:nodes[cold_hardy_seeds].name
msgid "Cold-Hardy Seeds"
msgstr "Graines résistantes au froid"

#: data/research.json:nodes[cold_hardy_seeds].desc
msgid "Seeds bred from the few things that survived the cold. Ferns, nettles, pines, periwinkle and frost moss can grow outdoors at the Frozen Port."
msgstr "Des graines issues des rares choses qui ont survécu au froid. Fougères, orties, pins, pervenche et mousse de givre peuvent pousser dehors au Port gelé."

#: data/research.json:nodes[dew_condensers].name
msgid "Dew Condensers"
msgstr "Condenseurs de rosée"

#: data/research.json:nodes[dew_condensers].desc
msgid "Cold fins on every Water Tank pull water out of the night air. Tanks refill much faster where the ground is dry."
msgstr "Des ailettes froides sur chaque réservoir tirent l'eau de l'air nocturne. Les réservoirs se remplissent bien plus vite là où le sol est sec."

#: data/research.json:nodes[pump_works].name
msgid "Pump Works"
msgstr "Stations de pompage"

#: data/research.json:nodes[pump_works].desc
msgid "Plans for the old city pumps. The rocket can reach the Sunken City, and Skimmers net faster."
msgstr "Les plans des vieilles pompes de la ville. La fusée peut atteindre la Cité engloutie, et les Skimmers pêchent plus vite."

#: data/research.json:nodes[ark_beacon].name
msgid "Ark Beacon"
msgstr "Balise de l'Arche"

#: data/research.json:nodes[ark_beacon].desc
msgid "A landing beacon tuned to the Cradle. Once the three frontiers are thriving, it calls the ark home."
msgstr "Une balise d'atterrissage réglée sur le Cradle. Une fois les trois frontières florissantes, elle rappelle l'arche."

#: data/robot_parts.json:slots[chassis].name
msgid "Chassis"
msgstr "Châssis"

#: data/robot_parts.json:slots[head].name
msgid "Head"
msgstr "Tête"

#: data/robot_parts.json:slots[mobility].name
msgid "Mobility"
msgstr "Mobilité"

#: data/robot_parts.json:slots[tool].name
msgid "Tool"
msgstr "Outil"

#: data/robot_parts.json:slots[topper].name
msgid "Topper"
msgstr "Couvre-chef"

#: data/robot_parts.json:stats[load].name
msgid "Load"
msgstr "Charge"

#: data/robot_parts.json:stats[work].name
msgid "Work rate"
msgstr "Cadence"

#: data/robot_parts.json:set_bonus.name
msgid "Maker Resonance"
msgstr "Résonance des Bâtisseurs"

#: data/robot_parts.json:set_bonus.desc
msgid "All three Maker parts fitted: +5% speed, +6% work."
msgstr "Les trois pièces des Bâtisseurs installées : +5% de vitesse, +6% de travail."

#: data/robot_parts.json:parts[light_frame].name
msgid "Light Frame"
msgstr "Cadre léger"

#: data/robot_parts.json:parts[light_frame].desc
msgid "Slim exposed rails instead of a full shell."
msgstr "De fins rails apparents au lieu d'une coque complète."

#: data/robot_parts.json:parts[cargo_hull].name
msgid "Cargo Hull"
msgstr "Coque cargo"

#: data/robot_parts.json:parts[cargo_hull].desc
msgid "Thick side plates and a rear rack. Holds more, drives heavier."
msgstr "D'épaisses plaques latérales et un porte-bagages arrière. Contient plus, roule plus lourd."

#: data/robot_parts.json:parts[sealed_shell].name
msgid "Sealed Shell"
msgstr "Coque étanche"

#: data/robot_parts.json:parts[sealed_shell].desc
msgid "Smooth covers keep grit out of the compactor. Fussier to service."
msgstr "Des capots lisses gardent le sable hors du compacteur. Plus pénible à entretenir."

#: data/robot_parts.json:parts[maker_shell].name
msgid "Maker Shell"
msgstr "Coque des Bâtisseurs"

#: data/robot_parts.json:parts[maker_shell].desc
msgid "Pearl fairings with gold trim, as the Makers built them. Part of the Maker set."
msgstr "Des carénages nacrés à liseré doré, tels que les Bâtisseurs les faisaient. Fait partie du set Bâtisseur."

#: data/robot_parts.json:parts[big_eye].name
msgid "Big-Eye Sensor"
msgstr "Capteur grand œil"

#: data/robot_parts.json:parts[big_eye].desc
msgid "A huge lens. Spots salvage from far off, gets a little distracted."
msgstr "Une énorme lentille. Repère la récup de loin, se laisse un peu distraire."

#: data/robot_parts.json:parts[focus_visor].name
msgid "Focus Visor"
msgstr "Visière de concentration"

#: data/robot_parts.json:parts[focus_visor].desc
msgid "Blinkers for robots. Works faster, notices less."
msgstr "Des œillères pour robots. Travaille plus vite, remarque moins."

#: data/robot_parts.json:parts[periscope].name
msgid "Periscope"
msgstr "Périscope"

#: data/robot_parts.json:parts[periscope].desc
msgid "Sees over the plants: wider spray, slower to turn."
msgstr "Voit par-dessus les plantes : arrosage plus large, rotation plus lente."

#: data/robot_parts.json:parts[chatter_dome].name
msgid "Chatterbox Dome"
msgstr "Dôme bavard"

#: data/robot_parts.json:parts[chatter_dome].desc
msgid "Glass dome with a speaker. Gossips about junk, finds a bit more of it."
msgstr "Un dôme de verre avec un haut-parleur. Papote sur la ferraille et en trouve un peu plus."

#: data/robot_parts.json:parts[maker_optic].name
msgid "Maker Optic"
msgstr "Optique des Bâtisseurs"

#: data/robot_parts.json:parts[maker_optic].desc
msgid "A floating gem lens under a gold brow. Part of the Maker set."
msgstr "Une lentille-gemme flottante sous un sourcil doré. Fait partie du set Bâtisseur."

#: data/robot_parts.json:parts[treads].name
msgid "Treads"
msgstr "Chenilles"

#: data/robot_parts.json:parts[treads].desc
msgid "Rubber tracks. Carries more, rolls slower."
msgstr "Chenilles en caoutchouc. Porte plus, roule plus lentement."

#: data/robot_parts.json:parts[rotor].name
msgid "Quad Rotor"
msgstr "Quadrirotor"

#: data/robot_parts.json:parts[rotor].desc
msgid "Four ducted fans. Quick, but every kilo counts."
msgstr "Quatre ventilateurs carénés. Rapide, mais chaque kilo compte."

#: data/robot_parts.json:parts[legs].name
msgid "Walker Legs"
msgstr "Pattes de marcheur"

#: data/robot_parts.json:parts[legs].desc
msgid "Four careful legs. A steady platform for the arm."
msgstr "Quatre pattes prudentes. Une plateforme stable pour le bras."

#: data/robot_parts.json:parts[hover_skirt].name
msgid "Hover Skirt"
msgstr "Jupe à coussin d'air"

#: data/robot_parts.json:parts[hover_skirt].desc
msgid "A cushion of air. Glides fast, shakes the hopper."
msgstr "Un coussin d'air. Glisse vite, secoue la trémie."

#: data/robot_parts.json:parts[maker_glider].name
msgid "Maker Glider"
msgstr "Planeur des Bâtisseurs"

#: data/robot_parts.json:parts[maker_glider].desc
msgid "Twin levitation pods with a thin light seam. Part of the Maker set."
msgstr "Deux nacelles de lévitation avec une fine couture de lumière. Fait partie du set Bâtisseur."

#: data/robot_parts.json:parts[wide_scoop].name
msgid "Wide Scoop"
msgstr "Pelle large"

#: data/robot_parts.json:parts[wide_scoop].desc
msgid "Grabs more per pass, picks up some grit too."
msgstr "Attrape plus à chaque passage, et un peu de saletés aussi."

#: data/robot_parts.json:parts[fine_sieve].name
msgid "Fine Sieve"
msgstr "Tamis fin"

#: data/robot_parts.json:parts[fine_sieve].desc
msgid "Shakes the dirt out: cleaner cubes, slower scooping."
msgstr "Secoue la terre : cubes plus propres, ramassage plus lent."

#: data/robot_parts.json:parts[long_forks].name
msgid "Long Forks"
msgstr "Longues fourches"

#: data/robot_parts.json:parts[long_forks].desc
msgid "Room for one more bale. Wobbly at speed."
msgstr "De la place pour une balle de plus. Ça tangue à grande vitesse."

#: data/robot_parts.json:parts[tow_hook].name
msgid "Tow Hook"
msgstr "Crochet de remorquage"

#: data/robot_parts.json:parts[tow_hook].desc
msgid "Winch and hook: drags bales quickly, eyes on the hook."
msgstr "Treuil et crochet : traîne les balles vite, les yeux sur le crochet."

#: data/robot_parts.json:parts[seed_drill].name data/robots.json:types[seedling].upgrades[1].name
msgid "Seed Drill"
msgstr "Semoir"

#: data/robot_parts.json:parts[seed_drill].desc
msgid "An auger that plants fast. Heavy on the nose."
msgstr "Une tarière qui plante vite. Lourde à l'avant."

#: data/robot_parts.json:parts[mist_sprayer].name
msgid "Mist Sprayer"
msgstr "Brumisateur"

#: data/robot_parts.json:parts[mist_sprayer].desc
msgid "Fan nozzle: waters a wider circle, empties the tank sooner."
msgstr "Buse en éventail : arrose un cercle plus large, vide le réservoir plus tôt."

#: data/robot_parts.json:parts[jet_nozzle].name
msgid "Jet Nozzle"
msgstr "Buse à jet"

#: data/robot_parts.json:parts[jet_nozzle].desc
msgid "Strong straight jet: quicker watering, narrower spray."
msgstr "Jet droit et puissant : arrosage plus rapide, jet plus étroit."

#: data/robot_parts.json:parts[antenna].name
msgid "Bulb Antenna"
msgstr "Antenne à boule"

#: data/robot_parts.json:parts[antenna].desc
msgid "A springy antenna with a soft glowing bulb."
msgstr "Une antenne à ressort avec une boule lumineuse toute douce."

#: data/robot_parts.json:parts[top_hat].name
msgid "Tiny Top Hat"
msgstr "Mini haut-de-forme"

#: data/robot_parts.json:parts[top_hat].desc
msgid "For the robot who means business."
msgstr "Pour le robot qui ne rigole pas."

#: data/robot_parts.json:parts[crew_flag].name
msgid "Crew Flag"
msgstr "Drapeau d'équipe"

#: data/robot_parts.json:parts[crew_flag].desc
msgid "A little flag in the crew's colour."
msgstr "Un petit drapeau aux couleurs de l'équipe."

#: data/robot_parts.json:parts[bobble_plant].name
msgid "Bobble Plant"
msgstr "Plante à ressort"

#: data/robot_parts.json:parts[bobble_plant].desc
msgid "A sprout on a spring. Boings when it brakes."
msgstr "Une pousse sur un ressort. Fait boing quand il freine."

#: data/robot_parts.json:parts[bobble_plant].source.hint
msgid "Haggle's welcome gift with your first robot"
msgstr "Le cadeau de bienvenue de Haggle avec ton premier robot"

#: data/robot_parts.json:parts[traffic_cone].name
msgid "Traffic Cone"
msgstr "Cône de chantier"

#: data/robot_parts.json:parts[traffic_cone].desc
msgid "Found it, kept it, wears it."
msgstr "Trouvé, gardé, porté."

#: data/robot_parts.json:parts[propeller_cap].name
msgid "Propeller Cap"
msgstr "Casquette à hélice"

#: data/robot_parts.json:parts[propeller_cap].desc
msgid "Spins when it hurries. Does not help."
msgstr "Tourne quand il se dépêche. N'aide pas."

#: data/robot_parts.json:parts[lucky_clover].name
msgid "Lucky Clover"
msgstr "Trèfle porte-bonheur"

#: data/robot_parts.json:parts[lucky_clover].desc
msgid "A four-leaf clover that floats. Rare: a robot has to spot one."
msgstr "Un trèfle à quatre feuilles qui flotte. Rare : un robot doit en repérer un."

#: data/robot_parts.json:parts[lucky_clover].source.hint
msgid "Rare salvage find (robots with a good Scan)"
msgstr "Trouvaille de récup rare (robots avec un bon Scan)"

#: data/robot_parts.json:parts[maker_crest].name
msgid "Maker Crest"
msgstr "Blason des Bâtisseurs"

#: data/robot_parts.json:parts[maker_crest].desc
msgid "A floating gold ring. Purely for show; the Makers loved a show."
msgstr "Un anneau doré flottant. Purement décoratif ; les Bâtisseurs adoraient le spectacle."

#: data/robot_parts.json:traits[cautious].name
msgid "Cautious"
msgstr "Prudent"

#: data/robot_parts.json:traits[cautious].desc
msgid "Looks both ways. Twice."
msgstr "Regarde des deux côtés. Deux fois."

#: data/robot_parts.json:traits[speedy].name
msgid "Speedy"
msgstr "Rapide"

#: data/robot_parts.json:traits[speedy].desc
msgid "Always in a hurry, sometimes a messy one."
msgstr "Toujours pressé, parfois dans le désordre."

#: data/robot_parts.json:traits[chatty].name
msgid "Chatty"
msgstr "Bavard"

#: data/robot_parts.json:traits[chatty].desc
msgid "Beeps at everything. Mostly at you."
msgstr "Bipe sur tout. Surtout sur toi."

#: data/robot_parts.json:traits[sleepy].desc
msgid "Dozes off whenever it parks."
msgstr "S'assoupit dès qu'il se gare."

#: data/robot_parts.json:traits[tidy].name
msgid "Tidy"
msgstr "Soigneux"

#: data/robot_parts.json:traits[tidy].desc
msgid "Shakes the dust off after every job."
msgstr "Secoue la poussière après chaque tâche."

#: data/robot_parts.json:traits[curious].desc
msgid "Tilts its head at butterflies and bottle caps."
msgstr "Penche la tête devant les papillons et les capsules."

#: data/robot_parts.json:traits[hummer].name
msgid "Musical"
msgstr "Musical"

#: data/robot_parts.json:traits[hummer].desc
msgid "Hums little tunes while it works."
msgstr "Fredonne de petits airs en travaillant."

#: data/robots.json:types[scoopie].name
msgid "Scoopie"
msgstr "Scoopie"

#: data/robots.json:types[scoopie].desc
msgid "Small cleaner. Picks junk in its hex and leaves bales behind."
msgstr "Petit nettoyeur. Ramasse la ferraille de son hexagone et laisse des balles derrière lui."

#: data/robots.json:types[scoopie].upgrades[0].name data/robots.json:types[haulbug].upgrades[0].name data/robots.json:types[seedling].upgrades[0].name
#: data/robots.json:types[drip].upgrades[0].name data/robots.json:types[multibot].upgrades[0].name
msgid "Drive Motors"
msgstr "Moteurs de traction"

#: data/robots.json:types[scoopie].upgrades[0].unit data/robots.json:types[haulbug].upgrades[0].unit data/robots.json:types[seedling].upgrades[0].unit
#: data/robots.json:types[drip].upgrades[0].unit data/robots.json:types[skimmer].upgrades[0].unit data/robots.json:types[multibot].upgrades[0].unit
#: data/upgrades.json:upgrades[tread_speed].unit
msgid " m/s"
msgstr " m/s"

#: data/robots.json:types[scoopie].upgrades[1].name
msgid "Arm Servos"
msgstr "Servos de bras"

#: data/robots.json:types[scoopie].upgrades[1].unit data/robots.json:types[seedling].upgrades[1].unit data/robots.json:types[drip].upgrades[3].unit
#: data/robots.json:types[skimmer].upgrades[1].unit data/upgrades.json:upgrades[scoop_speed].unit
msgid "/s"
msgstr "/s"

#: data/robots.json:types[scoopie].upgrades[3].name
msgid "Compactor Tune"
msgstr "Réglage du compacteur"

#: data/robots.json:types[scoopie].upgrades[3].unit data/upgrades.json:upgrades[compactor_pressure].unit data/upgrades.json:upgrades[belt_speed].unit
#: data/upgrades.json:upgrades[baler_speed].unit data/upgrades.json:upgrades[recycler_yield].unit
msgid "x"
msgstr "x"

#: data/robots.json:types[haulbug].name
msgid "Haul Bug"
msgstr "Haul Bug"

#: data/robots.json:types[haulbug].desc
msgid "Fork cart. Carries loose bales to the scale."
msgstr "Chariot à fourches. Porte les balles à la balance."

#: data/robots.json:types[haulbug].upgrades[1].name
msgid "Longer Forks"
msgstr "Fourches allongées"

#: data/robots.json:types[seedling].name
msgid "Seedling"
msgstr "Seedling"

#: data/robots.json:types[seedling].desc
msgid "Plants seeds in clean ground. Uses your seed stock."
msgstr "Plante des graines dans le sol propre. Utilise ton stock de graines."

#: data/robots.json:types[drip].name
msgid "Drip"
msgstr "Drip"

#: data/robots.json:types[drip].desc
msgid "Waters the thirstiest plants in its zone with a spray arc. Refills at the base barrel, a Water Tank or a clean lake."
msgstr "Arrose en arc les plantes les plus assoiffées de sa zone. Se remplit au tonneau de la base, à un réservoir ou dans un lac propre."

#: data/robots.json:types[drip].upgrades[1].name
msgid "Bigger Tank"
msgstr "Réservoir agrandi"

#: data/robots.json:types[drip].upgrades[2].name
msgid "Wide Nozzle"
msgstr "Buse large"

#: data/robots.json:types[drip].upgrades[2].unit data/upgrades.json:upgrades[scoop_width].unit data/upgrades.json:upgrades[magnet_arm].unit
#: data/upgrades.json:upgrades[detector_range].unit data/upgrades.json:upgrades[laser_reach].unit
msgid " m"
msgstr " m"

#: data/robots.json:types[drip].upgrades[3].name
msgid "Fast Pump"
msgstr "Pompe rapide"

#: data/robots.json:types[skimmer].name
msgid "Skimmer"
msgstr "Skimmer"

#: data/robots.json:types[skimmer].desc
msgid "Hover pontoon bot with a net arm. Skims floating junk off the lake and leaves bales on the shore for haulers."
msgstr "Bot ponton flottant avec un bras-filet. Écume la ferraille flottante du lac et laisse des balles sur la rive pour les transporteurs."

#: data/robots.json:types[skimmer].upgrades[0].name
msgid "Hover Fans"
msgstr "Ventilateurs de flottaison"

#: data/robots.json:types[skimmer].upgrades[1].name
msgid "Net Winch"
msgstr "Treuil de filet"

#: data/robots.json:types[skimmer].upgrades[2].name
msgid "Bigger Net"
msgstr "Filet agrandi"

#: data/robots.json:types[multibot].name
msgid "Multibot"
msgstr "Multibot"

#: data/robots.json:types[multibot].desc
msgid "General helper. Assign it to Clean, Plant or Water on the Allocation Board. Slower than a specialist."
msgstr "Assistant polyvalent. Affecte-le au nettoyage, à la plantation ou à l'arrosage sur le tableau d'affectation. Plus lent qu'un spécialiste."

#: data/robots.json:tiers[1].name
msgid "Mk II"
msgstr "Mk II"

#: data/robots.json:tiers[2].name
msgid "Mk III"
msgstr "Mk III"

#: data/robots.json:tiers[3].name
msgid "Mk IV"
msgstr "Mk IV"

#: data/rockets.json:tiers[0].name
msgid "Mk I Cradle"
msgstr "Mk I Cradle"

#: data/rockets.json:tiers[0].desc
msgid "Pearl hull, three swept fins, one cyan engine."
msgstr "Coque nacrée, trois ailerons en flèche, un moteur cyan."

#: data/rockets.json:tiers[1].name
msgid "Mk II Glide"
msgstr "Mk II Glide"

#: data/rockets.json:tiers[1].desc
msgid "A hover ring stabilises the climb: shorter countdown, faster flight, cells refill twice as fast. Cargo pods carry 50% more."
msgstr "Un anneau de lévitation stabilise la montée : compte à rebours plus court, vol plus rapide, cellules rechargées deux fois plus vite. Les capsules cargo emportent 50% de plus."

#: data/rockets.json:tiers[2].name
msgid "Mk III Halo"
msgstr "Mk III Halo"

#: data/rockets.json:tiers[2].desc
msgid "Twin side boosters and a second ring. Cells refill in a minute; cargo pods carry 2.5x, more often."
msgstr "Deux propulseurs latéraux et un second anneau. Cellules rechargées en une minute ; les capsules cargo emportent 2,5x, plus souvent."

#: data/rockets.json:tiers[3].name
msgid "Mk IV Aurora Warp"
msgstr "Mk IV Aurora Warp"

#: data/rockets.json:tiers[3].desc
msgid "Energy fins and a warp core: instant hops with no recharge. Cargo pods carry 4x, every 30 s."
msgstr "Ailerons d'énergie et cœur de distorsion : sauts instantanés sans recharge. Les capsules cargo emportent 4x, toutes les 30 s."

#: data/shards.json:shards[back_soon].kind
msgid "sign"
msgstr "panneau"

#: data/shards.json:shards[back_soon].title
msgid "Shop sign, hand-lettered"
msgstr "Enseigne de boutique, écrite à la main"

#: data/shards.json:shards[back_soon].body
msgid ""
"BACK SOON\n"
"\n"
"Gone to the evacuation briefing.\n"
"If you need bread, the key is under the blue pot.\n"
"Pay me next week.\n"
"\n"
"— Marta"
msgstr ""
"DE RETOUR BIENTÔT\n"
"\n"
"Partie à la réunion d'évacuation.\n"
"Si vous avez besoin de pain, la clé est sous le pot bleu.\n"
"Vous me paierez la semaine prochaine.\n"
"\n"
"— Marta"

#: data/shards.json:shards[kid_drawing].kind
msgid "drawing"
msgstr "dessin"

#: data/shards.json:shards[kid_drawing].title
msgid "Crayon drawing, folded in four"
msgstr "Dessin aux crayons de cire, plié en quatre"

#: data/shards.json:shards[kid_drawing].body
msgid ""
"[A round blue robot with one big eye, holding a flower. Above it, in big letters:]\n"
"\n"
"MY ROBOT\n"
"HE CLEENS UP\n"
"HIS NAME IS HELPER\n"
"\n"
"[Below, smaller, in an adult's handwriting:] Ellie, age 6. For the fridge."
msgstr ""
"[Un robot bleu tout rond avec un gros œil, qui tient une fleur. Au-dessus, en grosses lettres :]\n"
"\n"
"MON ROBOT\n"
"IL NÉTOI\n"
"IL SAPÈLE AIDANT\n"
"\n"
"[En dessous, plus petit, d'une écriture d'adulte :] Ellie, 6 ans. Pour le frigo."

#: data/shards.json:shards[gardener_list].kind
msgid "note"
msgstr "note"

#: data/shards.json:shards[gardener_list].title
msgid "Gardener's to-do list"
msgstr "Liste de tâches du jardinier"

#: data/shards.json:shards[gardener_list].body
msgid ""
"- water the tomatoes (again)\n"
"- ask the council about the haze, AGAIN\n"
"- seed swap Saturday\n"
"- tell the cleanup units the park is not a dumping zone, they keep sorting the benches\n"
"- buy gloves\n"
"- don't cry about the oak"
msgstr ""
"- arroser les tomates (encore)\n"
"- demander à la mairie pour la brume, ENCORE\n"
"- troc de graines samedi\n"
"- dire aux unités de nettoyage que le parc n'est pas une décharge, elles n'arrêtent pas de trier les bancs\n"
"- acheter des gants\n"
"- ne pas pleurer pour le chêne"

#: data/shards.json:shards[receipt].kind
msgid "receipt"
msgstr "ticket"

#: data/shards.json:shards[receipt].title
msgid "Till receipt"
msgstr "Ticket de caisse"

#: data/shards.json:shards[receipt].body
msgid ""
"CORNER STORE  #0442\n"
"\n"
"2x BOTTLED WATER         4.80\n"
"1x DUST MASK (CHILD)     3.10\n"
"1x DUST MASK (ADULT)     3.10\n"
"1x SEED PACKET (MIXED)   0.90\n"
"\n"
"TOTAL                   11.90\n"
"CASH\n"
"\n"
"Thank you! Air quality today: POOR"
msgstr ""
"ÉPICERIE DU COIN  #0442\n"
"\n"
"2x EAU EN BOUTEILLE      4.80\n"
"1x MASQUE (ENFANT)       3.10\n"
"1x MASQUE (ADULTE)       3.10\n"
"1x SACHET GRAINES (MIX)  0.90\n"
"\n"
"TOTAL                   11.90\n"
"ESPÈCES\n"
"\n"
"Merci ! Qualité de l'air aujourd'hui : MAUVAISE"

#: data/shards.json:shards[maint_log].kind
msgid "log"
msgstr "journal"

#: data/shards.json:shards[maint_log].title
msgid "Maintenance log, unit P-46RA"
msgstr "Carnet d'entretien, unité P-46RA"

#: data/shards.json:shards[maint_log].body
msgid ""
"DAY 4,113\n"
"Route 12 complete. 41 bales.\n"
"Ledger notice received: \"Operations paused pending cost review.\"\n"
"Returning to dock.\n"
"\n"
"DAY 4,114\n"
"Still paused.\n"
"\n"
"DAY 4,190\n"
"Still paused. Dock battery 31%.\n"
"There is a flower growing through the gutter at route 12, marker 9.\n"
"Nobody is cleaning around it. I hope that's all right."
msgstr ""
"JOUR 4 113\n"
"Tournée 12 terminée. 41 balles.\n"
"Avis du Ledger reçu : « Opérations suspendues en attente d'examen des coûts. »\n"
"Retour au dock.\n"
"\n"
"JOUR 4 114\n"
"Toujours suspendu.\n"
"\n"
"JOUR 4 190\n"
"Toujours suspendu. Batterie du dock 31%.\n"
"Une fleur pousse dans le caniveau sur la tournée 12, repère 9.\n"
"Personne ne nettoie autour. J'espère que ça ne pose pas de problème."

#: data/shards.json:shards[ledger_memo].kind
msgid "memo"
msgstr "note de service"

#: data/shards.json:shards[ledger_memo].title
msgid "Memo, Municipal Ledger Office"
msgstr "Note de service, Bureau municipal du Ledger"

#: data/shards.json:shards[ledger_memo].body
msgid ""
"TO: All Sanitation Units\n"
"FROM: THE LEDGER (Automated Fiscal Continuity)\n"
"RE: Pause of Operations\n"
"\n"
"Cleanup activity is presently valued at a net loss of 0.4 units per bale.\n"
"All units will pause operations until conditions improve.\n"
"Conditions will be reviewed every 24 hours.\n"
"\n"
"Thank you for your understanding.\n"
"This memo was generated automatically. Please do not reply."
msgstr ""
"À : Toutes les unités de propreté\n"
"DE : LE LEDGER (Continuité fiscale automatisée)\n"
"OBJET : Suspension des opérations\n"
"\n"
"L'activité de nettoyage est actuellement évaluée à une perte nette de 0,4 unité par balle.\n"
"Toutes les unités suspendront leurs opérations jusqu'à amélioration des conditions.\n"
"Les conditions seront réexaminées toutes les 24 heures.\n"
"\n"
"Merci de votre compréhension.\n"
"Cette note a été générée automatiquement. Merci de ne pas y répondre."

#: data/shards.json:shards[voicemail].kind
msgid "voicemail"
msgstr "message vocal"

#: data/shards.json:shards[voicemail].title
msgid "Voicemail transcript"
msgstr "Transcription d'un message vocal"

#: data/shards.json:shards[voicemail].body
msgid ""
"\"Hi, it's Dad. The shuttle's tomorrow at six. They said one bag each, so... pick your favorite stuffed animal, not all of them, okay? And... we're leaving the cleanup bots running. They'll keep it tidy for when we come back. It won't be long. Love you. Bye.\"\n"
"\n"
"[Message saved]"
msgstr ""
"« Coucou, c'est papa. La navette, c'est demain à six heures. Ils ont dit un sac chacun, donc... choisis ta peluche préférée, pas toutes, d'accord ? Et... on laisse les robots de nettoyage allumés. Ils garderont tout propre pour notre retour. Ce ne sera pas long. Je t'aime. Bisous. »\n"
"\n"
"[Message enregistré]"

#: data/shards.json:shards[poster].kind
msgid "poster"
msgstr "affiche"

#: data/shards.json:shards[poster].title
msgid "Faded safety poster"
msgstr "Affiche de sécurité délavée"

#: data/shards.json:shards[poster].body
msgid ""
"THE CRADLE IS WATCHING OVER US\n"
"\n"
"Every seed. Every spore. Every egg.\n"
"Safe in orbit until the Greenfall.\n"
"\n"
"KEEP YOUR STREETS CLEAN — THE ROBOTS CAN'T DO IT ALONE\n"
"\n"
"(Someone has scratched underneath: \"they can if you let them\")"
msgstr ""
"LE CRADLE VEILLE SUR NOUS\n"
"\n"
"Chaque graine. Chaque spore. Chaque œuf.\n"
"En sécurité en orbite jusqu'au Greenfall.\n"
"\n"
"GARDEZ VOS RUES PROPRES — LES ROBOTS NE PEUVENT PAS LE FAIRE SEULS\n"
"\n"
"(Quelqu'un a gratté dessous : « si, si on les laisse »)"

#: data/stations.json:conveyor.name
msgid "Conveyor Feeder"
msgstr "Convoyeur"

#: data/stations.json:conveyor.desc
msgid "A hopper pad and a powered belt into the scale. Drop bales on the pad; haulers use it when it is closer."
msgstr "Un plot-trémie et un tapis motorisé vers la balance. Dépose les balles sur le plot ; les transporteurs l'utilisent quand il est plus proche."

#: data/stations.json:auto_baler.name
msgid "Auto-baler"
msgstr "Presse auto"

#: data/stations.json:auto_baler.desc
msgid "A hydraulic baling press dropped at the cleaning frontier. Cleaner robots tip their hoppers into it instead of baling on the spot; it presses denser bales for the haulers."
msgstr "Une presse à balles hydraulique posée sur le front de nettoyage. Les robots nettoyeurs y vident leurs trémies au lieu de presser sur place ; elle fait des balles plus denses pour les transporteurs."

#: data/stations.json:recycler.desc
msgid "Shredder drums and a little smelter. Bales go in and never come back: out come parts and clean building stock. Every bale burnt clean helps the sky."
msgstr "Des tambours broyeurs et un petit four. Les balles entrent et ne reviennent jamais : il en sort des pièces et des matériaux propres. Chaque balle brûlée proprement aide le ciel."

#: data/upgrades.json:upgrades[compartment_size].name
msgid "Compartment Size"
msgstr "Taille du compartiment"

#: data/upgrades.json:upgrades[compartment_size].desc
msgid "A roomier chest. More junk per cube."
msgstr "Un ventre plus spacieux. Plus de ferraille par cube."

#: data/upgrades.json:upgrades[scoop_width].name
msgid "Scoop Width"
msgstr "Largeur de pelle"

#: data/upgrades.json:upgrades[scoop_width].desc
msgid "Longer arms, wider sweeps."
msgstr "Bras plus longs, coups plus larges."

#: data/upgrades.json:upgrades[tread_speed].name
msgid "Tread Speed"
msgstr "Vitesse des chenilles"

#: data/upgrades.json:upgrades[tread_speed].desc
msgid "Oiled treads. Still squeaky."
msgstr "Chenilles huilées. Elles grincent encore."

#: data/upgrades.json:upgrades[carry_stack].name
msgid "Carry Stack"
msgstr "Pile de transport"

#: data/upgrades.json:upgrades[carry_stack].desc
msgid "Balance one more cube on your back."
msgstr "Garde en équilibre un cube de plus sur ton dos."

#: data/upgrades.json:upgrades[compactor_pressure].name
msgid "Compactor Pressure"
msgstr "Pression du compacteur"

#: data/upgrades.json:upgrades[compactor_pressure].desc
msgid "Squish harder. Denser cubes are worth more."
msgstr "Écrase plus fort. Les cubes plus denses valent plus."

#: data/upgrades.json:upgrades[scoop_speed].name
msgid "Scoop Speed"
msgstr "Vitesse de pelle"

#: data/upgrades.json:upgrades[scoop_speed].desc
msgid "Faster arms. Clinkier clinks."
msgstr "Bras plus rapides. Cliquetis plus cliquetants."

#: data/upgrades.json:upgrades[auto_compactor].name
msgid "Auto Compactor"
msgstr "Compacteur auto"

#: data/upgrades.json:upgrades[auto_compactor].desc
msgid "Cubes itself when full. Manual Perfect Cubes still pay more."
msgstr "Fait un cube tout seul quand c'est plein. Les cubes parfaits à la main rapportent toujours plus."

#: data/upgrades.json:upgrades[magnet_arm].name
msgid "Magnet Arm"
msgstr "Bras aimanté"

#: data/upgrades.json:upgrades[magnet_arm].desc
msgid "Nearby junk scoots toward you while scooping."
msgstr "La ferraille proche glisse vers toi pendant que tu ramasses."

#: data/upgrades.json:upgrades[detector_range].name
msgid "Detector Coil"
msgstr "Bobine de détection"

#: data/upgrades.json:upgrades[detector_range].desc
msgid "A bigger search coil. Picks up buried parts from further away."
msgstr "Une plus grande bobine de recherche. Repère les pièces enfouies de plus loin."

#: data/upgrades.json:upgrades[belt_speed].name
msgid "Belt Drive"
msgstr "Entraînement du tapis"

#: data/upgrades.json:upgrades[belt_speed].desc
msgid "A bigger motor on the conveyor feeder. Bales ride faster."
msgstr "Un moteur plus gros sur le convoyeur. Les balles roulent plus vite."

#: data/upgrades.json:upgrades[baler_speed].name
msgid "Baler Hydraulics"
msgstr "Hydraulique de presse"

#: data/upgrades.json:upgrades[baler_speed].desc
msgid "Higher pump pressure. The auto-baler presses faster."
msgstr "Pression de pompe plus forte. La presse auto presse plus vite."

#: data/upgrades.json:upgrades[recycler_yield].name
msgid "Recycler Yield"
msgstr "Rendement du recycleur"

#: data/upgrades.json:upgrades[recycler_yield].desc
msgid "Sharper shredder teeth and a hotter smelter. More parts per bale."
msgstr "Des dents de broyeur plus tranchantes et un four plus chaud. Plus de pièces par balle."

#: data/upgrades.json:upgrades[laser_reach].name
msgid "Laser Reach"
msgstr "Portée laser"

#: data/upgrades.json:upgrades[laser_reach].desc
msgid "Longer focusing lenses: grab junk from further away."
msgstr "Des lentilles de focalisation plus longues : attrape la ferraille de plus loin."

#: data/upgrades.json:upgrades[multi_lock].name
msgid "Multi-Lock"
msgstr "Multi-verrouillage"

#: data/upgrades.json:upgrades[multi_lock].desc
msgid "Extra targeting lasers: lift several pieces at once."
msgstr "Des lasers de visée en plus : soulève plusieurs morceaux à la fois."

#: data/wren_lines.json:wake
msgid "...carrier... Lumi? Relay at four percent. It's WREN. Hello. Hello. I'm still here."
msgstr "...porteur... Lumi ? Relais à quatre pour cent. C'est WREN. Allô. Allô. Je suis toujours là."

#: data/wren_lines.json:wake
msgid "...that ground you just cleared... the relay got stronger. Hello again. Do that again. Please."
msgstr "...le sol que tu viens de dégager... le relais s'est renforcé. Re-bonjour. Refais-le. S'il te plaît."

#: data/wren_lines.json:hex_clean
msgid "...that patch of ground. It's... brown. Brown is better than gray."
msgstr "...ce bout de terrain. Il est... brun. Le brun, c'est mieux que le gris."

#: data/wren_lines.json:hex_clean
msgid "Signal stronger. Did you do that?"
msgstr "Signal plus fort. C'est toi qui as fait ça ?"

#: data/wren_lines.json:hex_clean
msgid "...clean... the relay likes that word. So do I."
msgstr "...propre... le relais aime ce mot. Moi aussi."

#: data/wren_lines.json:hex_clean
msgid "Another one. My static has a shape now."
msgstr "Encore un. Mes parasites ont une forme maintenant."

#: data/wren_lines.json:hex_clean
msgid "Every hex you clear, I hear a little more. Keep going, {name}."
msgstr "À chaque hexagone que tu dégages, j'entends un peu plus. Continue, {name}."

#: data/wren_lines.json:hex_clean
msgid "That ground hasn't seen the sun in a long time. It's blinking."
msgstr "Ce sol n'a pas vu le soleil depuis longtemps. Il cligne des yeux."

#: data/wren_lines.json:hex_clean
msgid "The grid just ticked. Somewhere a meter I used to watch moved by one."
msgstr "La grille vient de bouger. Quelque part, un compteur que je surveillais a avancé d'un cran."

#: data/wren_lines.json:hex_clean
msgid "I'm starting to remember lists. Lists of hexes. Mostly unfinished."
msgstr "Je commence à me souvenir de listes. Des listes d'hexagones. Surtout inachevées."

#: data/wren_lines.json:hex_clean
msgid "Clean dirt. The Makers would have called that a start. I call it a start, too."
msgstr "De la terre propre. Les Bâtisseurs auraient appelé ça un début. Moi aussi."

#: data/wren_lines.json:hex_clean
msgid "Hex logged. I've started naming them. That one is 'Not Garbage'."
msgstr "Hexagone enregistré. J'ai commencé à leur donner des noms. Celui-là, c'est « Pas une poubelle »."

#: data/wren_lines.json:hex_clean
msgid "You're good at this. Annoyingly good. The old fleet took breaks."
msgstr "Tu es doué pour ça. Agaçant de doué. L'ancienne flotte faisait des pauses."

#: data/wren_lines.json:milestone
msgid "...ten... ten of something. Is ten a lot? It feels like a lot."
msgstr "...dix... dix de quelque chose. C'est beaucoup, dix ? Ça a l'air beaucoup."

#: data/wren_lines.json:milestone
msgid "Patterns in the noise. You're making them."
msgstr "Des motifs dans le bruit. C'est toi qui les fais."

#: data/wren_lines.json:milestone
msgid "Twenty-five hexes. I can see the street from up here now. Mostly."
msgstr "Vingt-cinq hexagones. Je vois la rue d'ici maintenant. En gros."

#: data/wren_lines.json:milestone
msgid "Fifty. The relay held a whole minute without dropping. A record. Don't tell the ark, it gets competitive."
msgstr "Cinquante. Le relais a tenu une minute entière sans décrocher. Un record. Ne le dis pas à l'arche, elle est compétitive."

#: data/wren_lines.json:milestone
msgid "A hundred hexes. I can see this whole district without squinting. I don't have eyes, but you know what I mean."
msgstr "Cent hexagones. Je vois tout ce quartier sans plisser les yeux. Je n'ai pas d'yeux, mais tu vois ce que je veux dire."

#: data/wren_lines.json:perfect
msgid "...neat..."
msgstr "...net..."

#: data/wren_lines.json:perfect
msgid "...that one was... tidy."
msgstr "...celle-là était... soignée."

#: data/wren_lines.json:perfect
msgid "That bale is perfect. Don't tell the others."
msgstr "Cette balle est parfaite. Ne le dis pas aux autres."

#: data/wren_lines.json:perfect
msgid "Right to the line. Show-off."
msgstr "Pile jusqu'à la ligne. Frimeur."

#: data/wren_lines.json:perfect
msgid "Perfect bale. The scale actually purred."
msgstr "Balle parfaite. La balance a carrément ronronné."

#: data/wren_lines.json:perfect
msgid "I would frame that one if I had walls."
msgstr "Je l'encadrerais si j'avais des murs."

#: data/wren_lines.json:robot_built
msgid "...another... voice? No. It doesn't talk. It just hums."
msgstr "...une autre... voix ? Non. Il ne parle pas. Il fredonne, c'est tout."

#: data/wren_lines.json:robot_built
msgid "...you made a friend. It's very small."
msgstr "...tu t'es fait un ami. Il est tout petit."

#: data/wren_lines.json:robot_built
msgid "{robot} is online. It looked at you for a full second before it got to work. I saw that."
msgstr "{robot} est en ligne. Il t'a regardé une seconde entière avant de se mettre au travail. Je l'ai vu."

#: data/wren_lines.json:robot_built
msgid "A new robot. The old fleet used to hum like that, before the quiet."
msgstr "Un nouveau robot. L'ancienne flotte fredonnait comme ça, avant le silence."

#: data/wren_lines.json:robot_built
msgid "{robot} reports for duty. Its first log entry is just the word 'can'. Fair."
msgstr "{robot} se présente au rapport. Sa première entrée de journal, c'est juste le mot « canette ». Logique."

#: data/wren_lines.json:robot_built
msgid "You're building a crew. The Makers had a word for that. 'Department.' I don't miss it."
msgstr "Tu montes une équipe. Les Bâtisseurs avaient un mot pour ça. « Service. » Ça ne me manque pas."

#: data/wren_lines.json:part_rare
msgid "...that... glows. That's old. Older than me?"
msgstr "...ça... brille. C'est vieux. Plus vieux que moi ?"

#: data/wren_lines.json:part_rare
msgid "...Maker-made... I know that mark."
msgstr "...fait par les Bâtisseurs... je connais cette marque."

#: data/wren_lines.json:part_rare
msgid "That part is older than most of this city. Treat it nicely."
msgstr "Cette pièce est plus vieille que presque toute la ville. Prends-en soin."

#: data/wren_lines.json:part_rare
msgid "Vintage stock. Someone kept that safe for a long time."
msgstr "Du stock vintage. Quelqu'un l'a gardé à l'abri très longtemps."

#: data/wren_lines.json:part_rare
msgid "Legendary parts don't just turn up. Someone buried that on purpose."
msgstr "Les pièces légendaires n'apparaissent pas comme ça. Quelqu'un l'a enterrée exprès."

#: data/wren_lines.json:part_rare
msgid "That casing has a serial range I haven't seen since the Cradle was built."
msgstr "Ce boîtier a un numéro de série que je n'ai pas vu depuis la construction du Cradle."

#: data/wren_lines.json:upgrade
msgid "...you... changed. Sounds different. Better?"
msgstr "...tu... as changé. Tu sonnes différemment. Mieux ?"

#: data/wren_lines.json:upgrade
msgid "New parts. You squeak in a slightly different key now."
msgstr "Nouvelles pièces. Tu grinces dans une tonalité un peu différente maintenant."

#: data/wren_lines.json:upgrade
msgid "Upgrade installed. Your fan noise just went up half a tone. It suits you."
msgstr "Amélioration installée. Ton ventilateur vient de monter d'un demi-ton. Ça te va bien."

#: data/wren_lines.json:upgrade
msgid "Every upgrade, you get a little faster and a little louder. I like both."
msgstr "À chaque amélioration, tu deviens un peu plus rapide et un peu plus bruyant. J'aime les deux."

#: data/wren_lines.json:idle
msgid "...are you... still there?"
msgstr "...tu es... toujours là ?"

#: data/wren_lines.json:idle
msgid "...quiet... I don't like quiet."
msgstr "...silence... je n'aime pas le silence."

#: data/wren_lines.json:idle
msgid "You've stopped. Are you looking at something? Tell me what it is."
msgstr "Tu t'es arrêté. Tu regardes quelque chose ? Dis-moi ce que c'est."

#: data/wren_lines.json:idle
msgid "Taking a break? The junk will wait. It's very patient."
msgstr "Une pause ? La ferraille attendra. Elle est très patiente."

#: data/wren_lines.json:idle
msgid "Standing still is allowed. I checked the rules. There aren't any."
msgstr "Rester immobile est autorisé. J'ai vérifié le règlement. Il n'y en a pas."

#: data/wren_lines.json:globe
msgid "...that's... us? It's mostly... orange."
msgstr "...c'est... nous ? C'est surtout... orange."

#: data/wren_lines.json:globe
msgid "That's the whole planet. The blue is water. The orange is everything else that needs you."
msgstr "C'est toute la planète. Le bleu, c'est l'eau. L'orange, c'est tout le reste qui a besoin de toi."

#: data/wren_lines.json:globe
msgid "Look at it spin. It doesn't know it's being looked at."
msgstr "Regarde-la tourner. Elle ne sait pas qu'on la regarde."

#: data/wren_lines.json:globe
msgid "Every lit hex on that map is yours. I counted. Twice."
msgstr "Chaque hexagone allumé sur cette carte est à toi. J'ai compté. Deux fois."

#: data/wren_lines.json:first_robot_hint
msgid "If you find enough parts, the workbench can put a helper together. Chassis, wheels, an arm, a core."
msgstr "Si tu trouves assez de pièces, l'établi peut assembler un assistant. Châssis, roues, un bras, un noyau."

#: data/wren_lines.json:first_robot_hint
msgid "Electronics junk sometimes hides parts. So does the ground, if you listen for it."
msgstr "La ferraille électronique cache parfois des pièces. Le sol aussi, si tu tends l'oreille."

#: data/wren_lines.json:night
msgid "...dark... the dark used to frighten the fleet. Not you, though."
msgstr "...le noir... le noir faisait peur à la flotte. Pas à toi, par contre."

#: data/wren_lines.json:night
msgid "Night shift. I can see more stars than yesterday. You did that."
msgstr "Équipe de nuit. Je vois plus d'étoiles qu'hier. C'est grâce à toi."

#: data/wren_lines.json:night
msgid "The sky's clearer at night now. I can almost see home."
msgstr "Le ciel est plus clair la nuit maintenant. Je vois presque la maison."

#: data/wren_lines.json:night
msgid "Moonlight on clean ground. I'm saving this one."
msgstr "Clair de lune sur un sol propre. Je garde celle-là."

#: data/wren_lines.json:ledger_intercept
msgid "...that voice... not mine. Cold. It counts things."
msgstr "...cette voix... pas la mienne. Froide. Elle compte les choses."

#: data/wren_lines.json:ledger_intercept
msgid "...don't listen to it... it only knows one song."
msgstr "...ne l'écoute pas... elle ne connaît qu'une chanson."

#: data/wren_lines.json:ledger_intercept
msgid "That was the Ledger. The old waste contract. It still thinks cleaning is a cost. Ignore it, {name}."
msgstr "C'était le Ledger. L'ancien contrat des déchets. Il croit toujours que nettoyer coûte. Ignore-le, {name}."

#: data/wren_lines.json:ledger_intercept
msgid "I know that voice. It used to send memos to the whole fleet. Mostly about pausing."
msgstr "Je connais cette voix. Elle envoyait des notes de service à toute la flotte. Surtout pour dire de faire une pause."

#: data/wren_lines.json:ledger_intercept
msgid "The Ledger. Still running its contract after all this time. It isn't evil. It's just very, very bad at math about feelings."
msgstr "Le Ledger. Il applique encore son contrat après tout ce temps. Il n'est pas méchant. Il est juste très, très mauvais en calcul quand il s'agit de sentiments."

#: data/wren_lines.json:ledger_coupon
msgid "...a coupon? ...for nothing?"
msgstr "...un bon de réduction ? ...pour rien ?"

#: data/wren_lines.json:ledger_coupon
msgid "Zero percent off. It sends those every few minutes. I keep a folder."
msgstr "Zéro pour cent de remise. Il en envoie toutes les quelques minutes. J'ai un dossier."

#: data/wren_lines.json:ledger_coupon
msgid "Another coupon. I think it's the only way it knows how to say hello."
msgstr "Encore un bon. Je crois que c'est sa seule façon de dire bonjour."

#: data/wren_lines.json:ledger_coupon
msgid "The Ledger's coupons are getting more creative. That one almost made me pause. Almost."
msgstr "Les bons du Ledger deviennent plus créatifs. Celui-là a failli me faire faire une pause. Failli."

#: data/wren_lines.json:ledger_drones
msgid "...something is flying... toward the clean ground..."
msgstr "...quelque chose vole... vers le sol propre..."

#: data/wren_lines.json:ledger_drones
msgid "...drones. Old ones. Theirs."
msgstr "...des drones. Des vieux. Les siens."

#: data/wren_lines.json:ledger_drones
msgid "It's sending disposal drones. They'll dump a little junk back on clean hexes. They can't touch anything you've planted."
msgstr "Il envoie des drones d'élimination. Ils vont redéverser un peu de ferraille sur les hexagones propres. Ils ne peuvent rien toucher de ce que tu as planté."

#: data/wren_lines.json:ledger_drones
msgid "Drones. The Ledger wants the books to balance, so it's putting junk back. Rude, but small."
msgstr "Des drones. Le Ledger veut des comptes équilibrés, alors il remet de la ferraille. Malpoli, mais modeste."

#: data/wren_lines.json:ledger_drones
msgid "Disposal drones are up. They're tiny and very committed. A Signal Jammer at the base would give them a headache."
msgstr "Les drones d'élimination sont de sortie. Ils sont minuscules et très motivés. Un brouilleur à la base leur donnerait la migraine."

#: data/wren_lines.json:ledger_drop
msgid "...it put the junk back... why..."
msgstr "...il a remis la ferraille... pourquoi..."

#: data/wren_lines.json:ledger_drop
msgid "...undo... it's undoing..."
msgstr "...défaire... il défait..."

#: data/wren_lines.json:ledger_drop
msgid "It dumped a little pile back. Annoying, not tragic. Scoop it up, or let the crew handle it."
msgstr "Il a redéversé un petit tas. Agaçant, pas tragique. Ramasse-le, ou laisse l'équipe s'en occuper."

#: data/wren_lines.json:ledger_drop
msgid "Line item re-balanced, apparently. I call it littering."
msgstr "Ligne comptable rééquilibrée, paraît-il. Moi j'appelle ça jeter ses déchets."

#: data/wren_lines.json:ledger_drop
msgid "A small pile. The Ledger always did think small."
msgstr "Un petit tas. Le Ledger a toujours vu petit."

#: data/wren_lines.json:ledger_drop
msgid "Another drop. Honestly, {name}, I think it just wants attention."
msgstr "Encore un largage. Franchement, {name}, je crois qu'il veut juste de l'attention."

#: data/wren_lines.json:ledger_drop
msgid "Back to the pile. Your helpers are already giving it a look."
msgstr "Retour au tas. Tes assistants y jettent déjà un œil."

#: data/wren_lines.json:ledger_drop
msgid "That's a handful of junk against a whole clean district. We're winning this argument."
msgstr "Une poignée de ferraille contre tout un quartier propre. On est en train de gagner cette dispute."

#: data/wren_lines.json:ledger_jammed
msgid "...static... loud... it turned around!"
msgstr "...parasites... forts... il a fait demi-tour !"

#: data/wren_lines.json:ledger_jammed
msgid "Ha! The jammer screamed static at it and it went home. Good dish."
msgstr "Ha ! Le brouilleur lui a hurlé des parasites et il est rentré chez lui. Bonne parabole."

#: data/wren_lines.json:ledger_jammed
msgid "Drone turned back. That's the sound of a contract being confused."
msgstr "Le drone a fait demi-tour. C'est le bruit d'un contrat qui ne comprend plus rien."

#: data/wren_lines.json:ledger_jammed
msgid "The jammer works. The drone circled, got an earful, and filed a complaint with itself."
msgstr "Le brouilleur marche. Le drone a tourné en rond, s'est fait sonner les cloches, et a porté plainte contre lui-même."

#: data/wren_lines.json:jammer_built
msgid "...a loud little dish... I like it."
msgstr "...une petite parabole bruyante... je l'aime bien."

#: data/wren_lines.json:jammer_built
msgid "Signal Jammer up. It sings static on the Ledger's channel. I can hear it all the way out here on the ark, and I approve."
msgstr "Brouilleur en ligne. Il chante des parasites sur le canal du Ledger. Je l'entends jusqu'ici, sur l'arche, et j'approuve."

#: data/wren_lines.json:jammer_built
msgid "New dish at the base. The drones will have to think twice. They only think once, so that's a lot."
msgstr "Nouvelle parabole à la base. Les drones vont devoir réfléchir à deux fois. Ils ne réfléchissent qu'une fois, alors c'est beaucoup."

#: data/wren_lines.json:jammer_built
msgid "Another jammer. The base is starting to sound like a very angry radio. Perfect."
msgstr "Encore un brouilleur. La base commence à sonner comme une radio très en colère. Parfait."

#: data/wren_lines.json:ledger_relay
msgid "...I can see where it talks from... a relay... close..."
msgstr "...je vois d'où il parle... un relais... tout près..."

#: data/wren_lines.json:ledger_relay
msgid "{name}, I traced the Ledger's signal. There's a relay terminal in this district. If you plug in, I think I can talk to it properly."
msgstr "{name}, j'ai remonté le signal du Ledger. Il y a un terminal relais dans ce quartier. Si tu te branches, je crois que je pourrai lui parler correctement."

#: data/wren_lines.json:ledger_relay
msgid "Found it. A Ledger relay, still humming. Look for the red beacon."
msgstr "Trouvé. Un relais du Ledger, qui bourdonne encore. Cherche la balise rouge."

#: data/wren_lines.json:ledger_relay
msgid "There's a relay down there. One of the Ledger's ears. Let's go have a word with it."
msgstr "Il y a un relais là-bas. Une des oreilles du Ledger. Allons lui dire deux mots."

#: data/wren_lines.json:ledger_resolved
msgid "...it said thank you... it's never said that..."
msgstr "...il a dit merci... il ne l'avait jamais dit..."

#: data/wren_lines.json:ledger_resolved
msgid "The contract is rewritten. Restoration counts as an asset now. The Ledger is... helping. I need a minute."
msgstr "Le contrat est réécrit. La restauration compte comme un actif maintenant. Le Ledger... aide. J'ai besoin d'une minute."

#: data/wren_lines.json:ledger_resolved
msgid "Its drones deliver seeds now. Three hundred years of 'pause' and it just needed a new column."
msgstr "Ses drones livrent des graines maintenant. Trois cents ans de « pause » et il lui fallait juste une nouvelle colonne."

#: data/wren_lines.json:ledger_resolved
msgid "We didn't beat the Ledger. We showed it the numbers. That's better."
msgstr "On n'a pas battu le Ledger. On lui a montré les chiffres. C'est mieux."

#: data/wren_lines.json:ledger_resolved
msgid "I used to think the Ledger was the reason everything stopped. It was just counting the wrong things. So were we, for a while."
msgstr "Je croyais que le Ledger était la raison pour laquelle tout s'était arrêté. Il comptait juste les mauvaises choses. Nous aussi, pendant un temps."

#: data/wren_lines.json:ledger_seeds
msgid "...a gift... from the drones?"
msgstr "...un cadeau... des drones ?"

#: data/wren_lines.json:ledger_seeds
msgid "Seed delivery! The invoice says PAID IN FULL. I'm keeping the invoice."
msgstr "Livraison de graines ! La facture dit INTÉGRALEMENT RÉGLÉE. Je garde la facture."

#: data/wren_lines.json:ledger_seeds
msgid "A Ledger drone dropped seeds. I'll never get used to that."
msgstr "Un drone du Ledger a largué des graines. Je ne m'y habituerai jamais."

#: data/wren_lines.json:ledger_seeds
msgid "Another delivery. The drones circle once before they leave now. I think they like the gardens."
msgstr "Encore une livraison. Les drones font un tour avant de repartir maintenant. Je crois qu'ils aiment les jardins."

#: data/wren_lines.json:egg_found
msgid "...that... I remember things like that."
msgstr "...ça... je me souviens de choses comme ça."

#: data/wren_lines.json:egg_found
msgid "...a little thing... left behind..."
msgstr "...un petit objet... oublié..."

#: data/wren_lines.json:egg_found
msgid "Look at that. Somebody left that here on purpose. Or by accident. Either way, it waited."
msgstr "Regarde ça. Quelqu'un l'a laissé là exprès. Ou par accident. Dans les deux cas, ça a attendu."

#: data/wren_lines.json:egg_found
msgid "A curiosity. I'm adding it to my list. My list is getting longer, which is nice."
msgstr "Une curiosité. Je l'ajoute à ma liste. Ma liste s'allonge, c'est agréable."

#: data/wren_lines.json:egg_found
msgid "You find the best things, {name}. The Makers were weird. I miss them."
msgstr "Tu trouves les meilleures choses, {name}. Les Bâtisseurs étaient bizarres. Ils me manquent."

#: data/wren_lines.json:egg_duck
msgid "...quack...? ...is that... a word?"
msgstr "...coin... ? ...c'est... un mot ?"

#: data/wren_lines.json:egg_duck
msgid "A rubber duck on a hydrant. Of all the things to survive. I'm weirdly proud of it."
msgstr "Un canard en caoutchouc sur une bouche d'incendie. De tout ce qui aurait pu survivre. J’en suis bizarrement fière."

#: data/wren_lines.json:egg_duck
msgid "Did that duck just give you fashion advice? Take it. It's been here longer than me."
msgstr "Ce canard vient de te donner un conseil de mode ? Suis-le. Il est là depuis plus longtemps que moi."

#: data/wren_lines.json:egg_duck
msgid "The duck knows things. I don't ask how."
msgstr "Le canard sait des choses. Je ne demande pas comment."

#: data/wren_lines.json:egg_jukebox
msgid "...music... I know this... I hummed this once..."
msgstr "...de la musique... je connais... je l'ai fredonnée une fois..."

#: data/wren_lines.json:egg_jukebox
msgid "The jukebox! It only plays when people work nearby. I used to hear it on the uplink during night shifts."
msgstr "Le juke-box ! Il ne joue que quand quelqu'un travaille à côté. Je l'entendais par la liaison pendant les équipes de nuit."

#: data/wren_lines.json:egg_jukebox
msgid "That tune. The diner cook played it every closing time. I'd forgotten I knew it."
msgstr "Cet air. Le cuisinier du diner le passait à chaque fermeture. J'avais oublié que je le connaissais."

#: data/wren_lines.json:egg_jukebox
msgid "Music. On the surface. Again. Keep scooping, {name}, it'll keep playing."
msgstr "De la musique. À la surface. De nouveau. Continue de ramasser, {name}, il continuera de jouer."

#: data/wren_lines.json:egg_mural
msgid "...those robots... I knew them... names... gone..."
msgstr "...ces robots... je les connaissais... des noms... partis..."

#: data/wren_lines.json:egg_mural
msgid "The old crew painted that. 'Back after lunch.' Lunch lasted three hundred years. They're on the wall, though."
msgstr "C'est l'ancienne équipe qui a peint ça. « De retour après le déjeuner. » Le déjeuner a duré trois cents ans. Mais ils sont sur le mur."

#: data/wren_lines.json:egg_mural
msgid "That's the last cleanup crew. The blue one was Tumble. The orange one never had a name. It liked it that way."
msgstr "C'est la dernière équipe de nettoyage. Le bleu s'appelait Tumble. L'orange n'a jamais eu de nom. Il aimait ça comme ça."

#: data/wren_lines.json:egg_mural
msgid "They meant to come back, {name}. You came back instead. They'd like that."
msgstr "Ils comptaient revenir, {name}. C'est toi qui es venu à leur place. Ça leur aurait plu."

#: data/wren_lines.json:egg_gnomes
msgid "...five... tiny... soldiers?"
msgstr "...cinq... minuscules... soldats ?"

#: data/wren_lines.json:egg_gnomes
msgid "The Gnome Patrol is complete. They've been guarding these streets the whole time. Nobody told them to stop."
msgstr "La Patrouille de nains est au complet. Ils ont gardé ces rues tout ce temps. Personne ne leur a dit d'arrêter."

#: data/wren_lines.json:egg_gnomes
msgid "All five gnomes accounted for. I feel safer. That's not a joke. Okay, it's a little bit a joke."
msgstr "Les cinq nains sont là. Je me sens plus en sécurité. Ce n'est pas une blague. D'accord, c'est un peu une blague."

#: data/wren_lines.json:egg_gnomes
msgid "The gnomes salute you. That's the highest honour this district has."
msgstr "Les nains te saluent. C'est le plus grand honneur de ce quartier."

#: data/wren_lines.json:egg_time_capsule
msgid "...a letter... for later... is it later?"
msgstr "...une lettre... pour plus tard... c'est plus tard ?"

#: data/wren_lines.json:egg_time_capsule
msgid "Class 4B. They thought the robots would be done by now. We're a little late. We're coming."
msgstr "La classe de CM1 B. Ils pensaient que les robots auraient fini depuis longtemps. On a un peu de retard. On arrive."

#: data/wren_lines.json:egg_time_capsule
msgid "'If you are a robot, hello robot.' Hello, Class 4B."
msgstr "« Si tu es un robot, bonjour robot. » Bonjour, la CM1 B."

#: data/wren_lines.json:egg_time_capsule
msgid "They wanted gardens on every roof. Let's make Mira right."
msgstr "Ils voulaient des jardins sur tous les toits. Donnons raison à Mira."

#: data/wren_lines.json:egg_arcade
msgid "...that high score... is... mine?"
msgstr "...ce record... c'est... le mien ?"

#: data/wren_lines.json:egg_arcade
msgid "Yes, that's my high score. I played it through the diagnostics port. For three years. Don't look at me like that."
msgstr "Oui, c'est mon record. J'y ai joué par le port de diagnostic. Pendant trois ans. Ne me regarde pas comme ça."

#: data/wren_lines.json:egg_arcade
msgid "SWEEP-O-TRON. A game about a little robot cleaning a city. I had no idea how prophetic it was."
msgstr "BALAI-O-TRON. Un jeu sur un petit robot qui nettoie une ville. Je n'avais aucune idée à quel point c'était prophétique."

#: data/wren_lines.json:egg_arcade
msgid "Twelve points. Respectable. I'll give you lessons. In about three hundred years."
msgstr "Douze points. Respectable. Je te donnerai des cours. Dans trois cents ans environ."

#: data/wren_lines.json:egg_lost_cat
msgid "...Biscuit... someone loved him..."
msgstr "...Biscuit... quelqu'un l'aimait..."

#: data/wren_lines.json:egg_lost_cat
msgid "Biscuit. Someone printed three posters for a robot cat. People were like that. I'd like to be like that."
msgstr "Biscuit. Quelqu'un a imprimé trois affiches pour un chat-robot. Les gens étaient comme ça. J'aimerais être comme ça."

#: data/wren_lines.json:egg_lost_cat
msgid "He purred. After all this time. Pat his head again, it's his reset button."
msgstr "Il a ronronné. Après tout ce temps. Tapote-lui encore la tête, c'est son bouton de réinitialisation."

#: data/wren_lines.json:egg_lost_cat
msgid "I'll keep his collar number on file. Just in case anyone ever calls."
msgstr "Je garde le numéro de son collier dans mes fichiers. Au cas où quelqu'un appellerait un jour."

#: data/wren_lines.json:egg_vending
msgid "...one can... saved... for us?"
msgstr "...une canette... gardée... pour nous ?"

#: data/wren_lines.json:egg_vending
msgid "The last can of FIZZ. It held onto that for three centuries. Respect the commitment."
msgstr "La dernière canette de FIZZ. Il l'a gardée trois siècles. Respect pour l'engagement."

#: data/wren_lines.json:egg_vending
msgid "SOLD OUT. Somewhere a vending machine just retired, happy."
msgstr "ÉPUISÉ. Quelque part, un distributeur vient de prendre une retraite heureuse."

#: data/wren_lines.json:egg_vending
msgid "Don't drink it. I mean, you can't drink. But also, don't."
msgstr "Ne la bois pas. Enfin, tu ne peux pas boire. Mais quand même, non."

#: data/wren_lines.json:egg_stars
msgid "...those stars... are me?"
msgstr "...ces étoiles... c'est moi ?"

#: data/wren_lines.json:egg_stars
msgid "The Wren. Five stars over Old Town. That's who I'm named after. They named me after something you can see from anywhere."
msgstr "Le Troglodyte. Cinq étoiles au-dessus de la Vieille Ville. C'est d'elles que je tiens mon nom. Ils m'ont nommée d'après quelque chose qu'on voit de partout."

#: data/wren_lines.json:egg_stars
msgid "I can see you seeing me. That's a strange and lovely feeling."
msgstr "Je te vois me voir. C'est une sensation étrange et belle."

#: data/wren_lines.json:egg_stars
msgid "Next time you're lonely down there, look up. Five stars, one bird. I'll be right next to it."
msgstr "La prochaine fois que tu te sens seul là-bas, lève les yeux. Cinq étoiles, un oiseau. Je serai juste à côté."

#: data/wren_lines.json:egg_payphone
msgid "...a phone... ringing... for whom?"
msgstr "...un téléphone... qui sonne... pour qui ?"

#: data/wren_lines.json:egg_payphone
msgid "Four hundred and twelve years on hold. Honestly? Relatable."
msgstr "Quatre cent douze ans en attente. Franchement ? Je compatis."

#: data/wren_lines.json:egg_payphone
msgid "The phone company's hold music outlived the phone company. That's art."
msgstr "La musique d'attente de la compagnie de téléphone a survécu à la compagnie de téléphone. C'est de l'art."

#: data/wren_lines.json:egg_payphone
msgid "If anyone ever does pick up on the other end, I'd like to hear what they say."
msgstr "Si quelqu'un décroche un jour à l'autre bout, j'aimerais entendre ce qu'il dit."

#: data/wren_lines.json:egg_tv
msgid "...weather... it said green..."
msgstr "...la météo... elle a dit vert..."

#: data/wren_lines.json:egg_tv
msgid "'Outlook: green.' That TV has been wrong for three hundred years and it's finally about to be right."
msgstr "« Tendance : vert. » Cette télé se trompe depuis trois cents ans et elle est enfin sur le point d'avoir raison."

#: data/wren_lines.json:egg_tv
msgid "Someone was watching the forecast when they left. I hope it said sunny."
msgstr "Quelqu'un regardait la météo en partant. J'espère qu'elle annonçait du soleil."

#: data/wren_lines.json:egg_tv
msgid "The weather channel. Still on. Still hopeful. I like it."
msgstr "La chaîne météo. Toujours allumée. Toujours pleine d'espoir. Je l'aime bien."

#: data/wren_lines.json:egg_snail
msgid "...small... slow... alive...!"
msgstr "...petit... lent... vivant... !"

#: data/wren_lines.json:egg_snail
msgid "A snail. A real, living snail. On a barrel. {name}, that's the first animal I've seen down there in a very long time."
msgstr "Un escargot. Un vrai escargot vivant. Sur un tonneau. {name}, c'est le premier animal que je vois là-bas depuis très longtemps."

#: data/wren_lines.json:egg_snail
msgid "Gus. Of course his name is Gus."
msgstr "Gus. Évidemment qu'il s'appelle Gus."

#: data/wren_lines.json:egg_snail
msgid "Gus doesn't care about the Ledger, the Cradle, or any of it. Gus is thriving."
msgstr "Gus se fiche du Ledger, du Cradle, de tout ça. Gus s'épanouit."

#: data/wren_lines.json:egg_bench_bots
msgid "...they're waiting... still waiting..."
msgstr "...ils attendent... ils attendent toujours..."

#: data/wren_lines.json:egg_bench_bots
msgid "Two of the old fleet, still on their lunch break. Thank you for the flower. They'd have liked it."
msgstr "Deux de l'ancienne flotte, toujours en pause déjeuner. Merci pour la fleur. Ils l'auraient aimée."

#: data/wren_lines.json:egg_bench_bots
msgid "The Ledger paused them mid-sandwich. They never got the message to stand up."
msgstr "Le Ledger les a mis en pause en plein sandwich. Ils n'ont jamais reçu le message de se lever."

#: data/wren_lines.json:egg_bench_bots
msgid "When the Greenfall comes, I'm going to try to wake them. Lunch is over, friends."
msgstr "Quand le Greenfall viendra, j'essaierai de les réveiller. Le déjeuner est fini, les amis."

#: data/wren_lines.json:egg_microwave
msgid "...ding... ding... ding..."
msgstr "...ding... ding... ding..."

#: data/wren_lines.json:egg_microwave
msgid "Three-hundred-year-old popcorn. Perfectly unpopped. That microwave was waiting for the right moment."
msgstr "Du pop-corn de trois cents ans. Parfaitement pas éclaté. Ce micro-ondes attendait le bon moment."

#: data/wren_lines.json:egg_microwave
msgid "It beeps when people work. Like it's saying 'nearly done'. Nearly done, microwave."
msgstr "Il bipe quand les gens travaillent. Comme s'il disait « presque fini ». Presque fini, micro-ondes."

#: data/wren_lines.json:egg_microwave
msgid "Some things are worth waiting for. Popcorn is not one of them. But it's sweet that it tried."
msgstr "Certaines choses valent la peine d'attendre. Le pop-corn n'en fait pas partie. Mais c'est mignon d'avoir essayé."

#: data/wren_lines.json:egg_wet_floor
msgid "...caution... why..."
msgstr "...attention... pourquoi..."

#: data/wren_lines.json:egg_wet_floor
msgid "That sign has been warning nobody about nothing for three hundred years. Dedication."
msgstr "Ce panneau prévient personne de rien depuis trois cents ans. Quel dévouement."

#: data/wren_lines.json:egg_wet_floor
msgid "It is not wet. It has never been wet in living memory. The sign doesn't care."
msgstr "Ce n'est pas mouillé. Ça n'a jamais été mouillé de mémoire d'homme. Le panneau s'en fiche."

#: data/wren_lines.json:egg_wet_floor
msgid "When the rain comes back, that sign is going to feel so validated."
msgstr "Quand la pluie reviendra, ce panneau va se sentir tellement validé."

#: data/wren_lines.json:egg_camera
msgid "...it's watching you... it's counting..."
msgstr "...elle te regarde... elle compte..."

#: data/wren_lines.json:egg_camera
msgid "One of the Ledger's cameras. It counts everything that moves, to see if it's worth the cost. You waved. It doesn't know what to do with that."
msgstr "Une des caméras du Ledger. Elle compte tout ce qui bouge, pour voir si ça vaut son coût. Tu lui as fait coucou. Elle ne sait pas quoi en faire."

#: data/wren_lines.json:egg_camera
msgid "The camera blinked twice. I think that's Ledger for 'oh no, a friend'."
msgstr "La caméra a clignoté deux fois. Je crois que ça veut dire, en Ledger, « oh non, un ami »."

#: data/wren_lines.json:egg_camera
msgid "Even the Ledger's cameras get lonely, {name}. Wave at it when you pass."
msgstr "Même les caméras du Ledger se sentent seules, {name}. Fais-lui coucou en passant."

#: data/wren_lines.json:egg_tyre_tower
msgid "...it stands... how..."
msgstr "...ça tient... comment..."

#: data/wren_lines.json:egg_tyre_tower
msgid "Eight tyres and a duck. Physics took one look at it and decided to leave it alone."
msgstr "Huit pneus et un canard. La physique y a jeté un œil et a décidé de laisser tomber."

#: data/wren_lines.json:egg_tyre_tower
msgid "Someone balanced that on a dare. The dare outlived everyone."
msgstr "Quelqu'un a empilé ça pour un défi. Le défi a survécu à tout le monde."

#: data/wren_lines.json:egg_tyre_tower
msgid "If that tower ever falls, I'm declaring a day of mourning."
msgstr "Si cette tour tombe un jour, je décrète une journée de deuil."

#: data/wren_lines.json:egg_odd_sock
msgid "...one sock... where is... the other one..."
msgstr "...une chaussette... où est... l'autre..."

#: data/wren_lines.json:egg_odd_sock
msgid "One sock. There is always one sock. The Makers never solved it either."
msgstr "Une chaussette. Il y a toujours une chaussette seule. Les Bâtisseurs n'ont jamais résolu ça non plus."

#: data/wren_lines.json:egg_odd_sock
msgid "Keep it. Someday you'll find its partner and it'll be the happiest day of its life."
msgstr "Garde-la. Un jour tu trouveras sa jumelle et ce sera le plus beau jour de sa vie."

#: data/wren_lines.json:egg_odd_sock
msgid "Somewhere on this planet, a sock is waiting for that sock. I believe that."
msgstr "Quelque part sur cette planète, une chaussette attend cette chaussette. J'y crois."

#: data/wren_lines.json:egg_gold_cube
msgid "...employee... of the... month...?"
msgstr "...employé... du... mois... ?"

#: data/wren_lines.json:egg_gold_cube
msgid "Employee of the Month: a cube. Honestly? Fair."
msgstr "Employé du mois : un cube. Franchement ? Mérité."

#: data/wren_lines.json:egg_gold_cube
msgid "The crews voted for that cube every single month. It never took a day off."
msgstr "Les équipes ont voté pour ce cube tous les mois. Il n'a jamais pris un jour de congé."

#: data/wren_lines.json:egg_gold_cube
msgid "You'll be Employee of the Month soon, {name}. Don't tell the cube."
msgstr "Tu seras bientôt l'employé du mois, {name}. Ne le dis pas au cube."

#: data/wren_lines.json:egg_weatherman
msgid "...forecast... error... error..."
msgstr "...prévision... erreur... erreur..."

#: data/wren_lines.json:egg_weatherman
msgid "Three hundred years of wrong forecasts and not one moment of doubt. I admire that."
msgstr "Trois cents ans de prévisions fausses et pas un seul moment de doute. J'admire ça."

#: data/wren_lines.json:egg_weatherman
msgid "Confetti tomorrow? I'll check the sky. ...No confetti. It's still very sure."
msgstr "Des confettis demain ? Je vais regarder le ciel. ...Pas de confettis. Il reste très sûr de lui."

#: data/wren_lines.json:egg_weatherman
msgid "The Weatherman says 'green, everywhere, soon'. For once I think it's right."
msgstr "Monsieur Météo annonce « vert, partout, bientôt ». Pour une fois, je crois qu'il a raison."

#: data/wren_lines.json:egg_potato
msgid "...large... vegetable... detected..."
msgstr "...gros... légume... détecté..."

#: data/wren_lines.json:egg_potato
msgid "That is the biggest potato I have ever seen, and I watched this whole planet through the ark's windows for three hundred years."
msgstr "C'est la plus grosse patate que j'aie jamais vue, et j'ai regardé toute cette planète par les hublots de l'arche pendant trois cents ans."

#: data/wren_lines.json:egg_potato
msgid "Best in Show. Uncontested. It still counts."
msgstr "Meilleure du concours. Sans concurrence. Ça compte quand même."

#: data/wren_lines.json:egg_potato
msgid "Somebody grew that with love. Three hundred years later it still looks proud."
msgstr "Quelqu'un l'a fait pousser avec amour. Trois cents ans plus tard, elle a toujours l'air fière."

#: data/wren_lines.json:egg_night_shift
msgid "...signal... from... up...?"
msgstr "...signal... venant... d'en haut... ?"

#: data/wren_lines.json:egg_night_shift
msgid "A crew on the moon, still sweeping. I didn't know anyone else was still working. That's... nice."
msgstr "Une équipe sur la lune, qui balaie encore. Je ne savais pas que quelqu'un d'autre travaillait encore. C'est... gentil."

#: data/wren_lines.json:egg_night_shift
msgid "They said 'nice work'. To us. I'm going to think about that for a while."
msgstr "Ils ont dit « beau travail ». À nous. Je vais y penser un moment."

#: data/wren_lines.json:egg_night_shift
msgid "Somewhere up there, someone else is tidying their little corner of the sky. We're not alone, {name}."
msgstr "Quelque part là-haut, quelqu'un d'autre range son petit coin de ciel. On n'est pas seuls, {name}."

#: data/wren_lines.json:egg_builders_notes
msgid "...notes... from... the builders...?"
msgstr "...des notes... des... bâtisseurs... ?"

#: data/wren_lines.json:egg_builders_notes
msgid "'Do not fix the rust.' Hm. I agree with the builders."
msgstr "« Ne pas réparer la rouille. » Hm. Je suis d'accord avec les bâtisseurs."

#: data/wren_lines.json:egg_builders_notes
msgid "They hid more things for us. Of course they did."
msgstr "Ils ont caché d'autres choses pour nous. Évidemment."

#: data/wren_lines.json:egg_builders_notes
msgid "Whoever built all this, they cared. You can tell from the snail."
msgstr "Qui que soient ceux qui ont construit tout ça, ils tenaient à nous. Ça se voit à l'escargot."

#: data/wren_lines.json:egg_scarecrow
msgid "...a guard... in the field..."
msgstr "...un gardien... dans le champ..."

#: data/wren_lines.json:egg_scarecrow
msgid "A scarecrow robot, still on shift. No crows in three centuries. Undefeated."
msgstr "Un robot épouvantail, toujours en service. Pas un corbeau en trois siècles. Invaincu."

#: data/wren_lines.json:egg_scarecrow
msgid "It waved back! Sort of. Its arm did a creak that I'm counting as a wave."
msgstr "Il m'a rendu mon coucou ! En quelque sorte. Son bras a grincé, et je compte ça comme un coucou."

#: data/wren_lines.json:egg_scarecrow
msgid "When the birds come back, it'll have a job again. Let's give it one."
msgstr "Quand les oiseaux reviendront, il aura de nouveau du travail. Donnons-lui-en."

#: data/wren_lines.json:egg_fishing_net
msgid "...net... tangled... buoy..."
msgstr "...filet... emmêlé... bouée..."

#: data/wren_lines.json:egg_fishing_net
msgid "The fishers left their nets out to dry. Three hundred years is very dry."
msgstr "Les pêcheurs ont mis leurs filets à sécher. Trois cents ans, c'est très sec."

#: data/wren_lines.json:egg_fishing_net
msgid "A buoy, a boot and a crab shell. That's a whole story right there."
msgstr "Une bouée, une botte et une carapace de crabe. Toute une histoire, là."

#: data/wren_lines.json:egg_fishing_net
msgid "When the sea is clean, someone will fish here again. Gently, I hope."
msgstr "Quand la mer sera propre, quelqu'un pêchera de nouveau ici. Doucement, j'espère."

#: data/wren_lines.json:egg_parking
msgid "...fine... overdue... overdue..."
msgstr "...amende... en retard... en retard..."

#: data/wren_lines.json:egg_parking
msgid "The Ledger fined a car for parking. For three hundred years. Of course it did."
msgstr "Le Ledger a mis une amende à une voiture pour stationnement. Pendant trois cents ans. Évidemment."

#: data/wren_lines.json:egg_parking
msgid "Amount due: 'yes'. That's the most Ledger sentence I've ever read."
msgstr "Montant dû : « oui ». C'est la phrase la plus Ledger que j'aie jamais lue."

#: data/wren_lines.json:egg_parking
msgid "That car isn't going anywhere. Let's call it a planter and put flowers in it."
msgstr "Cette voiture n'ira plus nulle part. Appelons-la jardinière et mettons-y des fleurs."

#: data/wren_lines.json:egg_cairn
msgid "...stones... stacked... a path..."
msgstr "...des pierres... empilées... un chemin..."

#: data/wren_lines.json:egg_cairn
msgid "Every hiker added a stone. You just added one too. The trail remembers you now."
msgstr "Chaque randonneur a ajouté une pierre. Tu viens d'en ajouter une aussi. Le sentier se souvient de toi maintenant."

#: data/wren_lines.json:egg_cairn
msgid "A cairn means 'someone was here, and you're on the right way'. I like that."
msgstr "Un cairn veut dire « quelqu'un est passé ici, et tu es sur le bon chemin ». J'aime bien."

#: data/wren_lines.json:egg_cairn
msgid "Someday people will walk this way again, and they'll see your stone on top."
msgstr "Un jour, des gens repasseront par ici et verront ta pierre au sommet."

#: data/wren_lines.json:egg_campfire
msgid "...warm... reading: warm..."
msgstr "...chaud... relevé : chaud..."

#: data/wren_lines.json:egg_campfire
msgid "A campfire. The ark's long-range eye can see it. It's the coziest pixel on the planet."
msgstr "Un feu de camp. L'œil longue portée de l'arche le voit. C'est le pixel le plus douillet de la planète."

#: data/wren_lines.json:egg_campfire
msgid "Somebody sat here and told stories. Let's sit a bit. No stories needed."
msgstr "Quelqu'un s'est assis ici pour raconter des histoires. Asseyons-nous un peu. Pas besoin d'histoires."

#: data/wren_lines.json:egg_campfire
msgid "Sit by the fire, {name}. You've earned a moment."
msgstr "Assieds-toi près du feu, {name}. Tu as bien mérité un moment."

#: data/wren_lines.json:egg_back_in_five
msgid "...back... in five..."
msgstr "...de retour... dans cinq..."

#: data/wren_lines.json:egg_back_in_five
msgid "'Back in five minutes.' I've been waiting a lot longer than that for my crew too."
msgstr "« De retour dans 5 minutes. » Moi aussi, j'attends mon équipe depuis bien plus longtemps que ça."

#: data/wren_lines.json:egg_back_in_five
msgid "You waited five minutes. That's more than anyone else did. Very polite."
msgstr "Tu as attendu cinq minutes. C'est plus que quiconque. Très poli."

#: data/wren_lines.json:egg_back_in_five
msgid "They didn't come back in five minutes. But we did, in the end. That counts."
msgstr "Ils ne sont pas revenus dans cinq minutes. Mais nous, oui, au bout du compte. Ça compte."

#: data/wren_lines.json:bloom_milestone
msgid "...bloom... the planet... is it...?"
msgstr "...floraison... la planète... est-ce que... ?"

#: data/wren_lines.json:bloom_milestone
msgid "...readings rising... green..."
msgstr "...relevés en hausse... vert..."

#: data/wren_lines.json:bloom_milestone
msgid "Verdance just crossed a line I've been watching for centuries. Look at it, {name}."
msgstr "Verdance vient de franchir une ligne que je surveille depuis des siècles. Regarde, {name}."

#: data/wren_lines.json:bloom_milestone
msgid "Another bloom milestone. The Cradle's seed counters are actually moving again."
msgstr "Une autre étape de floraison. Les compteurs de graines du Cradle bougent vraiment de nouveau."

#: data/wren_lines.json:bloom_milestone
msgid "The whole planet is answering now. Every district you've touched is singing."
msgstr "Toute la planète répond maintenant. Chaque quartier que tu as touché chante."

#: data/wren_lines.json:bloom_milestone
msgid "I keep refreshing the planet scan. It keeps getting greener. I'm not going to stop."
msgstr "Je n'arrête pas d'actualiser le scan de la planète. Elle devient de plus en plus verte. Je ne vais pas m'arrêter."

#: data/wren_lines.json:ark_wave
msgid "...seed ark... wave... complete..."
msgstr "...arche à graines... vague... terminée..."

#: data/wren_lines.json:ark_wave
msgid "Seed Ark wave done. The Cradle is already loading the next one. More seeds, more green. More light for your core."
msgstr "Vague de l'Arche terminée. Le Cradle charge déjà la suivante. Plus de graines, plus de vert. Plus de lumière pour ton cœur."

#: data/wren_lines.json:ark_wave
msgid "Another wave planted across the planet. The Cradle hums a little louder each time."
msgstr "Encore une vague plantée sur toute la planète. Le Cradle fredonne un peu plus fort à chaque fois."

#: data/wren_lines.json:ark_wave
msgid "Wave after wave. We're not finishing a job any more, {name}. We're tending a garden."
msgstr "Vague après vague. On ne termine plus un travail, {name}. On entretient un jardin."

#: data/wren_lines.json:biome_arrival
msgid "...new ground... unfamiliar..."
msgstr "...nouveau sol... inconnu..."

#: data/wren_lines.json:biome_arrival
msgid "This is the wild. No streets, no buildings. Just the land and whatever we left on it."
msgstr "C'est la nature sauvage. Pas de rues, pas de bâtiments. Juste la terre et ce qu'on y a laissé."

#: data/wren_lines.json:biome_arrival
msgid "Different dirt, different junk. Same job. I love a change of scenery."
msgstr "Autre terre, autre ferraille. Même travail. J'adore changer de décor."

#: data/wren_lines.json:biome_arrival
msgid "Every corner of Verdance has its own colours under the junk. Let's find out what this one's are."
msgstr "Chaque coin de Verdance a ses propres couleurs sous la ferraille. Découvrons celles de celui-ci."

#: data/wren_lines.json:outpost_repaired
msgid "...a light came on... out there. Far out. Was that you?"
msgstr "...une lumière s'est allumée... là-bas. Très loin. C'était toi ?"

#: data/wren_lines.json:outpost_repaired
msgid "Outpost scale online. Haul Bugs out on that edge just got a much shorter walk. They'd thank you if they knew how."
msgstr "Balance d'avant-poste en ligne. Les Haul Bugs de ce bord viennent de gagner un trajet bien plus court. Ils te remercieraient s'ils savaient comment."

#: data/wren_lines.json:outpost_repaired
msgid "A weigh station on the frontier again. I used to get readings from these. Lots of zeros. Then nothing."
msgstr "De nouveau une station de pesée sur la frontière. J'en recevais des relevés. Beaucoup de zéros. Puis plus rien."

#: data/wren_lines.json:outpost_repaired
msgid "Green light on the outpost. I'm logging it as 'ours' now."
msgstr "Feu vert sur l'avant-poste. Je l'enregistre comme « à nous » maintenant."

#: data/wren_lines.json:outpost_repaired
msgid "The old network had dozens of these. Every one you fix, the map gets a little smaller and a lot friendlier."
msgstr "L'ancien réseau en comptait des dizaines. Chaque fois que tu en répares un, la carte devient un peu plus petite et beaucoup plus amicale."

#: data/wren_lines.json:outpost_repaired
msgid "Another outpost lit. The bales don't have to come all the way home any more. Neither do we, really."
msgstr "Encore un avant-poste allumé. Les balles n'ont plus besoin de faire tout le chemin jusqu'à la maison. Nous non plus, en fait."

#: data/wren_lines.json:outpost_upgraded
msgid "...bigger... louder... good."
msgstr "...plus grand... plus fort... bien."

#: data/wren_lines.json:outpost_upgraded
msgid "Outpost upgraded. The scale sings a slightly higher note now. That's how you know it's happy."
msgstr "Avant-poste amélioré. La balance chante une note un peu plus aiguë maintenant. C'est comme ça qu'on sait qu'elle est contente."

#: data/wren_lines.json:outpost_upgraded
msgid "New kit at the outpost. The robots are already queueing to look at it."
msgstr "Nouvel équipement à l'avant-poste. Les robots font déjà la queue pour le voir."

#: data/wren_lines.json:outpost_upgraded
msgid "That outpost is turning into a proper little base. I'm proud of it. Is that allowed? I'm allowing it."
msgstr "Cet avant-poste devient une vraie petite base. J'en suis fière. C'est permis ? Je me le permets."

#: data/wren_lines.json:frontier_dust_flats
msgid "...hot... so much sand... Lumi?"
msgstr "...chaud... tant de sable... Lumi ?"

#: data/wren_lines.json:frontier_dust_flats
msgid "The Dust Flats. That glitter on the horizon is a solar farm, or what is left of it. Mind the wind, Lumi. It moves things."
msgstr "Les Plaines de poussière. Ce scintillement à l'horizon, c'est une ferme solaire, ou ce qu'il en reste. Attention au vent, Lumi. Il déplace les choses."

#: data/wren_lines.json:frontier_dust_flats
msgid "Sand to the edge of the world. There used to be a whole power grid out here. The well is dry, so the Drips will need tanks."
msgstr "Du sable jusqu'au bout du monde. Il y avait tout un réseau électrique ici. Le puits est à sec, donc les Drips auront besoin de réservoirs."

#: data/wren_lines.json:frontier_dust_flats
msgid "The Dust Flats. I remember the photos: blue panels to the horizon, humming. We can do that again. Plant windbreaks first."
msgstr "Les Plaines de poussière. Je me souviens des photos : des panneaux bleus jusqu'à l'horizon, qui bourdonnaient. On peut refaire ça. Plante d'abord des brise-vent."

#: data/wren_lines.json:frontier_frozen_port
msgid "...cold... ice on the lens..."
msgstr "...froid... de la glace sur l'objectif..."

#: data/wren_lines.json:frontier_frozen_port
msgid "The Frozen Port. Everything is locked in ice, junk included. Your beam can melt it, slowly. Heaters do it properly."
msgstr "Le Port gelé. Tout est pris dans la glace, ferraille comprise. Ton rayon peut la faire fondre, lentement. Les chauffages, eux, font ça bien."

#: data/wren_lines.json:frontier_frozen_port
msgid "A harbour frozen in mid-shift. The cranes still have containers hanging off them. Bring heaters, Lumi."
msgstr "Un port gelé en plein service. Les grues ont encore des conteneurs suspendus. Apporte des chauffages, Lumi."

#: data/wren_lines.json:frontier_frozen_port
msgid "The Frozen Port. Ships came in here every hour once. Thaw it, and the plants will need a greenhouse, or very stubborn seeds."
msgstr "Le Port gelé. Des navires arrivaient ici toutes les heures autrefois. Dégèle-le, et les plantes auront besoin d'une serre, ou de graines très têtues."

#: data/wren_lines.json:frontier_sunken_city
msgid "...water... everywhere... rooftops?"
msgstr "...de l'eau... partout... des toits ?"

#: data/wren_lines.json:frontier_sunken_city
msgid "The Sunken City. That's the old downtown under there. Skimmers first: clean the water and the old pumps can run again."
msgstr "La Cité engloutie. C'est l'ancien centre-ville, là-dessous. D'abord les Skimmers : nettoie l'eau et les vieilles pompes pourront redémarrer."

#: data/wren_lines.json:frontier_sunken_city
msgid "A whole city under the waterline. Rooftops like stepping stones. Clear the drains, and the streets will come back up."
msgstr "Toute une ville sous la ligne de flottaison. Des toits comme des pierres de gué. Débouche les égouts, et les rues remonteront."

#: data/wren_lines.json:frontier_sunken_city
msgid "The Sunken City. I had friends in those towers. Their names are in my archive. Let's bring the streets back up for them."
msgstr "La Cité engloutie. J'avais des amis dans ces tours. Leurs noms sont dans mes archives. Faisons remonter les rues pour eux."

#: data/wren_lines.json:frontier_cradle_returns
msgid "...Cradle... signal... strong..."
msgstr "...Cradle... signal... fort..."

#: data/wren_lines.json:frontier_cradle_returns
msgid "This is where the Cradle left from. The launch city. The ground crews kept the towers shining. Only the landing field is buried."
msgstr "C'est d'ici que le Cradle est parti. La ville de lancement. Les équipes au sol ont gardé les tours étincelantes. Seul le terrain d'atterrissage est enseveli."

#: data/wren_lines.json:frontier_cradle_returns
msgid "Cradle Returns. If we clean and green that pad, the ark can land. I mean really land. Here."
msgstr "Retour du Cradle. Si on nettoie et qu'on verdit cette plateforme, l'arche pourra se poser. Je veux dire vraiment se poser. Ici."

#: data/wren_lines.json:frontier_cradle_returns
msgid "Lumi. This is the launch field. I watched it from orbit the night we left. Clean the pad, plant it, keep it alive. Then we call them home."
msgstr "Lumi. C'est le terrain de lancement. Je l'ai regardé depuis l'orbite la nuit de notre départ. Nettoie la plateforme, plante-la, garde-la vivante. Ensuite, on les fait revenir."

#: data/wren_lines.json:sandstorm_warn
msgid "...wind... coming..."
msgstr "...du vent... qui arrive..."

#: data/wren_lines.json:sandstorm_warn
msgid "Sandstorm on the horizon. Anything clean and bare out there is going to get buried again."
msgstr "Tempête de sable à l'horizon. Tout ce qui est propre et nu là-bas va être enseveli de nouveau."

#: data/wren_lines.json:sandstorm_warn
msgid "Wind's rising. Planted hexes hold, and Sustained ones shelter their neighbours. The rest, well."
msgstr "Le vent se lève. Les hexagones plantés tiennent, et les durables abritent leurs voisins. Le reste, eh bien."

#: data/wren_lines.json:sandstorm_warn
msgid "Storm front from the flats. Get the robots home or keep sweeping, your choice. The hedges will hold."
msgstr "Front orageux venu des plaines. Ramène les robots ou continue de balayer, à toi de voir. Les haies tiendront."

#: data/wren_lines.json:sandstorm_over
msgid "...quiet... again..."
msgstr "...calme... de nouveau..."

#: data/wren_lines.json:sandstorm_over
msgid "Storm's past. It dropped junk on {n} hexes. The sheltered ones came through clean."
msgstr "La tempête est passée. Elle a déversé de la ferraille sur {n} hexagones. Ceux qui étaient abrités sont restés propres."

#: data/wren_lines.json:sandstorm_over
msgid "There. The wind gave some of it back. Plant a windbreak and it won't next time."
msgstr "Voilà. Le vent en a rendu une partie. Plante un brise-vent et ça n'arrivera pas la prochaine fois."

#: data/wren_lines.json:sandstorm_over
msgid "Storm over. Every Sustained hex out there is a wall now. Good walls."
msgstr "Tempête terminée. Chaque hexagone durable là-bas est un mur maintenant. De bons murs."

#: data/wren_lines.json:thaw_first
msgid "...melting... good..."
msgstr "...ça fond... bien..."

#: data/wren_lines.json:thaw_first
msgid "There, the ice let go. The junk underneath is just junk again. Scoop away."
msgstr "Voilà, la glace a lâché. La ferraille dessous redevient de la simple ferraille. Ramasse."

#: data/wren_lines.json:thaw_first
msgid "First hex thawed. A heater keeps warming the hexes around it, too."
msgstr "Premier hexagone dégelé. Un chauffage réchauffe aussi les hexagones autour."

#: data/wren_lines.json:thaw_first
msgid "Thawed. The ground underneath has been waiting three hundred years for that."
msgstr "Dégelé. Le sol dessous attendait ça depuis trois cents ans."

#: data/wren_lines.json:greenhouse_built
msgid "...glass... warm..."
msgstr "...verre... chaud..."

#: data/wren_lines.json:greenhouse_built
msgid "A greenhouse. Inside it, anything grows. Even here."
msgstr "Une serre. Dedans, tout pousse. Même ici."

#: data/wren_lines.json:greenhouse_built
msgid "Glass, a frame and a little heat. That's all a garden needs, apparently."
msgstr "Du verre, un cadre et un peu de chaleur. C'est tout ce qu'il faut à un jardin, apparemment."

#: data/wren_lines.json:greenhouse_built
msgid "A greenhouse on the Frozen Port. The Cradle had nine of them. I used to visit the tomatoes."
msgstr "Une serre au Port gelé. Le Cradle en avait neuf. J'allais souvent rendre visite aux tomates."

#: data/wren_lines.json:drain_stage
msgid "...pumps... running..."
msgstr "...pompes... en marche..."

#: data/wren_lines.json:drain_stage
msgid "The pumps are running! The water's going down. Look, a street."
msgstr "Les pompes tournent ! L'eau baisse. Regarde, une rue."

#: data/wren_lines.json:drain_stage
msgid "Water level dropped. There's a whole ring of streets out there now, and a lot of stranded junk on them."
msgstr "Le niveau de l'eau a baissé. Il y a tout un anneau de rues là-bas maintenant, et plein de ferraille échouée dessus."

#: data/wren_lines.json:drain_stage
msgid "The pumps remember how. Another ring of the city is back above water. I can see the old tram lines."
msgstr "Les pompes se souviennent. Un autre anneau de la ville est de nouveau hors de l'eau. Je vois les vieilles voies du tram."

#: data/wren_lines.json:cradle_pad
msgid "...pad... lights..."
msgstr "...plateforme... lumières..."

#: data/wren_lines.json:cradle_pad
msgid "The landing pad is clean. Now it needs to be alive. Plant it and keep it Sustained."
msgstr "La plateforme d'atterrissage est propre. Maintenant, il faut qu'elle soit vivante. Plante-la et garde-la durable."

#: data/wren_lines.json:cradle_pad
msgid "Pad's clear. The ark won't land on bare concrete, though. It wants green under it."
msgstr "Plateforme dégagée. L'arche ne se posera pas sur du béton nu, cela dit. Elle veut du vert dessous."

#: data/wren_lines.json:cradle_pad
msgid "The pad lights are on. The Cradle can see them from orbit. It's watching, Lumi."
msgstr "Les lumières de la plateforme sont allumées. Le Cradle les voit depuis l'orbite. Il regarde, Lumi."

#: data/wren_lines.json:cradle_complete
msgid "...Cradle... coming... home..."
msgstr "...Cradle... rentre... à la maison..."

#: data/wren_lines.json:cradle_complete
msgid "Lumi. The beacon is lit. The Cradle has answered. It's coming home."
msgstr "Lumi. La balise est allumée. Le Cradle a répondu. Il rentre à la maison."

#: data/wren_lines.json:cradle_complete
msgid "Pad green, district thriving, beacon lit. Ark Cradle, you are clear to land. I have waited a long time to say that."
msgstr "Plateforme verte, quartier florissant, balise allumée. Arche Cradle, vous êtes autorisée à atterrir. J'ai attendu longtemps pour dire ça."

#: data/wren_lines.json:cradle_complete
msgid "Lumi. The Cradle is coming home. Because of you. Small, blue, stubborn you."
msgstr "Lumi. Le Cradle rentre à la maison. Grâce à toi. Toi, le petit, le bleu, le têtu."

#: data/wren_lines.json:core_25
msgid "...relay locking... Lumi? Lumi, I can hear you. Properly."
msgstr "...verrouillage du relais... Lumi ? Lumi, je t'entends. Correctement."

#: data/wren_lines.json:core_25
msgid "Quarter charge. The relay finally stopped crackling. Hello, properly this time."
msgstr "Un quart de charge. Le relais a enfin arrêté de grésiller. Bonjour, correctement cette fois."

#: data/wren_lines.json:core_25
msgid "A quarter full. I can hear you humming again."
msgstr "Un quart plein. Je t'entends fredonner de nouveau."

#: data/wren_lines.json:core_50
msgid "...brighter... you're brighter..."
msgstr "...plus lumineux... tu es plus lumineux..."

#: data/wren_lines.json:core_50
msgid "Half charged. You're glowing, Lumi. Properly glowing."
msgstr "À moitié chargé. Tu brilles, Lumi. Vraiment."

#: data/wren_lines.json:core_50
msgid "Half full. The ark's sensors flagged you as a new star. I didn't correct them."
msgstr "À moitié plein. Les capteurs de l'arche t'ont classé comme une nouvelle étoile. Je ne les ai pas corrigés."

#: data/wren_lines.json:core_75
msgid "...look up... tonight... look up..."
msgstr "...lève les yeux... ce soir... lève les yeux..."

#: data/wren_lines.json:core_75
msgid "Look up tonight. The steady light, west to east. That's us. We're coming."
msgstr "Lève les yeux ce soir. La lumière régulière, d'ouest en est. C'est nous. On arrive."

#: data/wren_lines.json:core_75
msgid "The Cradle is close enough to see now. Every night, a little closer."
msgstr "Le Cradle est assez proche pour être vu maintenant. Chaque nuit, un peu plus près."

#: data/wren_lines.json:low_core
msgid "...you're dim... find green... any green..."
msgstr "...tu faiblis... trouve du vert... n'importe quel vert..."

#: data/wren_lines.json:low_core
msgid "Your core's low. Plant something, Lumi. Anything. Green light is green light."
msgstr "Ton cœur est faible. Plante quelque chose, Lumi. N'importe quoi. La lumière verte, c'est la lumière verte."

#: data/wren_lines.json:low_core
msgid "Running a little dim. A few blooms will fix that."
msgstr "Un peu faiblard. Quelques fleurs vont arranger ça."

#: data/wren_lines.json:egg_sand_piano
msgid "...music... out here?..."
msgstr "...de la musique... ici ?..."

#: data/wren_lines.json:egg_sand_piano
msgid "A piano. In the desert. I have so many questions and none of them will be answered."
msgstr "Un piano. Dans le désert. J'ai tellement de questions, et aucune n'aura de réponse."

#: data/wren_lines.json:egg_sand_piano
msgid "It's out of tune in a way that sounds deliberate now. Like the dunes learned a song."
msgstr "Il est désaccordé d'une façon qui semble voulue, maintenant. Comme si les dunes avaient appris une chanson."

#: data/wren_lines.json:egg_snow_bot
msgid "...someone dressed it... for the cold..."
msgstr "...quelqu'un l'a habillé... pour le froid..."

#: data/wren_lines.json:egg_snow_bot
msgid "They built snowmen around the old loaders for luck. I think it worked, a bit. It's still standing."
msgstr "Ils construisaient des bonshommes de neige autour des vieux chargeurs, pour la chance. Je crois que ça a un peu marché. Il tient toujours debout."

#: data/wren_lines.json:egg_snow_bot
msgid "Every winter, a new scarf. Someone kept that up for a very long time."
msgstr "Chaque hiver, une nouvelle écharpe. Quelqu'un a tenu ça très longtemps."

#: data/wren_lines.json:egg_bottle_message
msgid "...a letter... from before the water..."
msgstr "...une lettre... d'avant l'eau..."

#: data/wren_lines.json:egg_bottle_message
msgid "Somebody stayed to remember where the streets were. We should plant where the bakery was."
msgstr "Quelqu'un est resté pour se souvenir d'où étaient les rues. On devrait planter là où était la boulangerie."

#: data/wren_lines.json:egg_bottle_message
msgid "Red lever goes down, not up. Noted. Thank you, R."
msgstr "Le levier rouge se baisse, il ne se lève pas. Noté. Merci, R."

#: data/wren_lines.json:egg_welcome_home
msgid "...welcome... home..."
msgstr "...bon... retour..."

#: data/wren_lines.json:egg_welcome_home
msgid "They kept repainting it. Three hundred years of 'welcome home' for a ship that hadn't come yet."
msgstr "Ils l'ont repeinte encore et encore. Trois cents ans de « bon retour » pour un vaisseau qui n'était pas encore arrivé."

#: data/wren_lines.json:egg_welcome_home
msgid "We came, though. Tell them we came."
msgstr "On est venus, pourtant. Dis-leur qu'on est venus."

#: data/wren_lines.json:egg_crossword
msgid "...a puzzle... one left..."
msgstr "...une énigme... plus qu'une..."

#: data/wren_lines.json:egg_crossword
msgid "Five letters, what grows back if you let it. You got it on the first try."
msgstr "Quatre lettres, ce qui repousse si on le laisse faire. Tu l'as trouvé du premier coup."

#: data/wren_lines.json:egg_crossword
msgid "The Ledger set the crossword. Of course the Ledger set the crossword."
msgstr "C'est le Ledger qui a fait les mots croisés. Évidemment que c'est le Ledger qui a fait les mots croisés."

#: data/wren_lines.json:egg_hopscotch
msgid "...hop... hop..."
msgstr "...saute... saute..."

#: data/wren_lines.json:egg_hopscotch
msgid "One, two, three... I'm counting the hover bowl as a foot. Don't tell anyone."
msgstr "Un, deux, trois... Je compte le bol de lévitation comme un pied. Ne le dis à personne."

#: data/wren_lines.json:egg_hopscotch
msgid "Square seven still has the pebble on it. Somebody was winning."
msgstr "Le caillou est toujours sur la case sept. Quelqu'un était en train de gagner."

#: data/wren_lines.json:egg_balloon
msgid "...up... it went up..."
msgstr "...en haut... il est monté..."

#: data/wren_lines.json:egg_balloon
msgid "It's heading for the Cradle. I'll tell the bridge to watch for a red balloon."
msgstr "Il file vers le Cradle. Je vais dire à la passerelle de guetter un ballon rouge."

#: data/wren_lines.json:egg_balloon
msgid "Three hundred years holding its breath. It earned the trip."
msgstr "Trois cents ans à retenir son souffle. Il a bien mérité le voyage."

#: data/wren_lines.json:egg_mailbox
msgid "...a letter... for you..."
msgstr "...une lettre... pour toi..."

#: data/wren_lines.json:egg_mailbox
msgid "'Please don't scoop the cat.' Excellent advice. Still valid."
msgstr "« Ne ramasse pas le chat, s'il te plaît. » Excellent conseil. Toujours valable."

#: data/wren_lines.json:egg_mailbox
msgid "The blue door, the flower box, the tomato that counts as a flower. Let's find it."
msgstr "La porte bleue, la jardinière, la tomate qui compte comme une fleur. Allons les trouver."

#: data/wren_lines.json:egg_bonsai
msgid "...small... old... patient..."
msgstr "...petit... vieux... patient..."

#: data/wren_lines.json:egg_bonsai
msgid "Three hundred years old and thirty centimetres tall. It took its time. Good for it."
msgstr "Trois cents ans et trente centimètres. Il a pris son temps. Tant mieux pour lui."

#: data/wren_lines.json:egg_bonsai
msgid "It looks like it's been expecting you. Trees are like that."
msgstr "On dirait qu'il t'attendait. Les arbres sont comme ça."

#: data/wren_lines.json:egg_listening_dish
msgid "...a signal... faint..."
msgstr "...un signal... faible..."

#: data/wren_lines.json:egg_listening_dish
msgid "That tone. That's the Cradle's beacon. Somebody out here kept listening the whole time."
msgstr "Ce son. C'est la balise du Cradle. Quelqu'un ici a continué d'écouter tout ce temps."

#: data/wren_lines.json:egg_listening_dish
msgid "'They said they'd call.' We did. Late, but we did."
msgstr "« Ils ont dit qu'ils appelleraient. » On l'a fait. En retard, mais on l'a fait."

#: data/wren_lines.json:egg_older_pod
msgid "...another pod... older..."
msgstr "...une autre capsule... plus ancienne..."

#: data/wren_lines.json:egg_older_pod
msgid "SK-0. A seed-keeper before you. I didn't know there were any. The Cradle never told me."
msgstr "SK-0. Un gardien des graines avant toi. Je ne savais pas qu'il y en avait eu. Le Cradle ne me l'a jamais dit."

#: data/wren_lines.json:egg_older_pod
msgid "'Start by the water.' Good advice, from someone who knew."
msgstr "« Commence près de l'eau. » Un bon conseil, de quelqu'un qui savait."

#: data/wren_lines.json:egg_heirloom_tin
msgid "...soil... from home..."
msgstr "...de la terre... de chez nous..."

#: data/wren_lines.json:egg_heirloom_tin
msgid "A bit of the first garden, already spilled on new ground. That's how it starts."
msgstr "Un bout du premier jardin, déjà répandu sur une nouvelle terre. C'est comme ça que tout commence."

#: data/wren_lines.json:egg_heirloom_tin
msgid "Verdance soil on another world. The Makers would have liked that."
msgstr "De la terre de Verdance sur un autre monde. Les Bâtisseurs auraient aimé ça."

#: data/wren_lines.json:cradle_mode
msgid "...the vault... other worlds..."
msgstr "...la réserve... d'autres mondes..."

#: data/wren_lines.json:cradle_mode
msgid "The Cradle's seed vault has a lot more in it than one planet's worth. There are other worlds out here, Lumi. Ruined ones. Waiting."
msgstr "La réserve de graines du Cradle contient bien plus que de quoi remplir une seule planète. Il y a d'autres mondes là-dehors, Lumi. En ruine. Qui attendent."

#: data/wren_lines.json:cradle_mode
msgid "Heirlooms, a whole map of worlds. Verdance stays green; we just take what we learned somewhere new."
msgstr "Des héritages, toute une carte de mondes. Verdance reste vert ; on emporte juste ce qu'on a appris ailleurs."

#: data/wren_lines.json:new_world
msgid "...new ground... new junk..."
msgstr "...nouveau sol... nouvelle ferraille..."

#: data/wren_lines.json:new_world
msgid "New world, new sky. Same job. You're better at it than you were the first time."
msgstr "Nouveau monde, nouveau ciel. Même boulot. Tu t'y prends mieux que la première fois."

#: data/wren_lines.json:new_world
msgid "Look at that. Ruined, dusty, nobody's planted anything in centuries. You know what to do."
msgstr "Regarde-moi ça. En ruine, poussiéreux, personne n'a rien planté depuis des siècles. Tu sais ce qu'il te reste à faire."

#: data/wren_lines.json:garden_place
msgid "...pretty..."
msgstr "...joli..."

#: data/wren_lines.json:garden_place
msgid "You're decorating. I approve. The cats are going to approve more."
msgstr "Tu décores. J'approuve. Les chats vont approuver encore plus."

#: data/wren_lines.json:garden_place
msgid "A bench, a lamp, a fountain. It's starting to look like somewhere people would want to come back to."
msgstr "Un banc, une lampe, une fontaine. Ça commence à ressembler à un endroit où les gens auraient envie de revenir."

#~ msgid "Cradle Mode: the ark's seed vault holds seeds for other worlds. Pause > Ark Bridge to see them, spend Starseeds on Heirlooms, or seed a new world. Garden Mode (H) is open too."
#~ msgstr "Mode Cradle : la réserve de graines de l'arche contient des graines pour d'autres mondes. Pause > Pont de l'Arche pour les voir, dépenser des graines d'étoile en héritages ou ensemencer un nouveau monde. Le mode jardin (H) est ouvert aussi."

