#: planets/verdance/data/pollution.json:kinds.wrecks.name
msgid "Wrecks"
msgstr "Épaves"

#: planets/verdance/data/pollution.json:kinds.wrecks.hint
msgid "WRECKS  CUT AND LIFT THEM"
msgstr "ÉPAVES  DÉCOUPE ET SOULÈVE"

#: planets/verdance/data/pollution.json:kinds.wrecks.prompt
msgid "WRECKS  NEED THE PLATE CUTTER"
msgstr "ÉPAVES  IL FAUT LE COUPE-TÔLE"

#: planets/verdance/data/pollution.json:kinds.slick.name
msgid "Slick"
msgstr "Nappe"

#: planets/verdance/data/pollution.json:kinds.slick.hint
msgid "SLICK  SKIM IT"
