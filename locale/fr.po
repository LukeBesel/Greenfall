#: planets/verdance/data/robots.json:types[haulbug].name
msgid "Haul Bug"
msgstr "Haul Bug"

#: planets/verdance/data/robots.json:types[haulbug].desc
msgid "Fork cart. Carries loose bales to the scale."
msgstr "Chariot à fourches. Porte les balles à la balance."

#: planets/verdance/data/robots.json:types[haulbug].upgrades[1].name
msgid "Longer Forks"
msgstr "Fourches allongées"

#: planets/verdance/data/robots.json:types[scrounger].name
msgid "Scrounger"
msgstr "Scrounger"

#: planets/verdance/data/robots.json:types[scrounger].desc
msgid "Parts finder. Digs buried parts out of cleaned ground in its search area and carries them to the base."
msgstr "Chercheur de pièces. Déterre les pièces enfouies dans le sol nettoyé de sa zone de recherche et les rapporte à la base."

#: planets/verdance/data/robots.json:types[scrounger].upgrades[1].name
msgid "Bigger Sack"
msgstr "Sac plus grand"

#: planets/verdance/data/robots.json:types[seedling].name
msgid "Seedling"
msgstr "Seedling"

#: planets/verdance/data/robots.json:types[seedling].desc
msgid "Plants seeds in clean ground. Uses your seed stock."
msgstr "Plante des graines dans le sol propre. Utilise ton stock de graines."

#: planets/verdance/data/robots.json:types[drip].name
msgid "Drip"
msgstr "Drip"

#: planets/verdance/data/robots.json:types[drip].desc
msgid "Waters the thirstiest plants in its zone with a spray arc. Refills at the base barrel, a Water Tank or a clean lake."
msgstr "Arrose en arc les plantes les plus assoiffées de sa zone. Se remplit au tonneau de la base, à un réservoir ou dans un lac propre."

#: planets/verdance/data/robots.json:types[drip].upgrades[1].name
msgid "Bigger Tank"
msgstr "Réservoir agrandi"

#: planets/verdance/data/robots.json:types[drip].upgrades[2].name
msgid "Wide Nozzle"
msgstr "Buse large"

