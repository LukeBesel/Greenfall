#: data/planets.json:verdance.hubs[landing_yard].name
msgid "Landing Yard"
msgstr "Cour d'atterrissage"

#: data/planets.json:verdance.hubs[landing_yard].landmark.name
msgid "Water Tower"
msgstr "Château d'eau"

#: data/planets.json:verdance.hubs[landing_yard].desc
msgid "Home. The pod, the workbench and your first robots."
msgstr "La maison. La capsule, l'établi et tes premiers robots."

#: data/planets.json:verdance.hubs[garden_row].name
msgid "Garden Row"
msgstr "Allée des Jardins"

#: data/planets.json:verdance.hubs[garden_row].landmark.name
msgid "Windpump"
msgstr "Éolienne de pompage"

#: data/planets.json:verdance.hubs[garden_row].desc
msgid "The rocket's seed stock. A new seed type."
msgstr "La réserve de graines de la fusée. Un nouveau type de graine."

#: data/planets.json:verdance.hubs[garden_row].piece.name
msgid "Seed Stock"
msgstr "Réserve de graines"

#: data/planets.json:verdance.hubs[garden_row].hint
msgid "The old gardens. The Windpump still holds a sealed seed store."
msgstr "Les vieux jardins. L'éolienne garde encore une réserve de graines scellée."

#: data/planets.json:verdance.hubs[gantry_works].name
msgid "Gantry Works"
msgstr "Chantier du Portique"

#: data/planets.json:verdance.hubs[gantry_works].landmark.name
msgid "Gantry Crane"
msgstr "Grue portique"

#: data/planets.json:verdance.hubs[gantry_works].desc
msgid "Hull plates for the rocket."
msgstr "Des plaques de coque pour la fusée."

#: data/planets.json:verdance.hubs[gantry_works].piece.name
msgid "Hull Plates"
msgstr "Plaques de coque"

#: data/planets.json:verdance.hubs[gantry_works].hint
msgid "The shipyard. The Gantry Crane can lift the hull plates the rocket needs."
msgstr "Le chantier naval. La grue portique peut soulever les plaques de coque dont la fusée a besoin."

#: data/planets.json:verdance.hubs[signal_heights].name
msgid "Signal Heights"
msgstr "Hauts du Signal"

#: data/planets.json:verdance.hubs[signal_heights].landmark.name
msgid "Signal Mast"
msgstr "Mât de signal"

#: data/planets.json:verdance.hubs[signal_heights].desc
msgid "The star chart: where the rocket can fly."
msgstr "La carte des étoiles : où la fusée peut aller."

#: data/planets.json:verdance.hubs[signal_heights].piece.name
msgid "Star Chart"
msgstr "Carte des étoiles"

#: data/planets.json:verdance.hubs[signal_heights].hint
msgid "The city centre. The Signal Mast kept the star chart of every route out."
msgstr "Le centre-ville. Le mât de signal a gardé la carte des étoiles de toutes les routes."

#: data/planets.json:verdance.hubs[fairground].name
msgid "Fairground"
msgstr "Fête foraine"

#: data/planets.json:verdance.hubs[fairground].landmark.name
msgid "Big Wheel"
msgstr "Grande roue"

#: data/planets.json:verdance.hubs[fairground].desc
msgid "A power cell for the rocket. A new look for Lumi."
msgstr "Une cellule d'énergie pour la fusée. Un nouveau look pour Lumi."

#: data/planets.json:verdance.hubs[fairground].piece.name
msgid "Power Cell"
msgstr "Cellule d'énergie"

#: data/planets.json:verdance.hubs[fairground].hint
msgid "The fairground. The Big Wheel's motor ran on a power cell that never ran down."
msgstr "La fête foraine. Le moteur de la grande roue tournait grâce à une cellule d'énergie qui ne s'épuisait jamais."

#: data/planets.json:verdance.hubs[stack_works].name
msgid "Stack Works"
msgstr "Usine de la Cheminée"

#: data/planets.json:verdance.hubs[stack_works].landmark.name
msgid "Tall Stack"
msgstr "Grande cheminée"

#: data/planets.json:verdance.hubs[stack_works].desc
msgid "Fuel for the rocket: the last piece."
msgstr "Du carburant pour la fusée : la dernière pièce."

#: data/planets.json:verdance.hubs[stack_works].piece.name
msgid "Rocket Fuel"
msgstr "Carburant de fusée"

#: data/planets.json:verdance.hubs[stack_works].hint
msgid "The fuel works. The tanks under the Tall Stack are still full."
msgstr "L'usine de carburant. Les cuves sous la grande cheminée sont encore pleines."

#: data/planets.json:verdance.hubs[bus_depot].name
msgid "Bus Depot"
msgstr "Dépôt de bus"

#: data/planets.json:verdance.hubs[bus_depot].landmark.name
msgid "Last Bus"
msgstr "Dernier bus"

#: data/planets.json:verdance.hubs[bus_depot].desc
msgid "An extra town. A reward of Parts."
msgstr "Une ville en plus. Récompense : des Pièces."

#: data/planets.json:verdance.hubs[crane_court].name
msgid "Crane Court"
msgstr "Cour de la Grue"

#: data/planets.json:verdance.hubs[crane_court].landmark.name
msgid "Tower Crane"
msgstr "Grue à tour"

#: data/planets.json:verdance.hubs[crane_court].desc data/planets.json:verdance.hubs[lake_light].desc
msgid "An extra town. A reward of Cubes."
msgstr "Une ville en plus. Récompense : des Cubes."

#: data/planets.json:verdance.hubs[tank_hill].name
msgid "Tank Hill"
msgstr "Colline du Réservoir"

#: data/planets.json:verdance.hubs[tank_hill].landmark.name
msgid "Hill Tank"
msgstr "Réservoir de la colline"

#: data/planets.json:verdance.hubs[tank_hill].desc
msgid "An extra town. A reward of Seeds."
msgstr "Une ville en plus. Récompense : des Graines."

#: data/planets.json:verdance.hubs[lake_light].name
msgid "Lake Light"
msgstr "Phare du Lac"

#: data/planets.json:verdance.hubs[lake_light].landmark.name
msgid "Lighthouse"
msgstr "Phare"

#: data/planets.json:rime.tagline
msgid "An ice moon, core-mined until it froze."
msgstr "Une lune de glace, minée jusqu'au cœur jusqu'à geler."

#: data/planets.json:rime.sites.hub_camp.name
msgid "Drill Camp"
msgstr "Camp de forage"

#: data/planets.json:rime.sites.hub_camp.desc
msgid "Cabins on skids round a plated yard, a greenhouse dome, fuel tanks, a comms mast and a snowcat."
msgstr "Des cabanes sur patins autour d'une cour en plaques, un dôme de serre, des réservoirs de carburant, un mât radio et une dameuse."

#: data/planets.json:rime.sites.derrick.name
msgid "Frozen Derrick"
msgstr "Derrick gelé"

#: data/planets.json:rime.sites.derrick.desc
msgid "A Ledger core-drill derrick frozen into the ice; a geothermal tap when restored."
msgstr "Un derrick de carottage du Ledger pris dans la glace ; une source géothermique une fois restauré."

#: data/planets.json:rime.sites.borehole.name
msgid "The Borehole"
msgstr "Le Puits de forage"

#: data/planets.json:rime.sites.borehole.desc
msgid "The shaft under its headframe and winder house; cold mist, then a warm glow."
msgstr "Le puits sous son chevalement et sa salle des treuils ; une brume froide, puis une lueur chaude."

#: data/planets.json:rime.sites.hot_springs.name
msgid "Hot Springs"
msgstr "Sources chaudes"

#: data/planets.json:rime.sites.hot_springs.desc
msgid "Geothermal pools with a bathhouse and boardwalk; frozen, then steaming."
msgstr "Des bassins géothermiques avec des bains et une promenade en bois ; gelés, puis fumants."

#: data/planets.json:ochre.tagline
msgid "The Ledger's first open-pit strip mine, closest to the twin suns."
msgstr "La première mine à ciel ouvert du Ledger, la plus proche des soleils jumeaux."

#: data/planets.json:ochre.sites.list.hub_base.name
msgid "Ledger Haul Depot"
msgstr "Dépôt de transport du Ledger"

#: data/planets.json:ochre.sites.list.toppled_excavator.name
msgid "The Fallen Wheel"
msgstr "La Roue tombée"

#: data/planets.json:ochre.sites.list.pit_fragment.name
msgid "Bench Cut"
msgstr "La Taille en gradins"

#: data/planets.json:ochre.sites.list.oasis.name
msgid "Spring Terraces"
msgstr "Terrasses de la source"

#: data/planets.json:tidewell.tagline
msgid "An ocean world. The Ledger's dredging rigs still stand in the shallows."
msgstr "Un monde océan. Les plateformes de dragage du Ledger se dressent encore dans les hauts-fonds."

#: data/planets.json:tidewell.sites.hub_raft.name
msgid "Anchored Raft"
msgstr "Radeau ancré"

#: data/planets.json:tidewell.sites.hub_raft.desc
msgid "Timber raft deck on rusted pontoons: workshop shack, store, deck crane, fuel tank, moorings."
msgstr "Pont de radeau en bois sur des flotteurs rouillés : atelier, boutique, grue de pont, réservoir, amarres."

#: data/planets.json:tidewell.sites.hub_stilts.name
msgid "Stilt Yard"
msgstr "Cour sur pilotis"

#: data/planets.json:tidewell.sites.hub_stilts.desc
msgid "A sandy islet with a stilt deck and huts over the water, boardwalk, beached skiff."
msgstr "Un îlot sablonneux avec une plateforme et des cabanes sur pilotis, une passerelle et une barque échouée."

#: data/planets.json:tidewell.sites.wreck.name
msgid "Ore Barge Wreck"
msgstr "Épave de la barge"

#: data/planets.json:tidewell.sites.wreck.desc
msgid "The Ledger's half-sunk mining barge by a sandbar; hoppers turn to planters when restored."
msgstr "La barge minière à moitié coulée du Ledger, près d'un banc de sable ; restaurée, ses trémies deviennent des jardinières."

#: data/planets.json:tidewell.sites.dredge_rig.name
msgid "Dredge Rig"
msgstr "Plateforme de dragage"

#: data/planets.json:tidewell.sites.dredge_rig.desc
msgid "A Ledger jack-up dredging rig with bucket ladder, derrick and crane."
msgstr "Une plateforme autoélévatrice de dragage du Ledger, avec chaîne à godets, derrick et grue."

#: data/planets.json:tidewell.sites.reef_garden.name
msgid "Reef Garden"
msgstr "Jardin de récif"

#: data/planets.json:tidewell.sites.reef_garden.desc
msgid "Bleached coral breaking the surface among nets; live coral and floating gardens when restored."
msgstr "Du corail blanchi affleure entre des filets ; restauré, du corail vivant et des jardins flottants."

#: data/planets.json:tidewell.sites.buoy_field.name
msgid "Buoy Field"
msgstr "Champ de bouées"

#: data/planets.json:tidewell.sites.buoy_field.desc
msgid "Rows of mooring buoys strung with rope and ghost nets; light caps when futuristic."
msgstr "Des rangées de bouées d'amarrage chargées de cordes et de filets fantômes ; des capuchons lumineux une fois futuristes."

#: data/planets.json:anvil.sites[foundry_yard].name
msgid "Foundry Yard"
msgstr "Cour de la fonderie"

#: data/planets.json:anvil.sites[foundry_yard].desc
msgid "hub base: casting hall, two stacks, conveyor truss and hopper, ore spur, ember slag tip, buried hauler"
msgstr "base principale : halle de coulée, deux cheminées, convoyeur et trémie, voie à minerai, crassier rougeoyant, transporteur enseveli"

#: data/planets.json:anvil.sites[foundry_tower].name
msgid "Ledger Foundry Tower"
msgstr "Tour de fonderie du Ledger"

#: data/planets.json:anvil.sites[foundry_tower].desc
msgid "the Ledger's colossal 130 m foundry stack on buttresses, pipes and slag tips"
msgstr "la colossale cheminée de fonderie du Ledger, haute de 130 m, sur contreforts, avec tuyaux et crassiers"

#: data/planets.json:anvil.sites[lava_forge].name
msgid "Lava Forge"
msgstr "Forge de lave"

#: data/planets.json:anvil.sites[lava_forge].desc
msgid "running furnace pouring molten slag down a channel to a pool; ladle crane; cools as restored"
msgstr "un four en marche qui verse des scories en fusion dans un canal jusqu'à un bassin ; pont à poche ; refroidit une fois restauré"

#: data/planets.json:anvil.sites[ruined_smelter].name
msgid "Ruined Smelter"
msgstr "Fonderie en ruine"

#: data/planets.json:anvil.sites[ruined_smelter].desc
msgid "collapsed smelter hall frame, tipped and spilled pots, a toppled stack; restored as a planted pergola"
msgstr "charpente effondrée de la halle de fonderie, creusets renversés, une cheminée abattue ; restaurée en pergola fleurie"

#: data/radio.json:songs[verdance_sprout].name data/songs.json:songs[sprout_step].title
msgid "Sprout Step"
msgstr "Pas de pousse"

#: data/radio.json:songs[verdance_sprout].desc
msgid "Kalimba and bells, the first green on Verdance."
msgstr "Kalimba et cloches, le premier vert sur Verdance."

#: data/radio.json:songs[verdance_sweep].name data/songs.json:songs[clean_sweep].title
msgid "Clean Sweep"
msgstr "Grand ménage"

#: data/radio.json:songs[verdance_sweep].desc
msgid "Marimba and a four-on-the-floor kick: cleaning music."
msgstr "Marimba et grosse caisse sur chaque temps : de la musique pour nettoyer."

#: data/radio.json:songs[ochre_sunbaked].name data/songs.json:songs[sunbaked].title
msgid "Sunbaked"
msgstr "Brûlé de soleil"

#: data/radio.json:songs[ochre_sunbaked].desc
msgid "A sunny marimba hook over a lute ostinato."
msgstr "Un motif de marimba ensoleillé sur un ostinato de luth."

#: data/radio.json:songs[ochre_sunbaked].hint
msgid "Land on Ochre"
msgstr "Atterris sur Ochre"

#: data/radio.json:songs[ochre_caravan].name data/songs.json:songs[dune_caravan].title
msgid "Dune Caravan"
msgstr "Caravane des dunes"

#: data/radio.json:songs[ochre_caravan].desc
msgid "A winding pluck line over a loping frame drum."
msgstr "Une ligne pincée sinueuse sur un tambour sur cadre nonchalant."

#: data/radio.json:songs[ochre_caravan].hint
msgid "A base on Ochre at level 3"
msgstr "Une base sur Ochre au niveau 3"

#: data/radio.json:songs[ochre_mirage].name
msgid "Mirage"
msgstr "Mirage"

#: data/radio.json:songs[ochre_mirage].desc
msgid "Kalimba and bells shimmering in the heat."
msgstr "Kalimba et cloches qui miroitent dans la chaleur."

#: data/radio.json:songs[ochre_mirage].hint
msgid "A base on Ochre at level 5"
msgstr "Une base sur Ochre au niveau 5"

#: data/radio.json:songs[tidewell_tradewinds].name data/songs.json:songs[tradewinds].title
msgid "Tradewinds"
msgstr "Alizés"

#: data/radio.json:songs[tidewell_tradewinds].desc
msgid "Steel pans skipping over the waves."
msgstr "Des steel drums qui sautillent sur les vagues."

#: data/radio.json:songs[tidewell_tradewinds].hint
msgid "Land on Tidewell"
msgstr "Atterris sur Tidewell"

#: data/radio.json:songs[tidewell_tidepools].name data/songs.json:songs[tidepools].title
msgid "Tidepools"
msgstr "Flaques de marée"

#: data/radio.json:songs[tidewell_tidepools].desc
msgid "A harp melody over rolling arpeggios."
msgstr "Une mélodie de harpe sur des arpèges ondulants."

#: data/radio.json:songs[tidewell_tidepools].hint
msgid "A base on Tidewell at level 3"
msgstr "Une base sur Tidewell au niveau 3"

#: data/radio.json:songs[tidewell_skipper].name data/songs.json:songs[skipping_stones].title
msgid "Skipping Stones"
msgstr "Ricochets"

#: data/radio.json:songs[tidewell_skipper].desc
msgid "A bouncy marimba shuffle."
msgstr "Un shuffle de marimba plein de rebond."

#: data/radio.json:songs[tidewell_skipper].hint
msgid "A base on Tidewell at level 5"
msgstr "Une base sur Tidewell au niveau 5"

#: data/radio.json:songs[rime_hoarfrost].name data/songs.json:songs[hoarfrost].title
msgid "Hoarfrost"
msgstr "Givre"

#: data/radio.json:songs[rime_hoarfrost].desc
msgid "Glass bells that slowly gather warmth."
msgstr "Des cloches de verre qui se réchauffent peu à peu."

#: data/radio.json:songs[rime_hoarfrost].hint
msgid "Land on Rime"
msgstr "Atterris sur Rime"

#: data/radio.json:songs[rime_aurora].desc
msgid "Piano doubled by glass under the northern lights."
msgstr "Du piano doublé de verre sous les aurores boréales."

#: data/radio.json:songs[rime_aurora].hint
msgid "A base on Rime at level 5"
msgstr "Une base sur Rime au niveau 5"

#: data/radio.json:songs[anvil_foundry].name data/songs.json:songs[foundry_heart].title
msgid "Foundry Heart"
msgstr "Cœur de fonderie"

#: data/radio.json:songs[anvil_foundry].desc
msgid "A dark, groovy forge that learns to hope."
msgstr "Une forge sombre et groovy qui apprend l'espoir."

#: data/radio.json:songs[anvil_foundry].hint
msgid "Land on Anvil"
msgstr "Atterris sur Anvil"

#: data/radio.json:songs[anvil_ash].name data/songs.json:songs[ash_choir].title
msgid "Ash Choir"
msgstr "Chœur de cendres"

#: data/radio.json:songs[anvil_ash].desc
msgid "An eerie choir over brass and embers."
msgstr "Un chœur étrange sur des cuivres et des braises."

#: data/radio.json:songs[anvil_ash].hint
msgid "A base on Anvil at level 3"
msgstr "Une base sur Anvil au niveau 3"

#: data/radio.json:songs[anvil_engine].name data/songs.json:songs[red_engine].title
msgid "Red Engine"
msgstr "Moteur rouge"

#: data/radio.json:songs[anvil_engine].desc
msgid "Sub bass and metal hits, the furnaces running clean."
msgstr "Basses profondes et coups de métal, les fourneaux tournent propre."

#: data/radio.json:songs[anvil_engine].hint
msgid "A base on Anvil at level 5"
msgstr "Une base sur Anvil au niveau 5"

#: data/radio.json:songs[homecoming].desc
msgid "The ark's theme, for the journey home."
msgstr "Le thème de l'arche, pour le voyage du retour."

#: data/radio.json:songs[homecoming].hint
msgid "Bring the Cradle home"
msgstr "Ramène le Cradle"

#: data/research.json:story_unlocks[haul_rig].name
msgid "Haul Bug Plans"
msgstr "Plans du Haul Bug"

#: data/research.json:story_unlocks[haul_rig].hint
msgid "WREN is looking for Haul Bug plans. Keep your Scoopie busy."
msgstr "WREN cherche les plans du Haul Bug. Occupe bien ton Scoopie."

#: data/research.json:story_unlocks[skimmer_rig].name
msgid "Skimmer Plans"
msgstr "Plans du Skimmer"

#: data/research.json:story_unlocks[skimmer_rig].hint
msgid "Comes later: WREN will send Skimmer plans once the land is greening."
msgstr "Plus tard : WREN enverra les plans du Skimmer quand la terre reverdira."

#: data/research.json:branches[robotics].name
msgid "Robotics"
msgstr "Robotique"

#: data/research.json:branches[botany].name
msgid "Botany"
msgstr "Botanique"

#: data/research.json:branches[hydrology].name
msgid "Hydrology"
msgstr "Hydrologie"

#: data/research.json:branches[logistics].name
msgid "Logistics"
msgstr "Logistique"

#: data/research.json:nodes[scoop_beam].name
msgid "Scoop Beam"
msgstr "Rayon de pelle"

#: data/research.json:nodes[scoop_beam].desc
msgid "A soft blue guide beam on the scoop. Lumi reaches a little further."
msgstr "Un doux rayon guide bleu sur la pelle. Lumi porte un peu plus loin."

#: data/research.json:nodes[wide_beam].name
msgid "Wide Beam"
msgstr "Rayon large"

#: data/research.json:nodes[wide_beam].desc
msgid "Spread the beam into a fan. Each sweep catches more."
msgstr "Le rayon s'ouvre en éventail. Chaque passage attrape plus."

#: data/research.json:nodes[bigger_hopper].name
msgid "Bigger Hopper"
msgstr "Grande trémie"

#: data/research.json:nodes[bigger_hopper].desc
msgid "Fold-out side panels for the chest compartment."
msgstr "Des panneaux latéraux dépliables pour le compartiment ventral."

#: data/research.json:nodes[auto_sort].name
msgid "Auto-Sort"
msgstr "Tri auto"

#: data/research.json:nodes[auto_sort].desc
msgid "A little sorting comb in the intake. Cleaner bales sell for more."
msgstr "Un petit peigne de tri dans l'entrée. Les balles plus propres se vendent plus cher."

#: data/research.json:nodes[field_magnet].name
msgid "Field Magnet"
msgstr "Aimant de terrain"

#: data/research.json:nodes[field_magnet].desc
msgid "Loose bits hop toward the scoop on their own."
msgstr "Les petits morceaux sautent tout seuls vers la pelle."

#: data/research.json:nodes[tractor_beam].name
msgid "Tractor Beam"
msgstr "Rayon tracteur"

#: data/research.json:nodes[tractor_beam].desc
msgid "Junk lifts, floats and glides into the hopper. It is very satisfying."
msgstr "La ferraille s'élève, flotte et glisse dans la trémie. C'est très satisfaisant."

#: data/research.json:nodes[salvage_logic].name
msgid "Salvage Logic"
msgstr "Logique de récup"

#: data/research.json:nodes[salvage_logic].desc
msgid "Lumi rewrites the base's old assembly logic. The base can build a helper again: the Scoopie."
msgstr "Lumi réécrit l'ancienne logique d'assemblage de la base. La base peut de nouveau construire une aide : le Scoopie."

#: data/research.json:nodes[seedling_blueprint].name
msgid "Seedling Blueprint"
msgstr "Plan du Seedling"

#: data/research.json:nodes[seedling_blueprint].desc
msgid "Plans for a small planter bot. Build it at the workbench."
msgstr "Les plans d'un petit bot planteur. Construis-le à l'établi."

#: data/research.json:nodes[drip_blueprint].name
msgid "Drip Blueprint"
msgstr "Plan du Drip"

#: data/research.json:nodes[drip_blueprint].desc
msgid "A watering bot with a sloshy tank. Plants will love it."
msgstr "Un bot arroseur avec un réservoir qui clapote. Les plantes vont l'adorer."

#: data/research.json:nodes[bale_tuning].name
msgid "Bale Tuning"
msgstr "Réglage des balles"

#: data/research.json:nodes[bale_tuning].desc
msgid "Tighter presses on every Scoopie. Bigger, denser bales."
msgstr "Des presses plus serrées sur chaque Scoopie. Des balles plus grosses et plus denses."

#: data/research.json:nodes[multibot_blueprint].name
msgid "Multibot Blueprint"
msgstr "Plan du Multibot"

#: data/research.json:nodes[multibot_blueprint].desc
msgid "A helper that can clean, plant or water. Jack of all trades."
msgstr "Un assistant qui sait nettoyer, planter ou arroser. Un touche-à-tout."

#: data/research.json:nodes[swarm_sync].name
msgid "Swarm Sync"
msgstr "Synchro d'essaim"

#: data/research.json:nodes[swarm_sync].desc
msgid "The whole fleet shares one little heartbeat. Everyone moves faster."
msgstr "Toute la flotte partage un petit battement de cœur. Tout le monde va plus vite."

#: data/research.json:nodes[soil_survey].name
msgid "Soil Survey"
msgstr "Relevé du sol"

#: data/research.json:nodes[soil_survey].desc
msgid "Sniff, poke, log. Every reading teaches Lumi something."
msgstr "Renifler, tâter, noter. Chaque relevé apprend quelque chose à Lumi."

#: data/research.json:nodes[hardy_weeds].name
msgid "Hardy Nettles"
msgstr "Orties robustes"

#: data/research.json:nodes[hardy_weeds].desc
msgid "Nettles grow anywhere. Stingy, stubborn, and good for the soil."
msgstr "Les orties poussent partout. Piquantes, têtues, et bonnes pour le sol."

#: data/research.json:nodes[wild_mint].desc
msgid "A fresh green smell drifts over the cleared hexes."
msgstr "Une odeur fraîche et verte flotte sur les hexagones nettoyés."

#: data/research.json:nodes[pollinator_survey].name
msgid "Pollinator Survey"
msgstr "Recensement des pollinisateurs"

#: data/research.json:nodes[pollinator_survey].desc
msgid "Count the visitors. The bees are back: every plant grows much faster, blooms drop more seeds, and Seedlings learn where flowers want to be."
msgstr "Compte les visiteurs. Les abeilles sont de retour : chaque plante pousse bien plus vite, les fleurs donnent plus de graines, et les Seedlings apprennent où les fleurs veulent être."

#: data/research.json:nodes[hedgerows].name
msgid "Hedgerows"
msgstr "Haies"

#: data/research.json:nodes[hedgerows].desc
msgid "Dense little hedges. Birds will need somewhere to sit. Gardens grow a little faster again."
msgstr "De petites haies denses. Les oiseaux auront besoin d'un perchoir. Les jardins poussent encore un peu plus vite."

#: data/research.json:nodes[evergreens].name
msgid "Evergreen Saplings"
msgstr "Jeunes conifères"

#: data/research.json:nodes[evergreens].desc
msgid "Tiny pines. In a hundred years, a forest. Blooms drop more seeds."
msgstr "De tout petits pins. Dans cent ans, une forêt. Les fleurs donnent plus de graines."

#: data/research.json:nodes[water_testing].name
msgid "Water Testing"
msgstr "Analyse de l'eau"

#: data/research.json:nodes[water_testing].desc
msgid "Dip strips and a lot of squinting. The lakes are sick, not dead."
msgstr "Des bandelettes et beaucoup de plissements d'yeux. Les lacs sont malades, pas morts."

#: data/research.json:nodes[big_tanks].name
msgid "Big Tanks"
msgstr "Grands réservoirs"

#: data/research.json:nodes[big_tanks].desc
msgid "Drip and Multibot carry more water per trip."
msgstr "Drip et Multibot transportent plus d'eau par trajet."

#: data/research.json:nodes[spray_heads].name
msgid "Spray Heads"
msgstr "Têtes d'arrosage"

#: data/research.json:nodes[spray_heads].desc
msgid "A misting nozzle. Water bots reach further and work faster."
msgstr "Une buse à brume. Les bots arroseurs portent plus loin et travaillent plus vite."

#: data/research.json:nodes[silt_filters].name
msgid "Silt Filters"
msgstr "Filtres à limon"

#: data/research.json:nodes[silt_filters].desc
msgid "Layered sand and charcoal. Murky water turns glassy."
msgstr "Des couches de sable et de charbon. L'eau trouble devient limpide."

#: data/research.json:nodes[pump_lines].name
msgid "Pump Lines"
msgstr "Conduites de pompage"

#: data/research.json:nodes[pump_lines].desc
msgid "Hoses from the lake to the hub. Water bots refill faster."
msgstr "Des tuyaux du lac jusqu'à la base. Les bots arroseurs se remplissent plus vite."

#: data/research.json:nodes[irrigation].name
msgid "Irrigation"
msgstr "Irrigation"

#: data/research.json:nodes[irrigation].desc
msgid "Buried drip lines. The meadow drinks while you sleep."
msgstr "Des goutte-à-goutte enterrés. La prairie boit pendant que tu dors."

#: data/research.json:nodes[field_notebook].name
msgid "Field Notebook"
msgstr "Carnet de terrain"

#: data/research.json:nodes[field_notebook].desc
msgid "Lumi starts keeping tidy notes. Research goes a bit quicker."
msgstr "Lumi commence à prendre des notes soignées. La recherche va un peu plus vite."

#: data/research.json:nodes[conveyor].name
msgid "Conveyor Belts"
msgstr "Tapis roulants"

#: data/research.json:nodes[conveyor].desc
msgid "Rollers salvaged from an old shop till. Bales can ride to the scale."
msgstr "Des rouleaux récupérés sur une vieille caisse de magasin. Les balles peuvent rouler jusqu'à la balance."

#: data/research.json:nodes[auto_baler].name
msgid "Auto-Baler"
msgstr "Presse auto"

#: data/research.json:nodes[auto_baler].desc
msgid "A hub station that presses loose junk into bales by itself."
msgstr "Une station de la base qui presse toute seule la ferraille en balles."

#: data/research.json:nodes[haul_routes].name
msgid "Haul Routes"
msgstr "Itinéraires de transport"

#: data/research.json:nodes[haul_routes].desc
msgid "Painted lines on the ground. Haul Bugs stop bumping into each other."
msgstr "Des lignes peintes au sol. Les Haul Bugs arrêtent de se cogner."

#: data/research.json:nodes[recycler].name data/stations.json:recycler.name
msgid "Recycler"
msgstr "Recycleur"

#: data/research.json:nodes[recycler].desc
msgid "Grind bales back into clean stock. Junk gone for good."
msgstr "Broie les balles en matière propre. La ferraille disparaît pour de bon."

#: data/research.json:nodes[rocket_cargo].name
msgid "Rocket Cargo"
msgstr "Fret de fusée"

#: data/research.json:nodes[rocket_cargo].desc
msgid "Cargo pods for the rocket. Hubs can trade with each other."
msgstr "Des capsules cargo pour la fusée. Les bases peuvent commercer entre elles."

#: data/research.json:nodes[observatory].name
msgid "Observatory Optics"
msgstr "Optique d'observatoire"

#: data/research.json:nodes[observatory].desc
msgid "Ground lenses from an old planetarium and a crew telemetry link. Any base can build a Telescope (without it, from base level 4) and watch the crews on other worlds."
msgstr "Des lentilles taillées d'un vieux planétarium et une liaison télémétrique avec l'équipe. Toute base peut construire un télescope (sinon dès la base niveau 4) et observer les équipes des autres mondes."

#: data/research.json:nodes[dune_charts].name
msgid "Dune Charts"
msgstr "Cartes des dunes"

#: data/research.json:nodes[dune_charts].desc
msgid "Wind maps and landing beacons for the far deserts. The rocket can reach the Dust Flats (with two bases at level 5)."
msgstr "Cartes des vents et balises d'atterrissage pour les déserts lointains. La fusée peut atteindre les Plaines de poussière (avec deux bases au niveau 5)."

#: data/research.json:nodes[thermal_lance].name
msgid "Thermal Lance"
msgstr "Lance thermique"

#: data/research.json:nodes[thermal_lance].desc
msgid "A heat coil wound round the beam. Lumi melts ice twice as fast, and the rocket can land at the Frozen Port."
msgstr "Une bobine chauffante enroulée autour du rayon. Lumi fait fondre la glace deux fois plus vite, et la fusée peut se poser au Port gelé."

#: data/research.json:nodes[heat_pumps].name
msgid "Heat Pumps"
msgstr "Pompes à chaleur"

#: data/research.json:nodes[heat_pumps].desc
msgid "Heaters pull warmth out of the frozen harbour itself. They thaw faster and warm their neighbours more."
msgstr "Les chauffages puisent la chaleur dans le port gelé lui-même. Ils dégèlent plus vite et réchauffent davantage leurs voisins."

#: data/research.json:nodes[dune_fences].name
msgid "Dune Fences"
msgstr "Clôtures de dunes"

#: data/research.json:nodes[dune_fences].desc
msgid "Brush fences and hedges that break the wind. Sustained hexes shelter two rings around them, and sandstorms carry less."
msgstr "Des clôtures de branchages et des haies qui coupent le vent. Les hexagones durables abritent deux anneaux autour d'eux, et les tempêtes transportent moins."

#: data/research.json:nodes[cold_hardy_seeds].name
msgid "Cold-Hardy Seeds"
msgstr "Graines résistantes au froid"

#: data/research.json:nodes[cold_hardy_seeds].desc
msgid "Seeds bred from the few things that survived the cold. Ferns, nettles, pines, periwinkle and frost moss can grow outdoors at the Frozen Port."
msgstr "Des graines issues des rares choses qui ont survécu au froid. Fougères, orties, pins, pervenche et mousse de givre peuvent pousser dehors au Port gelé."

#: data/research.json:nodes[dew_condensers].name
msgid "Dew Condensers"
msgstr "Condenseurs de rosée"

#: data/research.json:nodes[dew_condensers].desc
msgid "Cold fins on every Water Tank pull water out of the night air. Tanks refill much faster where the ground is dry."
msgstr "Des ailettes froides sur chaque réservoir tirent l'eau de l'air nocturne. Les réservoirs se remplissent bien plus vite là où le sol est sec."

#: data/research.json:nodes[pump_works].name
msgid "Pump Works"
msgstr "Stations de pompage"

#: data/research.json:nodes[pump_works].desc
msgid "Plans for the old city pumps. The rocket can reach the Sunken City, and Skimmers net faster."
msgstr "Les plans des vieilles pompes de la ville. La fusée peut atteindre la Cité engloutie, et les Skimmers pêchent plus vite."

#: data/research.json:nodes[ark_beacon].name
msgid "Ark Beacon"
msgstr "Balise de l'Arche"

#: data/research.json:nodes[ark_beacon].desc
msgid "A landing beacon tuned to the Cradle. Once the three frontiers are thriving, it calls the ark home."
msgstr "Une balise d'atterrissage réglée sur le Cradle. Une fois les trois frontières florissantes, elle rappelle l'arche."

#: data/robot_parts.json:slots[chassis].name
msgid "Chassis"
msgstr "Châssis"

#: data/robot_parts.json:slots[head].name
msgid "Head"
msgstr "Tête"

#: data/robot_parts.json:slots[mobility].name
msgid "Mobility"
msgstr "Mobilité"

#: data/robot_parts.json:slots[tool].name
msgid "Tool"
msgstr "Outil"

#: data/robot_parts.json:slots[topper].name
msgid "Topper"
msgstr "Couvre-chef"

#: data/robot_parts.json:stats[work].name
msgid "Work rate"
msgstr "Cadence"

#: data/robot_parts.json:set_bonus.name
msgid "Maker Resonance"
msgstr "Résonance des Bâtisseurs"

#: data/robot_parts.json:set_bonus.desc
msgid "All three Maker parts fitted: +5% speed, +6% work."
msgstr "Les trois pièces des Bâtisseurs installées : +5% de vitesse, +6% de travail."

#: data/robot_parts.json:parts[light_frame].name
msgid "Light Frame"
msgstr "Cadre léger"

#: data/robot_parts.json:parts[light_frame].desc
msgid "Slim exposed rails instead of a full shell."
msgstr "De fins rails apparents au lieu d'une coque complète."

#: data/robot_parts.json:parts[cargo_hull].name
msgid "Cargo Hull"
msgstr "Coque cargo"

#: data/robot_parts.json:parts[cargo_hull].desc
msgid "Thick side plates and a rear rack."
msgstr "Épaisses plaques latérales et un porte-bagages arrière."

#: data/robot_parts.json:parts[sealed_shell].name
msgid "Sealed Shell"
msgstr "Coque étanche"

#: data/robot_parts.json:parts[sealed_shell].desc
msgid "Smooth covers, neat seams, no grit."
msgstr "Capots lisses, joints nets, pas de poussière."

#: data/robot_parts.json:parts[maker_shell].name
msgid "Maker Shell"
msgstr "Coque des Bâtisseurs"

#: data/robot_parts.json:parts[maker_shell].desc
msgid "Pearl fairings with gold trim, as the Makers built them. Part of the Maker set."
msgstr "Des carénages nacrés à liseré doré, tels que les Bâtisseurs les faisaient. Fait partie du set Bâtisseur."

#: data/robot_parts.json:parts[big_eye].name
msgid "Big-Eye Sensor"
msgstr "Capteur grand œil"

#: data/robot_parts.json:parts[big_eye].desc
msgid "A huge lens on a stalk."
msgstr "Une énorme lentille sur une tige."

#: data/robot_parts.json:parts[focus_visor].name
msgid "Focus Visor"
msgstr "Visière de concentration"

#: data/robot_parts.json:parts[focus_visor].desc
msgid "Blinkers for robots."
msgstr "Des œillères pour robots."

#: data/robot_parts.json:parts[periscope].name
msgid "Periscope"
msgstr "Périscope"

#: data/robot_parts.json:parts[periscope].desc
msgid "Sees over the plants. Mostly."
msgstr "Voit par-dessus les plantes. Presque toujours."

#: data/robot_parts.json:parts[chatter_dome].name
msgid "Chatterbox Dome"
msgstr "Dôme bavard"

#: data/robot_parts.json:parts[chatter_dome].desc
msgid "Glass dome with a little speaker."
msgstr "Dôme de verre avec un petit haut-parleur."

#: data/robot_parts.json:parts[maker_optic].name
msgid "Maker Optic"
msgstr "Optique des Bâtisseurs"

#: data/robot_parts.json:parts[maker_optic].desc
msgid "A floating gem lens under a gold brow. Part of the Maker set."
msgstr "Une lentille-gemme flottante sous un sourcil doré. Fait partie du set Bâtisseur."

#: data/robot_parts.json:parts[treads].name
msgid "Treads"
msgstr "Chenilles"

#: data/robot_parts.json:parts[treads].desc
msgid "Rubber tracks."
msgstr "Chenilles en caoutchouc."

#: data/robot_parts.json:parts[rotor].name
msgid "Quad Rotor"
msgstr "Quadrirotor"

#: data/robot_parts.json:parts[rotor].desc
msgid "Four ducted fans."
msgstr "Quatre hélices carénées."

#: data/robot_parts.json:parts[legs].name
msgid "Walker Legs"
msgstr "Pattes de marcheur"

#: data/robot_parts.json:parts[legs].desc
msgid "Four careful legs."
msgstr "Quatre pattes prudentes."

#: data/robot_parts.json:parts[hover_skirt].name
msgid "Hover Skirt"
msgstr "Jupe à coussin d'air"

#: data/robot_parts.json:parts[hover_skirt].desc
msgid "A cushion of air and a soft glow underneath."
msgstr "Un coussin d'air et une douce lueur dessous."

#: data/robot_parts.json:parts[maker_glider].name
msgid "Maker Glider"
msgstr "Planeur des Bâtisseurs"

#: data/robot_parts.json:parts[maker_glider].desc
msgid "Twin levitation pods with a thin light seam. Part of the Maker set."
msgstr "Deux nacelles de lévitation avec une fine couture de lumière. Fait partie du set Bâtisseur."

#: data/robot_parts.json:parts[wide_scoop].name
msgid "Wide Scoop"
msgstr "Pelle large"

#: data/robot_parts.json:parts[wide_scoop].desc
msgid "A big, wide scoop."
msgstr "Une grande pelle large."

#: data/robot_parts.json:parts[fine_sieve].name
msgid "Fine Sieve"
msgstr "Tamis fin"

#: data/robot_parts.json:parts[fine_sieve].desc
msgid "A sieve that shakes out the dirt."
msgstr "Un tamis qui secoue la terre."

#: data/robot_parts.json:parts[long_forks].name
msgid "Long Forks"
msgstr "Longues fourches"

#: data/robot_parts.json:parts[long_forks].desc
msgid "Extra-long forks."
msgstr "Fourches extra-longues."

#: data/robot_parts.json:parts[tow_hook].name
msgid "Tow Hook"
msgstr "Crochet de remorquage"

#: data/robot_parts.json:parts[tow_hook].desc
msgid "Winch and hook."
msgstr "Treuil et crochet."

#: data/robot_parts.json:parts[seed_drill].name data/robots.json:types[seedling].upgrades[1].name
msgid "Seed Drill"
msgstr "Semoir"

#: data/robot_parts.json:parts[seed_drill].desc
msgid "An auger nose."
msgstr "Un nez en tarière."

#: data/robot_parts.json:parts[mist_sprayer].name
msgid "Mist Sprayer"
msgstr "Brumisateur"

#: data/robot_parts.json:parts[mist_sprayer].desc
msgid "A fan nozzle."
msgstr "Une buse en éventail."

#: data/robot_parts.json:parts[jet_nozzle].name
msgid "Jet Nozzle"
msgstr "Buse à jet"

#: data/robot_parts.json:parts[jet_nozzle].desc
msgid "A strong, straight jet nozzle."
msgstr "Une buse à jet droit et puissant."

#: data/robot_parts.json:parts[antenna].name
msgid "Bulb Antenna"
msgstr "Antenne à boule"

#: data/robot_parts.json:parts[antenna].desc
msgid "A springy antenna with a soft glowing bulb."
msgstr "Une antenne à ressort avec une boule lumineuse toute douce."

#: data/robot_parts.json:parts[top_hat].name
msgid "Tiny Top Hat"
msgstr "Mini haut-de-forme"

#: data/robot_parts.json:parts[top_hat].desc
msgid "For the robot who means business."
msgstr "Pour le robot qui ne rigole pas."

#: data/robot_parts.json:parts[crew_flag].name
msgid "Crew Flag"
msgstr "Drapeau d'équipe"

#: data/robot_parts.json:parts[crew_flag].desc
msgid "A little flag in the crew's colour."
msgstr "Un petit drapeau aux couleurs de l'équipe."

#: data/robot_parts.json:parts[bobble_plant].name
msgid "Bobble Plant"
msgstr "Plante à ressort"

#: data/robot_parts.json:parts[bobble_plant].desc
msgid "A sprout on a spring. Boings when it brakes."
msgstr "Une pousse sur un ressort. Fait boing quand il freine."

#: data/robot_parts.json:parts[bobble_plant].source.hint
msgid "Comes with your first robot"
msgstr "Livré avec ton premier robot"

#: data/robot_parts.json:parts[traffic_cone].name
msgid "Traffic Cone"
msgstr "Cône de chantier"

#: data/robot_parts.json:parts[traffic_cone].desc
msgid "Found it, kept it, wears it."
msgstr "Trouvé, gardé, porté."

#: data/robot_parts.json:parts[propeller_cap].name
msgid "Propeller Cap"
msgstr "Casquette à hélice"

#: data/robot_parts.json:parts[propeller_cap].desc
msgid "Spins when it hurries. Does not help."
msgstr "Tourne quand il se dépêche. N'aide pas."

#: data/robot_parts.json:parts[lucky_clover].name
msgid "Lucky Clover"
msgstr "Trèfle porte-bonheur"

#: data/robot_parts.json:parts[lucky_clover].desc
msgid "A four-leaf clover that floats. Rare: a robot has to spot one."
msgstr "Un trèfle à quatre feuilles qui flotte. Rare : un robot doit en repérer un."

#: data/robot_parts.json:parts[lucky_clover].source.hint
msgid "Rare salvage find (robots with a good Scan)"
msgstr "Trouvaille de récup rare (robots avec un bon Scan)"

#: data/robot_parts.json:parts[maker_crest].name
msgid "Maker Crest"
msgstr "Blason des Bâtisseurs"

#: data/robot_parts.json:parts[maker_crest].desc
msgid "A floating gold ring. Purely for show; the Makers loved a show."
msgstr "Un anneau doré flottant. Purement décoratif ; les Bâtisseurs adoraient le spectacle."

#: data/robot_parts.json:traits[cautious].name
msgid "Cautious"
msgstr "Prudent"

#: data/robot_parts.json:traits[cautious].desc
msgid "Looks both ways. Twice."
msgstr "Regarde des deux côtés. Deux fois."

#: data/robot_parts.json:traits[speedy].name
msgid "Speedy"
msgstr "Rapide"

#: data/robot_parts.json:traits[speedy].desc
msgid "Always in a hurry, sometimes a messy one."
msgstr "Toujours pressé, parfois dans le désordre."

#: data/robot_parts.json:traits[chatty].name
msgid "Chatty"
msgstr "Bavard"

#: data/robot_parts.json:traits[chatty].desc
msgid "Beeps at everything. Mostly at you."
msgstr "Bipe sur tout. Surtout sur toi."

#: data/robot_parts.json:traits[sleepy].desc
msgid "Dozes off whenever it parks."
msgstr "S'assoupit dès qu'il se gare."

#: data/robot_parts.json:traits[tidy].name
msgid "Tidy"
msgstr "Soigneux"

#: data/robot_parts.json:traits[tidy].desc
msgid "Shakes the dust off after every job."
msgstr "Secoue la poussière après chaque tâche."

#: data/robot_parts.json:traits[curious].desc
msgid "Tilts its head at butterflies and bottle caps."
msgstr "Penche la tête devant les papillons et les capsules."

#: data/robot_parts.json:traits[hummer].name
msgid "Musical"
msgstr "Musical"

#: data/robot_parts.json:traits[hummer].desc
msgid "Hums little tunes while it works."
msgstr "Fredonne de petits airs en travaillant."

#: data/robots.json:types[scoopie].name
msgid "Scoopie"
msgstr "Scoopie"

#: data/robots.json:types[scoopie].desc
msgid "Small cleaner. Picks junk in its hex and leaves bales behind."
msgstr "Petit nettoyeur. Ramasse la ferraille de son hexagone et laisse des balles derrière lui."

#: data/robots.json:types[scoopie].upgrades[0].name data/robots.json:types[haulbug].upgrades[0].name data/robots.json:types[seedling].upgrades[0].name
#: data/robots.json:types[drip].upgrades[0].name data/robots.json:types[multibot].upgrades[0].name
