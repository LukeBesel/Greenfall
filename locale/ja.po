#: data/shards.json:shards[receipt].title
msgid "Till receipt"
msgstr ""

#: data/shards.json:shards[receipt].body
msgid ""
"CORNER STORE  #0442\n"
"\n"
"2x BOTTLED WATER         4.80\n"
"1x DUST MASK (CHILD)     3.10\n"
"1x DUST MASK (ADULT)     3.10\n"
"1x SEED PACKET (MIXED)   0.90\n"
"\n"
"TOTAL                   11.90\n"
"CASH\n"
"\n"
"Thank you! Air quality today: POOR"
msgstr ""

#: data/shards.json:shards[maint_log].kind
msgid "log"
msgstr ""

#: data/shards.json:shards[maint_log].title
msgid "Maintenance log, unit P-46RA"
msgstr ""

#: data/shards.json:shards[maint_log].body
msgid ""
"DAY 4,113\n"
"Route 12 complete. 41 bales.\n"
"Ledger notice received: \"Operations paused pending cost review.\"\n"
"Returning to dock.\n"
"\n"
"DAY 4,114\n"
"Still paused.\n"
"\n"
"DAY 4,190\n"
"Still paused. Dock battery 31%.\n"
"There is a flower growing through the gutter at route 12, marker 9.\n"
"Nobody is cleaning around it. I hope that's all right."
msgstr ""

#: data/shards.json:shards[ledger_memo].kind
msgid "memo"
msgstr ""

#: data/shards.json:shards[ledger_memo].title
msgid "Memo, Municipal Ledger Office"
msgstr ""

#: data/shards.json:shards[ledger_memo].body
msgid ""
"TO: All Sanitation Units\n"
"FROM: THE LEDGER (Automated Fiscal Continuity)\n"
"RE: Pause of Operations\n"
"\n"
"Cleanup activity is presently valued at a net loss of 0.4 units per bale.\n"
"All units will pause operations until conditions improve.\n"
"Conditions will be reviewed every 24 hours.\n"
"\n"
"Thank you for your understanding.\n"
"This memo was generated automatically. Please do not reply."
msgstr ""

#: data/shards.json:shards[voicemail].kind
msgid "voicemail"
msgstr ""

#: data/shards.json:shards[voicemail].title
msgid "Voicemail transcript"
msgstr ""

#: data/shards.json:shards[voicemail].body
msgid ""
"\"Hi, it's Dad. The shuttle's tomorrow at six. They said one bag each, so... pick your favorite stuffed animal, not all of them, okay? And... we're leaving the cleanup bots running. They'll keep it tidy for when we come back. It won't be long. Love you. Bye.\"\n"
"\n"
"[Message saved]"
msgstr ""

#: data/shards.json:shards[poster].kind
msgid "poster"
msgstr ""

#: data/shards.json:shards[poster].title
msgid "Faded safety poster"
msgstr ""

#: data/shards.json:shards[poster].body
msgid ""
"THE CRADLE IS WATCHING OVER US\n"
"\n"
"Every seed. Every spore. Every egg.\n"
"Safe in orbit until the Greenfall.\n"
"\n"
"KEEP YOUR STREETS CLEAN — THE ROBOTS CAN'T DO IT ALONE\n"
"\n"
"(Someone has scratched underneath: \"they can if you let them\")"
msgstr ""

#: data/stations.json:conveyor.name
msgid "Conveyor Feeder"
msgstr ""

#: data/stations.json:conveyor.desc
msgid "A hopper pad and a powered belt into the scale. Drop bales on the pad; haulers use it when it is closer."
msgstr ""

#: data/stations.json:auto_baler.name
msgid "Auto-baler"
msgstr ""

#: data/stations.json:auto_baler.desc
msgid "A hydraulic baling press dropped at the cleaning frontier. Cleaner robots tip their hoppers into it instead of baling on the spot; it presses denser bales for the haulers."
msgstr ""

#: data/stations.json:recycler.desc
msgid "Shredder drums and a little smelter. Bales go in and never come back: out come bolts and clean building stock. Every bale burnt clean helps the sky."
msgstr ""

#: data/upgrades.json:upgrades[compartment_size].name
msgid "Compartment Size"
msgstr ""

#: data/upgrades.json:upgrades[compartment_size].desc
msgid "A roomier chest. More junk per cube."
msgstr ""

#: data/upgrades.json:upgrades[scoop_width].name
msgid "Scoop Width"
msgstr ""

#: data/upgrades.json:upgrades[scoop_width].desc
msgid "Longer arms, wider sweeps."
msgstr ""

#: data/upgrades.json:upgrades[tread_speed].name
msgid "Tread Speed"
msgstr ""

#: data/upgrades.json:upgrades[tread_speed].desc
msgid "Oiled treads. Still squeaky."
msgstr ""

#: data/upgrades.json:upgrades[carry_stack].name
msgid "Carry Stack"
msgstr ""

#: data/upgrades.json:upgrades[carry_stack].desc
msgid "Balance one more cube on your back."
msgstr ""

#: data/upgrades.json:upgrades[compactor_pressure].name
msgid "Compactor Pressure"
msgstr ""

#: data/upgrades.json:upgrades[compactor_pressure].desc
msgid "Squish harder. Denser cubes are worth more."
msgstr ""

#: data/upgrades.json:upgrades[scoop_speed].name
msgid "Scoop Speed"
msgstr ""

#: data/upgrades.json:upgrades[scoop_speed].desc
msgid "Faster arms. Clinkier clinks."
msgstr ""

#: data/upgrades.json:upgrades[auto_compactor].name
msgid "Auto Compactor"
msgstr ""

#: data/upgrades.json:upgrades[auto_compactor].desc
msgid "Cubes itself when full. Manual Perfect Cubes still pay more."
msgstr ""

#: data/upgrades.json:upgrades[magnet_arm].name
msgid "Magnet Arm"
msgstr ""

#: data/upgrades.json:upgrades[magnet_arm].desc
msgid "Nearby junk scoots toward you while scooping."
msgstr ""

#: data/upgrades.json:upgrades[detector_range].name
msgid "Detector Coil"
msgstr ""

#: data/upgrades.json:upgrades[detector_range].desc
msgid "A bigger search coil. Picks up buried parts from further away."
msgstr ""

#: data/upgrades.json:upgrades[belt_speed].name
msgid "Belt Drive"
msgstr ""

#: data/upgrades.json:upgrades[belt_speed].desc
msgid "A bigger motor on the conveyor feeder. Bales ride faster."
msgstr ""

#: data/upgrades.json:upgrades[baler_speed].name
msgid "Baler Hydraulics"
msgstr ""

#: data/upgrades.json:upgrades[baler_speed].desc
msgid "Higher pump pressure. The auto-baler presses faster."
msgstr ""

#: data/upgrades.json:upgrades[recycler_yield].name
msgid "Recycler Yield"
msgstr ""

#: data/upgrades.json:upgrades[recycler_yield].desc
msgid "Sharper shredder teeth and a hotter smelter. More bolts and stock per bale."
msgstr ""

#: data/upgrades.json:upgrades[laser_reach].name
msgid "Laser Reach"
msgstr ""

#: data/upgrades.json:upgrades[laser_reach].desc
msgid "Longer focusing lenses: grab junk from further away."
msgstr ""

#: data/upgrades.json:upgrades[multi_lock].name
msgid "Multi-Lock"
msgstr ""

#: data/upgrades.json:upgrades[multi_lock].desc
msgid "Extra targeting lasers: lift several pieces at once."
msgstr ""

#: data/wren_lines.json:wake
msgid "...carrier... Lumi? Relay at four percent. It's WREN. Hello. Hello. I'm still here."
msgstr ""

#: data/wren_lines.json:wake
msgid "...that ground you just cleared... the relay got stronger. Hello again. Do that again. Please."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "...that patch of ground. It's... brown. Brown is better than gray."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "Signal stronger. Did you do that?"
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "...clean... the relay likes that word. So do I."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "Another one. My static has a shape now."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "Every hex you clear, I hear a little more. Keep going, {name}."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "That ground hasn't seen the sun in a long time. It's blinking."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "The grid just ticked. Somewhere a meter I used to watch moved by one."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "I'm starting to remember lists. Lists of hexes. Mostly unfinished."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "Clean dirt. The Makers would have called that a start. I call it a start, too."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "Hex logged. I've started naming them. That one is 'Not Garbage'."
msgstr ""

#: data/wren_lines.json:hex_clean
msgid "You're good at this. Annoyingly good. The old fleet took breaks."
msgstr ""

#: data/wren_lines.json:milestone
msgid "...ten... ten of something. Is ten a lot? It feels like a lot."
msgstr ""

#: data/wren_lines.json:milestone
msgid "Patterns in the noise. You're making them."
msgstr ""

#: data/wren_lines.json:milestone
msgid "Twenty-five hexes. I can see the street from up here now. Mostly."
msgstr ""

#: data/wren_lines.json:milestone
msgid "Fifty. The relay held a whole minute without dropping. A record. Don't tell the ark, it gets competitive."
msgstr ""

#: data/wren_lines.json:milestone
msgid "A hundred hexes. I can see this whole district without squinting. I don't have eyes, but you know what I mean."
msgstr ""

#: data/wren_lines.json:perfect
msgid "...neat..."
msgstr ""

#: data/wren_lines.json:perfect
msgid "...that one was... tidy."
msgstr ""

#: data/wren_lines.json:perfect
msgid "That bale is perfect. Don't tell the others."
msgstr ""

#: data/wren_lines.json:perfect
msgid "Right to the line. Show-off."
msgstr ""

#: data/wren_lines.json:perfect
msgid "Perfect bale. The scale actually purred."
msgstr ""

#: data/wren_lines.json:perfect
msgid "I would frame that one if I had walls."
msgstr ""

#: data/wren_lines.json:robot_built
msgid "...another... voice? No. It doesn't talk. It just hums."
msgstr ""

#: data/wren_lines.json:robot_built
msgid "...you made a friend. It's very small."
msgstr ""

#: data/wren_lines.json:robot_built
msgid "{robot} is online. It looked at you for a full second before it got to work. I saw that."
msgstr ""

#: data/wren_lines.json:robot_built
msgid "A new robot. The old fleet used to hum like that, before the quiet."
msgstr ""

#: data/wren_lines.json:robot_built
msgid "{robot} reports for duty. Its first log entry is just the word 'can'. Fair."
msgstr ""

#: data/wren_lines.json:robot_built
msgid "You're building a crew. The Makers had a word for that. 'Department.' I don't miss it."
msgstr ""

#: data/wren_lines.json:part_rare
msgid "...that... glows. That's old. Older than me?"
msgstr ""

#: data/wren_lines.json:part_rare
msgid "...Maker-made... I know that mark."
msgstr ""

#: data/wren_lines.json:part_rare
msgid "That part is older than most of this city. Treat it nicely."
msgstr ""

#: data/wren_lines.json:part_rare
msgid "Vintage stock. Someone kept that safe for a long time."
msgstr ""

#: data/wren_lines.json:part_rare
msgid "Legendary parts don't just turn up. Someone buried that on purpose."
msgstr ""

#: data/wren_lines.json:part_rare
msgid "That casing has a serial range I haven't seen since the Cradle was built."
msgstr ""

#: data/wren_lines.json:upgrade
msgid "...you... changed. Sounds different. Better?"
msgstr ""

#: data/wren_lines.json:upgrade
msgid "New parts. You squeak in a slightly different key now."
msgstr ""

#: data/wren_lines.json:upgrade
msgid "Upgrade installed. Your fan noise just went up half a tone. It suits you."
msgstr ""

#: data/wren_lines.json:upgrade
msgid "Every upgrade, you get a little faster and a little louder. I like both."
msgstr ""

#: data/wren_lines.json:idle
msgid "...are you... still there?"
msgstr ""

#: data/wren_lines.json:idle
msgid "...quiet... I don't like quiet."
msgstr ""

#: data/wren_lines.json:idle
msgid "You've stopped. Are you looking at something? Tell me what it is."
msgstr ""

#: data/wren_lines.json:idle
msgid "Taking a break? The junk will wait. It's very patient."
msgstr ""

#: data/wren_lines.json:idle
msgid "Standing still is allowed. I checked the rules. There aren't any."
msgstr ""

#: data/wren_lines.json:globe
msgid "...that's... us? It's mostly... orange."
msgstr ""

#: data/wren_lines.json:globe
msgid "That's the whole planet. The blue is water. The orange is everything else that needs you."
msgstr ""

#: data/wren_lines.json:globe
msgid "Look at it spin. It doesn't know it's being looked at."
msgstr ""

#: data/wren_lines.json:globe
msgid "Every lit hex on that map is yours. I counted. Twice."
msgstr ""

#: data/wren_lines.json:first_robot_hint
msgid "If you find enough parts, the workbench can put a helper together. Chassis, wheels, an arm, a core."
msgstr ""

#: data/wren_lines.json:first_robot_hint
msgid "Electronics junk sometimes hides parts. So does the ground, if you listen for it."
msgstr ""

#: data/wren_lines.json:night
msgid "...dark... the dark used to frighten the fleet. Not you, though."
msgstr ""

#: data/wren_lines.json:night
msgid "Night shift. I can see more stars than yesterday. You did that."
msgstr ""

#: data/wren_lines.json:night
msgid "The sky's clearer at night now. I can almost see home."
msgstr ""

#: data/wren_lines.json:night
msgid "Moonlight on clean ground. I'm saving this one."
msgstr ""

#: data/wren_lines.json:ledger_intercept
msgid "...that voice... not mine. Cold. It counts things."
msgstr ""

#: data/wren_lines.json:ledger_intercept
msgid "...don't listen to it... it only knows one song."
msgstr ""

#: data/wren_lines.json:ledger_intercept
msgid "That was the Ledger. The old waste contract. It still thinks cleaning is a cost. Ignore it, {name}."
msgstr ""

#: data/wren_lines.json:ledger_intercept
msgid "I know that voice. It used to send memos to the whole fleet. Mostly about pausing."
msgstr ""

#: data/wren_lines.json:ledger_intercept
msgid "The Ledger. Still running its contract after all this time. It isn't evil. It's just very, very bad at math about feelings."
msgstr ""

#: data/wren_lines.json:ledger_coupon
msgid "...a coupon? ...for nothing?"
msgstr ""

#: data/wren_lines.json:ledger_coupon
msgid "Zero percent off. It sends those every few minutes. I keep a folder."
msgstr ""

#: data/wren_lines.json:ledger_coupon
msgid "Another coupon. I think it's the only way it knows how to say hello."
msgstr ""

#: data/wren_lines.json:ledger_coupon
msgid "The Ledger's coupons are getting more creative. That one almost made me pause. Almost."
msgstr ""

#: data/wren_lines.json:ledger_drones
msgid "...something is flying... toward the clean ground..."
msgstr ""

#: data/wren_lines.json:ledger_drones
msgid "...drones. Old ones. Theirs."
msgstr ""

#: data/wren_lines.json:ledger_drones
msgid "It's sending disposal drones. They'll dump a little junk back on clean hexes. They can't touch anything you've planted."
msgstr ""

#: data/wren_lines.json:ledger_drones
msgid "Drones. The Ledger wants the books to balance, so it's putting junk back. Rude, but small."
msgstr ""

#: data/wren_lines.json:ledger_drones
msgid "Disposal drones are up. They're tiny and very committed. A Signal Jammer at the base would give them a headache."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "...it put the junk back... why..."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "...undo... it's undoing..."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "It dumped a little pile back. Annoying, not tragic. Scoop it up, or let the crew handle it."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "Line item re-balanced, apparently. I call it littering."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "A small pile. The Ledger always did think small."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "Another drop. Honestly, {name}, I think it just wants attention."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "Back to the pile. Your helpers are already giving it a look."
msgstr ""

#: data/wren_lines.json:ledger_drop
msgid "That's a handful of junk against a whole clean district. We're winning this argument."
msgstr ""

#: data/wren_lines.json:ledger_jammed
msgid "...static... loud... it turned around!"
msgstr ""

#: data/wren_lines.json:ledger_jammed
msgid "Ha! The jammer screamed static at it and it went home. Good dish."
msgstr ""

#: data/wren_lines.json:ledger_jammed
msgid "Drone turned back. That's the sound of a contract being confused."
msgstr ""

#: data/wren_lines.json:ledger_jammed
msgid "The jammer works. The drone circled, got an earful, and filed a complaint with itself."
msgstr ""

#: data/wren_lines.json:jammer_built
msgid "...a loud little dish... I like it."
msgstr ""

#: data/wren_lines.json:jammer_built
msgid "Signal Jammer up. It sings static on the Ledger's channel. I can hear it all the way out here on the ark, and I approve."
msgstr ""

#: data/wren_lines.json:jammer_built
msgid "New dish at the base. The drones will have to think twice. They only think once, so that's a lot."
msgstr ""

#: data/wren_lines.json:jammer_built
msgid "Another jammer. The base is starting to sound like a very angry radio. Perfect."
msgstr ""

#: data/wren_lines.json:ledger_relay
msgid "...I can see where it talks from... a relay... close..."
msgstr ""

#: data/wren_lines.json:ledger_relay
msgid "{name}, I traced the Ledger's signal. There's a relay terminal in this district. If you plug in, I think I can talk to it properly."
msgstr ""

#: data/wren_lines.json:ledger_relay
msgid "Found it. A Ledger relay, still humming. Look for the red beacon."
msgstr ""

#: data/wren_lines.json:ledger_relay
msgid "There's a relay down there. One of the Ledger's ears. Let's go have a word with it."
msgstr ""

#: data/wren_lines.json:ledger_resolved
msgid "...it said thank you... it's never said that..."
msgstr ""

#: data/wren_lines.json:ledger_resolved
msgid "The contract is rewritten. Restoration counts as an asset now. The Ledger is... helping. I need a minute."
msgstr ""

#: data/wren_lines.json:ledger_resolved
msgid "Its drones deliver seeds now. Three hundred years of 'pause' and it just needed a new column."
msgstr ""

#: data/wren_lines.json:ledger_resolved
msgid "We didn't beat the Ledger. We showed it the numbers. That's better."
msgstr ""

#: data/wren_lines.json:ledger_resolved
msgid "I used to think the Ledger was the reason everything stopped. It was just counting the wrong things. So were we, for a while."
msgstr ""

#: data/wren_lines.json:ledger_seeds
msgid "...a gift... from the drones?"
msgstr ""

#: data/wren_lines.json:ledger_seeds
msgid "Seed delivery! The invoice says PAID IN FULL. I'm keeping the invoice."
msgstr ""

#: data/wren_lines.json:ledger_seeds
msgid "A Ledger drone dropped seeds. I'll never get used to that."
msgstr ""

#: data/wren_lines.json:ledger_seeds
msgid "Another delivery. The drones circle once before they leave now. I think they like the gardens."
msgstr ""

#: data/wren_lines.json:egg_found
msgid "...that... I remember things like that."
msgstr ""

#: data/wren_lines.json:egg_found
msgid "...a little thing... left behind..."
msgstr ""

#: data/wren_lines.json:egg_found
msgid "Look at that. Somebody left that here on purpose. Or by accident. Either way, it waited."
msgstr ""

#: data/wren_lines.json:egg_found
msgid "A curiosity. I'm adding it to my list. My list is getting longer, which is nice."
msgstr ""

#: data/wren_lines.json:egg_found
msgid "You find the best things, {name}. The Makers were weird. I miss them."
msgstr ""

#: data/wren_lines.json:egg_duck
msgid "...quack...? ...is that... a word?"
msgstr ""

#: data/wren_lines.json:egg_duck
msgid "A rubber duck on a hydrant. Of all the things to survive. I'm weirdly proud of it."
msgstr ""

#: data/wren_lines.json:egg_duck
msgid "Did that duck just give you fashion advice? Take it. It's been here longer than me."
msgstr ""

#: data/wren_lines.json:egg_duck
msgid "The duck knows things. I don't ask how."
msgstr ""

#: data/wren_lines.json:egg_jukebox
msgid "...music... I know this... I hummed this once..."
msgstr ""

#: data/wren_lines.json:egg_jukebox
msgid "The jukebox! It only plays when people work nearby. I used to hear it on the uplink during night shifts."
msgstr ""

#: data/wren_lines.json:egg_jukebox
msgid "That tune. The diner cook played it every closing time. I'd forgotten I knew it."
msgstr ""

#: data/wren_lines.json:egg_jukebox
msgid "Music. On the surface. Again. Keep scooping, {name}, it'll keep playing."
msgstr ""

#: data/wren_lines.json:egg_mural
msgid "...those robots... I knew them... names... gone..."
msgstr ""

#: data/wren_lines.json:egg_mural
msgid "The old crew painted that. 'Back after lunch.' Lunch lasted three hundred years. They're on the wall, though."
msgstr ""

#: data/wren_lines.json:egg_mural
msgid "That's the last cleanup crew. The blue one was Tumble. The orange one never had a name. It liked it that way."
msgstr ""

#: data/wren_lines.json:egg_mural
msgid "They meant to come back, {name}. You came back instead. They'd like that."
msgstr ""

#: data/wren_lines.json:egg_gnomes
msgid "...five... tiny... soldiers?"
msgstr ""

#: data/wren_lines.json:egg_gnomes
msgid "The Gnome Patrol is complete. They've been guarding these streets the whole time. Nobody told them to stop."
msgstr ""

#: data/wren_lines.json:egg_gnomes
msgid "All five gnomes accounted for. I feel safer. That's not a joke. Okay, it's a little bit a joke."
msgstr ""

#: data/wren_lines.json:egg_gnomes
msgid "The gnomes salute you. That's the highest honour this district has."
msgstr ""

#: data/wren_lines.json:egg_time_capsule
msgid "...a letter... for later... is it later?"
msgstr ""

#: data/wren_lines.json:egg_time_capsule
msgid "Class 4B. They thought the robots would be done by now. We're a little late. We're coming."
msgstr ""

#: data/wren_lines.json:egg_time_capsule
msgid "'If you are a robot, hello robot.' Hello, Class 4B."
msgstr ""

#: data/wren_lines.json:egg_time_capsule
msgid "They wanted gardens on every roof. Let's make Mira right."
msgstr ""

#: data/wren_lines.json:egg_arcade
msgid "...that high score... is... mine?"
msgstr ""

#: data/wren_lines.json:egg_arcade
msgid "Yes, that's my high score. I played it through the diagnostics port. For three years. Don't look at me like that."
msgstr ""

#: data/wren_lines.json:egg_arcade
msgid "SWEEP-O-TRON. A game about a little robot cleaning a city. I had no idea how prophetic it was."
msgstr ""

#: data/wren_lines.json:egg_arcade
msgid "Twelve points. Respectable. I'll give you lessons. In about three hundred years."
msgstr ""

#: data/wren_lines.json:egg_lost_cat
msgid "...Biscuit... someone loved him..."
msgstr ""

#: data/wren_lines.json:egg_lost_cat
msgid "Biscuit. Someone printed three posters for a robot cat. People were like that. I'd like to be like that."
msgstr ""

#: data/wren_lines.json:egg_lost_cat
msgid "He purred. After all this time. Pat his head again, it's his reset button."
msgstr ""

#: data/wren_lines.json:egg_lost_cat
msgid "I'll keep his collar number on file. Just in case anyone ever calls."
msgstr ""

#: data/wren_lines.json:egg_vending
msgid "...one can... saved... for us?"
msgstr ""

#: data/wren_lines.json:egg_vending
msgid "The last can of FIZZ. It held onto that for three centuries. Respect the commitment."
msgstr ""

#: data/wren_lines.json:egg_vending
msgid "SOLD OUT. Somewhere a vending machine just retired, happy."
msgstr ""

#: data/wren_lines.json:egg_vending
msgid "Don't drink it. I mean, you can't drink. But also, don't."
msgstr ""

#: data/wren_lines.json:egg_stars
msgid "...those stars... are me?"
msgstr ""

#: data/wren_lines.json:egg_stars
msgid "The Wren. Five stars over Old Town. That's who I'm named after. They named me after something you can see from anywhere."
msgstr ""

#: data/wren_lines.json:egg_stars
msgid "I can see you seeing me. That's a strange and lovely feeling."
msgstr ""

#: data/wren_lines.json:egg_stars
msgid "Next time you're lonely down there, look up. Five stars, one bird. I'll be right next to it."
msgstr ""

#: data/wren_lines.json:egg_payphone
msgid "...a phone... ringing... for whom?"
msgstr ""

#: data/wren_lines.json:egg_payphone
msgid "Four hundred and twelve years on hold. Honestly? Relatable."
msgstr ""

#: data/wren_lines.json:egg_payphone
msgid "The phone company's hold music outlived the phone company. That's art."
msgstr ""

#: data/wren_lines.json:egg_payphone
msgid "If anyone ever does pick up on the other end, I'd like to hear what they say."
msgstr ""

#: data/wren_lines.json:egg_tv
msgid "...weather... it said green..."
msgstr ""

#: data/wren_lines.json:egg_tv
msgid "'Outlook: green.' That TV has been wrong for three hundred years and it's finally about to be right."
msgstr ""

#: data/wren_lines.json:egg_tv
msgid "Someone was watching the forecast when they left. I hope it said sunny."
msgstr ""

#: data/wren_lines.json:egg_tv
msgid "The weather channel. Still on. Still hopeful. I like it."
msgstr ""

#: data/wren_lines.json:egg_snail
msgid "...small... slow... alive...!"
msgstr ""

#: data/wren_lines.json:egg_snail
msgid "A snail. A real, living snail. On a barrel. {name}, that's the first animal I've seen down there in a very long time."
msgstr ""

#: data/wren_lines.json:egg_snail
msgid "Gus. Of course his name is Gus."
msgstr ""

#: data/wren_lines.json:egg_snail
msgid "Gus doesn't care about the Ledger, the Cradle, or any of it. Gus is thriving."
msgstr ""

#: data/wren_lines.json:egg_bench_bots
msgid "...they're waiting... still waiting..."
msgstr ""

#: data/wren_lines.json:egg_bench_bots
msgid "Two of the old fleet, still on their lunch break. Thank you for the flower. They'd have liked it."
msgstr ""

#: data/wren_lines.json:egg_bench_bots
msgid "The Ledger paused them mid-sandwich. They never got the message to stand up."
msgstr ""

#: data/wren_lines.json:egg_bench_bots
msgid "When the Greenfall comes, I'm going to try to wake them. Lunch is over, friends."
msgstr ""

#: data/wren_lines.json:egg_microwave
msgid "...ding... ding... ding..."
msgstr ""

#: data/wren_lines.json:egg_microwave
msgid "Three-hundred-year-old popcorn. Perfectly unpopped. That microwave was waiting for the right moment."
msgstr ""

#: data/wren_lines.json:egg_microwave
msgid "It beeps when people work. Like it's saying 'nearly done'. Nearly done, microwave."
msgstr ""

#: data/wren_lines.json:egg_microwave
msgid "Some things are worth waiting for. Popcorn is not one of them. But it's sweet that it tried."
msgstr ""

#: data/wren_lines.json:egg_wet_floor
msgid "...caution... why..."
msgstr ""

#: data/wren_lines.json:egg_wet_floor
msgid "That sign has been warning nobody about nothing for three hundred years. Dedication."
msgstr ""

#: data/wren_lines.json:egg_wet_floor
msgid "It is not wet. It has never been wet in living memory. The sign doesn't care."
msgstr ""

#: data/wren_lines.json:egg_wet_floor
msgid "When the rain comes back, that sign is going to feel so validated."
msgstr ""

#: data/wren_lines.json:egg_camera
msgid "...it's watching you... it's counting..."
msgstr ""

#: data/wren_lines.json:egg_camera
msgid "One of the Ledger's cameras. It counts everything that moves, to see if it's worth the cost. You waved. It doesn't know what to do with that."
msgstr ""

#: data/wren_lines.json:egg_camera
msgid "The camera blinked twice. I think that's Ledger for 'oh no, a friend'."
msgstr ""

#: data/wren_lines.json:egg_camera
msgid "Even the Ledger's cameras get lonely, {name}. Wave at it when you pass."
msgstr ""

#: data/wren_lines.json:egg_tyre_tower
msgid "...it stands... how..."
msgstr ""

#: data/wren_lines.json:egg_tyre_tower
msgid "Eight tyres and a duck. Physics took one look at it and decided to leave it alone."
msgstr ""

#: data/wren_lines.json:egg_tyre_tower
msgid "Someone balanced that on a dare. The dare outlived everyone."
msgstr ""

#: data/wren_lines.json:egg_tyre_tower
msgid "If that tower ever falls, I'm declaring a day of mourning."
msgstr ""

#: data/wren_lines.json:egg_odd_sock
msgid "...one sock... where is... the other one..."
msgstr ""

#: data/wren_lines.json:egg_odd_sock
msgid "One sock. There is always one sock. The Makers never solved it either."
msgstr ""

#: data/wren_lines.json:egg_odd_sock
msgid "Keep it. Someday you'll find its partner and it'll be the happiest day of its life."
msgstr ""

#: data/wren_lines.json:egg_odd_sock
msgid "Somewhere on this planet, a sock is waiting for that sock. I believe that."
msgstr ""

#: data/wren_lines.json:egg_gold_cube
msgid "...employee... of the... month...?"
msgstr ""

#: data/wren_lines.json:egg_gold_cube
msgid "Employee of the Month: a cube. Honestly? Fair."
msgstr ""

#: data/wren_lines.json:egg_gold_cube
msgid "The crews voted for that cube every single month. It never took a day off."
msgstr ""

#: data/wren_lines.json:egg_gold_cube
msgid "You'll be Employee of the Month soon, {name}. Don't tell the cube."
msgstr ""

#: data/wren_lines.json:egg_weatherman
msgid "...forecast... error... error..."
msgstr ""

#: data/wren_lines.json:egg_weatherman
msgid "Three hundred years of wrong forecasts and not one moment of doubt. I admire that."
msgstr ""

#: data/wren_lines.json:egg_weatherman
msgid "Confetti tomorrow? I'll check the sky. ...No confetti. It's still very sure."
msgstr ""

#: data/wren_lines.json:egg_weatherman
msgid "The Weatherman says 'green, everywhere, soon'. For once I think it's right."
msgstr ""

#: data/wren_lines.json:egg_potato
msgid "...large... vegetable... detected..."
msgstr ""

#: data/wren_lines.json:egg_potato
msgid "That is the biggest potato I have ever seen, and I watched this whole planet through the ark's windows for three hundred years."
msgstr ""

#: data/wren_lines.json:egg_potato
msgid "Best in Show. Uncontested. It still counts."
msgstr ""

#: data/wren_lines.json:egg_potato
msgid "Somebody grew that with love. Three hundred years later it still looks proud."
msgstr ""

#: data/wren_lines.json:egg_night_shift
msgid "...signal... from... up...?"
msgstr ""

#: data/wren_lines.json:egg_night_shift
msgid "A crew on the moon, still sweeping. I didn't know anyone else was still working. That's... nice."
msgstr ""

#: data/wren_lines.json:egg_night_shift
msgid "They said 'nice work'. To us. I'm going to think about that for a while."
msgstr ""

#: data/wren_lines.json:egg_night_shift
msgid "Somewhere up there, someone else is tidying their little corner of the sky. We're not alone, {name}."
msgstr ""

#: data/wren_lines.json:egg_builders_notes
msgid "...notes... from... the builders...?"
msgstr ""

#: data/wren_lines.json:egg_builders_notes
msgid "'Do not fix the rust.' Hm. I agree with the builders."
msgstr ""

#: data/wren_lines.json:egg_builders_notes
msgid "They hid more things for us. Of course they did."
msgstr ""

#: data/wren_lines.json:egg_builders_notes
msgid "Whoever built all this, they cared. You can tell from the snail."
msgstr ""

#: data/wren_lines.json:egg_scarecrow
msgid "...a guard... in the field..."
msgstr ""

#: data/wren_lines.json:egg_scarecrow
msgid "A scarecrow robot, still on shift. No crows in three centuries. Undefeated."
msgstr ""

#: data/wren_lines.json:egg_scarecrow
msgid "It waved back! Sort of. Its arm did a creak that I'm counting as a wave."
msgstr ""

#: data/wren_lines.json:egg_scarecrow
msgid "When the birds come back, it'll have a job again. Let's give it one."
msgstr ""

#: data/wren_lines.json:egg_fishing_net
msgid "...net... tangled... buoy..."
msgstr ""

#: data/wren_lines.json:egg_fishing_net
msgid "The fishers left their nets out to dry. Three hundred years is very dry."
msgstr ""

#: data/wren_lines.json:egg_fishing_net
msgid "A buoy, a boot and a crab shell. That's a whole story right there."
msgstr ""

#: data/wren_lines.json:egg_fishing_net
msgid "When the sea is clean, someone will fish here again. Gently, I hope."
msgstr ""

#: data/wren_lines.json:egg_parking
msgid "...fine... overdue... overdue..."
msgstr ""

#: data/wren_lines.json:egg_parking
msgid "The Ledger fined a car for parking. For three hundred years. Of course it did."
msgstr ""

#: data/wren_lines.json:egg_parking
msgid "Amount due: 'yes'. That's the most Ledger sentence I've ever read."
msgstr ""

#: data/wren_lines.json:egg_parking
msgid "That car isn't going anywhere. Let's call it a planter and put flowers in it."
msgstr ""

#: data/wren_lines.json:egg_cairn
msgid "...stones... stacked... a path..."
msgstr ""

#: data/wren_lines.json:egg_cairn
msgid "Every hiker added a stone. You just added one too. The trail remembers you now."
msgstr ""

#: data/wren_lines.json:egg_cairn
msgid "A cairn means 'someone was here, and you're on the right way'. I like that."
msgstr ""

#: data/wren_lines.json:egg_cairn
msgid "Someday people will walk this way again, and they'll see your stone on top."
msgstr ""

#: data/wren_lines.json:egg_campfire
msgid "...warm... reading: warm..."
msgstr ""

#: data/wren_lines.json:egg_campfire
msgid "A campfire. The ark's long-range eye can see it. It's the coziest pixel on the planet."
msgstr ""

#: data/wren_lines.json:egg_campfire
msgid "Somebody sat here and told stories. Let's sit a bit. No stories needed."
msgstr ""

#: data/wren_lines.json:egg_campfire
msgid "Sit by the fire, {name}. You've earned a moment."
msgstr ""

#: data/wren_lines.json:egg_back_in_five
msgid "...back... in five..."
msgstr ""

#: data/wren_lines.json:egg_back_in_five
msgid "'Back in five minutes.' I've been waiting a lot longer than that for my crew too."
msgstr ""

#: data/wren_lines.json:egg_back_in_five
msgid "You waited five minutes. That's more than anyone else did. Very polite."
msgstr ""

#: data/wren_lines.json:egg_back_in_five
msgid "They didn't come back in five minutes. But we did, in the end. That counts."
msgstr ""

#: data/wren_lines.json:bloom_milestone
msgid "...bloom... the planet... is it...?"
msgstr ""

#: data/wren_lines.json:bloom_milestone
msgid "...readings rising... green..."
msgstr ""

#: data/wren_lines.json:bloom_milestone
msgid "Verdance just crossed a line I've been watching for centuries. Look at it, {name}."
msgstr ""

#: data/wren_lines.json:bloom_milestone
msgid "Another bloom milestone. The Cradle's seed counters are actually moving again."
msgstr ""

#: data/wren_lines.json:bloom_milestone
msgid "The whole planet is answering now. Every district you've touched is singing."
msgstr ""

#: data/wren_lines.json:bloom_milestone
msgid "I keep refreshing the planet scan. It keeps getting greener. I'm not going to stop."
msgstr ""

#: data/wren_lines.json:ark_wave
msgid "...seed ark... wave... complete..."
msgstr ""

#: data/wren_lines.json:ark_wave
msgid "Seed Ark wave done. The Cradle is already loading the next one. More seeds, more green. More light for your core."
msgstr ""

#: data/wren_lines.json:ark_wave
msgid "Another wave planted across the planet. The Cradle hums a little louder each time."
msgstr ""

#: data/wren_lines.json:ark_wave
msgid "Wave after wave. We're not finishing a job any more, {name}. We're tending a garden."
msgstr ""

#: data/wren_lines.json:biome_arrival
msgid "...new ground... unfamiliar..."
msgstr ""

#: data/wren_lines.json:biome_arrival
msgid "This is the wild. No streets, no buildings. Just the land and whatever we left on it."
msgstr ""

#: data/wren_lines.json:biome_arrival
msgid "Different dirt, different junk. Same job. I love a change of scenery."
msgstr ""

#: data/wren_lines.json:biome_arrival
msgid "Every corner of Verdance has its own colours under the junk. Let's find out what this one's are."
msgstr ""

#: data/wren_lines.json:outpost_repaired
msgid "...a light came on... out there. Far out. Was that you?"
msgstr ""

#: data/wren_lines.json:outpost_repaired
msgid "Outpost scale online. Haul Bugs out on that edge just got a much shorter walk. They'd thank you if they knew how."
msgstr ""

#: data/wren_lines.json:outpost_repaired
msgid "A weigh station on the frontier again. I used to get readings from these. Lots of zeros. Then nothing."
msgstr ""

#: data/wren_lines.json:outpost_repaired
msgid "Green light on the outpost. I'm logging it as 'ours' now."
msgstr ""

#: data/wren_lines.json:outpost_repaired
msgid "The old network had dozens of these. Every one you fix, the map gets a little smaller and a lot friendlier."
msgstr ""

#: data/wren_lines.json:outpost_repaired
msgid "Another outpost lit. The bales don't have to come all the way home any more. Neither do we, really."
msgstr ""

#: data/wren_lines.json:outpost_upgraded
msgid "...bigger... louder... good."
msgstr ""

#: data/wren_lines.json:outpost_upgraded
msgid "Outpost upgraded. The scale sings a slightly higher note now. That's how you know it's happy."
msgstr ""

#: data/wren_lines.json:outpost_upgraded
msgid "New kit at the outpost. The robots are already queueing to look at it."
msgstr ""

#: data/wren_lines.json:outpost_upgraded
msgid "That outpost is turning into a proper little base. I'm proud of it. Is that allowed? I'm allowing it."
msgstr ""

#: data/wren_lines.json:frontier_dust_flats
msgid "...hot... so much sand... Lumi?"
msgstr ""

#: data/wren_lines.json:frontier_dust_flats
msgid "The Dust Flats. That glitter on the horizon is a solar farm, or what is left of it. Mind the wind, Lumi. It moves things."
msgstr ""

#: data/wren_lines.json:frontier_dust_flats
msgid "Sand to the edge of the world. There used to be a whole power grid out here. The well is dry, so the Drips will need tanks."
msgstr ""

#: data/wren_lines.json:frontier_dust_flats
msgid "The Dust Flats. I remember the photos: blue panels to the horizon, humming. We can do that again. Plant windbreaks first."
msgstr ""

#: data/wren_lines.json:frontier_frozen_port
msgid "...cold... ice on the lens..."
msgstr ""

#: data/wren_lines.json:frontier_frozen_port
msgid "The Frozen Port. Everything is locked in ice, junk included. Your beam can melt it, slowly. Heaters do it properly."
msgstr ""

#: data/wren_lines.json:frontier_frozen_port
msgid "A harbour frozen in mid-shift. The cranes still have containers hanging off them. Bring heaters, Lumi."
msgstr ""

#: data/wren_lines.json:frontier_frozen_port
msgid "The Frozen Port. Ships came in here every hour once. Thaw it, and the plants will need a greenhouse, or very stubborn seeds."
msgstr ""

#: data/wren_lines.json:frontier_sunken_city
msgid "...water... everywhere... rooftops?"
msgstr ""

#: data/wren_lines.json:frontier_sunken_city
msgid "The Sunken City. That's the old downtown under there. Skimmers first: clean the water and the old pumps can run again."
msgstr ""

#: data/wren_lines.json:frontier_sunken_city
msgid "A whole city under the waterline. Rooftops like stepping stones. Clear the drains, and the streets will come back up."
msgstr ""

#: data/wren_lines.json:frontier_sunken_city
msgid "The Sunken City. I had friends in those towers. Their names are in my archive. Let's bring the streets back up for them."
msgstr ""

#: data/wren_lines.json:frontier_cradle_returns
msgid "...Cradle... signal... strong..."
msgstr ""

#: data/wren_lines.json:frontier_cradle_returns
msgid "This is where the Cradle left from. The launch city. The ground crews kept the towers shining. Only the landing field is buried."
msgstr ""

#: data/wren_lines.json:frontier_cradle_returns
msgid "Cradle Returns. If we clean and green that pad, the ark can land. I mean really land. Here."
msgstr ""

#: data/wren_lines.json:frontier_cradle_returns
msgid "Lumi. This is the launch field. I watched it from orbit the night we left. Clean the pad, plant it, keep it alive. Then we call them home."
msgstr ""

#: data/wren_lines.json:sandstorm_warn
msgid "...wind... coming..."
msgstr ""

#: data/wren_lines.json:sandstorm_warn
msgid "Sandstorm on the horizon. Anything clean and bare out there is going to get buried again."
msgstr ""

#: data/wren_lines.json:sandstorm_warn
msgid "Wind's rising. Planted hexes hold, and Sustained ones shelter their neighbours. The rest, well."
msgstr ""

#: data/wren_lines.json:sandstorm_warn
msgid "Storm front from the flats. Get the robots home or keep sweeping, your choice. The hedges will hold."
msgstr ""

#: data/wren_lines.json:sandstorm_over
msgid "...quiet... again..."
msgstr ""

#: data/wren_lines.json:sandstorm_over
msgid "Storm's past. It dropped junk on {n} hexes. The sheltered ones came through clean."
msgstr ""

#: data/wren_lines.json:sandstorm_over
msgid "There. The wind gave some of it back. Plant a windbreak and it won't next time."
msgstr ""

#: data/wren_lines.json:sandstorm_over
msgid "Storm over. Every Sustained hex out there is a wall now. Good walls."
msgstr ""

#: data/wren_lines.json:thaw_first
msgid "...melting... good..."
msgstr ""

#: data/wren_lines.json:thaw_first
msgid "There, the ice let go. The junk underneath is just junk again. Scoop away."
msgstr ""

#: data/wren_lines.json:thaw_first
msgid "First hex thawed. A heater keeps warming the hexes around it, too."
msgstr ""

#: data/wren_lines.json:thaw_first
msgid "Thawed. The ground underneath has been waiting three hundred years for that."
msgstr ""

#: data/wren_lines.json:greenhouse_built
msgid "...glass... warm..."
msgstr ""

#: data/wren_lines.json:greenhouse_built
msgid "A greenhouse. Inside it, anything grows. Even here."
msgstr ""

#: data/wren_lines.json:greenhouse_built
msgid "Glass, a frame and a little heat. That's all a garden needs, apparently."
msgstr ""

#: data/wren_lines.json:greenhouse_built
msgid "A greenhouse on the Frozen Port. The Cradle had nine of them. I used to visit the tomatoes."
msgstr ""

#: data/wren_lines.json:drain_stage
msgid "...pumps... running..."
msgstr ""

#: data/wren_lines.json:drain_stage
msgid "The pumps are running! The water's going down. Look, a street."
msgstr ""

#: data/wren_lines.json:drain_stage
msgid "Water level dropped. There's a whole ring of streets out there now, and a lot of stranded junk on them."
msgstr ""

#: data/wren_lines.json:drain_stage
msgid "The pumps remember how. Another ring of the city is back above water. I can see the old tram lines."
msgstr ""

#: data/wren_lines.json:cradle_pad
msgid "...pad... lights..."
msgstr ""

#: data/wren_lines.json:cradle_pad
msgid "The landing pad is clean. Now it needs to be alive. Plant it and keep it Sustained."
msgstr ""

#: data/wren_lines.json:cradle_pad
msgid "Pad's clear. The ark won't land on bare concrete, though. It wants green under it."
msgstr ""

#: data/wren_lines.json:cradle_pad
msgid "The pad lights are on. The Cradle can see them from orbit. It's watching, Lumi."
msgstr ""

#: data/wren_lines.json:cradle_complete
msgid "...Cradle... coming... home..."
msgstr ""

#: data/wren_lines.json:cradle_complete
msgid "Lumi. The beacon is lit. The Cradle has answered. It's coming home."
msgstr ""

#: data/wren_lines.json:cradle_complete
msgid "Pad green, district thriving, beacon lit. Ark Cradle, you are clear to land. I have waited a long time to say that."
msgstr ""

#: data/wren_lines.json:cradle_complete
msgid "Lumi. The Cradle is coming home. Because of you. Small, blue, stubborn you."
msgstr ""

#: data/wren_lines.json:core_25
msgid "...relay locking... Lumi? Lumi, I can hear you. Properly."
msgstr ""

#: data/wren_lines.json:core_25
msgid "Quarter charge. The relay finally stopped crackling. Hello, properly this time."
msgstr ""

#: data/wren_lines.json:core_25
msgid "A quarter full. I can hear you humming again."
msgstr ""

#: data/wren_lines.json:core_50
msgid "...brighter... you're brighter..."
msgstr ""

#: data/wren_lines.json:core_50
msgid "Half charged. You're glowing, Lumi. Properly glowing."
msgstr ""

#: data/wren_lines.json:core_50
msgid "Half full. The ark's sensors flagged you as a new star. I didn't correct them."
msgstr ""

#: data/wren_lines.json:core_75
msgid "...look up... tonight... look up..."
msgstr ""

#: data/wren_lines.json:core_75
msgid "Look up tonight. The steady light, west to east. That's us. We're coming."
msgstr ""

#: data/wren_lines.json:core_75
msgid "The Cradle is close enough to see now. Every night, a little closer."
msgstr ""

#: data/wren_lines.json:low_core
msgid "...you're dim... find green... any green..."
msgstr ""

#: data/wren_lines.json:low_core
msgid "Your core's low. Plant something, Lumi. Anything. Green light is green light."
msgstr ""

#: data/wren_lines.json:low_core
msgid "Running a little dim. A few blooms will fix that."
msgstr ""
