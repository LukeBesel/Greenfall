msgstr "研究を1件完了する"

#: data/goals.json:goals[bales_20].text
msgid "Robots press 20 bales"
msgstr "ロボットがベールを20個圧縮"

#: data/goals.json:goals[hex_12].text
msgid "Clean 12 hexes"
msgstr "ヘックスを12個片づける"

#: data/goals.json:goals[hexlv_2].text
msgid "Get a hex to Planted"
msgstr "ヘックスを「植え付け済み」にする"

#: data/goals.json:goals[hex_15].text
msgid "Clean 15 hexes"
msgstr "ヘックスを15個片づける"

#: data/goals.json:goals[hex_17].text
msgid "Clean 17 hexes"
msgstr "ヘックスを17個片づける"

#: data/goals.json:goals[hex_20].text data/objectives.json:objectives[hex20].text
msgid "Clean 20 hexes"
msgstr "ヘックスを20個片づける"

#: data/goals.json:goals[base_3].text
msgid "Upgrade the base to level 3"
msgstr "基地をレベル3にする"

#: data/goals.json:goals[seedling_1].text
msgid "Build a Seedling planter"
msgstr "Seedling の植え付けロボを作る"

#: data/goals.json:goals[hub_fly_5].text data/goals.json:goals[hub_fly_6].text data/objectives.json:objectives[hub_fly_2].text
#: data/objectives.json:objectives[hub_fly_3].text data/objectives.json:objectives[hub_fly_4].text
msgid "Fly to the next station"
msgstr "次のステーションへ飛ぼう"

#: data/goals.json:goals[hub_wake_5].text
msgid "Wake station 5 of 6"
msgstr "ステーション5/6を目覚めさせよう"

#: data/goals.json:goals[plant_25].text
msgid "Plant 25 seeds"
msgstr "種を25個植える"

#: data/goals.json:goals[rocket_tier_3].text
msgid "Upgrade the rocket to Mk III"
msgstr "ロケットをMk IIIに強化しよう"

#: data/goals.json:goals[drip_1].text
msgid "Build a Drip watering robot"
msgstr "Drip 水やりロボを作る"

#: data/goals.json:goals[hub_wake_6].text
msgid "Wake station 6 of 6"
msgstr "ステーション6/6を目覚めさせよう"

#: data/goals.json:goals[home_drive_5].text
msgid "Build the Mk V Orbital drive"
msgstr "Mk V オービタル推進を造る"

#: data/goals.json:goals[home_land_1].text
msgid "Fly to another planet"
msgstr "別の惑星へ飛ぶ"

#: data/goals.json:goals[perfect_1].text
msgid "Make a perfect bale"
msgstr "パーフェクトベールを作る"

#: data/goals.json:goals[compartment_3].text
msgid "Chest Size level 3"
msgstr "胸のサイズをレベル3に"

#: data/goals.json:goals[shards_1].text
msgid "Find a memory shard"
msgstr "メモリーの破片を見つける"

#: data/goals.json:goals[parts_2].text
msgid "Dig up 2 robot parts"
msgstr "ロボットのパーツを2個掘り出す"

#: data/goals.json:goals[lift_2].text
msgid "Lift Strength level 2"
msgstr "リフト力をレベル2に"

#: data/goals.json:goals[upgrades_12].text
msgid "Buy 12 upgrades"
msgstr "アップグレードを12個買う"

#: data/goals.json:goals[pet_cat].text
msgid "Pet a stray cat"
msgstr "ノラネコをなでる"

#: data/goals.json:goals[research_4].text
msgid "Finish 4 research projects"
msgstr "研究を4件完了する"

#: data/goals.json:goals[upgrades_20].text
msgid "Buy 20 upgrades"
msgstr "アップグレードを20個買う"

#: data/goals.json:goals[scoopie_2].text
msgid "Run 2 Scoopies"
msgstr "Scoopie を2台動かす"

#: data/goals.json:goals[upgrades_25].text
msgid "Buy 25 upgrades"
msgstr "アップグレードを25個買う"

