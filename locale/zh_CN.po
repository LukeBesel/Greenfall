#: data/codex.json:categories[junk].name data/hex_levels.json:levels[0].name
msgid "Junk"
msgstr ""

#: data/codex.json:categories[plants].name
msgid "Plants"
msgstr ""

#: data/codex.json:categories[shards].name
msgid "Memory Shards"
msgstr ""

#: data/codex.json:categories[landmarks].name
msgid "Landmarks"
msgstr ""

#: data/codex.json:categories[frontiers].name
msgid "Frontiers"
msgstr ""

#: data/codex.json:junk.metal.hint
msgid "Rusty, clanky, everywhere."
msgstr ""

#: data/codex.json:junk.metal.desc
msgid "Cans, tins and bent brackets. Most of it was made to last, and it did. Pressed into bales, it can be rolled and stamped into something useful again."
msgstr ""

#: data/codex.json:junk.plastic.hint
msgid "Bright colours that never faded."
msgstr ""

#: data/codex.json:junk.plastic.desc
msgid "Bottles, crates and the occasional chair. It outlived the people who bought it. It weighs almost nothing, and still the ground under it stayed bare."
msgstr ""

#: data/codex.json:junk.glass.hint
msgid "It glints in the dust."
msgstr ""

#: data/codex.json:junk.glass.desc
msgid "Jugs and wine bottles, a few still corked. Sorted by colour, glass melts down beautifully. Lumi likes how the light comes through it."
msgstr ""

#: data/codex.json:junk.rubber.hint
msgid "Squeaky. Bouncy. Sad."
msgstr ""

#: data/codex.json:junk.rubber.desc
msgid "Tyres, boots and one very patient rubber duck. Rubber holds water, and water holds mosquitoes. Clearing it makes room for frogs."
msgstr ""

#: data/codex.json:junk.electronics.hint
msgid "It might still remember something."
msgstr ""

#: data/codex.json:junk.electronics.desc
msgid "Laptops, radios and televisions with nothing left to say. Inside are tiny useful parts. Lumi keeps the good ones for new friends."
msgstr ""

#: data/codex.json:junk.paper.hint
msgid "Soft, and slowly going back to soil."
msgstr ""

#: data/codex.json:junk.paper.desc
msgid "Cardboard boxes, bags and old gloves. Paper is the one kind of junk that is already trying to become soil. Lumi helps it along."
msgstr ""

#: data/codex.json:plants.grass.name
msgid "Meadow Grass"
msgstr ""

#: data/codex.json:plants.grass.hint
msgid "Plant your first seeds."
msgstr ""

#: data/codex.json:plants.grass.desc
msgid "The first thing to come back, always. Its roots knit the loose dust together so other plants have something to hold on to."
msgstr ""

#: data/codex.json:plants.grass2.name
msgid "Tufted Grass"
msgstr ""

#: data/codex.json:plants.grass2.hint
msgid "Keep planting."
msgstr ""

#: data/codex.json:plants.grass2.desc
msgid "A slightly scruffier cousin. It grows in clumps, and small beetles like to live between them."
msgstr ""

#: data/codex.json:plants.celandine.name
msgid "Celandine"
msgstr ""

#: data/codex.json:plants.celandine.hint
msgid "A little yellow star."
msgstr ""

#: data/codex.json:plants.celandine.desc
msgid "Glossy yellow petals that open in the sun and close when clouds pass. Bees find it before they find anything else."
msgstr ""

#: data/codex.json:plants.gazania.name
msgid "Gazania"
msgstr ""

#: data/codex.json:plants.gazania.hint
msgid "Bold stripes, big smile."
msgstr ""

#: data/codex.json:plants.gazania.desc
msgid "A tough little sun-lover with striped petals. It does not mind poor soil. It seems to enjoy proving people wrong."
msgstr ""

#: data/codex.json:plants.heliophila.name
msgid "Heliophila"
msgstr ""

#: data/codex.json:plants.heliophila.hint
msgid "The first flower you ever saw here."
msgstr ""

#: data/codex.json:plants.heliophila.desc
msgid "Small blue flowers that turn to follow the light. One grew beside a crushed can before anyone helped it. That is where this all began."
msgstr ""

#: data/codex.json:plants.dandelion.name
msgid "Dandelion"
msgstr ""

#: data/codex.json:plants.dandelion.hint
msgid "Make a wish."
msgstr ""

#: data/codex.json:plants.dandelion.desc
msgid "Golden today, a puff of wishes tomorrow. Each seed rides the wind to a new patch of clean ground. It plants itself, if you let it."
msgstr ""

#: data/codex.json:plants.fern.name
msgid "Fern"
msgstr ""

#: data/codex.json:plants.fern.hint
msgid "Shade-lover."
msgstr ""

#: data/codex.json:plants.fern.desc
msgid "Fronds that unroll like slow fireworks. Ferns are very old. They have come back from worse than this."
msgstr ""

#: data/codex.json:plants.shrub.name
msgid "Shrub"
msgstr ""

#: data/codex.json:plants.shrub.hint
msgid "Something bigger."
msgstr ""

#: data/codex.json:plants.shrub.desc
msgid "A low woody bush. Birds will notice it before you do. Shrubs are how a meadow starts thinking about becoming a wood."
msgstr ""

#: data/codex.json:plants.nettle.name
msgid "Nettle"
msgstr ""

#: data/codex.json:plants.nettle.hint
msgid "Needs Hardy Nettles research."
msgstr ""

#: data/codex.json:plants.nettle.desc
msgid "Stingy, stubborn and wonderful. Nettles pull nutrients up from deep down, and caterpillars adore them."
msgstr ""

#: data/codex.json:plants.mint.name data/research.json:nodes[wild_mint].name
msgid "Wild Mint"
msgstr ""

#: data/codex.json:plants.mint.hint
msgid "Needs Wild Mint research."
msgstr ""

#: data/codex.json:plants.mint.desc
msgid "Crush a leaf and the whole hex smells fresh. Mint spreads quickly. Nobody minds."
msgstr ""

#: data/codex.json:plants.hedge.name
msgid "Hedgerow"
msgstr ""

#: data/codex.json:plants.hedge.hint
msgid "Needs Hedgerows research."
msgstr ""

#: data/codex.json:plants.hedge.desc
msgid "A dense green wall, alive with small rustlings. Hedges are highways for hedgehogs, and hotels for wrens."
msgstr ""

#: data/codex.json:plants.pine.name
msgid "Pine Sapling"
msgstr ""

#: data/codex.json:plants.pine.hint
msgid "Needs Evergreen Saplings research."
msgstr ""

#: data/codex.json:plants.pine.desc
msgid "Knee-high today. In a hundred years, a forest that smells of resin and rain. Lumi plants it carefully, for whoever comes after."
msgstr ""

#: data/codex.json:plants.iceplant.name
msgid "Crystalline Iceplant"
msgstr ""

#: data/codex.json:plants.iceplant.hint data/codex.json:plants.rooibos.hint data/codex.json:plants.ursinia.hint
msgid "Plant in the Dust Flats."
msgstr ""

#: data/codex.json:plants.iceplant.desc
msgid "A desert succulent whose leaves are covered in tiny glassy blisters that store water. It glitters at noon and needs almost nothing to drink."
msgstr ""

#: data/codex.json:plants.rooibos.name
msgid "Wild Rooibos"
msgstr ""

#: data/codex.json:plants.rooibos.desc
msgid "A needle-leafed bush that turns rusty red in the heat. Its roots go down further than you would believe. It holds the sand in place."
msgstr ""

#: data/codex.json:plants.ursinia.name
msgid "Ursinia"
msgstr ""

#: data/codex.json:plants.ursinia.desc
msgid "A bright orange desert daisy. After the first rain in years, whole slopes of them opened at once, and the Cradle's old cameras saw it from orbit."
msgstr ""

#: data/codex.json:plants.periwinkle.name
msgid "Periwinkle"
msgstr ""

#: data/codex.json:plants.periwinkle.hint data/codex.json:plants.frost_moss.hint
msgid "A cold-hardy seed for the Frozen Port."
msgstr ""

#: data/codex.json:plants.periwinkle.desc
msgid "An evergreen groundcover with violet flowers. It keeps its leaves under snow and simply carries on in spring."
msgstr ""

#: data/codex.json:plants.frost_moss.name
msgid "Frost Moss"
msgstr ""

#: data/codex.json:plants.frost_moss.desc
msgid "A tight green cushion that grows on cold stone. It is slow, but it survives what nothing else does, and it makes soil where there was none."
msgstr ""

#: data/codex.json:plants.reed.name
msgid "Marsh Reed"
msgstr ""

#: data/codex.json:plants.reed.hint
msgid "Plant on the drained streets of the Sunken City."
msgstr ""

#: data/codex.json:plants.reed.desc
msgid "Tall reeds that drink the silt dry and filter the last of the floodwater. Little birds sit on them and complain about the wind."
msgstr ""

#: data/codex.json:plants.marsh_mint.name
msgid "Marsh Mint"
msgstr ""

#: data/codex.json:plants.marsh_mint.hint
msgid "Plant in the Sunken City."
msgstr ""

#: data/codex.json:plants.marsh_mint.desc
msgid "Mint that does not mind wet feet. The drained streets smell of it on warm evenings."
msgstr ""

#: data/codex.json:robots.scoopie.hint data/codex.json:robots.haulbug.hint
msgid "Build one at the workbench."
msgstr ""

#: data/codex.json:robots.scoopie.desc
msgid "A small, earnest cleaner with one scoop arm and a lot of enthusiasm. It hums when it finds a good pile."
msgstr ""

#: data/codex.json:robots.haulbug.desc
msgid "A fork cart that never complains. It carries loose bales to the scale and parks itself neatly afterwards."
msgstr ""

#: data/codex.json:robots.seedling.hint
msgid "Research the Seedling Blueprint."
msgstr ""

#: data/codex.json:robots.seedling.desc
msgid "A planter bot with a seed hopper on its back. It pats every seed into the soil, twice, just to be sure."
msgstr ""

#: data/codex.json:robots.drip.hint
msgid "Research the Drip Blueprint."
msgstr ""

#: data/codex.json:robots.drip.desc
msgid "A watering bot with a sloshy tank. It makes a little happy gurgle when a plant drinks."
msgstr ""

#: data/codex.json:robots.multibot.hint
msgid "Research the Multibot Blueprint."
msgstr ""

#: data/codex.json:robots.multibot.desc
msgid "A helper that can clean, plant or water. Not the fastest at anything, but always where it is needed."
msgstr ""

#: data/codex.json:robots.skimmer.hint
msgid "Build a Skimmer."
msgstr ""

#: data/codex.json:robots.skimmer.desc
msgid "A little raft robot with a net and a rubber duck for luck. It drifts across the lakes fishing out bottles, and leaves neat bales on the shore."
msgstr ""

#: data/codex.json:shards.back_soon.desc
msgid "A hand-lettered sign from a bakery. Marta promised to be back soon."
msgstr ""

#: data/codex.json:shards.kid_drawing.desc
msgid "A crayon drawing, folded small enough to fit a pocket."
msgstr ""

#: data/codex.json:shards.gardener_list.desc
msgid "Someone's to-do list for a garden. Half the items are ticked."
msgstr ""

#: data/codex.json:shards.receipt.desc
msgid "A till receipt from the last ordinary day."
msgstr ""

#: data/codex.json:shards.maint_log.desc
msgid "A maintenance log for a unit that looked a lot like Lumi."
msgstr ""

#: data/codex.json:shards.ledger_memo.desc
msgid "An office memo about the evacuation. Very polite. Very tired."
msgstr ""

#: data/codex.json:shards.voicemail.desc
msgid "A voicemail transcript. Someone was calling to say they were safe."
msgstr ""

#: data/codex.json:shards.poster.desc
msgid "A faded safety poster. The smiling robot on it is waving."
msgstr ""

#: data/codex.json:landmarks.covered_car.name
msgid "Covered Car"
msgstr ""

#: data/codex.json:landmarks.covered_car.hint
msgid "Under a tarp, waiting."
msgstr ""

#: data/codex.json:landmarks.covered_car.desc
msgid "Somebody covered it carefully before they left, as if they meant to come back for it. The tarp has held for a very long time."
msgstr ""

#: data/codex.json:landmarks.concrete_road_barrier.name
msgid "Road Barrier"
msgstr ""

#: data/codex.json:landmarks.concrete_road_barrier.hint
msgid "Grey and heavy."
msgstr ""

#: data/codex.json:landmarks.concrete_road_barrier.desc
msgid "Once it told traffic where to go. Now moss is slowly telling it where to stay."
msgstr ""

#: data/codex.json:landmarks.exterior_aircon_unit.name
msgid "Air Conditioner"
msgstr ""

#: data/codex.json:landmarks.exterior_aircon_unit.hint
msgid "It used to hum."
msgstr ""

#: data/codex.json:landmarks.exterior_aircon_unit.desc
msgid "An old outdoor unit with a rusted fan. Small birds have started nesting behind the grille."
msgstr ""

#: data/codex.json:landmarks.electric_stove.name
msgid "Abandoned Stove"
msgstr ""

#: data/codex.json:landmarks.electric_stove.hint
msgid "A kitchen, without the kitchen."
msgstr ""

#: data/codex.json:landmarks.electric_stove.desc
msgid "Someone carried it this far and then set it down. Its oven door still opens with a cheerful squeak."
msgstr ""

#: data/codex.json:landmarks.Barrel_01.name
msgid "Old Barrel"
msgstr ""

#: data/codex.json:landmarks.Barrel_01.hint
msgid "Dented and rusty."
msgstr ""

#: data/codex.json:landmarks.Barrel_01.desc
msgid "Empty now, thankfully. Turned on its side it makes a decent shelter for a fox."
msgstr ""

#: data/codex.json:landmarks.metal_trash_can.name
msgid "Trash Can"
msgstr ""

#: data/codex.json:landmarks.metal_trash_can.hint
msgid "The irony is not lost on Lumi."
msgstr ""

#: data/codex.json:landmarks.metal_trash_can.desc
msgid "The one place junk was supposed to go. Lumi salutes it every time he passes."
msgstr ""

#: data/codex.json:landmarks.propane_tank.name
msgid "Propane Tank"
msgstr ""

#: data/codex.json:landmarks.propane_tank.hint
msgid "Handle with care."
msgstr ""

#: data/codex.json:landmarks.propane_tank.desc
msgid "Long since empty and safe. Someone painted a flower on the side, a long time ago."
msgstr ""

#: data/codex.json:landmarks.plastic_monobloc_chair_01.name
msgid "Plastic Chair"
msgstr ""

#: data/codex.json:landmarks.plastic_monobloc_chair_01.hint
msgid "Somebody sat here."
msgstr ""

#: data/codex.json:landmarks.plastic_monobloc_chair_01.desc
msgid "The most common chair in the world. It faces the horizon, as if someone liked to watch the sunset from here."
msgstr ""

#: data/codex.json:landmarks.dead_tree_trunk.name
msgid "Old Tree Trunk"
msgstr ""

#: data/codex.json:landmarks.dead_tree_trunk.hint
msgid "It used to be tall."
msgstr ""

#: data/codex.json:landmarks.dead_tree_trunk.desc
msgid "A tree that did not make it. But there are tiny green shoots at its base, and beetles inside, and it is not as dead as it looks."
msgstr ""

#: data/codex.json:landmarks.old_drill_press.name
msgid "Drill Press"
msgstr ""

#: data/codex.json:landmarks.old_drill_press.hint
msgid "Out in the rust plains."
msgstr ""

#: data/codex.json:landmarks.old_drill_press.desc
msgid "A workshop drill press standing alone in a field. The workshop around it is long gone; the press stayed exactly where it was told."
msgstr ""

#: data/codex.json:landmarks.old_military_compressor.name
msgid "Field Compressor"
msgstr ""

#: data/codex.json:landmarks.old_military_compressor.hint
msgid "Out where the wild bases are."
msgstr ""

#: data/codex.json:landmarks.old_military_compressor.desc
msgid "A wheeled air compressor, its gauges frozen at 'enough'. It pumped up the tyres of a whole fleet of cleanup carts once."
msgstr ""

#: data/codex.json:landmarks.tree_stump_01.name
msgid "Tree Stump"
msgstr ""

#: data/codex.json:landmarks.tree_stump_01.hint
msgid "Where a forest used to be."
msgstr ""

#: data/codex.json:landmarks.tree_stump_01.desc
msgid "Cut, not fallen. The rings count back further than the Ledger. Moss has started a quiet negotiation with the bark."
msgstr ""

#: data/codex.json:landmarks.ocean_buoy.name
msgid "Washed-up Buoy"
msgstr ""

#: data/codex.json:landmarks.ocean_buoy.hint
msgid "On a far coast."
msgstr ""

#: data/codex.json:landmarks.ocean_buoy.desc
msgid "A channel buoy that drifted inland on a storm tide and never found its way back. Its lamp still blinks, once an hour, out of habit."
msgstr ""

#: data/codex.json:landmarks.wooden_crate_02.name
msgid "Cargo Crate"
msgstr ""

#: data/codex.json:landmarks.wooden_crate_02.hint
msgid "Near the shore, or the dunes."
msgstr ""

#: data/codex.json:landmarks.wooden_crate_02.desc
msgid "A slatted crate stencilled CRADLE SUPPLY: FRAGILE. Packed for the ark's launch three hundred years ago, and left behind in the rush. Empty. Whatever was inside was planted somewhere, a long time ago."
msgstr ""

#: data/codex.json:landmarks.barrel_03.name
msgid "Sand-Blasted Drum"
msgstr ""

#: data/codex.json:landmarks.barrel_03.hint
msgid "Where the wind carries sand."
msgstr ""

#: data/codex.json:landmarks.barrel_03.desc
msgid "Centuries of wind have polished this drum down to bare, shining metal. In the dunes even the junk gets buffed."
msgstr ""

#: data/codex.json:landmarks.dead_quiver_trunk.name
msgid "Dead Quiver Tree"
msgstr ""

#: data/codex.json:landmarks.dead_quiver_trunk.hint
msgid "Out in the Dust Flats."
msgstr ""

#: data/codex.json:landmarks.dead_quiver_trunk.desc
msgid "A desert tree that stored water in its trunk until there was none left to store. It still stands, bleached silver, pointing at the sky."
msgstr ""

#: data/codex.json:landmarks.namaqualand_rocks_01.name
msgid "Desert Rocks"
msgstr ""

#: data/codex.json:landmarks.namaqualand_rocks_01.hint
msgid "Scattered over the Dust Flats."
msgstr ""

#: data/codex.json:landmarks.namaqualand_rocks_01.desc
msgid "Wind-polished stones. Lumi swears one of them looks like WREN's logo. WREN says it does not."
msgstr ""

#: data/codex.json:landmarks.small_lpg_tank.name
msgid "Gas Bottle"
msgstr ""

#: data/codex.json:landmarks.small_lpg_tank.hint
msgid "Frozen into the port yard."
msgstr ""

#: data/codex.json:landmarks.small_lpg_tank.desc
msgid "A small gas bottle with a frozen valve. The harbour heaters once ran on these. Now they run on Lumi."
msgstr ""

#: data/codex.json:landmarks.portable_generator.name
msgid "Field Generator"
msgstr ""

#: data/codex.json:landmarks.portable_generator.hint data/codex.json:landmarks.utility_box_01.hint
msgid "Near the Cradle's old launch field."
msgstr ""

#: data/codex.json:landmarks.portable_generator.desc
msgid "A ground-crew generator, still labelled LAUNCH SUPPORT. It powered the floodlights on the night the Cradle left."
msgstr ""

#: data/codex.json:landmarks.utility_box_01.name
msgid "Launch Utility Box"
msgstr ""

#: data/codex.json:landmarks.utility_box_01.desc
msgid "A junction box for the launch field's lights. Someone wrote GOOD LUCK on the door in marker pen, three hundred years ago."
msgstr ""

#: data/codex.json:landmarks.concrete_road_barrier_02.name
msgid "Blast Barrier"
msgstr ""

#: data/codex.json:landmarks.concrete_road_barrier_02.hint
msgid "Around the landing pad."
msgstr ""

#: data/codex.json:landmarks.concrete_road_barrier_02.desc
msgid "Barriers that kept the crowd back from the pad. The crowd has been gone a long time. The barriers took their job very seriously."
msgstr ""

#: data/codex.json:frontiers.dust_flats.name data/frontiers.json:kinds[dust_flats].name data/junk.json:biomes.dust_flats.name
msgid "Dust Flats"
msgstr ""

#: data/codex.json:frontiers.dust_flats.hint
msgid "Research Dune Charts and fly there."
msgstr ""

#: data/codex.json:frontiers.dust_flats.desc
msgid "Old salt flats where a solar farm once powered half a continent. Sandstorms roll in every few minutes and bury cleaned ground again; Sustained hexes shelter their neighbours. The well is dry: Drips need Water Tanks."
msgstr ""

#: data/codex.json:frontiers.frozen_port.name data/frontiers.json:kinds[frozen_port].name data/junk.json:biomes.frozen_port.name
msgid "Frozen Port"
msgstr ""

#: data/codex.json:frontiers.frozen_port.hint
msgid "Research the Thermal Lance and fly there."
msgstr ""

#: data/codex.json:frontiers.frozen_port.desc
msgid "A container harbour frozen solid. Junk is locked in ice until it is thawed: Lumi's beam melts it slowly, heaters melt it fast and warm the hexes around them. Plants need a greenhouse, or Cold-Hardy Seeds."
msgstr ""

#: data/codex.json:frontiers.sunken_city.name data/frontiers.json:kinds[sunken_city].name data/junk.json:biomes.sunken_city.name
msgid "Sunken City"
msgstr ""

#: data/codex.json:frontiers.sunken_city.hint
msgid "Research Pump Works and fly there."
msgstr ""

#: data/codex.json:frontiers.sunken_city.desc
msgid "A downtown that went under when the sea walls failed. Skimmers net the floating junk; once most of a ring is clean, the old pumps run and the water drops, revealing streets full of stranded debris."
msgstr ""

#: data/codex.json:frontiers.cradle_returns.name data/frontiers.json:kinds[cradle_returns].name data/junk.json:biomes.cradle_landing.name
msgid "Cradle Returns"
msgstr ""

#: data/codex.json:frontiers.cradle_returns.hint
msgid "Restore all three frontiers and research the Ark Beacon."
msgstr ""

#: data/codex.json:frontiers.cradle_returns.desc
msgid "The launch city the Cradle left from. Its towers were kept by ground crews, but the landing field is buried. Clean and green the pad, and the ark can come home."
msgstr ""

#: data/codex.json:frontiers.sandstorm.name
msgid "Sandstorms"
msgstr ""

#: data/codex.json:frontiers.sandstorm.hint
msgid "Wait for the wind in the Dust Flats."
msgstr ""

#: data/codex.json:frontiers.sandstorm.desc
msgid "The wind picks up junk from the open flats and drops it on clean ground. Planted hexes are never touched, and Sustained hexes break the wind for every hex next to them."
msgstr ""

#: data/codex.json:frontiers.thaw.name
msgid "Thawing"
msgstr ""

#: data/codex.json:frontiers.thaw.hint
msgid "Melt the ice in the Frozen Port."
msgstr ""

#: data/codex.json:frontiers.thaw.desc
msgid "Hold the beam on ice and it slowly melts. A heater thaws a whole hex in about a minute and keeps warming the hexes around it."
msgstr ""

#: data/codex.json:frontiers.greenhouse.name
msgid "Greenhouses"
msgstr ""

#: data/codex.json:frontiers.greenhouse.hint
msgid "Build one in the Frozen Port."
msgstr ""

#: data/codex.json:frontiers.greenhouse.desc
msgid "A glass hex over clean ground. Anything grows inside, a quarter faster than outdoors."
msgstr ""

#: data/codex.json:frontiers.pumps.name
msgid "The Old Pumps"
msgstr ""

#: data/codex.json:frontiers.pumps.hint
msgid "Clean the water in the Sunken City."
msgstr ""

#: data/codex.json:frontiers.pumps.desc
msgid "The city's flood pumps still work. They only needed the drains cleared. Every time they run, a ring of streets comes back out of the water."
msgstr ""

#: data/codex.json:frontiers.ark_pad.name
msgid "The Landing Pad"
msgstr ""

#: data/codex.json:frontiers.ark_pad.hint
msgid "Find it in Cradle Returns."
msgstr ""

#: data/codex.json:frontiers.ark_pad.desc
msgid "A ring of hexes in front of the base where the Cradle will set down. It has to be clean and Sustained before the ark will trust it."
msgstr ""

#: data/eggs.json:eggs[duck].name
msgid "Duck on Duty"
msgstr ""

#: data/eggs.json:eggs[duck].prompt
msgid "E   squeeze the duck"
msgstr ""

#: data/eggs.json:eggs[duck].lore
msgid "A rubber duck standing guard on a hydrant. A whole container of them spilled at the old port; this one walked inland."
msgstr ""

#: data/eggs.json:eggs[duck].toast
msgid "QUACK. The duck seems to know things."
msgstr ""

#: data/eggs.json:eggs[duck].hint
msgid "A fire hydrant with a lookout on top."
msgstr ""

#: data/eggs.json:eggs[jukebox].name
msgid "The Last Jukebox"
msgstr ""

#: data/eggs.json:eggs[jukebox].prompt
msgid "E   thump the jukebox"
msgstr ""

#: data/eggs.json:eggs[jukebox].lore
msgid "The diner's jukebox only plays when it hears work being done. The cook said it was 'motivational'."
msgstr ""

#: data/eggs.json:eggs[jukebox].toast
msgid "The jukebox wakes up and plays a music-box waltz for the workers."
msgstr ""

#: data/eggs.json:eggs[jukebox].hint
msgid "It only plays when it hears work being done nearby."
msgstr ""

#: data/eggs.json:eggs[mural].name
msgid "The Crew Mural"
msgstr ""

#: data/eggs.json:eggs[mural].lore
msgid "The last cleanup crew painted themselves on a wall before the Ledger paused them. They really meant to come back."
msgstr ""

#: data/eggs.json:eggs[mural].toast
msgid "A mural of the old cleaning crew. 'WE'LL BE BACK AFTER LUNCH.'"
msgstr ""

#: data/eggs.json:eggs[mural].hint
msgid "A painted wall in Old Town. Just walk up to it."
msgstr ""

#: data/eggs.json:eggs[gnomes].name
msgid "Gnome Patrol"
msgstr ""

#: data/eggs.json:eggs[gnomes].lore
msgid "Five garden gnomes, each facing a different street. A Maker kid's sign said they were 'on patrol'. They still are."
msgstr ""

#: data/eggs.json:eggs[gnomes].toast
msgid "All five gnomes found. They turn, very slowly, and salute."
msgstr ""

#: data/eggs.json:eggs[gnomes].hint
msgid "Five small guards, each watching a different street."
msgstr ""

#: data/eggs.json:eggs[time_capsule].name
msgid "Class of the Last Spring"
msgstr ""

#: data/eggs.json:eggs[time_capsule].prompt
msgid "E   open the time capsule"
msgstr ""

#: data/eggs.json:eggs[time_capsule].lore
msgid "A school time capsule. Open in 100 years. It has been a little longer than that."
msgstr ""

#: data/eggs.json:eggs[time_capsule].toast
msgid "A time capsule from a Maker school class."
msgstr ""

#: data/eggs.json:eggs[time_capsule].doc.title
msgid "To whoever opens this"
msgstr ""

#: data/eggs.json:eggs[time_capsule].doc.body
msgid ""
"Hello from Class 4B! We are burying this under the playground so you can find it in 100 years. By then the robots will have cleaned everything up and there will be gardens on every roof (Mira says). We put in: one marble, a drawing of our class snail (his name is Gus), and this letter. Please water the school garden. It is the one with the yellow fence. If you are a robot, hello robot. You are doing a great job.\n"
"\n"
"— Class 4B, last spring"
msgstr ""

#: data/eggs.json:eggs[time_capsule].hint
msgid "Buried under the junk. Clean the ground and see what surfaces."
msgstr ""

#: data/eggs.json:eggs[arcade].name
msgid "High Score"
msgstr ""

#: data/eggs.json:eggs[arcade].prompt
msgid "E   insert a coin"
msgstr ""

#: data/eggs.json:eggs[arcade].lore
msgid "SWEEP-O-TRON, an arcade cabinet about a little robot cleaning up a city. The top score belongs to someone called WREN."
msgstr ""

#: data/eggs.json:eggs[arcade].toast
msgid "Lumi finds a coin in its compartment. SWEEP-O-TRON boots up: 'NEW CHALLENGER'."
msgstr ""

#: data/eggs.json:eggs[arcade].hint
msgid "A coin-op cabinet with a high score to beat."
msgstr ""

#: data/eggs.json:eggs[lost_cat].name
msgid "Lost: Biscuit"
msgstr ""

#: data/eggs.json:eggs[lost_cat].prompt
msgid "E   read the poster"
msgstr ""

#: data/eggs.json:eggs[lost_cat].final_prompt
msgid "E   pet Biscuit"
msgstr ""

#: data/eggs.json:eggs[lost_cat].lore
msgid "LOST CAT. Answers to Biscuit. Orange, friendly, runs on two AA batteries. Three posters, one trail."
msgstr ""

#: data/eggs.json:eggs[lost_cat].toast
msgid "Biscuit! A little robot cat shell, curled up exactly where the posters said. It purrs."
msgstr ""

#: data/eggs.json:eggs[lost_cat].posters[0].title
msgid "LOST CAT"
msgstr ""

#: data/eggs.json:eggs[lost_cat].posters[0].body
msgid ""
"LOST CAT — BISCUIT\n"
"Orange, stripy, very friendly. Purrs when you pat his head (that is his reset button). Last seen chasing a leaf toward the market.\n"
"If found please call the number on his collar. Reward: one (1) fresh-baked muffin."
msgstr ""

#: data/eggs.json:eggs[lost_cat].posters[1].title
msgid "STILL LOST"
msgstr ""

#: data/eggs.json:eggs[lost_cat].posters[1].body
msgid ""
"STILL LOOKING FOR BISCUIT\n"
"Someone saw him near the old laundromat, sleeping in a warm dryer vent. He likes warm places and quiet corners.\n"
"He is a robot cat, so please don't feed him fish. He will try. It will not go well."
msgstr ""

#: data/eggs.json:eggs[lost_cat].posters[2].title
msgid "LAST SEEN"
msgstr ""

#: data/eggs.json:eggs[lost_cat].posters[2].body
msgid ""
"BISCUIT WAS HERE\n"
"He sleeps in the sun on the corner by the old lot. He does not need much: a warm spot, a pat on the head, and somebody to come back.\n"
"If you find him, tell him we are sorry we had to leave."
msgstr ""

#: data/eggs.json:eggs[lost_cat].hint
msgid "Read the posters. Each one points to the next."
msgstr ""

#: data/eggs.json:eggs[vending].name
msgid "The Last Can"
msgstr ""

#: data/eggs.json:eggs[vending].prompt
msgid "E   give the machine a whack"
msgstr ""

#: data/eggs.json:eggs[vending].lore
msgid "A FIZZ machine with exactly one can left. It has been holding it for someone who really needed it."
msgstr ""

#: data/eggs.json:eggs[vending].toast
msgid "KA-CHUNK. The machine gives up its very last can of FIZZ. SOLD OUT lights up, proudly."
msgstr ""

#: data/eggs.json:eggs[vending].hint
msgid "A drinks machine that is holding on to something."
msgstr ""

#: data/eggs.json:eggs[stars].name
msgid "WREN's Constellation"
msgstr ""

#: data/eggs.json:eggs[stars].prompt
msgid "E   look through the telescope"
msgstr ""

#: data/eggs.json:eggs[stars].lore
msgid "Old Town's amateur telescope still points at the five stars the Makers called 'the Wren'. The Cradle's AI was named after them."
msgstr ""

#: data/eggs.json:eggs[stars].toast
msgid "Five stars over Old Town line up into a little bird. And next to it, faint, the letters W R E N."
msgstr ""

#: data/eggs.json:eggs[stars].hint
msgid "Old Town has a telescope. Try it after dark."
msgstr ""

#: data/eggs.json:eggs[payphone].name
msgid "Long Distance"
msgstr ""

#: data/eggs.json:eggs[payphone].prompt
msgid "E   answer the phone"
msgstr ""

#: data/eggs.json:eggs[payphone].lore
msgid "A payphone that rings when anything walks past. The line has been on hold for a very long time."
msgstr ""

#: data/eggs.json:eggs[payphone].toast
msgid "'Thank you for holding. Your call is important to us. Estimated wait: four hundred and twelve years.' Smooth jazz."
msgstr ""

#: data/eggs.json:eggs[payphone].hint
msgid "Listen for a ringing that nobody answers."
msgstr ""

#: data/eggs.json:eggs[tv].name
msgid "Still Broadcasting"
msgstr ""

#: data/eggs.json:eggs[tv].prompt
msgid "E   adjust the antenna"
msgstr ""

#: data/eggs.json:eggs[tv].lore
msgid "A television on a lawn chair, still tuned to the weather channel. Someone was watching the forecast when everyone left."
msgstr ""

#: data/eggs.json:eggs[tv].toast
msgid "The static clears for a second: 'TODAY: DUSTY. TOMORROW: DUSTY. OUTLOOK: ...GREEN?' Then snow again."
msgstr ""

#: data/eggs.json:eggs[tv].hint
msgid "Somebody left the weather on."
msgstr ""

#: data/eggs.json:eggs[snail].name
msgid "Gus"
msgstr ""

#: data/eggs.json:eggs[snail].prompt
msgid "E   say hello"
msgstr ""

#: data/eggs.json:eggs[snail].lore
msgid "A snail on top of a barrel. Class 4B's class pet was called Gus. This might be his great-great-(a lot)-grandsnail."
msgstr ""

#: data/eggs.json:eggs[snail].toast
msgid "A snail. Small, slow, unbothered. Lumi decides his name is Gus."
msgstr ""

#: data/eggs.json:eggs[snail].hint
msgid "Small, slow, and on top of a barrel."
msgstr ""

#: data/eggs.json:eggs[bench_bots].name
msgid "Lunch Break"
msgstr ""

#: data/eggs.json:eggs[bench_bots].prompt
msgid "E   leave a flower"
msgstr ""

#: data/eggs.json:eggs[bench_bots].lore
msgid "Two old cleanup robots on a bench, waiting for the end of a lunch break the Ledger never ended."
msgstr ""

#: data/eggs.json:eggs[bench_bots].toast
msgid "Lumi leaves a small flower between the two old robots. It seems right."
msgstr ""

#: data/eggs.json:eggs[bench_bots].hint
msgid "Two old workers on the longest lunch break."
msgstr ""

#: data/eggs.json:eggs[microwave].name
msgid "Ding!"
msgstr ""

#: data/eggs.json:eggs[microwave].prompt
msgid "E   open the door"
msgstr ""

#: data/eggs.json:eggs[microwave].lore
msgid "A microwave that still beeps three times whenever someone works nearby. There is a bag of popcorn inside. It has been waiting."
msgstr ""

#: data/eggs.json:eggs[microwave].toast
msgid "Inside: one bag of popcorn, three hundred years old and perfectly un-popped. Patience is a virtue."
msgstr ""

#: data/eggs.json:eggs[microwave].hint
msgid "Something beeps when you work nearby."
msgstr ""

#: data/eggs.json:eggs[wet_floor].name
msgid "Caution"
msgstr ""

#: data/eggs.json:eggs[wet_floor].prompt data/eggs.json:eggs[back_in_five].prompt
msgid "E   read the sign"
msgstr ""

#: data/eggs.json:eggs[wet_floor].lore
msgid "A WET FLOOR sign in the middle of a dry, dusty lot. Somebody, centuries ago, mopped here."
msgstr ""

#: data/eggs.json:eggs[wet_floor].toast
msgid "CAUTION: WET FLOOR. The floor has been dry for three centuries. The sign remains cautious."
msgstr ""

#: data/eggs.json:eggs[wet_floor].hint
msgid "A warning sign in a very unlikely place."
msgstr ""

#: data/eggs.json:eggs[camera].name
msgid "Being Watched"
msgstr ""

#: data/eggs.json:eggs[camera].lore
msgid "One of the Ledger's old cost-saving cameras. It still swivels to follow anything that moves, and counts it."
msgstr ""

#: data/eggs.json:eggs[camera].toast
msgid "The old Ledger camera has been following Lumi around. Lumi waves. The red light blinks twice, flustered."
msgstr ""

#: data/eggs.json:eggs[camera].hint
msgid "Something is watching. Let it watch you for a while."
msgstr ""

#: data/eggs.json:eggs[tyre_tower].name
msgid "Tyre Tower"
msgstr ""

#: data/eggs.json:eggs[tyre_tower].prompt
msgid "E   poke the tower"
msgstr ""

#: data/eggs.json:eggs[tyre_tower].lore
msgid "Eight tyres, one duck. Someone balanced this as a dare and it simply never fell down."
msgstr ""

#: data/eggs.json:eggs[tyre_tower].toast
msgid "The tyre tower wobbles... wobbles... and holds. The duck on top does not even blink."
msgstr ""

#: data/eggs.json:eggs[tyre_tower].hint
msgid "A tall stack that really should have fallen over."
msgstr ""

#: data/eggs.json:eggs[odd_sock].name
msgid "The Odd Sock"
msgstr ""

#: data/eggs.json:eggs[odd_sock].prompt
msgid "E   unpeg the sock"
msgstr ""

#: data/eggs.json:eggs[odd_sock].hint
msgid "A washing line with exactly one thing on it."
msgstr ""

#: data/eggs.json:eggs[odd_sock].lore
msgid "A clothesline with exactly one sock on it. The laundromat's lost-and-found book lists 4,112 single socks. This is number 4,113."
msgstr ""

#: data/eggs.json:eggs[odd_sock].toast
msgid "Lumi unpegs the sock. It is warm from three hundred years of sun. Its partner is out there somewhere."
msgstr ""

#: data/eggs.json:eggs[gold_cube].name
msgid "Employee of the Month"
msgstr ""

#: data/eggs.json:eggs[gold_cube].prompt
msgid "E   polish the plaque"
msgstr ""

#: data/eggs.json:eggs[gold_cube].hint
msgid "Something golden on a pedestal, waiting for a polish."
msgstr ""

#: data/eggs.json:eggs[gold_cube].lore
msgid "A pedestal with one perfect golden cube and a plaque: EMPLOYEE OF THE MONTH. The cleanup crews voted for it every month. It never once complained."
msgstr ""

#: data/eggs.json:eggs[gold_cube].toast
msgid "Lumi polishes the plaque. EMPLOYEE OF THE MONTH: CUBE. Every month, forever."
msgstr ""

#: data/eggs.json:eggs[weatherman].name
msgid "The Weatherman"
msgstr ""

#: data/eggs.json:eggs[weatherman].prompt
msgid "E   ask for the forecast"
msgstr ""

#: data/eggs.json:eggs[weatherman].hint
msgid "A little robot on a pole, sure about tomorrow."
msgstr ""

#: data/eggs.json:eggs[weatherman].lore
msgid "A weather-station robot on a pole. It has given a forecast every morning for three hundred years, and it has been wrong every time, with total confidence."
msgstr ""

#: data/eggs.json:eggs[weatherman].toast
msgid "'TODAY: A LIGHT DRIZZLE OF CONFETTI. TOMORROW: SMOOTH JAZZ.' The Weatherman whirs, very pleased with itself."
msgstr ""

#: data/eggs.json:eggs[potato].name
msgid "Best in Show"
msgstr ""

#: data/eggs.json:eggs[potato].prompt
msgid "E   pat the potato"
msgstr ""

#: data/eggs.json:eggs[potato].hint
msgid "A crate marked SHOW ENTRY. Something big is inside."
msgstr ""

#: data/eggs.json:eggs[potato].lore
msgid "A potato the size of a beanbag in a crate marked SHOW ENTRY. The county fair was the day after everything stopped. It is still waiting for its ribbon."
msgstr ""

#: data/eggs.json:eggs[potato].toast
msgid "Lumi pins a ribbon on the potato: 1ST PLACE. It was the only entry. It earned it anyway."
msgstr ""

#: data/eggs.json:eggs[night_shift].name
msgid "Night Shift"
msgstr ""

#: data/eggs.json:eggs[night_shift].prompt
msgid "E   tune the radio"
msgstr ""

#: data/eggs.json:eggs[night_shift].hint
msgid "An old radio aimed at the moon. It only hears anything after dark."
msgstr ""

#: data/eggs.json:eggs[night_shift].lore
msgid "A shortwave radio on a crate, its antenna aimed at the moon. On clear nights it picks up a faint crew working somewhere very far up: 'Section nine, swept. Moving on.'"
msgstr ""

#: data/eggs.json:eggs[night_shift].toast
msgid "Static, then a tiny voice from very far away: 'Sweeping crew to whoever's down there: nice work. Keep it tidy.' Click."
msgstr ""

#: data/eggs.json:eggs[builders_notes].name
msgid "Notes From the Builders"
msgstr ""

#: data/eggs.json:eggs[builders_notes].prompt
msgid "E   read the notes"
msgstr ""

#: data/eggs.json:eggs[builders_notes].hint
msgid "A folding desk with a clipboard, left by whoever made this place."
msgstr ""

#: data/eggs.json:eggs[builders_notes].lore
msgid "A folding desk and a clipboard of notes signed 'the builders'. They seem to have put this whole world together, and they left a few notes on how it went."
msgstr ""

#: data/eggs.json:eggs[builders_notes].toast
msgid "A clipboard of notes from the builders of this world. Mostly lists. One doodle of Lumi."
msgstr ""

#: data/eggs.json:eggs[builders_notes].doc.title
msgid "Build notes (do not tidy)"
msgstr ""

#: data/eggs.json:eggs[builders_notes].doc.body
msgid ""
"Day 1. Made a small blue robot. It is rusty on purpose. Do not fix the rust.\n"
"\n"
"Day 4. The junk should look like candy, not like sadness. Teal bottles. Orange cones. Yellow ducks. Lots of ducks.\n"
"\n"
"Day 9. Added a snail. Nobody asked for a snail. The snail stays.\n"
"\n"
"Day 15. Tried to make the cubes stack higher. They fell over. Made them stack higher anyway.\n"
"\n"
"Day 22. WREN keeps getting the best lines. That seems fair.\n"
"\n"
"Day 30. If you are reading this: thank you for cleaning up. We hid a few more things. Go and look.\n"
"\n"
"— the builders"
msgstr ""

#: data/eggs.json:eggs[scarecrow].name
msgid "The Last Scarecrow"
msgstr ""

#: data/eggs.json:eggs[scarecrow].prompt
msgid "E   wave hello"
msgstr ""

#: data/eggs.json:eggs[scarecrow].hint
msgid "Out in the wild, arms open, guarding a field."
msgstr ""

#: data/eggs.json:eggs[scarecrow].lore
msgid "A farm robot in a straw hat and an old coat, arms out, guarding a field of junk. No crows have come in three hundred years. It counts that as a win."
msgstr ""

#: data/eggs.json:eggs[scarecrow].toast
msgid "The scarecrow bot creaks its arms down, then up again. Field secure. It has been a very long shift."
msgstr ""

#: data/eggs.json:eggs[fishing_net].name
msgid "Net Gains"
msgstr ""

#: data/eggs.json:eggs[fishing_net].prompt
msgid "E   untangle the net"
msgstr ""

#: data/eggs.json:eggs[fishing_net].hint
msgid "In the wild: an old net hung out to dry, still holding a catch."
msgstr ""

#: data/eggs.json:eggs[fishing_net].lore
msgid "A fishing net strung between two posts, a buoy still tangled in it. The fishers hung their nets out to dry on the day the boats stopped."
msgstr ""

#: data/eggs.json:eggs[fishing_net].toast
msgid "Lumi untangles the net. Out drops one boot, one bottle and a very surprised crab shell. The buoy bobs free."
msgstr ""

#: data/eggs.json:eggs[parking].name
msgid "Parking Forever"
msgstr ""

#: data/eggs.json:eggs[parking].prompt
msgid "E   check the windscreen"
msgstr ""

#: data/eggs.json:eggs[parking].hint
msgid "In the wild: a car that stayed far too long. Check the windscreen."
msgstr ""

#: data/eggs.json:eggs[parking].lore
msgid "A car sunk to its doors in sand with a ticket under the wiper. The Ledger fined it for every day it stayed. The fine is now bigger than the planet's economy."
msgstr ""

#: data/eggs.json:eggs[parking].toast
msgid "PARKING NOTICE: overstay of 109,500 days. Amount due: yes. Lumi tucks the ticket back, gently."
msgstr ""

#: data/eggs.json:eggs[cairn].name
msgid "Trail Cairn"
msgstr ""

#: data/eggs.json:eggs[cairn].hint
msgid "In the wild: a stack of stones marking a path that isn't there any more."
msgstr ""

#: data/eggs.json:eggs[cairn].lore
msgid "A stack of flat stones marking a hiking trail long since gone. Every hiker added one stone on the way past. Lumi adds one too."
msgstr ""

#: data/eggs.json:eggs[cairn].toast
msgid "Lumi sets one small stone on top of the cairn. The trail is marked again."
msgstr ""

#: data/eggs.json:eggs[campfire].name
msgid "The Last Campfire"
msgstr ""

#: data/eggs.json:eggs[campfire].prompt
msgid "E   rekindle the fire"
msgstr ""

#: data/eggs.json:eggs[campfire].hint
msgid "In the wild: a ring of stones, two stools and a cold kettle."
msgstr ""

#: data/eggs.json:eggs[campfire].lore
msgid "A ring of stones, two folding stools and a dented kettle: somebody's last camping trip before the Makers left. The ashes are three hundred years cold."
msgstr ""

#: data/eggs.json:eggs[campfire].toast
msgid "A small, safe, warm glow. Lumi sits for a moment. Nobody says anything. It's nice."
msgstr ""

#: data/eggs.json:eggs[back_in_five].name
msgid "Back in Five"
msgstr ""

#: data/eggs.json:eggs[back_in_five].hint
msgid "In the wild: a workshop machine with no workshop, and a sign."
msgstr ""

#: data/eggs.json:eggs[back_in_five].lore
msgid "A drill press alone in a field with a hand-written sign: BACK IN 5 MINUTES. The workshop around it blew away long ago. The sign stayed."
msgstr ""

#: data/eggs.json:eggs[back_in_five].toast
msgid "BACK IN 5 MINUTES. Lumi waits five minutes. Nobody comes. Lumi leaves a shiny bolt on the table, for luck."
msgstr ""

#: data/events.json:events[supply_drop].name
msgid "Supply Drop"
msgstr ""

#: data/events.json:events[supply_drop].toast
msgid "Supply Drop! A crate parachuted onto the junk %s of you. Clear the junk around it to crack it open."
msgstr ""

#: data/events.json:events[supply_drop].hud
msgid "Clear the junk around the crate"
msgstr ""

#: data/events.json:events[salvage_surge].name
msgid "Salvage Surge"
msgstr ""

#: data/events.json:events[salvage_surge].toast
msgid "Salvage Surge! A hex %s of you is glowing: its junk is worth 3x for two minutes."
msgstr ""

#: data/events.json:events[salvage_surge].hud
msgid "Junk from the glowing hex is worth 3x"
msgstr ""

#: data/events.json:events[rain_shower].name
msgid "Rain Shower"
msgstr ""

#: data/events.json:events[rain_shower].toast
msgid "Rain Shower. Real rain, the first in years. Your plants won't dry out while it lasts."
msgstr ""

#: data/events.json:events[rain_shower].hud
msgid "Plants stay watered while it rains"
msgstr ""

#: data/events.json:events[robot_hiccup].name
msgid "Robot Hiccup"
msgstr ""

#: data/events.json:events[robot_hiccup].toast
msgid "%s has the hiccups and stopped working. Walk over and press E for a quick fix."
msgstr ""

#: data/events.json:events[robot_hiccup].hud
msgid "Walk to the stuck robot and press E"
msgstr ""

#: data/events.json:events[wildlife_visit].name
msgid "Wildlife Visit"
msgstr ""

#: data/events.json:events[wildlife_visit].toast
msgid "Something is visiting a thriving hex %s of you. Sneak up and press E to take a photo."
msgstr ""

#: data/events.json:events[wildlife_visit].hud
msgid "Find the visitor and press E for a photo"
msgstr ""

#: data/events.json:events[rare_part_signal].name
msgid "Rare Part Signal"
msgstr ""

#: data/events.json:events[rare_part_signal].toast
msgid "Rare Part Signal! The detector caught a strong ping %s of you. Follow the violet beam."
msgstr ""

#: data/events.json:events[rare_part_signal].hud
