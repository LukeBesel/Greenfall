msgid ""
"THE LEDGER IS WATCHING\n"
"(FOR SAVINGS)"
msgstr ""
"LEDGER 正在关注你\n"
"（是否节约）"

#: story/egg_props.gd:704
msgid ""
"EMPLOYEE OF\n"
"THE MONTH\n"
"— CUBE —"
msgstr ""
"本月\n"
"最佳员工\n"
"— 方块 —"

