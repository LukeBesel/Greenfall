"CONTRACT 0001: ACTIVE\n"
"WASTE IS A LINE ITEM"
msgstr ""
"LEDGER 中继站 07\n"
"合同 0001：生效中\n"
"废料即为账目条款"

#: story/ledger.gd:821
msgid "RELAY 07  ·  PROPERTY OF THE LEDGER  ·  NO UNSCHEDULED ACCESS"
msgstr "中继站 07  ·  LEDGER 资产  ·  禁止计划外访问"

#: story/ledger.gd:860
msgid ""
"LEDGER RELAY 07\n"
"CONTRACT 0001: AMENDED\n"
"RESTORATION = ASSET"
msgstr ""
"LEDGER 中继站 07\n"
"合同 0001：已修订\n"
"修复 = 资产"

#: story/ledger.gd:980
msgid "The Ledger's contract is rewritten. Its drones deliver seeds now. (+%d seeds)"
