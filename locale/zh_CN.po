msgstr " 米/秒"

#: data/robots.json:types[scoopie].upgrades[1].name
msgid "Arm Servos"
msgstr "手臂伺服"

#: data/robots.json:types[scoopie].upgrades[1].unit data/robots.json:types[seedling].upgrades[1].unit data/robots.json:types[drip].upgrades[3].unit
#: data/robots.json:types[skimmer].upgrades[1].unit data/upgrades.json:upgrades[scoop_speed].unit
msgid "/s"
msgstr "/秒"

#: data/robots.json:types[scoopie].upgrades[3].name
msgid "Compactor Tune"
msgstr "压实机调校"

#: data/robots.json:types[scoopie].upgrades[3].unit data/upgrades.json:upgrades[compactor_pressure].unit data/upgrades.json:upgrades[belt_speed].unit
#: data/upgrades.json:upgrades[baler_speed].unit data/upgrades.json:upgrades[recycler_yield].unit
