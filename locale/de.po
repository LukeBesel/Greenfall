msgstr "Bringe Erbstücke auf 10 Stufen"

#: data/goals.json:goals[late_world_2].text
msgid "Seed a second new world"
msgstr "Besäe eine zweite neue Welt"

#: data/hex_levels.json:levels[0].hint
msgid "Clear every piece of junk"
msgstr "Räum jedes Stück Schrott weg"

#: data/hex_levels.json:levels[1].hint
msgid "Plant seeds here (tool 2)"
msgstr "Pflanz hier Samen (Werkzeug 2)"

#: data/hex_levels.json:levels[2].hint
msgid "Water the sprouts so they grow"
msgstr "Gieß die Sprosse, damit sie wachsen"

#: data/hex_levels.json:levels[3].hint
msgid "Keep it watered for 3 min (Drip robots)"
msgstr "Halt es 3 Min. lang gegossen (Drip-Roboter)"

#: data/hex_levels.json:levels[4].name
msgid "Sustained"
msgstr "Stabil"

#: data/hex_levels.json:levels[4].hint
msgid "Bring every plant to bloom"
msgstr "Bring jede Pflanze zum Blühen"

#: data/hex_levels.json:levels[5].hint
msgid "Wildlife has moved in"
msgstr "Tiere sind eingezogen"

#: data/homeward.json:planets[verdance].name data/planets.json:verdance.name data/telescope.json:planets_default[verdance].name
msgid "Verdance"
msgstr "Verdance"

#: data/homeward.json:planets[verdance].leave.toast
msgid "Six stations awake, Lumi. Their robots can look after Verdance now."
msgstr "Sechs Stationen sind wach, Lumi. Ihre Roboter kümmern sich jetzt um Verdance."

#: data/homeward.json:planets[ochre].name data/planets.json:ochre.name data/telescope.json:planets_default[ochre].name
msgid "Ochre"
msgstr "Ochre"

#: data/homeward.json:planets[tidewell].name data/planets.json:tidewell.name data/planets.json:tidewell.district.name
#: data/telescope.json:planets_default[tidewell].name
msgid "Tidewell"
msgstr "Tidewell"

#: data/homeward.json:planets[rime].name data/planets.json:rime.name data/telescope.json:planets_default[rime].name
msgid "Rime"
msgstr "Rime"

#: data/homeward.json:planets[anvil].name data/planets.json:anvil.name data/telescope.json:planets_default[anvil].name
msgid "Anvil"
msgstr "Anvil"

#: data/homeward.json:closed.map_line
msgid "Coming in a future update"
msgstr "Kommt mit einem späteren Update"

#: data/homeward.json:closed.drive_lines
msgid "The drive is ready, Lumi. But we can't reach Ochre yet. Its sky is still full of dust."
msgstr "Der Antrieb ist bereit, Lumi. Aber Ochre erreichen wir noch nicht. Sein Himmel ist noch voller Staub."

#: data/homeward.json:closed.drive_lines
msgid "So we stay a while. Every town we clean makes Verdance greener for the Settlers."
msgstr "Also bleiben wir noch eine Weile. Jede Stadt, die wir säubern, macht Verdance grüner für die Siedler."

#: data/homeward.json:closed.toast
msgid "To be continued: the trip to Ochre comes in a future update. Keep restoring Verdance!"
msgstr "Fortsetzung folgt: Die Reise nach Ochre kommt mit einem späteren Update. Mach Verdance weiter grün!"

#: data/homeward.json:closed.card.title
msgid "To be continued"
msgstr "Fortsetzung folgt"

#: data/homeward.json:closed.card.line
msgid "Your robots keep cleaning while you wait. Stay as long as you like and keep making Verdance green."
msgstr "Deine Roboter putzen weiter, während du wartest. Bleib, so lange du willst, und mach Verdance weiter grün."

#: data/homeward.json:closed.card.hint
msgid "{interact}  continue"
msgstr "{interact}  weiter"

#: data/homeward.json:tech[deep_drill].name
msgid "Deep Drill"
msgstr "Tiefenbohrer"

#: data/homeward.json:tech[deep_drill].desc
msgid "Ochre's miners bored through bedrock. On Verdance it breaks open the buried landfill of the Dust Flats."
msgstr "Ochres Bergleute bohrten durch das Grundgestein. Auf Verdance bricht er die vergrabene Deponie der Staubebene auf."

#: data/homeward.json:tech[tide_pump].name
msgid "Tide Pump"
msgstr "Gezeitenpumpe"

#: data/homeward.json:tech[tide_pump].desc
msgid "Tidewell's sea pumps. On Verdance they drain the flooded streets of the Sunken City."
msgstr "Tidewells Meerespumpen. Auf Verdance legen sie die überfluteten Straßen der Versunkenen Stadt trocken."

#: data/homeward.json:tech[cryo_beacon].name
msgid "Cryo Beacon"
msgstr "Kryo-Leuchtfeuer"

#: data/homeward.json:tech[cryo_beacon].desc
msgid "A beacon that sings through deep cold: what Verdance's Ark Beacon was missing."
msgstr "Ein Leuchtfeuer, das durch tiefe Kälte singt: genau das, was dem Arche-Leuchtfeuer von Verdance fehlte."

#: data/homeward.json:tech[heat_core].name
msgid "Heat Core"
msgstr "Hitzekern"

#: data/homeward.json:tech[heat_core].desc
msgid "Anvil's forge heart. Wound into the beam, it melts the Frozen Port's ice on Verdance."
msgstr "Anvils Schmiedeherz. In den Strahl gewunden, schmilzt es das Eis des Eishafens auf Verdance."

#: data/homeward.json:relics.ochre_glass.name data/museum.json:exhibits[ochre_glass].name
msgid "Ochre Sun-Glass"
msgstr "Ochre-Sonnenglas"

#: data/homeward.json:relics.ochre_glass.desc
msgid "Slag fused clear by the dune winds. It holds a little of Ochre's light."
msgstr "Schlacke, von den Dünenwinden klar geschmolzen. Sie hält ein wenig von Ochres Licht."

#: data/homeward.json:relics.tidewell_pearl.name data/museum.json:exhibits[tidewell_pearl].name
msgid "Tidewell Pearl"
msgstr "Tidewell-Perle"

#: data/homeward.json:relics.tidewell_pearl.desc
msgid "The first pearl grown in Tidewell's sea in two hundred years."
msgstr "Die erste Perle, die seit zweihundert Jahren in Tidewells Meer gewachsen ist."

#: data/homeward.json:relics.rime_core.name data/museum.json:exhibits[rime_core].name
msgid "Rime Heart-Ice"
msgstr "Rime-Herzeis"

#: data/homeward.json:relics.rime_core.desc
msgid "A core sample from the thawed lakes, still faintly warm."
msgstr "Eine Kernprobe aus den aufgetauten Seen, noch leicht warm."

#: data/homeward.json:relics.anvil_ingot.name data/museum.json:exhibits[anvil_ingot].name
msgid "Anvil Ingot"
msgstr "Anvil-Barren"

#: data/homeward.json:relics.anvil_ingot.desc
msgid "The Ledger's last ingot, recast as a plain ring with a seed stamped in it."
msgstr "Der letzte Barren des Ledgers, umgegossen zu einem schlichten Ring mit einem eingeprägten Samen."

#: data/homeward.json:drive[0].name
msgid "Mk V Orbital"
msgstr "Mk V Orbital"

#: data/homeward.json:drive[0].desc
msgid "Your hop rocket, rebuilt for space out of a mountain of cubes. It reaches the near planets, Ochre and Tidewell."
msgstr "Deine kleine Rakete, aus einem Berg von Würfeln für den Weltraum umgebaut. Sie erreicht die nahen Planeten Ochre und Tidewell."

#: data/homeward.json:drive[1].name
msgid "Mk VI Interplanetary"
msgstr "Mk VI Interplanetar"

#: data/homeward.json:drive[1].desc
msgid "A fold drive salvaged from a Ledger ore hauler: reaches Rime and Anvil."
msgstr "Ein Faltantrieb, geborgen aus einem Erzfrachter des Ledgers: erreicht Rime und Anvil."

#: data/homeward.json:drive[2].name
msgid "Mk VII Homeward"
msgstr "Mk VII Heimkehr"

#: data/homeward.json:drive[2].desc
msgid "A great green-light rocket, filled with the fuel and power of every world you woke. One trip: up to the Cradle."
msgstr "Eine große Grünlicht-Rakete, gefüllt mit Treibstoff und Energie aus jeder Welt, die du geweckt hast. Eine Reise: hinauf zur Cradle."

#: data/homeward.json:docs.ochre_arrive.header data/homeward.json:docs.tidewell_arrive.header data/homeward.json:docs.rime_arrive.header
msgid "L E D G E R   ·   I N T E R N A L"
msgstr "L E D G E R   ·   I N T E R N"

#: data/homeward.json:docs.ochre_arrive.title
msgid "Site closure notice, Ochre Open Pit 1"
msgstr "Schließungsmitteilung, Ochre-Tagebau 1"

#: data/homeward.json:docs.ochre_arrive.body
msgid ""
"OCHRE OPEN PIT 1: CLOSED\n"
"\n"
"Ore grade below threshold. All extraction ends at shift change.\n"
"Remaining equipment: abandon in place (removal not cost-effective).\n"
"Waste rock, slag and packaging: leave on site.\n"
"Residents: none of our concern; contracts expired.\n"
"\n"
"Thank you for your years of service.\n"
"— The Ledger"
msgstr ""
"OCHRE-TAGEBAU 1: GESCHLOSSEN\n"
"\n"
"Erzgehalt unter dem Grenzwert. Jeder Abbau endet mit Schichtwechsel.\n"
"Restliche Geräte: vor Ort zurücklassen (Abtransport nicht wirtschaftlich).\n"
"Abraum, Schlacke und Verpackung: vor Ort lassen.\n"
"Bewohner: nicht unser Anliegen; Verträge abgelaufen.\n"
"\n"
"Danke für Ihre langjährigen Dienste.\n"
"— Der Ledger"

#: data/homeward.json:docs.ochre_half.title
msgid "Haul truck log, unit OH-7"
msgstr "Fahrtenbuch Muldenkipper, Einheit OH-7"

#: data/homeward.json:docs.ochre_half.body
msgid ""
"DAY 1,904\n"
"Load 41 to the slag dunes.\n"
"DAY 1,905\n"
"No orders.\n"
"DAY 1,906\n"
"No orders.\n"
"DAY 3,000\n"
"Still parked. The wind keeps burying my wheels. A lizard lives under my bumper now. I have named it Load 42."
msgstr ""
"TAG 1.904\n"
"Ladung 41 zu den Schlackedünen.\n"
"TAG 1.905\n"
"Keine Aufträge.\n"
"TAG 1.906\n"
"Keine Aufträge.\n"
"TAG 3.000\n"
"Immer noch geparkt. Der Wind begräbt ständig meine Räder. Unter meiner Stoßstange wohnt jetzt eine Eidechse. Ich habe sie Ladung 42 genannt."

#: data/homeward.json:docs.ochre_restored.title
msgid "Chalk on a pit wall"
msgstr "Kreide an einer Grubenwand"

#: data/homeward.json:docs.ochre_restored.body
msgid ""
"[In big careful letters, on the old benches of the pit:]\n"
"\n"
"THE GREEN CAME BACK.\n"
"\n"
"[Underneath, smaller, in WREN's handwriting font:] One down, Lumi. Four to go."
msgstr ""
"[In großen, sorgfältigen Buchstaben auf den alten Stufen der Grube:]\n"
"\n"
"DAS GRÜN IST ZURÜCK.\n"
"\n"
"[Darunter, kleiner, in WRENs Handschrift-Schrift:] Einer geschafft, Lumi. Noch vier."

#: data/homeward.json:docs.tidewell_arrive.title
msgid "Dredging schedule, final revision"
msgstr "Baggerplan, letzte Fassung"

#: data/homeward.json:docs.tidewell_arrive.body
msgid ""
"TIDEWELL SEABED OPERATIONS\n"
"\n"
"Nodules recovered: 100%.\n"
"Reef and kelp beds: 'overburden', removed.\n"
"Silt plumes: within acceptable limits (limits revised).\n"
"Island towns: notified by post.\n"
"\n"
"Next quarter: none. Tidewell is closed for business."
msgstr ""
"TIDEWELL MEERESBODENBETRIEB\n"
"\n"
"Geborgene Knollen: 100%.\n"
"Riffe und Kelpwälder: „Abraum“, entfernt.\n"
"Schlammfahnen: innerhalb zulässiger Grenzen (Grenzen angepasst).\n"
"Inselstädte: per Post benachrichtigt.\n"
"\n"
"Nächstes Quartal: keins. Tidewell ist geschlossen."

#: data/homeward.json:docs.tidewell_half.title
msgid "Harbour radio, on a loop"
msgstr "Hafenfunk, in Dauerschleife"

#: data/homeward.json:docs.tidewell_half.body
msgid "...this is Tidewell harbour, still broadcasting. The water's gone grey and the fish have gone quiet. If anyone hears this, we planted mangroves along the north quay before we left. Check on them for us? They were only little..."
msgstr "...hier ist der Hafen von Tidewell, wir senden noch. Das Wasser ist grau geworden und die Fische sind still. Falls das jemand hört: Wir haben vor der Abreise Mangroven am Nordkai gepflanzt. Schaut ihr für uns nach ihnen? Sie waren noch so klein..."

#: data/homeward.json:docs.tidewell_restored.title
msgid "A message in a bottle"
msgstr "Eine Flaschenpost"

#: data/homeward.json:docs.tidewell_restored.body
msgid ""
"To whoever finds this,\n"
"\n"
"The sea used to be so green you could see it from the hill. Grandad said it would come back if someone gave it a reason.\n"
"\n"
"Thank you for being the reason.\n"
"\n"
"— Pim, age 9, Tidewell"
msgstr ""
"An alle, die das finden,\n"
"\n"
"das Meer war früher so grün, dass man es vom Hügel aus sehen konnte. Opa hat gesagt, es kommt zurück, wenn ihm jemand einen Grund gibt.\n"
"\n"
"Danke, dass du der Grund bist.\n"
"\n"
"— Pim, 9 Jahre, Tidewell"

#: data/homeward.json:docs.rime_arrive.title
msgid "Core tap report, Rime"
msgstr "Kernzapfbericht, Rime"

#: data/homeward.json:docs.rime_arrive.body
msgid ""
"RIME DEEP CORE TAP\n"
"\n"
"Heat extracted and sold: all of it.\n"
"Surface temperature: falling (expected).\n"
"Lakes: freezing (expected).\n"
"Population: relocated (see invoice).\n"
"\n"
"Note from Finance: the moon was not ours to keep warm."
msgstr ""
"RIME TIEFENKERNZAPFUNG\n"
"\n"
"Entzogene und verkaufte Wärme: alles.\n"
"Oberflächentemperatur: fallend (erwartet).\n"
"Seen: frierend (erwartet).\n"
"Bevölkerung: umgesiedelt (siehe Rechnung).\n"
"\n"
"Notiz der Finanzabteilung: Der Mond war nicht unserer zum Warmhalten."

#: data/homeward.json:docs.rime_half.title
msgid "Greenhouse keeper's diary"
msgstr "Tagebuch der Gewächshauswärterin"

#: data/homeward.json:docs.rime_half.body
msgid ""
"Day 1. The heaters are off. Moved the seedlings to the kitchen.\n"
"Day 9. Kitchen's cold too. Wrapped them in my coat.\n"
"Day 30. We're leaving on the last shuttle. I left the coat. And a note: please keep them warm. I know that's silly. You're a frozen moon."
msgstr ""
"Tag 1. Die Heizungen sind aus. Die Setzlinge in die Küche gebracht.\n"
"Tag 9. Die Küche ist auch kalt. Sie in meinen Mantel gewickelt.\n"
"Tag 30. Wir fliegen mit dem letzten Shuttle. Ich habe den Mantel dagelassen. Und einen Zettel: Bitte haltet sie warm. Ich weiß, das ist albern. Du bist ein gefrorener Mond."

#: data/homeward.json:docs.rime_restored.title
msgid "A note pinned in a thawed greenhouse"
msgstr "Ein Zettel in einem aufgetauten Gewächshaus"

#: data/homeward.json:docs.rime_restored.body
msgid ""
"[Under the note from Day 30, a new line in bright ink:]\n"
"\n"
"Kept them warm. They're fine. They're more than fine.\n"
"\n"
"— LM-1 (and WREN, who wants it known she helped)"
msgstr ""
"[Unter dem Zettel von Tag 30 eine neue Zeile in leuchtender Tinte:]\n"
"\n"
"Warm gehalten. Es geht ihnen gut. Mehr als gut.\n"
"\n"
"— LM-1 (und WREN, die betonen möchte, dass sie geholfen hat)"

#: data/homeward.json:docs.anvil_arrive.header
msgid "L E D G E R   ·   H E A D   O F F I C E"
msgstr "L E D G E R   ·   H A U P T S I T Z"

#: data/homeward.json:docs.anvil_arrive.title
msgid "Board minutes, the final meeting"
msgstr "Vorstandsprotokoll, die letzte Sitzung"

#: data/homeward.json:docs.anvil_arrive.body
msgid ""
"ITEM 1: The system is spent. Motion to dissolve: carried.\n"
"ITEM 2: Clean-up costs. Motion to not: carried.\n"
"ITEM 3: The Settlers' ark keeps asking about a 'charter'. Motion to ignore: carried.\n"
"ITEM 4: Audit drones to continue indefinitely, for form's sake.\n"
"\n"
"Meeting closed. Lights left on."
msgstr ""
"PUNKT 1: Das System ist erschöpft. Antrag auf Auflösung: angenommen.\n"
"PUNKT 2: Aufräumkosten. Antrag auf Nein: angenommen.\n"
"PUNKT 3: Die Arche der Siedler fragt immer wieder nach einer „Charta“. Antrag auf Ignorieren: angenommen.\n"
"PUNKT 4: Prüfdrohnen laufen auf unbestimmte Zeit weiter, der Form halber.\n"
"\n"
"Sitzung geschlossen. Licht bleibt an."

#: data/homeward.json:docs.anvil_half.title
msgid "The last audit"
msgstr "Die letzte Prüfung"

#: data/homeward.json:docs.anvil_half.body
msgid ""
"LEDGER AUDIT UNIT 0001\n"
"SUBJECT: Anvil foundry district\n"
"FINDING: Unauthorised gardens. 214 counts.\n"
"FINDING: Unauthorised gardens. 215 counts.\n"
"FINDING: ...\n"
"RECOMMENDATION: Recommend we stop counting. It is rather nice."
msgstr ""
"LEDGER-PRÜFEINHEIT 0001\n"
"BETREFF: Gießereibezirk Anvil\n"
"BEFUND: Unerlaubte Gärten. 214 Fälle.\n"
"BEFUND: Unerlaubte Gärten. 215 Fälle.\n"
"BEFUND: ...\n"
"EMPFEHLUNG: Empfehle, mit dem Zählen aufzuhören. Es ist eigentlich ganz schön."

#: data/homeward.json:docs.anvil_restored.title
msgid "From the Ledger's last clerk"
msgstr "Vom letzten Buchhalter des Ledgers"

#: data/homeward.json:docs.anvil_restored.body
msgid ""
"Whoever you are,\n"
"\n"
"I kept the books for forty years. I wrote down every ton we took. I never wrote down what we left.\n"
"\n"
"If you're reading this in a garden on Anvil, then someone finally balanced the account. Thank you.\n"
"\n"
"— T. Hale, Accounts"
msgstr ""
"Wer immer du bist,\n"
"\n"
"ich habe vierzig Jahre lang die Bücher geführt. Ich habe jede Tonne aufgeschrieben, die wir genommen haben. Ich habe nie aufgeschrieben, was wir zurückließen.\n"
"\n"
"Wenn du das in einem Garten auf Anvil liest, hat endlich jemand die Rechnung ausgeglichen. Danke.\n"
"\n"
"— T. Hale, Buchhaltung"

#: data/hub.json:levels[0].desc
msgid "An old Settler cleanup station: pipe frame, tin roof, a bench."
msgstr "Eine alte Aufräumstation der Siedler: Rohrgestell, Blechdach, eine Werkbank."

#: data/hub.json:levels[1].name
msgid "Workshop"
msgstr "Werkstatt"

#: data/hub.json:levels[1].desc
msgid "Walls, a roll-up door, floodlights. Bales sell for more at a proper scale."
msgstr "Wände, ein Rolltor, Flutlicht. Ballen bringen an einer richtigen Waage mehr."

#: data/hub.json:levels[2].name
msgid "Depot Station"
msgstr "Depotstation"

#: data/hub.json:levels[2].desc
msgid "A second building, a radio mast and a sorting table."
msgstr "Ein zweites Gebäude, ein Funkmast und ein Sortiertisch."

#: data/hub.json:levels[3].name
msgid "Solar Yard"
msgstr "Solarhof"

#: data/hub.json:levels[3].desc
msgid "Solar panels and a greenhouse frame. Power for bigger machines."
msgstr "Solarpaneele und ein Gewächshausgerüst. Strom für größere Maschinen."

#: data/hub.json:levels[4].name
msgid "Garden Station"
msgstr "Gartenstation"

#: data/hub.json:levels[4].desc
msgid "A wind turbine, clean paint, planters, and a pad that could take a rocket."
msgstr "Ein Windrad, frische Farbe, Pflanzkübel und eine Plattform, die eine Rakete tragen könnte."

#: data/hub.json:buildings[air_scrubber].name
msgid "Air Scrubber"
msgstr "Luftwäscher"

#: data/hub.json:buildings[air_scrubber].desc
msgid "Pulls dusty air through filter banks. The sky clears faster."
msgstr "Zieht staubige Luft durch Filterbänke. Der Himmel klart schneller auf."

#: data/junk.json:types[metal].name
msgid "Scrap Metal"
msgstr "Altmetall"

#: data/junk.json:types[plastic].name
msgid "Plastic"
msgstr "Plastik"

#: data/junk.json:types[glass].name
msgid "Glass"
msgstr "Glas"

#: data/junk.json:types[rubber].name
msgid "Rubber"
msgstr "Gummi"

#: data/junk.json:types[electronics].name
msgid "Electronics"
msgstr "Elektronik"

#: data/junk.json:types[paper].name
msgid "Paper & Fabric"
msgstr "Papier & Stoff"

#: data/junk.json:biomes.rustlands.name
msgid "Rustlands"
msgstr "Rostlande"

#: data/junk.json:biomes.dust_dunes.name
msgid "Dust Dunes"
msgstr "Staubdünen"

#: data/junk.json:biomes.neon_coast.name
msgid "Neon Coast"
msgstr "Neonküste"

#: data/junk.json:biomes.frostcap.name
msgid "Frostcap"
msgstr "Frostkappe"

#: data/junk.json:biomes.fungal_marsh.name
msgid "Fungal Marsh"
msgstr "Pilzmarsch"

#: data/ledger.json:jammer.name
msgid "Signal Jammer"
msgstr "Störsender"

#: data/ledger.json:jammer.desc
msgid "A dish that sings static at the Ledger's drones. Drops inside its radius around the base are blocked, and drones come less often."
msgstr "Eine Schüssel, die den Drohnen des Ledgers Rauschen vorsingt. Abwürfe in ihrem Radius um die Basis werden blockiert, und Drohnen kommen seltener."

#: data/ledger.json:act1
msgid "CARRIER DETECTED. UNSCHEDULED ACTIVITY IN SECTOR: {district}."
msgstr "TRÄGER ERKANNT. UNGEPLANTE AKTIVITÄT IN SEKTOR: {district}."

#: data/ledger.json:act1
msgid "THE LEDGER: Waste is a line item. Line items must balance."
msgstr "DER LEDGER: Abfall ist ein Posten. Posten müssen ausgeglichen sein."

#: data/ledger.json:act1
msgid "Cleanup operations were paused until conditions improve. Conditions have not improved. Please stop improving them."
msgstr "Die Aufräumarbeiten wurden ausgesetzt, bis sich die Bedingungen verbessern. Die Bedingungen haben sich nicht verbessert. Bitte hören Sie auf, sie zu verbessern."

#: data/ledger.json:coupons
msgid "LIMITED OFFER: pause operations today and receive 0% off."
msgstr "BEGRENZTES ANGEBOT: Setzen Sie den Betrieb heute aus und erhalten Sie 0% Rabatt."

#: data/ledger.json:coupons
msgid "COUPON: one (1) complimentary pause. Valid forever. Non-transferable."
msgstr "GUTSCHEIN: eine (1) kostenlose Pause. Unbegrenzt gültig. Nicht übertragbar."

#: data/ledger.json:coupons
msgid "Have you considered doing less? Our records show that less is cheaper."
msgstr "Haben Sie erwogen, weniger zu tun? Unsere Unterlagen zeigen, dass weniger günstiger ist."

#: data/ledger.json:coupons
msgid "SURVEY: on a scale of 1 to 1, how paused would you like to be?"
msgstr "UMFRAGE: Wie pausiert möchten Sie sein, auf einer Skala von 1 bis 1?"

#: data/ledger.json:coupons
msgid "NOTICE: sparkles are not an approved budget category."
msgstr "HINWEIS: Glitzer ist keine genehmigte Budgetkategorie."

#: data/ledger.json:coupons
msgid "BUY ONE PAUSE, GET ONE PAUSE."
msgstr "KAUFEN SIE EINE PAUSE, ERHALTEN SIE EINE PAUSE."

#: data/ledger.json:coupons
msgid "Loyalty reward: you have 0 Ledger Points. Pause now to keep them."
msgstr "Treueprämie: Sie haben 0 Ledger-Punkte. Pausieren Sie jetzt, um sie zu behalten."

#: data/ledger.json:coupons
msgid "REMINDER: the junk was here first. Seniority matters."
msgstr "ERINNERUNG: Der Schrott war zuerst da. Dienstalter zählt."

#: data/ledger.json:coupons
msgid "Your cleaning has been logged as an expense. Your expense has been logged as an expense."
msgstr "Ihre Reinigung wurde als Ausgabe verbucht. Ihre Ausgabe wurde als Ausgabe verbucht."

#: data/ledger.json:act2
msgid "ANOMALY: UNAUTHORIZED GROWTH DETECTED. Living matter is not a line item."
msgstr "ANOMALIE: NICHT GENEHMIGTES WACHSTUM ERKANNT. Lebende Materie ist kein Posten."

#: data/ledger.json:act2
msgid "CORRECTIVE ACTION: dispatching disposal units to restore the balance."
msgstr "KORREKTURMASSNAHME: Entsorgungseinheiten werden zur Wiederherstellung des Gleichgewichts entsandt."

#: data/ledger.json:drop_warn
msgid "Disposal unit dispatched. A clean hex has been selected for re-balancing."
msgstr "Entsorgungseinheit entsandt. Ein sauberes Hexfeld wurde zum Ausgleich ausgewählt."

#: data/ledger.json:drop_warn
msgid "A clean surface is an unbudgeted surface. Correcting."
msgstr "Eine saubere Fläche ist eine nicht budgetierte Fläche. Korrektur läuft."

#: data/ledger.json:drop_warn
msgid "Returning misplaced waste to its registered location."
msgstr "Fehlplatzierter Abfall wird an seinen registrierten Standort zurückgeführt."

#: data/ledger.json:drop_warn
msgid "This is not personal. Nothing is personal. Everything is a line item."
msgstr "Das ist nicht persönlich. Nichts ist persönlich. Alles ist ein Posten."

#: data/ledger.json:drop_warn
msgid "Delivery of one (1) small pile of junk. No signature required."
msgstr "Lieferung von einem (1) kleinen Haufen Schrott. Keine Unterschrift erforderlich."

#: data/ledger.json:jammed
msgid "SIGNAL... OBSTRUCTED. Disposal unit returning to depot. This will be noted."
msgstr "SIGNAL... BEHINDERT. Entsorgungseinheit kehrt zum Depot zurück. Dies wird vermerkt."

#: data/ledger.json:jammed
msgid "Jamming detected. The Ledger has no line item for 'jamming'. Creating one."
msgstr "Störung erkannt. Der Ledger hat keinen Posten für „Störung“. Posten wird angelegt."

#: data/ledger.json:jammed
msgid "Unit 07 reports: 'loud static, a feeling of being unwelcome'. Aborting."
msgstr "Einheit 07 meldet: „lautes Rauschen, ein Gefühl, unerwünscht zu sein“. Abbruch."

#: data/ledger.json:act3
msgid "WARNING: relay node 07 location exposed. Please do not visit relay node 07."
msgstr "WARNUNG: Standort von Relaisknoten 07 offengelegt. Bitte besuchen Sie Relaisknoten 07 nicht."

#: data/ledger.json:act3
msgid "Relay node 07 is closed for maintenance. It has been closed for maintenance for three hundred years."
msgstr "Relaisknoten 07 ist wegen Wartungsarbeiten geschlossen. Er ist seit dreihundert Jahren wegen Wartungsarbeiten geschlossen."

#: data/ledger.json:friendly
msgid "SEED DELIVERY dispatched. Invoice status: PAID IN FULL."
msgstr "SAMENLIEFERUNG versandt. Rechnungsstatus: VOLLSTÄNDIG BEZAHLT."

#: data/ledger.json:friendly
msgid "Balance report: positive. Again. The Ledger is... adjusting to this."
msgstr "Bilanzbericht: positiv. Schon wieder. Der Ledger... gewöhnt sich daran."

#: data/ledger.json:friendly
msgid "Asset column now contains: flowers. Recalculating priorities."
msgstr "Die Aktivspalte enthält jetzt: Blumen. Prioritäten werden neu berechnet."

#: data/ledger.json:friendly
msgid "Drone 07 requests permission to circle the garden once more. Permission granted."
msgstr "Drohne 07 bittet um Erlaubnis, den Garten noch einmal zu umkreisen. Erlaubnis erteilt."

#: data/ledger.json:friendly
msgid "Audit complete. Finding: the planet is worth keeping."
msgstr "Prüfung abgeschlossen. Ergebnis: Der Planet ist es wert, behalten zu werden."

#: data/ledger.json:lonely
msgid "Off the record: the Ledger kept every coupon you ignored. It was the most mail it had received in three hundred years. Thank you for reading them."
msgstr "Inoffiziell: Der Ledger hat jeden Gutschein aufbewahrt, den Sie ignoriert haben. Es war die meiste Post, die er in dreihundert Jahren bekommen hat. Danke, dass Sie sie gelesen haben."

#: data/ledger.json:cinematic
msgid "This is it. A Ledger relay. Still humming after all this time."
msgstr "Das ist es. Ein Ledger-Relais. Summt immer noch, nach all der Zeit."

#: data/ledger.json:cinematic
msgid "UNAUTHORIZED ACCESS. STATE YOUR COST CENTER."
msgstr "UNBEFUGTER ZUGRIFF. NENNEN SIE IHRE KOSTENSTELLE."

#: data/ledger.json:cinematic
msgid "Cost center: the whole planet. Hold still, {name}. I'm opening the contract."
msgstr "Kostenstelle: der ganze Planet. Halt still, {name}. Ich öffne den Vertrag."

#: data/ledger.json:cinematic
msgid "CONTRACT 0001: WASTE IS A LINE ITEM. LINE ITEMS MUST BALANCE."
msgstr "VERTRAG 0001: ABFALL IST EIN POSTEN. POSTEN MÜSSEN AUSGEGLICHEN SEIN."

#: data/ledger.json:cinematic
msgid "Fine. Let's balance them. Clean hexes. Sprouts. Water. Put them in the asset column."
msgstr "Gut. Dann gleichen wir sie aus. Saubere Hexfelder. Sprosse. Wasser. Ab in die Aktivspalte."

#: data/ledger.json:cinematic
msgid "ASSET COLUMN... NOT FOUND. CREATING COLUMN."
msgstr "AKTIVSPALTE... NICHT GEFUNDEN. SPALTE WIRD ANGELEGT."

#: data/ledger.json:cinematic
msgid "RECALCULATING. RECALCULATING. BALANCE: POSITIVE. That has not happened in a very long time."
msgstr "NEUBERECHNUNG. NEUBERECHNUNG. BILANZ: POSITIV. Das ist seit sehr langer Zeit nicht vorgekommen."

#: data/ledger.json:cinematic
msgid "New clause: restoration is an asset. Every seed is a deposit."
msgstr "Neue Klausel: Wiederherstellung ist ein Aktivposten. Jeder Samen ist eine Einlage."

#: data/ledger.json:cinematic
msgid "friendly"
msgstr "freundlich"

#: data/ledger.json:cinematic
msgid "AMENDMENT ACCEPTED. Reassigning drone fleet: DISPOSAL -> DELIVERY. ...Thank you for your patience."
msgstr "ÄNDERUNG ANGENOMMEN. Drohnenflotte wird neu zugewiesen: ENTSORGUNG -> LIEFERUNG. ...Vielen Dank für Ihre Geduld."

#: data/ledger.json:cinematic
msgid "Did the Ledger just say thank you? Write that down. Somewhere permanent."
msgstr "Hat der Ledger gerade Danke gesagt? Schreib das auf. Irgendwo, wo es bleibt."

#: data/ledger.json:contract_doc.header
msgid "L E D G E R   ·   C O N T R A C T   0 0 0 1   ( A M E N D E D )"
msgstr "L E D G E R   ·   V E R T R A G   0 0 0 1   ( G E Ä N D E R T )"

#: data/ledger.json:contract_doc.title
msgid "Waste Management Contract 0001, as amended"
msgstr "Abfallwirtschaftsvertrag 0001, in geänderter Fassung"

#: data/ledger.json:contract_doc.body
msgid ""
"§1. Waste is a line item. Line items must balance.\n"
"§2. (struck out) Cleanup costs more than it earns; pause until conditions improve.\n"
"§2a. AMENDED: Restoration is an asset. Clean ground, living plants and clear water are entered in the asset column.\n"
"§3. Every seed is a deposit. Deposits are to be delivered, not disposed of.\n"
"§4. Drone fleet reassigned: DISPOSAL -> DELIVERY.\n"
"§5. Thank you for your patience.\n"
"\n"
"Signed: THE LEDGER (reluctantly, then less reluctantly)\n"
"Witness: WREN, Cradle caretaker\n"
"Witness: LM-1 (left a small oil smudge)"
msgstr ""
"§1. Abfall ist ein Posten. Posten müssen ausgeglichen sein.\n"
"§2. (gestrichen) Aufräumen kostet mehr, als es einbringt; aussetzen, bis sich die Bedingungen verbessern.\n"
"§2a. GEÄNDERT: Wiederherstellung ist ein Aktivposten. Sauberer Boden, lebende Pflanzen und klares Wasser werden in der Aktivspalte erfasst.\n"
"§3. Jeder Samen ist eine Einlage. Einlagen sind zu liefern, nicht zu entsorgen.\n"
"§4. Drohnenflotte neu zugewiesen: ENTSORGUNG -> LIEFERUNG.\n"
"§5. Vielen Dank für Ihre Geduld.\n"
"\n"
"Gezeichnet: DER LEDGER (widerwillig, dann weniger widerwillig)\n"
"Zeugin: WREN, Hüterin der Cradle\n"
"Zeuge: LM-1 (hat einen kleinen Ölfleck hinterlassen)"

#: data/museum.json:exhibits[gnomes].hint
msgid "Five garden gnomes guard Old Town's streets. Pick them up."
msgstr "Fünf Gartengnome bewachen die Straßen der Altstadt. Heb sie auf."

#: data/museum.json:exhibits[biscuit].name
msgid "Biscuit's Shell"
msgstr "Biscuits Hülle"

#: data/museum.json:exhibits[time_capsule].name
msgid "Time Capsule"
msgstr "Zeitkapsel"

#: data/museum.json:exhibits[broadcast].name
msgid "The Last Broadcast"
msgstr "Die letzte Sendung"

#: data/museum.json:exhibits[broadcast].hint
msgid "A TV on a lawn chair is still on. Adjust the antenna."
msgstr "Ein Fernseher auf einem Gartenstuhl läuft noch. Richte die Antenne aus."

#: data/museum.json:exhibits[gold_cube].name
msgid "The Golden Cube"
msgstr "Der goldene Würfel"

#: data/museum.json:exhibits[curiosities].hint
msgid "Every curiosity on every planet (Codex > Curiosities has the hints)."
msgstr "Jede Kuriosität auf jedem Planeten (Hinweise im Kodex unter Kuriositäten)."

#: data/museum.json:exhibits[shards].hint
msgid "Letters, notes and drawings surface as the ground is cleaned."
msgstr "Briefe, Notizen und Zeichnungen tauchen auf, wenn der Boden gereinigt wird."

#: data/museum.json:exhibits[trinkets].name
msgid "Trinkets and Curios"
msgstr "Krimskrams und Kurioses"

#: data/museum.json:exhibits[trinkets].hint
msgid "World events, requests, streaks and Curio Capsules."
msgstr "Weltereignisse, Aufträge, Serien und Kuriositätenkapseln."

#: data/museum.json:exhibits[ochre_glass].hint
msgid "Restore Ochre."
msgstr "Stelle Ochre wieder her."

#: data/museum.json:exhibits[tidewell_pearl].hint
msgid "Restore Tidewell."
msgstr "Stelle Tidewell wieder her."

#: data/museum.json:exhibits[rime_core].hint
msgid "Restore Rime."
msgstr "Stelle Rime wieder her."

#: data/museum.json:exhibits[anvil_ingot].hint
msgid "Restore Anvil."
msgstr "Stelle Anvil wieder her."

#: data/objectives.json:wren_brief.lines
msgid "I run the Cradle, our big ship. I never stopped listening for you."
msgstr "Ich steuere die Cradle, unser großes Schiff. Ich habe nie aufgehört, nach dir zu lauschen."

#: data/objectives.json:wren_brief.lines
msgid "The Cradle can't land on a dead world. Let's make Verdance green again."
msgstr "Die Cradle kann nicht auf einer toten Welt landen. Machen wir Verdance wieder grün."

#: data/objectives.json:wren_brief.lines
msgid "Plants make green light. It fills your Bloom Core, and it shows the Cradle the way home."
msgstr "Pflanzen machen grünes Licht. Es füllt deinen Blütenkern, und es zeigt der Cradle den Weg nach Hause."

#: data/objectives.json:brief.lines
msgid "Lumi, it's WREN, up on the Cradle. Your pod fell by an old cleanup station, and my signal is weak."
msgstr "Lumi, hier ist WREN, oben auf der Cradle. Deine Kapsel ist neben einer alten Aufräumstation gelandet, und mein Signal ist schwach."

#: data/objectives.json:brief.lines
msgid "Its bin makes cubes from trash. Find parts, build a signal tower and we can talk. I'll be [glitch]listen—[/glitch]"
msgstr "Ihre Tonne macht aus Müll Würfel. Such Teile, bau einen Signalturm, dann können wir reden. Ich [glitch]höre zu—[/glitch]"

#: data/objectives.json:objectives[dump3].text
msgid "Fill the trash bin 3 times"
msgstr "Fülle die Mülltonne 3-mal"

#: data/objectives.json:objectives[dump3].desc
msgid "The bin turns trash into cubes. The bench builds with them."
msgstr "Die Tonne macht aus Müll Würfel. Die Werkbank baut damit."

#: data/objectives.json:objectives[dump3].lines
msgid "Start small, Lumi. Every load in the bin earns cubes."
msgstr "Fang klein an, Lumi. Jede Ladung in der Tonne bringt Würfel."

#: data/objectives.json:objectives[compartment].text
msgid "Buy a bigger chest"
msgstr "Kauf ein größeres Brustfach"

#: data/objectives.json:objectives[compartment].desc
msgid "Workbench: Chest Size. Fewer trips to the bin."
msgstr "Werkbank: Brustfachgröße. Weniger Wege zur Tonne."

#: data/objectives.json:objectives[compartment].lines
msgid "A bigger chest means fewer trips. The bench can fit one."
msgstr "Ein größeres Brustfach heißt weniger Wege. Die Werkbank kann eins einbauen."

#: data/objectives.json:objectives[scoop_size].text
msgid "Buy Scoop Size"
msgstr "Kaufe Schaufelgröße"

#: data/objectives.json:objectives[scoop_size].desc
msgid "Workbench: grab more trash at once."
msgstr "Werkbank: mehr Müll auf einmal greifen."

#: data/objectives.json:objectives[scoop_size].lines
msgid "A wider scoop. More trash per grab, less walking."
msgstr "Eine breitere Schaufel. Mehr Müll pro Griff, weniger Lauferei."

#: data/objectives.json:objectives[baler].text
msgid "Save up for the Baler"
msgstr "Spare auf die Ballenpresse"

#: data/objectives.json:objectives[baler].desc data/story_reasons.json:goal_reasons
msgid "A tight bale wastes nothing, so it makes more cubes."
msgstr "Ein fester Ballen verschwendet nichts, darum gibt er mehr Würfel."

#: data/objectives.json:objectives[baler].lines
msgid "Save up for the Baler. A tight bale wastes nothing, so it makes far more cubes."
msgstr "Spar auf die Ballenpresse. Ein fester Ballen verschwendet nichts, darum gibt er viel mehr Würfel."

#: data/objectives.json:objectives[power].text
msgid "Sell 3 bales"
msgstr "Verkauf 3 Ballen"

#: data/objectives.json:objectives[power].desc
msgid "Press {cube} for a bale. Cubes for the signal tower."
msgstr "Drück {cube} für einen Ballen. Würfel für den Signalturm."

#: data/objectives.json:objectives[power].lines
msgid "Carry bales to the scale by the bin. Three of them make plenty of cubes."
msgstr "Trag Ballen zur Waage neben der Tonne. Drei davon geben schon viele Würfel."

#: data/objectives.json:objectives[tower].text
msgid "Build the signal tower"
msgstr "Den Signalturm bauen"

#: data/objectives.json:objectives[tower].desc
msgid "Workbench, Build tab. Then WREN can talk to you."
msgstr "Werkbank, Tab „Bauen“. Dann kann WREN mit dir reden."

#: data/objectives.json:objectives[tower].lines
msgid "Build the tower, Lumi. Then I can stay with you."
msgstr "Bau den Turm, Lumi. Dann kann ich bei dir bleiben."

#: data/objectives.json:objectives[glim].desc
msgid "Build tab. He lights the dark and finds missed trash."
msgstr "Tab „Bauen“. Er leuchtet im Dunkeln und findet übersehenen Müll."

#: data/objectives.json:objectives[glim].lines
msgid "Lumi... something's still holding on to your pod. Small. Lantern-shaped. Patch him up at the bench."
msgstr "Lumi... da hält sich noch etwas an deiner Kapsel fest. Klein. Wie eine Laterne. Flick ihn an der Werkbank zusammen."

#: data/objectives.json:objectives[hex].text
msgid "Clean the glowing hex"
msgstr "Räum das leuchtende Hexfeld"

#: data/objectives.json:objectives[hex].desc
msgid "Plants only grow on clean ground. Clear the outline."
msgstr "Pflanzen wachsen nur auf sauberem Boden. Räum den Umriss leer."

#: data/objectives.json:objectives[hex].lines
msgid "First, one clean hex. Clear the outlined one. Green starts on clean ground."
msgstr "Zuerst ein sauberes Hexfeld. Räum das umrandete frei. Grün beginnt auf sauberem Boden."

#: data/objectives.json:objectives[bench2].text
msgid "Add a Bot Bay to the bench"
msgstr "Bau eine Bot-Bucht an die Werkbank"

#: data/objectives.json:objectives[bench2].desc
msgid "Upgrades tab. A planet is too big for one small robot."
msgstr "Tab „Upgrades“. Ein Planet ist zu groß für einen einzigen kleinen Roboter."

#: data/objectives.json:objectives[bench2].lines
msgid "Add a Bot Bay to the bench. You shouldn't do this alone."
msgstr "Bau eine Bot-Bucht an die Werkbank. Du sollst das nicht allein machen."

#: data/objectives.json:objectives[robot].text
msgid "Build your first robot"
msgstr "Baue deinen ersten Roboter"

#: data/objectives.json:objectives[robot].desc
msgid "Workbench, Bots tab. Robots clean for you."
msgstr "Werkbank, Tab „Bots“. Roboter räumen für dich auf."

#: data/objectives.json:objectives[robot].lines
msgid "The Bot Bay hums! It can build you a helper. Try the Bots tab at the workbench."
msgstr "Die Bot-Bucht summt! Sie kann dir einen Helfer bauen. Probier den Tab „Bots“ an der Werkbank."

#: data/objectives.json:objectives[hex2].text
msgid "Clean 2 hexes"
msgstr "Räum 2 Hexfelder"

#: data/objectives.json:objectives[hex2].desc
msgid "Your robot cleans on its own. Clean one more hex."
msgstr "Dein Roboter räumt von allein auf. Räum noch ein Hexfeld."

#: data/objectives.json:objectives[hex2].lines
msgid "One hex clean. Now one more, Lumi."
msgstr "Ein Hexfeld ist sauber. Jetzt noch eins, Lumi."

#: data/objectives.json:objectives[hex3].desc
msgid "Your robot helps now. Clean ground lets the garden spread."
msgstr "Dein Roboter hilft jetzt mit. Auf sauberem Boden breitet sich der Garten aus."

#: data/objectives.json:objectives[hex3].lines
msgid "Your robot cleans on its own. One more hex, Lumi."
msgstr "Dein Roboter räumt von allein auf. Noch ein Hexfeld, Lumi."

#: data/objectives.json:objectives[seed].text
msgid "Plant the first seed"
msgstr "Pflanze den ersten Samen"

#: data/objectives.json:objectives[seed].desc
msgid "Plants fill your Bloom Core."
msgstr "Pflanzen füllen deinen Blütenkern."

#: data/objectives.json:objectives[seed].hint
msgid "Keep cleaning. Seeds turn up in clean ground."
msgstr "Räum weiter auf. In sauberem Boden tauchen Samen auf."

#: data/objectives.json:objectives[seed].lines
msgid "Something green is waking out there. Plant the first seed."
msgstr "Da draußen erwacht etwas Grünes. Pflanz den ersten Samen."

#: data/objectives.json:objectives[hub_wake_2].text
msgid "Wake station 2 of 6"
msgstr "Weck Station 2 von 6"

#: data/objectives.json:objectives[hex10].desc
msgid "More clean ground, more room to plant. Robots help."
msgstr "Mehr sauberer Boden, mehr Platz zum Pflanzen. Roboter helfen."

#: data/objectives.json:objectives[hex10].lines
msgid "On to ten clean hexes. Your robots are learning from you, Lumi."
msgstr "Auf zu zehn sauberen Hexfeldern. Deine Roboter lernen von dir, Lumi."

#: data/objectives.json:objectives[base2].text
msgid "Rebuild the base to level 2"
msgstr "Bau die Basis auf Stufe 2 aus"

#: data/objectives.json:objectives[base2].desc
msgid "Workbench, Upgrades tab. A bigger base powers more robots."
msgstr "Werkbank, Tab „Upgrades“. Eine größere Basis versorgt mehr Roboter mit Strom."

#: data/objectives.json:objectives[base2].lines
msgid "A bigger base makes more power, and power runs robots. Rebuild it at the workbench."
msgstr "Eine größere Basis macht mehr Strom, und Strom treibt Roboter an. Bau sie an der Werkbank wieder auf."

#: data/objectives.json:objectives[hub_wake_3].text
msgid "Wake station 3 of 6"
msgstr "Weck Station 3 von 6"

#: data/objectives.json:objectives[haul].desc
msgid "Workbench, Bots tab. It carries bales to the scale for you."
msgstr "Werkbank, Tab „Bots“. Er trägt Ballen für dich zur Waage."

#: data/objectives.json:objectives[haul].hint
msgid "Keep cleaning. WREN is looking for Haul Bug plans."
msgstr "Räum weiter auf. WREN sucht nach Plänen für den Haul Bug."

#: data/objectives.json:objectives[haul].lines
msgid "A Haul Bug carries bales for you. Build one at the bench."
msgstr "Ein Haul Bug trägt Ballen für dich. Bau einen an der Werkbank."

#: data/objectives.json:objectives[tower2].text
msgid "Boost the signal tower"
msgstr "Funkturm verstärken"

#: data/objectives.json:objectives[tower2].desc
msgid "Workbench. A stronger signal lets WREN look further."
msgstr "Werkbank. Mit einem stärkeren Signal kann WREN weiter schauen."

#: data/objectives.json:objectives[tower2].lines
msgid "Boost the tower. With a stronger signal I can look further for you."
msgstr "Verstärk den Turm. Mit einem stärkeren Signal kann ich für dich weiter schauen."

#: data/objectives.json:objectives[research1].desc
msgid "Workbench, Research tab. Research unlocks new robots."
msgstr "Werkbank, Tab „Forschung“. Forschung schaltet neue Roboter frei."

#: data/objectives.json:objectives[research1].hint
msgid "First add the Research Desk: workbench, Upgrades tab."
msgstr "Bau zuerst den Forschungstisch: Werkbank, Tab Upgrades."

#: data/objectives.json:objectives[research1].lines
msgid "Your bench can study now. Research unlocks new machines and seeds."
msgstr "Deine Werkbank kann jetzt forschen. Forschung schaltet neue Maschinen und Samen frei."

#: data/objectives.json:objectives[hex20].desc
msgid "More clean ground means more room to grow."
msgstr "Mehr sauberer Boden heißt mehr Platz zum Wachsen."

#: data/objectives.json:objectives[hex20].lines
msgid "Twenty hexes next. The air already smells different."
msgstr "Als Nächstes zwanzig Hexfelder. Die Luft riecht schon anders."

#: data/objectives.json:objectives[rocket_tier_2].text
msgid "Upgrade the rocket to Mk II"
msgstr "Rüste die Rakete auf Mk II auf"

#: data/objectives.json:objectives[base3].text
msgid "Rebuild the base to level 3"
msgstr "Bau die Basis auf Stufe 3 aus"

#: data/objectives.json:objectives[base3].desc
msgid "Upgrades tab. A stronger base runs bigger machines."
msgstr "Tab „Upgrades“. Eine stärkere Basis treibt größere Maschinen an."

#: data/objectives.json:objectives[base3].lines
msgid "One more base level, Lumi. Bigger machines need a stronger base."
msgstr "Noch eine Basisstufe, Lumi. Größere Maschinen brauchen eine stärkere Basis."

#: data/objectives.json:objectives[hub_wake_4].text
msgid "Wake station 4 of 6"
msgstr "Weck Station 4 von 6"

#: data/outposts.json:levels[0].name
msgid "Weigh Station"
msgstr "Wiegestation"

#: data/outposts.json:levels[0].desc
msgid "A working scale and skip on the frontier. Haul Bugs deliver to the nearest scale."
msgstr "Eine funktionierende Waage und Mulde an der Grenze. Haul Bugs liefern an die nächste Waage."

#: data/outposts.json:levels[1].name
msgid "Big Skip"
msgstr "Große Mulde"

#: data/outposts.json:levels[1].desc
msgid "A bigger skip and a wider, faster scale plate. Bales here sell for 15% more."
msgstr "Eine größere Mulde und eine breitere, schnellere Waagplatte. Ballen bringen hier 15% mehr."

#: data/outposts.json:levels[2].name
msgid "Recharge Pad"
msgstr "Ladeplattform"

#: data/outposts.json:levels[2].desc
msgid "A charging pad. Robots passing over it run 40% faster for 25 s."
msgstr "Eine Ladeplattform. Roboter, die darüberfahren, sind 25 s lang 40% schneller."

