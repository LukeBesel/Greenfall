msgstr "Lass 800 Blumen erblühen"

#: data/goals.json:goals[restored_40].text
msgid "Fully restore 40 hexes"
msgstr "Stell 40 Hexfelder vollständig wieder her"

#: data/goals.json:goals[base2_4].text
