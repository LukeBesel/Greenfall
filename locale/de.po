msgstr "Alle fünf Planeten wiederherstellen"

#: data/goals.json:goals[home_drive_7].text
msgid "Build the Homeward rocket"
msgstr "Baue die Heimkehr-Rakete"

#: data/goals.json:goals[home_last_seed].text
