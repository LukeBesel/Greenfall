msgstr "SMOG  BRAUCHT DEN NEBELWÄSCHER"

#: planets/verdance/data/pollution.json:kinds.blight.name
msgid "Blight"
msgstr "Fäule"

#: planets/verdance/data/pollution.json:kinds.blight.cost.prompt
msgid "Blight needs cleansing plants: out of seeds."
msgstr "Fäule braucht reinigende Pflanzen: keine Samen mehr."

#: planets/verdance/data/pollution.json:kinds.blight.hint
msgid "BLIGHT  PLANT IT CLEAN"
msgstr "FÄULE  SAUBER PFLANZEN"

#: planets/verdance/data/pollution.json:kinds.blight.prompt
msgid "BLIGHT  NEEDS THE SOIL DOSER"
msgstr "FÄULE  BRAUCHT DEN BODENDOSIERER"

#: data/radio.json:songs[verdance_sprout].name data/songs.json:songs[sprout_step].title
msgid "Sprout Step"
msgstr "Sprossenschritt"

#: data/radio.json:songs[verdance_sprout].desc
msgid "Kalimba and bells, the first green on Verdance."
msgstr "Kalimba und Glocken, das erste Grün auf Verdance."

#: data/radio.json:songs[verdance_sweep].name data/songs.json:songs[clean_sweep].title
msgid "Clean Sweep"
msgstr "Großputz"

#: data/radio.json:songs[verdance_sweep].desc
msgid "Marimba and a four-on-the-floor kick: cleaning music."
msgstr "Marimba und ein durchgehender Bass-Kick: Aufräummusik."

#: data/radio.json:songs[ochre_sunbaked].name data/songs.json:songs[sunbaked].title
msgid "Sunbaked"
msgstr "Sonnenverbrannt"

#: data/radio.json:songs[ochre_sunbaked].desc
msgid "A sunny marimba hook over a lute ostinato."
msgstr "Ein sonniges Marimba-Motiv über einem Lauten-Ostinato."

#: data/radio.json:songs[ochre_sunbaked].hint
msgid "Land on Ochre"
msgstr "Lande auf Ochre"

#: data/radio.json:songs[ochre_caravan].name data/songs.json:songs[dune_caravan].title
msgid "Dune Caravan"
msgstr "Dünenkarawane"

#: data/radio.json:songs[ochre_caravan].desc
msgid "A winding pluck line over a loping frame drum."
msgstr "Eine verschlungene Zupflinie über einer gemächlichen Rahmentrommel."

#: data/radio.json:songs[ochre_caravan].hint
msgid "A base on Ochre at level 3"
msgstr "Eine Basis auf Ochre auf Stufe 3"

#: data/radio.json:songs[ochre_mirage].name
msgid "Mirage"
msgstr "Fata Morgana"

#: data/radio.json:songs[ochre_mirage].desc
msgid "Kalimba and bells shimmering in the heat."
msgstr "Kalimba und Glocken, flirrend in der Hitze."

#: data/radio.json:songs[ochre_mirage].hint
msgid "A base on Ochre at level 5"
msgstr "Eine Basis auf Ochre auf Stufe 5"

#: data/radio.json:songs[tidewell_tradewinds].name data/songs.json:songs[tradewinds].title
msgid "Tradewinds"
msgstr "Passatwinde"

#: data/radio.json:songs[tidewell_tradewinds].desc
msgid "Steel pans skipping over the waves."
msgstr "Steel Pans, die über die Wellen hüpfen."

#: data/radio.json:songs[tidewell_tradewinds].hint
msgid "Land on Tidewell"
msgstr "Lande auf Tidewell"

#: data/radio.json:songs[tidewell_tidepools].name data/songs.json:songs[tidepools].title
msgid "Tidepools"
msgstr "Gezeitentümpel"

#: data/radio.json:songs[tidewell_tidepools].desc
msgid "A harp melody over rolling arpeggios."
msgstr "Eine Harfenmelodie über wogenden Arpeggien."

#: data/radio.json:songs[tidewell_tidepools].hint
msgid "A base on Tidewell at level 3"
msgstr "Eine Basis auf Tidewell auf Stufe 3"

#: data/radio.json:songs[tidewell_skipper].name data/songs.json:songs[skipping_stones].title
msgid "Skipping Stones"
msgstr "Steine flitschen"

#: data/radio.json:songs[tidewell_skipper].desc
msgid "A bouncy marimba shuffle."
msgstr "Ein hüpfender Marimba-Shuffle."

#: data/radio.json:songs[tidewell_skipper].hint
msgid "A base on Tidewell at level 5"
msgstr "Eine Basis auf Tidewell auf Stufe 5"

#: data/radio.json:songs[rime_hoarfrost].name data/songs.json:songs[hoarfrost].title
msgid "Hoarfrost"
msgstr "Raureif"

#: data/radio.json:songs[rime_hoarfrost].desc
msgid "Glass bells that slowly gather warmth."
msgstr "Glasglocken, die langsam Wärme sammeln."

#: data/radio.json:songs[rime_hoarfrost].hint
msgid "Land on Rime"
msgstr "Lande auf Rime"

#: data/radio.json:songs[rime_aurora].desc
msgid "Piano doubled by glass under the northern lights."
msgstr "Klavier, gedoppelt von Glas, unter dem Nordlicht."

#: data/radio.json:songs[rime_aurora].hint
msgid "A base on Rime at level 5"
msgstr "Eine Basis auf Rime auf Stufe 5"

#: data/radio.json:songs[anvil_foundry].name data/songs.json:songs[foundry_heart].title
msgid "Foundry Heart"
msgstr "Herz der Gießerei"

#: data/radio.json:songs[anvil_foundry].desc
msgid "A dark, groovy forge that learns to hope."
msgstr "Eine dunkle, groovige Schmiede, die Hoffnung lernt."

#: data/radio.json:songs[anvil_foundry].hint
msgid "Land on Anvil"
msgstr "Lande auf Anvil"

#: data/radio.json:songs[anvil_ash].name data/songs.json:songs[ash_choir].title
msgid "Ash Choir"
msgstr "Aschechor"

#: data/radio.json:songs[anvil_ash].desc
msgid "An eerie choir over brass and embers."
msgstr "Ein unheimlicher Chor über Blech und Glut."

#: data/radio.json:songs[anvil_ash].hint
msgid "A base on Anvil at level 3"
msgstr "Eine Basis auf Anvil auf Stufe 3"

#: data/radio.json:songs[anvil_engine].name data/songs.json:songs[red_engine].title
msgid "Red Engine"
msgstr "Roter Motor"

#: data/radio.json:songs[anvil_engine].desc
msgid "Sub bass and metal hits, the furnaces running clean."
msgstr "Subbass und Metallschläge, die Öfen laufen sauber."

#: data/radio.json:songs[anvil_engine].hint
msgid "A base on Anvil at level 5"
msgstr "Eine Basis auf Anvil auf Stufe 5"

#: data/radio.json:songs[homecoming].desc
msgid "The ark's theme, for the journey home."
msgstr "Das Thema der Arche, für die Reise nach Hause."

#: data/radio.json:songs[homecoming].hint
msgid "Bring the Cradle home"
msgstr "Hol die Cradle nach Hause"

#: planets/verdance/data/research.json:story_unlocks[haul_rig].name
msgid "Haul Bug Plans"
msgstr "Haul-Bug-Pläne"

#: planets/verdance/data/research.json:story_unlocks[haul_rig].hint
msgid "Comes with the Bot Bay: a Haul Bug carries your bales to the scale."
msgstr "Kommt mit der Bot-Bucht: Ein Haul Bug trägt deine Ballen zur Waage."

#: planets/verdance/data/research.json:story_unlocks[scoopie_rig].name
msgid "Scoopie Plans"
msgstr "Scoopie-Pläne"

#: planets/verdance/data/research.json:story_unlocks[scoopie_rig].hint
msgid "WREN is looking for Scoopie plans. Keep your Haul Bug busy."
msgstr "WREN sucht nach Scoopie-Plänen. Halt deinen Haul Bug auf Trab."

#: planets/verdance/data/research.json:story_unlocks[skimmer_rig].name
msgid "Skimmer Plans"
msgstr "Skimmer-Pläne"

#: planets/verdance/data/research.json:story_unlocks[skimmer_rig].hint
msgid "Comes later: WREN will send Skimmer plans once the land is greening."
msgstr "Kommt später: WREN schickt Skimmer-Pläne, sobald das Land grünt."

#: planets/verdance/data/research.json:story_unlocks[scrounger_rig].name
msgid "Scrounger Plans"
msgstr "Scrounger-Pläne"

#: planets/verdance/data/research.json:story_unlocks[scrounger_rig].hint
msgid "Comes with the second city: WREN will send plans for a parts finder."
msgstr "Kommt mit der zweiten Stadt: WREN schickt Pläne für einen Teilesucher."

#: planets/verdance/data/research.json:branches[robotics].name
msgid "Robotics"
msgstr "Robotik"

#: planets/verdance/data/research.json:branches[botany].name
msgid "Botany"
msgstr "Botanik"

#: planets/verdance/data/research.json:branches[hydrology].name
msgid "Hydrology"
msgstr "Hydrologie"

#: planets/verdance/data/research.json:branches[logistics].name
msgid "Logistics"
msgstr "Logistik"

#: planets/verdance/data/research.json:nodes[scoop_beam].name
msgid "Scoop Beam"
msgstr "Schaufelstrahl"

#: planets/verdance/data/research.json:nodes[scoop_beam].desc
msgid "A soft blue guide beam on the scoop. Lumi reaches a little further."
msgstr "Ein sanfter blauer Leitstrahl an der Schaufel. Lumi reicht ein bisschen weiter."

#: planets/verdance/data/research.json:nodes[wide_beam].name
msgid "Wide Beam"
msgstr "Breiter Strahl"

#: planets/verdance/data/research.json:nodes[wide_beam].desc
msgid "Spread the beam into a fan. Each sweep catches more."
msgstr "Fächert den Strahl auf. Jeder Schwung erwischt mehr."

#: planets/verdance/data/research.json:nodes[bigger_hopper].name
msgid "Bigger Hopper"
msgstr "Größerer Trichter"

#: planets/verdance/data/research.json:nodes[bigger_hopper].desc
msgid "Fold-out side panels for the chest compartment."
msgstr "Ausklappbare Seitenteile für das Brustfach."

#: planets/verdance/data/research.json:nodes[auto_sort].name
msgid "Auto-Sort"
msgstr "Auto-Sortierung"

#: planets/verdance/data/research.json:nodes[auto_sort].desc
msgid "A little sorting comb in the intake. Cleaner bales sell for more."
msgstr "Ein kleiner Sortierkamm im Einlass. Sauberere Ballen bringen mehr."

#: planets/verdance/data/research.json:nodes[field_magnet].name
msgid "Field Magnet"
msgstr "Feldmagnet"

#: planets/verdance/data/research.json:nodes[field_magnet].desc
msgid "Loose bits hop toward the scoop on their own."
msgstr "Lose Teile hüpfen von selbst zur Schaufel."

#: planets/verdance/data/research.json:nodes[tractor_beam].name
msgid "Tractor Beam"
msgstr "Traktorstrahl"

#: planets/verdance/data/research.json:nodes[tractor_beam].desc
msgid "Junk lifts, floats and glides into the hopper. It is very satisfying."
msgstr "Schrott hebt ab, schwebt und gleitet in den Trichter. Sehr befriedigend."

#: planets/verdance/data/research.json:nodes[salvage_logic].name
msgid "Salvage Logic"
msgstr "Bergungslogik"

#: planets/verdance/data/research.json:nodes[salvage_logic].desc
msgid "Lumi rewrites the base's old assembly logic. The base can build helpers again."
msgstr "Lumi schreibt die alte Montagelogik der Basis neu. Die Basis kann wieder Helfer bauen."

#: planets/verdance/data/research.json:nodes[seedling_blueprint].name
msgid "Seedling Blueprint"
msgstr "Seedling-Bauplan"

#: planets/verdance/data/research.json:nodes[seedling_blueprint].desc
msgid "Plans for a small planter bot. Build it at the workbench."
msgstr "Pläne für einen kleinen Pflanzbot. Bau ihn an der Werkbank."

#: planets/verdance/data/research.json:nodes[drip_blueprint].name
msgid "Drip Blueprint"
msgstr "Drip-Bauplan"

#: planets/verdance/data/research.json:nodes[drip_blueprint].desc
msgid "A watering bot with a sloshy tank. Plants will love it."
msgstr "Ein Gießbot mit schwappendem Tank. Die Pflanzen werden ihn lieben."

#: planets/verdance/data/research.json:nodes[bale_tuning].name
msgid "Bale Tuning"
msgstr "Ballen-Tuning"

#: planets/verdance/data/research.json:nodes[bale_tuning].desc
msgid "Tighter presses on every Scoopie. Bigger, denser bales."
msgstr "Strammere Pressen an jedem Scoopie. Größere, dichtere Ballen."

#: planets/verdance/data/research.json:nodes[multibot_blueprint].name
msgid "Multibot Blueprint"
msgstr "Multibot-Bauplan"

#: planets/verdance/data/research.json:nodes[multibot_blueprint].desc
msgid "A helper that can clean, plant or water. Jack of all trades."
msgstr "Ein Helfer, der putzen, pflanzen oder gießen kann. Ein Tausendsassa."

#: planets/verdance/data/research.json:nodes[swarm_sync].name
msgid "Swarm Sync"
msgstr "Schwarm-Sync"

#: planets/verdance/data/research.json:nodes[swarm_sync].desc
msgid "The whole fleet shares one little heartbeat. Everyone moves faster."
msgstr "Die ganze Flotte teilt einen kleinen Herzschlag. Alle bewegen sich schneller."

#: planets/verdance/data/research.json:nodes[soil_survey].name
msgid "Soil Survey"
msgstr "Bodenuntersuchung"

#: planets/verdance/data/research.json:nodes[soil_survey].desc
msgid "Sniff, poke, log. Every reading teaches Lumi something."
msgstr "Schnuppern, stochern, notieren. Jede Messung lehrt Lumi etwas."

#: planets/verdance/data/research.json:nodes[hardy_weeds].name
msgid "Hardy Nettles"
msgstr "Robuste Nesseln"

#: planets/verdance/data/research.json:nodes[hardy_weeds].desc
msgid "Nettles grow anywhere. Stingy, stubborn, and good for the soil."
msgstr "Brennnesseln wachsen überall. Pieksig, stur und gut für den Boden."

#: planets/verdance/data/research.json:nodes[wild_mint].desc
msgid "A fresh green smell drifts over the cleared hexes."
msgstr "Ein frischer grüner Duft weht über die geräumten Hexfelder."

#: planets/verdance/data/research.json:nodes[pollinator_survey].name
msgid "Pollinator Survey"
msgstr "Bestäuberzählung"

#: planets/verdance/data/research.json:nodes[pollinator_survey].desc
msgid "Count the visitors. The bees are back: every plant grows much faster, blooms drop more seeds, and Seedlings learn where flowers want to be."
msgstr "Zähl die Besucher. Die Bienen sind zurück: Jede Pflanze wächst viel schneller, Blüten geben mehr Samen, und Seedlings lernen, wo Blumen stehen wollen."

#: planets/verdance/data/research.json:nodes[hedgerows].name
msgid "Hedgerows"
msgstr "Hecken"

#: planets/verdance/data/research.json:nodes[hedgerows].desc
msgid "Dense little hedges. Birds will need somewhere to sit. Gardens grow a little faster again."
msgstr "Dichte kleine Hecken. Vögel brauchen einen Platz zum Sitzen. Gärten wachsen noch etwas schneller."

#: planets/verdance/data/research.json:nodes[evergreens].name
msgid "Evergreen Saplings"
msgstr "Immergrüne Setzlinge"

#: planets/verdance/data/research.json:nodes[evergreens].desc
msgid "Tiny pines. In a hundred years, a forest. Blooms drop more seeds."
msgstr "Winzige Kiefern. In hundert Jahren ein Wald. Blüten geben mehr Samen."

#: planets/verdance/data/research.json:nodes[water_testing].name
msgid "Water Testing"
msgstr "Wassertests"

#: planets/verdance/data/research.json:nodes[water_testing].desc
msgid "Dip strips and a lot of squinting. The lakes are sick, not dead."
msgstr "Teststreifen und viel Blinzeln. Die Seen sind krank, nicht tot."

#: planets/verdance/data/research.json:nodes[big_tanks].name
msgid "Big Tanks"
msgstr "Große Tanks"

#: planets/verdance/data/research.json:nodes[big_tanks].desc
msgid "Drip and Multibot carry more water per trip."
msgstr "Drip und Multibot tragen mehr Wasser pro Fahrt."

#: planets/verdance/data/research.json:nodes[spray_heads].name
msgid "Spray Heads"
msgstr "Sprühköpfe"

#: planets/verdance/data/research.json:nodes[spray_heads].desc
msgid "A misting nozzle. Water bots reach further and work faster."
msgstr "Eine Nebeldüse. Gießbots reichen weiter und arbeiten schneller."

#: planets/verdance/data/research.json:nodes[silt_filters].name
msgid "Silt Filters"
msgstr "Schlickfilter"

#: planets/verdance/data/research.json:nodes[silt_filters].desc
msgid "Layered sand and charcoal. Murky water turns glassy."
msgstr "Schichten aus Sand und Kohle. Trübes Wasser wird glasklar."

#: planets/verdance/data/research.json:nodes[pump_lines].name
msgid "Pump Lines"
msgstr "Pumpleitungen"

#: planets/verdance/data/research.json:nodes[pump_lines].desc
msgid "Hoses from the lake to the hub. Water bots refill faster."
msgstr "Schläuche vom See zur Basis. Gießbots tanken schneller."

#: planets/verdance/data/research.json:nodes[irrigation].name
msgid "Irrigation"
msgstr "Bewässerung"

#: planets/verdance/data/research.json:nodes[irrigation].desc
msgid "Buried drip lines. The meadow drinks while you sleep."
msgstr "Vergrabene Tropfschläuche. Die Wiese trinkt, während du schläfst."

#: planets/verdance/data/research.json:nodes[field_notebook].name
msgid "Field Notebook"
msgstr "Feldnotizbuch"

#: planets/verdance/data/research.json:nodes[field_notebook].desc
msgid "Lumi starts keeping tidy notes. Research goes a bit quicker."
msgstr "Lumi fängt an, ordentliche Notizen zu führen. Forschung geht etwas schneller."

#: planets/verdance/data/research.json:nodes[conveyor].name
msgid "Conveyor Belts"
msgstr "Förderbänder"

#: planets/verdance/data/research.json:nodes[conveyor].desc
msgid "Rollers salvaged from an old shop till. Bales can ride to the scale."
msgstr "Rollen aus einer alten Ladenkasse. Ballen können zur Waage fahren."

#: planets/verdance/data/research.json:nodes[auto_baler].name
msgid "Auto-Baler"
msgstr "Auto-Presse"

#: planets/verdance/data/research.json:nodes[auto_baler].desc
msgid "A hub station that presses loose junk into bales by itself."
msgstr "Eine Basisstation, die losen Schrott selbst zu Ballen presst."

#: planets/verdance/data/research.json:nodes[haul_routes].name
msgid "Haul Routes"
msgstr "Fahrrouten"

#: planets/verdance/data/research.json:nodes[haul_routes].desc
msgid "Painted lines on the ground. Haul Bugs stop bumping into each other."
msgstr "Aufgemalte Linien am Boden. Haul Bugs stoßen nicht mehr zusammen."

#: planets/verdance/data/research.json:nodes[recycler].name planets/verdance/data/stations.json:recycler.name
msgid "Recycler"
msgstr "Recycler"

#: planets/verdance/data/research.json:nodes[recycler].desc
msgid "Grind bales back into clean stock. Junk gone for good."
msgstr "Zermahlt Ballen wieder zu sauberem Rohstoff. Schrott für immer weg."

#: planets/verdance/data/research.json:nodes[rocket_cargo].name
msgid "Rocket Cargo"
msgstr "Raketenfracht"

#: planets/verdance/data/research.json:nodes[rocket_cargo].desc
msgid "Cargo pods for the rocket. Hubs can trade with each other."
msgstr "Frachtkapseln für die Rakete. Basen können miteinander handeln."

#: planets/verdance/data/research.json:nodes[dune_charts].name
msgid "Dune Charts"
msgstr "Dünenkarten"

#: planets/verdance/data/research.json:nodes[dune_charts].desc
msgid "Wind maps and landing beacons for the far deserts. The rocket can reach the Dust Flats (with two bases at level 5)."
msgstr "Windkarten und Landefeuer für die fernen Wüsten. Die Rakete erreicht die Staubebene (mit zwei Basen auf Stufe 5)."

#: planets/verdance/data/research.json:nodes[thermal_lance].name
msgid "Thermal Lance"
msgstr "Thermolanze"

#: planets/verdance/data/research.json:nodes[thermal_lance].desc
msgid "A heat coil wound round the beam. Lumi melts ice twice as fast, and the rocket can land at the Frozen Port."
msgstr "Eine Heizspule um den Strahl. Lumi schmilzt Eis doppelt so schnell, und die Rakete kann im Eishafen landen."

#: planets/verdance/data/research.json:nodes[heat_pumps].name
msgid "Heat Pumps"
msgstr "Wärmepumpen"

#: planets/verdance/data/research.json:nodes[heat_pumps].desc
msgid "Heaters pull warmth out of the frozen harbour itself. They thaw faster and warm their neighbours more."
msgstr "Heizer ziehen Wärme aus dem gefrorenen Hafen selbst. Sie tauen schneller und wärmen ihre Nachbarn stärker."

#: planets/verdance/data/research.json:nodes[dune_fences].name
msgid "Dune Fences"
msgstr "Dünenzäune"

#: planets/verdance/data/research.json:nodes[dune_fences].desc
msgid "Brush fences and hedges that break the wind. Sustained hexes shelter two rings around them, and sandstorms carry less."
msgstr "Reisigzäune und Hecken, die den Wind brechen. Stabile Hexfelder schützen zwei Ringe um sich, und Sandstürme tragen weniger."

#: planets/verdance/data/research.json:nodes[cold_hardy_seeds].name
msgid "Cold-Hardy Seeds"
msgstr "Kälteresistente Samen"

#: planets/verdance/data/research.json:nodes[cold_hardy_seeds].desc
msgid "Seeds bred from the few things that survived the cold. Ferns, nettles, pines, periwinkle and frost moss can grow outdoors at the Frozen Port."
msgstr "Samen, gezüchtet aus dem Wenigen, das die Kälte überlebt hat. Farne, Brennnesseln, Kiefern, Vinca und Frostmoos wachsen im Eishafen im Freien."

#: planets/verdance/data/research.json:nodes[dew_condensers].name
msgid "Dew Condensers"
msgstr "Taukondensatoren"

#: planets/verdance/data/research.json:nodes[dew_condensers].desc
msgid "Cold fins on every Water Tank pull water out of the night air. Tanks refill much faster where the ground is dry."
msgstr "Kalte Rippen an jedem Wassertank ziehen Wasser aus der Nachtluft. Tanks füllen sich auf trockenem Boden viel schneller."

#: planets/verdance/data/research.json:nodes[pump_works].name
msgid "Pump Works"
msgstr "Pumpwerke"

#: planets/verdance/data/research.json:nodes[pump_works].desc
msgid "Plans for the old city pumps. The rocket can reach the Sunken City, and Skimmers net faster."
msgstr "Pläne für die alten Stadtpumpen. Die Rakete erreicht die Versunkene Stadt, und Skimmer fischen schneller."

#: planets/verdance/data/research.json:nodes[ark_beacon].name
msgid "Ark Beacon"
msgstr "Arche-Leuchtfeuer"

#: planets/verdance/data/research.json:nodes[ark_beacon].desc
msgid "A landing beacon tuned to the Cradle. Once the three frontiers are thriving, it calls the ark home."
msgstr "Ein Landefeuer, abgestimmt auf die Cradle. Sobald die drei Grenzgebiete blühen, ruft es die Arche heim."

#: planets/verdance/data/restoration.json:planet.steps[first_green].name
msgid "First green"
msgstr "Erstes Grün"

#: planets/verdance/data/restoration.json:planet.steps[green_belt].name
msgid "Green belt"
msgstr "Grüngürtel"

#: planets/verdance/data/restoration.json:planet.steps[quarter_alive].name
msgid "A quarter alive"
msgstr "Zu einem Viertel lebendig"

#: planets/verdance/data/restoration.json:planet.steps[half_alive].name
msgid "Half the world"
msgstr "Die halbe Welt"

#: planets/verdance/data/restoration.json:planet.steps[whole_planet].name
msgid "The whole planet"
msgstr "Der ganze Planet"

#: planets/verdance/data/rigs.json:slots[arm].name
msgid "Arm"
msgstr "Arm"

#: planets/verdance/data/rigs.json:slots[chest].name
msgid "Chest"
msgstr "Brustfach"

#: planets/verdance/data/rigs.json:slots[drive].name
msgid "Drive"
msgstr "Antrieb"

#: planets/verdance/data/rigs.json:modules.plate_cutter.name
msgid "Plate Cutter"
msgstr "Plattenschneider"

#: planets/verdance/data/rigs.json:modules.plate_cutter.desc
msgid "A salvaged cutting head. Slices wrecks into pieces Lumi can lift. Narrow."
msgstr "Ein geborgener Schneidkopf. Zerteilt Wracks in Stücke, die Lumi heben kann. Schmal."

#: planets/verdance/data/rigs.json:modules.wide_sweep.name
msgid "Wide Sweep"
msgstr "Breitfeger"

#: planets/verdance/data/rigs.json:modules.wide_sweep.desc
msgid "A broad intake fan. Sweeps a wide path of loose junk, but only close up."
msgstr "Ein breiter Ansaugfächer. Fegt eine breite Bahn losen Schrott, aber nur aus der Nähe."

#: planets/verdance/data/rigs.json:modules.long_reach.name
msgid "Long Reach"
msgstr "Langer Arm"

#: planets/verdance/data/rigs.json:modules.long_reach.desc
msgid "A telescoping boom. Pulls junk in from far off and skims well from the bank. Thin beam."
msgstr "Ein Teleskopausleger. Zieht Schrott von weit her an und schöpft gut vom Ufer aus ab. Dünner Strahl."

#: planets/verdance/data/rigs.json:modules.guide_arm.name
msgid "Guide Arm"
msgstr "Leitarm"

#: planets/verdance/data/rigs.json:modules.guide_arm.desc
msgid "A signal paddle. Robots working near Lumi get three times the boost from her. Her own scoop slows."
msgstr "Eine Signalkelle. Roboter in Lumis Nähe bekommen den dreifachen Schub. Die eigene Schaufel wird langsamer."

#: planets/verdance/data/rigs.json:modules.deep_hold.name
msgid "Deep Hold"
msgstr "Tiefer Bunker"

#: planets/verdance/data/rigs.json:modules.deep_hold.desc
msgid "A bigger hopper bolted under the chest. Fewer trips to the scale. Heavy."
msgstr "Ein größerer Trichter, unter das Brustfach geschraubt. Weniger Wege zur Waage. Schwer."

#: planets/verdance/data/rigs.json:modules.press_frame.name
msgid "Press Frame"
msgstr "Pressrahmen"

#: planets/verdance/data/rigs.json:modules.press_frame.desc
msgid "Stiff press rails. Bales come out tighter and pay more. Less room inside."
msgstr "Steife Pressschienen. Ballen werden fester und bringen mehr ein. Weniger Platz innen."

#: planets/verdance/data/rigs.json:modules.mist_scrubber.name
msgid "Mist Scrubber"
msgstr "Nebelwäscher"

#: planets/verdance/data/rigs.json:modules.mist_scrubber.desc
msgid "A filter drum and spray bar. Turns the can's water into a mist that scrubs smog. The drum takes chest room."
msgstr "Eine Filtertrommel mit Sprühbalken. Macht aus dem Wasser der Kanne einen Nebel, der Smog auswäscht. Die Trommel braucht Platz im Brustfach."

#: planets/verdance/data/rigs.json:modules.sorter.name
msgid "Sorter"
msgstr "Sortierer"

#: planets/verdance/data/rigs.json:modules.sorter.desc
msgid "A sorting tray. Picks out far more parts worth keeping, for more robots. Bales pay a little less."
msgstr "Ein Sortiertablett. Findet viel mehr brauchbare Teile, für mehr Roboter. Ballen bringen etwas weniger ein."

#: planets/verdance/data/rigs.json:modules.sprint_coils.name
msgid "Sprint Coils"
msgstr "Sprintspulen"

#: planets/verdance/data/rigs.json:modules.sprint_coils.desc
msgid "Rewound hover coils. Much faster over ground. They take a little chest room."
msgstr "Neu gewickelte Schwebespulen. Viel schneller über Land. Sie brauchen etwas Platz im Brustfach."

#: planets/verdance/data/rigs.json:modules.skim_skirt.name
msgid "Skim Skirt"
msgstr "Schöpfschürze"

#: planets/verdance/data/rigs.json:modules.skim_skirt.desc
msgid "A float skirt with a skimming lip. Carries Lumi over water and lifts slick off it. Slower on land."
msgstr "Eine Schwimmschürze mit Schöpflippe. Trägt Lumi übers Wasser und hebt den Ölteppich ab. Langsamer an Land."

#: planets/verdance/data/rigs.json:modules.tow_hitch.name
msgid "Tow Hitch"
msgstr "Anhängerkupplung"

#: planets/verdance/data/rigs.json:modules.tow_hitch.desc
msgid "A bale rack on the back. Carries two more bales a trip. Slower."
msgstr "Ein Ballengestell am Rücken. Trägt zwei Ballen mehr pro Weg. Langsamer."

#: planets/verdance/data/rigs.json:modules.soil_doser.name
msgid "Soil Doser"
msgstr "Bodendosierer"

#: planets/verdance/data/rigs.json:modules.soil_doser.desc
msgid "A dosing bar under the hover ring. Feeds the cleansing plants that draw blight out of the soil. Slower."
msgstr "Ein Dosierbalken unter dem Schwebering. Nährt die reinigenden Pflanzen, die die Fäule aus dem Boden ziehen. Langsamer."

#: planets/verdance/data/rigs.json:modules.relay_mast.name
msgid "Relay Mast"
msgstr "Relaismast"

#: planets/verdance/data/rigs.json:modules.relay_mast.desc
msgid "A tall relay on the back. Robots much further away still get a boost from Lumi, and the detector sees further. Slower."
msgstr "Ein hohes Relais am Rücken. Auch weit entfernte Roboter bekommen noch einen Schub von Lumi, und der Detektor sieht weiter. Langsamer."

#: data/robot_parts.json:stats[speed].name
msgid "Speed"
msgstr "Tempo"

#: data/robot_parts.json:stats[load].name
msgid "Load"
msgstr "Last"

#: data/robot_parts.json:stats[work].name
msgid "Work rate"
msgstr "Arbeitsrate"

#: data/robot_parts.json:stats[quality].name
msgid "Cube quality"
msgstr "Würfelqualität"

#: data/robot_parts.json:stats[reach].name
msgid "Spray reach"
msgstr "Sprühweite"

#: data/robot_parts.json:stats[scan].name
msgid "Scan"
msgstr "Scan"

#: data/robot_parts.json:set_bonus.name
msgid "Maker Resonance"
msgstr "Erbauer-Resonanz"

#: data/robot_parts.json:set_bonus.desc
msgid "All three Maker parts fitted: +5% speed, +6% work."
msgstr "Alle drei Erbauer-Teile montiert: +5% Tempo, +6% Arbeit."

#: data/robot_parts.json:parts[light_frame].desc
msgid "Slim exposed rails instead of a full shell."
msgstr "Schlanke offene Streben statt einer vollen Hülle."

#: data/robot_parts.json:parts[cargo_hull].desc
msgid "Thick side plates and a rear rack."
msgstr "Dicke Seitenplatten und ein Heckträger."

#: data/robot_parts.json:parts[sealed_shell].desc
msgid "Smooth covers, neat seams, no grit."
msgstr "Glatte Abdeckungen, saubere Nähte, kein Dreck."

#: data/robot_parts.json:parts[maker_shell].desc
msgid "Pearl fairings with gold trim, as the Makers built them. Part of the Maker set."
msgstr "Perlmuttverkleidung mit Goldrand, wie die Erbauer sie bauten. Teil des Erbauer-Sets."

#: data/robot_parts.json:parts[big_eye].desc
msgid "A huge lens on a stalk."
msgstr "Eine riesige Linse auf einem Stiel."

#: data/robot_parts.json:parts[focus_visor].desc
msgid "Blinkers for robots."
msgstr "Scheuklappen für Roboter."

#: data/robot_parts.json:parts[periscope].desc
msgid "Sees over the plants. Mostly."
msgstr "Sieht über die Pflanzen. Meistens."

#: data/robot_parts.json:parts[chatter_dome].desc
msgid "Glass dome with a little speaker."
msgstr "Glaskuppel mit kleinem Lautsprecher."

#: data/robot_parts.json:parts[maker_optic].desc
msgid "A floating gem lens under a gold brow. Part of the Maker set."
msgstr "Eine schwebende Edelsteinlinse unter einer goldenen Braue. Teil des Erbauer-Sets."

#: data/robot_parts.json:parts[treads].desc
msgid "Rubber tracks."
msgstr "Gummiketten."

#: data/robot_parts.json:parts[rotor].desc
msgid "Four ducted fans."
msgstr "Vier Mantelpropeller."

#: data/robot_parts.json:parts[legs].desc
msgid "Four careful legs."
msgstr "Vier vorsichtige Beine."

#: data/robot_parts.json:parts[hover_skirt].desc
msgid "A cushion of air and a soft glow underneath."
msgstr "Ein Luftkissen und ein sanftes Leuchten darunter."

#: data/robot_parts.json:parts[maker_glider].desc
msgid "Twin levitation pods with a thin light seam. Part of the Maker set."
msgstr "Zwei Schwebekapseln mit einer feinen Lichtnaht. Teil des Erbauer-Sets."

#: data/robot_parts.json:parts[wide_scoop].desc
msgid "A big, wide scoop."
msgstr "Eine große, breite Schaufel."

#: data/robot_parts.json:parts[fine_sieve].desc
msgid "A sieve that shakes out the dirt."
msgstr "Ein Sieb, das den Dreck ausschüttelt."

#: data/robot_parts.json:parts[long_forks].desc
msgid "Extra-long forks."
msgstr "Extralange Gabeln."

#: data/robot_parts.json:parts[tow_hook].desc
msgid "Winch and hook."
msgstr "Seilwinde und Haken."

#: data/robot_parts.json:parts[seed_drill].desc
msgid "An auger nose."
msgstr "Eine Bohrernase."

#: data/robot_parts.json:parts[mist_sprayer].desc
msgid "A fan nozzle."
msgstr "Eine Fächerdüse."

#: data/robot_parts.json:parts[jet_nozzle].desc
msgid "A strong, straight jet nozzle."
msgstr "Eine kräftige, gerade Strahldüse."

#: data/robot_parts.json:parts[antenna].desc
msgid "A springy antenna with a soft glowing bulb."
msgstr "Eine federnde Antenne mit einer sanft leuchtenden Kugel."

#: data/robot_parts.json:parts[top_hat].desc
msgid "For the robot who means business."
msgstr "Für den Roboter, der es ernst meint."

#: data/robot_parts.json:parts[crew_flag].desc
msgid "A little flag in the crew's colour."
msgstr "Ein kleines Fähnchen in der Farbe der Crew."

#: data/robot_parts.json:parts[bobble_plant].desc
msgid "A sprout on a spring. Boings when it brakes."
msgstr "Ein Spross auf einer Feder. Macht „boing“, wenn er bremst."

#: data/robot_parts.json:parts[traffic_cone].desc
msgid "Found it, kept it, wears it."
msgstr "Gefunden, behalten, getragen."

#: data/robot_parts.json:parts[propeller_cap].desc
msgid "Spins when it hurries. Does not help."
msgstr "Dreht sich, wenn er es eilig hat. Hilft nicht."

#: data/robot_parts.json:parts[lucky_clover].desc
msgid "A four-leaf clover that floats. Rare: a robot has to spot one."
msgstr "Ein schwebendes vierblättriges Kleeblatt. Selten: Ein Roboter muss eins entdecken."

#: data/robot_parts.json:parts[maker_crest].desc
msgid "A floating gold ring. Purely for show; the Makers loved a show."
msgstr "Ein schwebender goldener Ring. Reine Show; die Erbauer liebten Show."

#: data/robot_parts.json:traits[cautious].name
msgid "Cautious"
msgstr "Vorsichtig"

#: data/robot_parts.json:traits[cautious].desc
msgid "Looks both ways. Twice."
msgstr "Schaut nach links und rechts. Zweimal."

#: data/robot_parts.json:traits[speedy].name
msgid "Speedy"
msgstr "Flott"

#: data/robot_parts.json:traits[speedy].desc
msgid "Always in a hurry, sometimes a messy one."
msgstr "Immer in Eile, manchmal in chaotischer."

#: data/robot_parts.json:traits[chatty].name
msgid "Chatty"
msgstr "Gesprächig"

#: data/robot_parts.json:traits[chatty].desc
msgid "Beeps at everything. Mostly at you."
msgstr "Piept alles an. Meistens dich."

#: data/robot_parts.json:traits[sleepy].desc
msgid "Dozes off whenever it parks."
msgstr "Döst ein, sobald er parkt."

#: data/robot_parts.json:traits[tidy].name
msgid "Tidy"
msgstr "Ordentlich"

#: data/robot_parts.json:traits[tidy].desc
msgid "Shakes the dust off after every job."
msgstr "Schüttelt nach jedem Job den Staub ab."

#: data/robot_parts.json:traits[curious].desc
msgid "Tilts its head at butterflies and bottle caps."
msgstr "Legt den Kopf schief bei Schmetterlingen und Kronkorken."

#: data/robot_parts.json:traits[hummer].name
msgid "Musical"
msgstr "Musikalisch"

#: data/robot_parts.json:traits[hummer].desc
msgid "Hums little tunes while it works."
msgstr "Summt bei der Arbeit kleine Melodien."

#: planets/verdance/data/robots.json:types[scoopie].name
msgid "Scoopie"
msgstr "Scoopie"

#: planets/verdance/data/robots.json:types[scoopie].desc
msgid "Small cleaner. Picks junk in its hex and leaves bales behind."
msgstr "Kleiner Putzer. Sammelt Schrott in seinem Hexfeld und hinterlässt Ballen."

#: planets/verdance/data/robots.json:types[scoopie].upgrades[0].name planets/verdance/data/robots.json:types[haulbug].upgrades[0].name planets/verdance/data/robots.json:types[scrounger].upgrades[0].name
#: planets/verdance/data/robots.json:types[seedling].upgrades[0].name planets/verdance/data/robots.json:types[drip].upgrades[0].name planets/verdance/data/robots.json:types[multibot].upgrades[0].name
msgid "Drive Motors"
msgstr "Antriebsmotoren"

#: planets/verdance/data/robots.json:types[scoopie].upgrades[0].unit planets/verdance/data/robots.json:types[haulbug].upgrades[0].unit planets/verdance/data/robots.json:types[scrounger].upgrades[0].unit
#: planets/verdance/data/robots.json:types[seedling].upgrades[0].unit planets/verdance/data/robots.json:types[drip].upgrades[0].unit planets/verdance/data/robots.json:types[skimmer].upgrades[0].unit
#: planets/verdance/data/robots.json:types[multibot].upgrades[0].unit planets/verdance/data/upgrades.json:upgrades[tread_speed].unit
msgid " m/s"
msgstr " m/s"

#: planets/verdance/data/robots.json:types[scoopie].upgrades[1].name
msgid "Arm Servos"
msgstr "Arm-Servos"

#: planets/verdance/data/robots.json:types[scoopie].upgrades[1].unit planets/verdance/data/robots.json:types[seedling].upgrades[1].unit planets/verdance/data/robots.json:types[drip].upgrades[3].unit
#: planets/verdance/data/robots.json:types[skimmer].upgrades[1].unit planets/verdance/data/upgrades.json:upgrades[scoop_speed].unit
msgid "/s"
msgstr "/s"

#: planets/verdance/data/robots.json:types[scoopie].upgrades[3].name
msgid "Compactor Tune"
msgstr "Verdichter-Tuning"

#: planets/verdance/data/robots.json:types[scoopie].upgrades[3].unit planets/verdance/data/upgrades.json:upgrades[compactor_pressure].unit planets/verdance/data/upgrades.json:upgrades[belt_speed].unit
#: planets/verdance/data/upgrades.json:upgrades[baler_speed].unit planets/verdance/data/upgrades.json:upgrades[recycler_yield].unit
msgid "x"
msgstr "x"

#: planets/verdance/data/robots.json:types[haulbug].name
msgid "Haul Bug"
msgstr "Haul Bug"

#: planets/verdance/data/robots.json:types[haulbug].desc
msgid "Fork cart. Carries loose bales to the scale."
msgstr "Gabelwagen. Bringt lose Ballen zur Waage."

#: planets/verdance/data/robots.json:types[haulbug].upgrades[1].name
msgid "Longer Forks"
msgstr "Längere Gabeln"

#: planets/verdance/data/robots.json:types[scrounger].name
msgid "Scrounger"
msgstr "Scrounger"

#: planets/verdance/data/robots.json:types[scrounger].desc
msgid "Parts finder. Digs buried parts out of cleaned ground in its search area and carries them to the base."
msgstr "Teilesucher. Gräbt in seinem Suchgebiet vergrabene Teile aus gereinigtem Boden und trägt sie zur Basis."

#: planets/verdance/data/robots.json:types[scrounger].upgrades[1].name
msgid "Bigger Sack"
msgstr "Größerer Sack"

#: planets/verdance/data/robots.json:types[seedling].name
msgid "Seedling"
msgstr "Seedling"

#: planets/verdance/data/robots.json:types[seedling].desc
msgid "Plants seeds in clean ground. Uses your seed stock."
msgstr "Pflanzt Samen in sauberen Boden. Nutzt deinen Samenvorrat."

#: planets/verdance/data/robots.json:types[drip].name
msgid "Drip"
msgstr "Drip"

#: planets/verdance/data/robots.json:types[drip].desc
msgid "Waters the thirstiest plants in its zone with a spray arc. Refills at the base barrel, a Water Tank or a clean lake."
msgstr "Gießt mit einem Sprühbogen die durstigsten Pflanzen seiner Zone. Tankt am Basisfass, an einem Wassertank oder an einem sauberen See."

#: planets/verdance/data/robots.json:types[drip].upgrades[1].name
msgid "Bigger Tank"
msgstr "Größerer Tank"

#: planets/verdance/data/robots.json:types[drip].upgrades[2].name
msgid "Wide Nozzle"
msgstr "Breite Düse"

#: planets/verdance/data/robots.json:types[drip].upgrades[2].unit planets/verdance/data/upgrades.json:upgrades[scoop_width].unit planets/verdance/data/upgrades.json:upgrades[magnet_arm].unit
#: planets/verdance/data/upgrades.json:upgrades[detector_range].unit planets/verdance/data/upgrades.json:upgrades[laser_reach].unit
msgid " m"
msgstr " m"

#: planets/verdance/data/robots.json:types[drip].upgrades[3].name
msgid "Fast Pump"
msgstr "Schnelle Pumpe"

#: planets/verdance/data/robots.json:types[skimmer].name
msgid "Skimmer"
msgstr "Skimmer"

#: planets/verdance/data/robots.json:types[skimmer].desc
msgid "Hover pontoon bot with a net arm. Skims floating junk off the lake and leaves bales on the shore for haulers."
msgstr "Schwebeponton-Bot mit Netzarm. Schöpft treibenden Schrott vom See und lässt Ballen am Ufer für die Fahrer."

#: planets/verdance/data/robots.json:types[skimmer].upgrades[0].name
msgid "Hover Fans"
msgstr "Schwebelüfter"

#: planets/verdance/data/robots.json:types[skimmer].upgrades[1].name
msgid "Net Winch"
msgstr "Netzwinde"

#: planets/verdance/data/robots.json:types[skimmer].upgrades[2].name
msgid "Bigger Net"
msgstr "Größeres Netz"

#: planets/verdance/data/robots.json:types[multibot].name
msgid "Multibot"
msgstr "Multibot"

#: planets/verdance/data/robots.json:types[multibot].desc
msgid "General helper. Assign it to Clean, Plant or Water on the Allocation Board. Slower than a specialist."
msgstr "Allroundhelfer. Teil ihn auf der Zuteilungstafel zum Putzen, Pflanzen oder Gießen ein. Langsamer als ein Spezialist."

#: planets/verdance/data/robots.json:tiers[1].name
msgid "Repaired"
msgstr "Repariert"

#: planets/verdance/data/robots.json:chain.assembler.desc
msgid "An old factory line, running again. Parts go in at the loading bay, robots roll out of the door, one at a time, in the mix you set."
msgstr "Ein altes Fließband, das wieder läuft. Teile kommen an der Laderampe hinein, Roboter rollen einzeln aus dem Tor, in dem Mix, den du einstellst."

#: data/rockets.json:tiers[0].name
msgid "Mk I Cradle"
msgstr "Mk I Cradle"

#: data/rockets.json:tiers[0].desc
msgid "A compact one-seat glider: pearl hull, swept wings, twin engines and lift fans for vertical take-off."
msgstr "Ein kompakter Einsitzer-Gleiter: perlweißer Rumpf, gepfeilte Flügel, Zwillingstriebwerke und Hubgebläse für Senkrechtstarts."

#: data/rockets.json:tiers[1].name
msgid "Mk II Glide"
msgstr "Mk II Glide"

#: data/rockets.json:tiers[1].desc
msgid "Wing extensions steady the climb: shorter countdown, faster flight, cells refill twice as fast. Cargo pods carry 50% more."
msgstr "Flügelverlängerungen stabilisieren den Steigflug: kürzerer Countdown, schnellerer Flug, Zellen laden doppelt so schnell. Frachtkapseln tragen 50% mehr."

#: data/rockets.json:tiers[2].name
msgid "Mk III Halo"
msgstr "Mk III Halo"

#: data/rockets.json:tiers[2].desc
msgid "Bigger engines and a new canopy. Cells refill in seconds; cargo pods carry 2.5x, more often."
msgstr ""

#: data/rockets.json:tiers[3].name
msgid "Mk IV Aurora Warp"
msgstr "Mk IV Aurora Warp"

#: data/rockets.json:tiers[3].desc
msgid "Landing gear, cargo pods and a warp core: instant hops with no recharge. Cargo pods carry 4x, every 30 s."
msgstr "Fahrwerk, Frachtkapseln und ein Warpkern: Sofortsprünge ohne Aufladen. Frachtkapseln tragen 4x, alle 30 s."

#: planets/verdance/data/shards.json:shards[back_soon].kind
msgid "sign"
msgstr "Schild"

#: planets/verdance/data/shards.json:shards[back_soon].title
msgid "Shop sign, hand-lettered"
msgstr "Ladenschild, handgeschrieben"

#: planets/verdance/data/shards.json:shards[back_soon].body
msgid ""
"BACK SOON\n"
"\n"
"Gone to the evacuation briefing.\n"
"If you need bread, the key is under the blue pot.\n"
"Pay me next week.\n"
"\n"
"— Marta"
msgstr ""
"BIN BALD ZURÜCK\n"
"\n"
"Bin bei der Evakuierungsbesprechung.\n"
"Wer Brot braucht: Der Schlüssel liegt unter dem blauen Topf.\n"
"Bezahlt mich nächste Woche.\n"
"\n"
"— Marta"

#: planets/verdance/data/shards.json:shards[kid_drawing].kind
msgid "drawing"
msgstr "Zeichnung"

#: planets/verdance/data/shards.json:shards[kid_drawing].title
msgid "Crayon drawing, folded in four"
msgstr "Wachsmalzeichnung, zweimal gefaltet"

#: planets/verdance/data/shards.json:shards[kid_drawing].body
msgid ""
"[A round blue robot with one big eye, holding a flower. Above it, in big letters:]\n"
"\n"
"MY ROBOT\n"
"HE CLEENS UP\n"
"HIS NAME IS HELPER\n"
"\n"
"[Below, smaller, in an adult's handwriting:] Ellie, age 6. For the fridge."
msgstr ""
"[Ein runder blauer Roboter mit einem großen Auge, der eine Blume hält. Darüber in großen Buchstaben:]\n"
"\n"
"MEIN ROBOTER\n"
"ER REUMT AUF\n"
"ER HEISST HELFER\n"
"\n"
"[Darunter, kleiner, in der Schrift eines Erwachsenen:] Ellie, 6 Jahre. Für den Kühlschrank."

#: planets/verdance/data/shards.json:shards[gardener_list].kind
msgid "note"
msgstr "Notiz"

#: planets/verdance/data/shards.json:shards[gardener_list].title
msgid "Gardener's to-do list"
msgstr "Gartenliste"

#: planets/verdance/data/shards.json:shards[gardener_list].body
msgid ""
"- water the tomatoes (again)\n"
"- ask the council about the haze, AGAIN\n"
"- seed swap Saturday\n"
"- tell the cleanup units the park is not a dumping zone, they keep sorting the benches\n"
"- buy gloves\n"
"- don't cry about the oak"
msgstr ""
"- Tomaten gießen (schon wieder)\n"
"- beim Stadtrat wegen des Dunstes nachfragen, SCHON WIEDER\n"
"- Samentausch am Samstag\n"
"- den Aufräumeinheiten sagen, dass der Park kein Müllplatz ist, sie sortieren dauernd die Bänke\n"
"- Handschuhe kaufen\n"
"- nicht wegen der Eiche weinen"

#: planets/verdance/data/shards.json:shards[receipt].kind
msgid "receipt"
msgstr "Kassenbon"

#: planets/verdance/data/shards.json:shards[receipt].title
msgid "Till receipt"
msgstr "Kassenbon"

#: planets/verdance/data/shards.json:shards[receipt].body
msgid ""
"CORNER STORE  #0442\n"
"\n"
"2x BOTTLED WATER         4.80\n"
"1x DUST MASK (CHILD)     3.10\n"
"1x DUST MASK (ADULT)     3.10\n"
"1x SEED PACKET (MIXED)   0.90\n"
"\n"
"TOTAL                   11.90\n"
"CASH\n"
"\n"
"Thank you! Air quality today: POOR"
msgstr ""
"ECKLADEN  #0442\n"
"\n"
"2x WASSER IN FLASCHEN     4.80\n"
"1x STAUBMASKE (KIND)     3.10\n"
"1x STAUBMASKE (ERW.)     3.10\n"
"1x SAMENTÜTE (GEMISCHT)  0.90\n"
"\n"
"SUMME                   11.90\n"
"BAR\n"
"\n"
"Danke! Luftqualität heute: SCHLECHT"

#: planets/verdance/data/shards.json:shards[maint_log].kind
msgid "log"
msgstr "Protokoll"

#: planets/verdance/data/shards.json:shards[maint_log].title
msgid "Maintenance log, unit P-46RA"
msgstr "Wartungsprotokoll, Einheit P-46RA"

#: planets/verdance/data/shards.json:shards[maint_log].body
msgid ""
"DAY 4,113\n"
"Route 12 complete. 41 bales.\n"
"Ledger notice received: \"Operations paused pending cost review.\"\n"
"Returning to dock.\n"
"\n"
"DAY 4,114\n"
"Still paused.\n"
"\n"
"DAY 4,190\n"
"Still paused. Dock battery 31%.\n"
"There is a flower growing through the gutter at route 12, marker 9.\n"
"Nobody is cleaning around it. I hope that's all right."
msgstr ""
"TAG 4.113\n"
"Route 12 erledigt. 41 Ballen.\n"
"Ledger-Hinweis erhalten: „Betrieb bis zur Kostenprüfung ausgesetzt.“\n"
"Kehre zum Dock zurück.\n"
"\n"
"TAG 4.114\n"
"Immer noch ausgesetzt.\n"
"\n"
"TAG 4.190\n"
"Immer noch ausgesetzt. Dock-Akku 31%.\n"
"Auf Route 12, Markierung 9, wächst eine Blume durch den Rinnstein.\n"
"Niemand räumt um sie herum auf. Ich hoffe, das ist in Ordnung."

#: planets/verdance/data/shards.json:shards[ledger_memo].kind
msgid "memo"
msgstr "Rundschreiben"

#: planets/verdance/data/shards.json:shards[ledger_memo].title
msgid "Memo, Municipal Ledger Office"
msgstr "Rundschreiben, Städtisches Ledger-Amt"

#: planets/verdance/data/shards.json:shards[ledger_memo].body
msgid ""
"TO: All Sanitation Units\n"
"FROM: THE LEDGER (Automated Fiscal Continuity)\n"
"RE: Pause of Operations\n"
"\n"
"Cleanup activity is presently valued at a net loss of 0.4 units per bale.\n"
"All units will pause operations until conditions improve.\n"
"Conditions will be reviewed every 24 hours.\n"
"\n"
"Thank you for your understanding.\n"
"This memo was generated automatically. Please do not reply."
msgstr ""
"AN: Alle Reinigungseinheiten\n"
"VON: DER LEDGER (Automatisierte Fiskalkontinuität)\n"
"BETREFF: Aussetzung des Betriebs\n"
"\n"
"Reinigungstätigkeit wird derzeit mit einem Nettoverlust von 0,4 Einheiten pro Ballen bewertet.\n"
"Alle Einheiten setzen den Betrieb aus, bis sich die Bedingungen verbessern.\n"
"Die Bedingungen werden alle 24 Stunden überprüft.\n"
"\n"
"Vielen Dank für Ihr Verständnis.\n"
"Dieses Schreiben wurde automatisch erstellt. Bitte nicht antworten."

#: planets/verdance/data/shards.json:shards[voicemail].kind
msgid "voicemail"
msgstr "Sprachnachricht"

#: planets/verdance/data/shards.json:shards[voicemail].title
msgid "Voicemail transcript"
msgstr "Abschrift einer Sprachnachricht"

#: planets/verdance/data/shards.json:shards[voicemail].body
msgid ""
"\"Hi, it's Dad. The shuttle's tomorrow at six. They said one bag each, so... pick your favorite stuffed animal, not all of them, okay? And... we're leaving the cleanup bots running. They'll keep it tidy for when we come back. It won't be long. Love you. Bye.\"\n"
"\n"
"[Message saved]"
msgstr ""
"„Hallo, hier ist Papa. Das Shuttle geht morgen um sechs. Sie haben gesagt, eine Tasche pro Person, also... such dir dein liebstes Kuscheltier aus, nicht alle, okay? Und... wir lassen die Aufräumbots laufen. Die halten alles ordentlich, bis wir zurückkommen. Es dauert nicht lange. Hab dich lieb. Tschüss.“\n"
"\n"
"[Nachricht gespeichert]"

#: planets/verdance/data/shards.json:shards[poster].kind
msgid "poster"
msgstr "Plakat"

#: planets/verdance/data/shards.json:shards[poster].title
msgid "Faded safety poster"
msgstr "Verblasstes Sicherheitsplakat"

#: planets/verdance/data/shards.json:shards[poster].body
msgid ""
"THE CRADLE IS WATCHING OVER US\n"
"\n"
"Every seed. Every spore. Every egg.\n"
"Safe in orbit until the Greenfall.\n"
"\n"
"KEEP YOUR STREETS CLEAN — THE ROBOTS CAN'T DO IT ALONE\n"
"\n"
"(Someone has scratched underneath: \"they can if you let them\")"
msgstr ""
"DIE CRADLE WACHT ÜBER UNS\n"
"\n"
"Jeder Samen. Jede Spore. Jedes Ei.\n"
"Sicher im Orbit bis zum Greenfall.\n"
"\n"
"HALTET EURE STRASSEN SAUBER — DIE ROBOTER SCHAFFEN ES NICHT ALLEIN\n"
"\n"
"(Jemand hat darunter gekratzt: „doch, wenn man sie lässt“)"

