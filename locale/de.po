msgstr "Schließ eine Welle der Saatarche ab."

#: data/achievements.json:achievements[ark_10].name
msgid "Tender of Worlds"
msgstr "Hüter der Welten"

#: data/achievements.json:achievements[ark_10].desc
msgid "Complete 10 Seed Ark waves."
msgstr "Schließ 10 Wellen der Saatarche ab."

#: data/achievements.json:achievements[outpost_1].name
msgid "Frontier Scale"
msgstr "Grenz-Waage"

#: data/achievements.json:achievements[outpost_1].desc
