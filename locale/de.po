msgstr "Pflanze fünf Wellen der Saatarche"

#: data/goals.json:goals[late_eggs_30].text
msgid "Find 30 curiosities"
msgstr "Finde 30 Kuriositäten"

#: data/goals.json:goals[late_world_1].text
msgid "Seed a new world"
msgstr "Besäe eine neue Welt"

#: data/goals.json:goals[late_charm_20].text
