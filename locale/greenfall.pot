msgid "A tall steel locker with a small turntable. Step up to wear the pieces you have found, and to dress Glim and your robots."
msgstr ""

#: planets/verdance/data/camp.json:builds.locker.flag_text
msgid "Find a piece of a look first."
msgstr ""

#: planets/verdance/data/camp.json:builds.nursery.name
msgid "Robot Nursery"
msgstr ""

#: planets/verdance/data/camp.json:builds.nursery.desc
msgid "A walled lawn with flower beds where retired robots tend the garden and lend your crew a hand."
msgstr ""

#: planets/verdance/data/camp.json:builds.glim.name planets/verdance/data/objectives.json:objectives[glim].text
msgid "Repair Glim"
msgstr ""

#: planets/verdance/data/camp.json:builds.glim.desc
msgid "The little lantern bot who held on to your pod all the way down. Patch him up and he'll follow you and light the way."
msgstr ""

#: planets/verdance/data/camp.json:builds.camera_bot.name
msgid "Blink"
msgstr ""

#: planets/verdance/data/camp.json:builds.camera_bot.desc
msgid "A little floating camera bot with a big lens for a face. Builds once; then he follows Lumi from base to base and photo mode opens."
msgstr ""

#: planets/verdance/data/codex.json:categories[junk].name planets/verdance/data/hex_levels.json:levels[0].name
msgid "Junk"
msgstr ""

#: planets/verdance/data/codex.json:categories[plants].name
msgid "Plants"
msgstr ""

#: planets/verdance/data/codex.json:categories[shards].name planets/verdance/data/museum.json:exhibits[shards].name
msgid "Memory Shards"
msgstr ""

#: planets/verdance/data/codex.json:categories[landmarks].name
msgid "Landmarks"
msgstr ""

#: planets/verdance/data/codex.json:categories[animals].name
msgid "Animals"
msgstr ""

#: planets/verdance/data/codex.json:categories[homeward].name
msgid "Homeward"
msgstr ""

#: planets/verdance/data/codex.json:categories[sightings].name
msgid "Sightings"
msgstr ""

#: planets/verdance/data/codex.json:junk.metal.hint
msgid "Rusty, clanky, everywhere."
msgstr ""

#: planets/verdance/data/codex.json:junk.metal.desc
msgid "Cans, tins and bent brackets. Most of it was made to last, and it did. Pressed into bales, it can be rolled and stamped into something useful again."
msgstr ""

#: planets/verdance/data/codex.json:junk.plastic.hint
msgid "Bright colours that never faded."
msgstr ""

#: planets/verdance/data/codex.json:junk.plastic.desc
msgid "Bottles, crates and the occasional chair. It outlived the people who bought it. It weighs almost nothing, and still the ground under it stayed bare."
msgstr ""

#: planets/verdance/data/codex.json:junk.glass.hint
msgid "It glints in the dust."
msgstr ""

#: planets/verdance/data/codex.json:junk.glass.desc
msgid "Jugs and wine bottles, a few still corked. Sorted by colour, glass melts down beautifully. Lumi likes how the light comes through it."
msgstr ""

#: planets/verdance/data/codex.json:junk.rubber.hint
msgid "Squeaky. Bouncy. Sad."
msgstr ""

#: planets/verdance/data/codex.json:junk.rubber.desc
msgid "Tyres, boots and one very patient rubber duck. Rubber holds water, and water holds mosquitoes. Clearing it makes room for frogs."
msgstr ""

#: planets/verdance/data/codex.json:junk.electronics.hint
msgid "It might still remember something."
msgstr ""

#: planets/verdance/data/codex.json:junk.electronics.desc
msgid "Laptops, radios and televisions with nothing left to say. Inside are tiny useful parts. Lumi keeps the good ones for new friends."
msgstr ""

#: planets/verdance/data/codex.json:junk.paper.hint
msgid "Soft, and slowly going back to soil."
msgstr ""

#: planets/verdance/data/codex.json:junk.paper.desc
msgid "Cardboard boxes, bags and old gloves. Paper is the one kind of junk that is already trying to become soil. Lumi helps it along."
msgstr ""

#: planets/verdance/data/codex.json:plants.grass.name
msgid "Meadow Grass"
msgstr ""

#: planets/verdance/data/codex.json:plants.grass.hint
msgid "Plant your first seeds."
msgstr ""

#: planets/verdance/data/codex.json:plants.grass.desc
msgid "The first thing to come back, always. Its roots knit the loose dust together so other plants have something to hold on to."
msgstr ""

#: planets/verdance/data/codex.json:plants.grass2.name
msgid "Tufted Grass"
msgstr ""

#: planets/verdance/data/codex.json:plants.grass2.hint
msgid "Keep planting."
msgstr ""

#: planets/verdance/data/codex.json:plants.grass2.desc
msgid "A slightly scruffier cousin. It grows in clumps, and small beetles like to live between them."
msgstr ""

#: planets/verdance/data/codex.json:plants.celandine.name
msgid "Celandine"
msgstr ""

#: planets/verdance/data/codex.json:plants.celandine.hint
msgid "A little yellow star."
msgstr ""

#: planets/verdance/data/codex.json:plants.celandine.desc
msgid "Glossy yellow petals that open in the sun and close when clouds pass. Bees find it before they find anything else."
msgstr ""

#: planets/verdance/data/codex.json:plants.gazania.name
msgid "Gazania"
msgstr ""

#: planets/verdance/data/codex.json:plants.gazania.hint
msgid "Bold stripes, big smile."
msgstr ""

#: planets/verdance/data/codex.json:plants.gazania.desc
msgid "A tough little sun-lover with striped petals. It does not mind poor soil. It seems to enjoy proving people wrong."
msgstr ""

#: planets/verdance/data/codex.json:plants.heliophila.name
msgid "Heliophila"
msgstr ""

#: planets/verdance/data/codex.json:plants.heliophila.hint
msgid "The first flower you ever saw here."
msgstr ""

#: planets/verdance/data/codex.json:plants.heliophila.desc
msgid "Small blue flowers that turn to follow the light. One grew beside a crushed can before anyone helped it. That is where this all began."
msgstr ""

#: planets/verdance/data/codex.json:plants.dandelion.name
msgid "Dandelion"
msgstr ""

#: planets/verdance/data/codex.json:plants.dandelion.hint
msgid "Make a wish."
msgstr ""

#: planets/verdance/data/codex.json:plants.dandelion.desc
msgid "Golden today, a puff of wishes tomorrow. Each seed rides the wind to a new patch of clean ground. It plants itself, if you let it."
msgstr ""

#: planets/verdance/data/codex.json:plants.fern.name
msgid "Fern"
msgstr ""

#: planets/verdance/data/codex.json:plants.fern.hint
msgid "Shade-lover."
msgstr ""

#: planets/verdance/data/codex.json:plants.fern.desc
msgid "Fronds that unroll like slow fireworks. Ferns are very old. They have come back from worse than this."
msgstr ""

#: planets/verdance/data/codex.json:plants.shrub.name
msgid "Shrub"
msgstr ""

#: planets/verdance/data/codex.json:plants.shrub.hint
msgid "Something bigger."
msgstr ""

#: planets/verdance/data/codex.json:plants.shrub.desc
msgid "A low woody bush. Birds will notice it before you do. Shrubs are how a meadow starts thinking about becoming a wood."
msgstr ""

#: planets/verdance/data/codex.json:plants.nettle.name
msgid "Nettle"
msgstr ""

#: planets/verdance/data/codex.json:plants.nettle.hint
msgid "Needs Hardy Nettles research."
msgstr ""

#: planets/verdance/data/codex.json:plants.nettle.desc
msgid "Stingy, stubborn and wonderful. Nettles pull nutrients up from deep down, and caterpillars adore them."
msgstr ""

#: planets/verdance/data/codex.json:plants.mint.name planets/verdance/data/research.json:nodes[wild_mint].name
msgid "Wild Mint"
msgstr ""

#: planets/verdance/data/codex.json:plants.mint.hint
msgid "Needs Wild Mint research."
msgstr ""

#: planets/verdance/data/codex.json:plants.mint.desc
msgid "Crush a leaf and the whole hex smells fresh. Mint spreads quickly. Nobody minds."
msgstr ""

#: planets/verdance/data/codex.json:plants.hedge.name
msgid "Hedgerow"
msgstr ""

#: planets/verdance/data/codex.json:plants.hedge.hint
msgid "Needs Hedgerows research."
msgstr ""

#: planets/verdance/data/codex.json:plants.hedge.desc
msgid "A dense green wall, alive with small rustlings. Hedges are highways for hedgehogs, and hotels for wrens."
msgstr ""

#: planets/verdance/data/codex.json:plants.pine.name
msgid "Pine Sapling"
msgstr ""

#: planets/verdance/data/codex.json:plants.pine.hint
msgid "Needs Evergreen Saplings research."
msgstr ""

#: planets/verdance/data/codex.json:plants.pine.desc
msgid "Knee-high today. In a hundred years, a forest that smells of resin and rain. Lumi plants it carefully, for whoever comes after."
msgstr ""

#: planets/verdance/data/codex.json:plants.iceplant.name
msgid "Crystalline Iceplant"
msgstr ""

#: planets/verdance/data/codex.json:plants.iceplant.hint planets/verdance/data/codex.json:plants.rooibos.hint planets/verdance/data/codex.json:plants.ursinia.hint
msgid "Plant in the Dust Flats."
msgstr ""

#: planets/verdance/data/codex.json:plants.iceplant.desc
msgid "A desert succulent whose leaves are covered in tiny glassy blisters that store water. It glitters at noon and needs almost nothing to drink."
msgstr ""

#: planets/verdance/data/codex.json:plants.rooibos.name
msgid "Wild Rooibos"
msgstr ""

#: planets/verdance/data/codex.json:plants.rooibos.desc
msgid "A needle-leafed bush that turns rusty red in the heat. Its roots go down further than you would believe. It holds the sand in place."
msgstr ""

#: planets/verdance/data/codex.json:plants.ursinia.name
msgid "Ursinia"
msgstr ""

#: planets/verdance/data/codex.json:plants.ursinia.desc
msgid "A bright orange desert daisy. After the first rain in years, whole slopes of them opened at once, and the Cradle's old cameras saw it from orbit."
msgstr ""

#: planets/verdance/data/codex.json:plants.periwinkle.name
msgid "Periwinkle"
msgstr ""

#: planets/verdance/data/codex.json:plants.periwinkle.hint planets/verdance/data/codex.json:plants.frost_moss.hint
msgid "A cold-hardy seed for the Frozen Port."
msgstr ""

#: planets/verdance/data/codex.json:plants.periwinkle.desc
msgid "An evergreen groundcover with violet flowers. It keeps its leaves under snow and simply carries on in spring."
msgstr ""

#: planets/verdance/data/codex.json:plants.frost_moss.name
msgid "Frost Moss"
msgstr ""

#: planets/verdance/data/codex.json:plants.frost_moss.desc
msgid "A tight green cushion that grows on cold stone. It is slow, but it survives what nothing else does, and it makes soil where there was none."
msgstr ""

#: planets/verdance/data/codex.json:plants.reed.name
msgid "Marsh Reed"
msgstr ""

#: planets/verdance/data/codex.json:plants.reed.hint
msgid "Plant on the drained streets of the Sunken City."
msgstr ""

#: planets/verdance/data/codex.json:plants.reed.desc
msgid "Tall reeds that drink the silt dry and filter the last of the floodwater. Little birds sit on them and complain about the wind."
msgstr ""

#: planets/verdance/data/codex.json:plants.marsh_mint.name
msgid "Marsh Mint"
msgstr ""

#: planets/verdance/data/codex.json:plants.marsh_mint.hint
msgid "Plant in the Sunken City."
msgstr ""

#: planets/verdance/data/codex.json:plants.marsh_mint.desc
msgid "Mint that does not mind wet feet. The drained streets smell of it on warm evenings."
msgstr ""

#: planets/verdance/data/codex.json:robots.scoopie.hint planets/verdance/data/codex.json:robots.haulbug.hint
msgid "Build one at the workbench."
msgstr ""

#: planets/verdance/data/codex.json:robots.scoopie.desc
msgid "A small, earnest cleaner with one scoop arm and a lot of enthusiasm. It hums when it finds a good pile."
msgstr ""

#: planets/verdance/data/codex.json:robots.haulbug.desc
msgid "A fork cart that never complains. It carries loose bales to the scale and parks itself neatly afterwards."
msgstr ""

#: planets/verdance/data/codex.json:robots.scrounger.hint
msgid "Its plans come with the second city."
msgstr ""

#: planets/verdance/data/codex.json:robots.scrounger.desc
msgid "A low digger with a detector coil out front. It noses over ground you have cleaned, digs up what the junk left behind and carries a crate of parts home."
msgstr ""

#: planets/verdance/data/codex.json:robots.seedling.hint
msgid "Research the Seedling Blueprint."
msgstr ""

#: planets/verdance/data/codex.json:robots.seedling.desc
msgid "A planter bot with a seed hopper on its back. It pats every seed into the soil, twice, just to be sure."
msgstr ""

#: planets/verdance/data/codex.json:robots.drip.hint
msgid "Research the Drip Blueprint."
msgstr ""

#: planets/verdance/data/codex.json:robots.drip.desc
msgid "A watering bot with a sloshy tank. It makes a little happy gurgle when a plant drinks."
msgstr ""

#: planets/verdance/data/codex.json:robots.multibot.hint
msgid "Research the Multibot Blueprint."
msgstr ""

#: planets/verdance/data/codex.json:robots.multibot.desc
msgid "A helper that can clean, plant or water. Not the fastest at anything, but always where it is needed."
msgstr ""

#: planets/verdance/data/codex.json:robots.skimmer.hint
msgid "Build a Skimmer."
msgstr ""

#: planets/verdance/data/codex.json:robots.skimmer.desc
msgid "A little raft robot with a net and a rubber duck for luck. It drifts across the lakes fishing out bottles, and leaves neat bales on the shore."
msgstr ""

#: planets/verdance/data/codex.json:shards.back_soon.desc
msgid "A hand-lettered sign from a bakery. Marta promised to be back soon."
msgstr ""

#: planets/verdance/data/codex.json:shards.kid_drawing.desc
msgid "A crayon drawing, folded small enough to fit a pocket."
msgstr ""

#: planets/verdance/data/codex.json:shards.gardener_list.desc
msgid "Someone's to-do list for a garden. Half the items are ticked."
msgstr ""

#: planets/verdance/data/codex.json:shards.receipt.desc
msgid "A till receipt from the last ordinary day."
msgstr ""

#: planets/verdance/data/codex.json:shards.maint_log.desc
msgid "A maintenance log for a unit that looked a lot like Lumi."
msgstr ""

#: planets/verdance/data/codex.json:shards.ledger_memo.desc
msgid "An office memo about the evacuation. Very polite. Very tired."
msgstr ""

#: planets/verdance/data/codex.json:shards.voicemail.desc
msgid "A voicemail transcript. Someone was calling to say they were safe."
msgstr ""

#: planets/verdance/data/codex.json:shards.poster.desc
msgid "A faded safety poster. The smiling robot on it is waving."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.covered_car.name
msgid "Covered Car"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.covered_car.hint
msgid "Under a tarp, waiting."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.covered_car.desc
msgid "Somebody covered it carefully before they left, as if they meant to come back for it. The tarp has held for a very long time."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.concrete_road_barrier.name
msgid "Road Barrier"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.concrete_road_barrier.hint
msgid "Grey and heavy."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.concrete_road_barrier.desc
msgid "Once it told traffic where to go. Now moss is slowly telling it where to stay."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.exterior_aircon_unit.name
msgid "Air Conditioner"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.exterior_aircon_unit.hint
msgid "It used to hum."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.exterior_aircon_unit.desc
msgid "An old outdoor unit with a rusted fan. Small birds have started nesting behind the grille."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.electric_stove.name
msgid "Abandoned Stove"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.electric_stove.hint
msgid "A kitchen, without the kitchen."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.electric_stove.desc
msgid "Someone carried it this far and then set it down. Its oven door still opens with a cheerful squeak."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.Barrel_01.name
msgid "Old Barrel"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.Barrel_01.hint
msgid "Dented and rusty."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.Barrel_01.desc
msgid "Empty now, thankfully. Turned on its side it makes a decent shelter for a fox."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.metal_trash_can.name
msgid "Trash Can"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.metal_trash_can.hint
msgid "The irony is not lost on Lumi."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.metal_trash_can.desc
msgid "The one place junk was supposed to go. Lumi salutes it every time he passes."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.propane_tank.name
msgid "Propane Tank"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.propane_tank.hint
msgid "Handle with care."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.propane_tank.desc
msgid "Long since empty and safe. Someone painted a flower on the side, a long time ago."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.plastic_monobloc_chair_01.name
msgid "Plastic Chair"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.plastic_monobloc_chair_01.hint
msgid "Somebody sat here."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.plastic_monobloc_chair_01.desc
msgid "The most common chair in the world. It faces the horizon, as if someone liked to watch the sunset from here."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.dead_tree_trunk.name
msgid "Old Tree Trunk"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.dead_tree_trunk.hint
msgid "It used to be tall."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.dead_tree_trunk.desc
msgid "A tree that did not make it. But there are tiny green shoots at its base, and beetles inside, and it is not as dead as it looks."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.old_drill_press.name
msgid "Drill Press"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.old_drill_press.hint
msgid "Out in the rust plains."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.old_drill_press.desc
msgid "A workshop drill press standing alone in a field. The workshop around it is long gone; the press stayed exactly where it was told."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.old_military_compressor.name
msgid "Field Compressor"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.old_military_compressor.hint
msgid "Out where the wild bases are."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.old_military_compressor.desc
msgid "A wheeled air compressor, its gauges frozen at 'enough'. It pumped up the tyres of a whole fleet of cleanup carts once."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.tree_stump_01.name
msgid "Tree Stump"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.tree_stump_01.hint
msgid "Where a forest used to be."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.tree_stump_01.desc
msgid "Cut, not fallen. The rings count back further than the Ledger. Moss has started a quiet negotiation with the bark."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.ocean_buoy.name
msgid "Washed-up Buoy"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.ocean_buoy.hint
msgid "On a far coast."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.ocean_buoy.desc
msgid "A channel buoy that drifted inland on a storm tide and never found its way back. Its lamp still blinks, once an hour, out of habit."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.wooden_crate_02.name
msgid "Cargo Crate"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.wooden_crate_02.hint
msgid "Near the shore, or the dunes."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.wooden_crate_02.desc
msgid "A slatted crate stencilled CRADLE SUPPLY: FRAGILE. Packed for the ark's launch three hundred years ago, and left behind in the rush. Empty. Whatever was inside was planted somewhere, a long time ago."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.barrel_03.name
msgid "Sand-Blasted Drum"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.barrel_03.hint
msgid "Where the wind carries sand."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.barrel_03.desc
msgid "Centuries of wind have polished this drum down to bare, shining metal. In the dunes even the junk gets buffed."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.dead_quiver_trunk.name
msgid "Dead Quiver Tree"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.dead_quiver_trunk.hint
msgid "Out in the Dust Flats."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.dead_quiver_trunk.desc
msgid "A desert tree that stored water in its trunk until there was none left to store. It still stands, bleached silver, pointing at the sky."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.namaqualand_rocks_01.name
msgid "Desert Rocks"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.namaqualand_rocks_01.hint
msgid "Scattered over the Dust Flats."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.namaqualand_rocks_01.desc
msgid "Wind-polished stones. Lumi swears one of them looks like WREN's logo. WREN says it does not."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.small_lpg_tank.name
msgid "Gas Bottle"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.small_lpg_tank.hint
msgid "Frozen into the port yard."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.small_lpg_tank.desc
msgid "A small gas bottle with a frozen valve. The harbour heaters once ran on these. Now they run on Lumi."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.portable_generator.name
msgid "Field Generator"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.portable_generator.hint planets/verdance/data/codex.json:landmarks.utility_box_01.hint
msgid "Near the Cradle's old launch field."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.portable_generator.desc
msgid "A ground-crew generator, still labelled LAUNCH SUPPORT. It powered the floodlights on the night the Cradle left."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.utility_box_01.name
msgid "Launch Utility Box"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.utility_box_01.desc
msgid "A junction box for the launch field's lights. Someone wrote GOOD LUCK on the door in marker pen, three hundred years ago."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.concrete_road_barrier_02.name
msgid "Blast Barrier"
msgstr ""

#: planets/verdance/data/codex.json:landmarks.concrete_road_barrier_02.hint
msgid "Around the landing pad."
msgstr ""

#: planets/verdance/data/codex.json:landmarks.concrete_road_barrier_02.desc
msgid "Barriers that kept the crowd back from the pad. The crowd has been gone a long time. The barriers took their job very seriously."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.dust_flats.name planets/verdance/data/frontiers.json:kinds[dust_flats].name planets/verdance/data/junk.json:biomes.dust_flats.name
msgid "Dust Flats"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.dust_flats.hint
msgid "Research Dune Charts and fly there."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.dust_flats.desc
msgid "Old salt flats where a solar farm once powered half a continent. Sandstorms roll in every few minutes and bury cleaned ground again; Sustained hexes shelter their neighbours. The well is dry: Drips need Water Tanks."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.frozen_port.name planets/verdance/data/frontiers.json:kinds[frozen_port].name planets/verdance/data/junk.json:biomes.frozen_port.name
msgid "Frozen Port"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.frozen_port.hint
msgid "Research the Thermal Lance and fly there."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.frozen_port.desc
msgid "A container harbour frozen solid. Junk is locked in ice until it is thawed: Lumi's beam melts it slowly, heaters melt it fast and warm the hexes around them. Plants need a greenhouse, or Cold-Hardy Seeds."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.sunken_city.name planets/verdance/data/frontiers.json:kinds[sunken_city].name planets/verdance/data/junk.json:biomes.sunken_city.name
msgid "Sunken City"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.sunken_city.hint
msgid "Research Pump Works and fly there."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.sunken_city.desc
msgid "A downtown that went under when the sea walls failed. Skimmers net the floating junk; once most of a ring is clean, the old pumps run and the water drops, revealing streets full of stranded debris."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.cradle_returns.name planets/verdance/data/frontiers.json:kinds[cradle_returns].name planets/verdance/data/junk.json:biomes.cradle_landing.name
msgid "Cradle Returns"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.cradle_returns.hint
msgid "Restore all three frontiers and research the Ark Beacon."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.cradle_returns.desc
msgid "The launch city the Cradle left from. Its towers were kept by ground crews, but the landing field is buried. Clean and green the pad, and the ark can come home."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.sandstorm.name
msgid "Sandstorms"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.sandstorm.hint
msgid "Wait for the wind in the Dust Flats."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.sandstorm.desc
msgid "The wind picks up junk from the open flats and drops it on clean ground. Planted hexes are never touched, and Sustained hexes break the wind for every hex next to them."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.thaw.name
msgid "Thawing"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.thaw.hint
msgid "Melt the ice in the Frozen Port."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.thaw.desc
msgid "Hold the beam on ice and it slowly melts. A heater thaws a whole hex in about a minute and keeps warming the hexes around it."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.greenhouse.name
msgid "Greenhouses"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.greenhouse.hint
msgid "Build one in the Frozen Port."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.greenhouse.desc
msgid "A glass hex over clean ground. Anything grows inside, a quarter faster than outdoors."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.pumps.name
msgid "The Old Pumps"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.pumps.hint
msgid "Clean the water in the Sunken City."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.pumps.desc
msgid "The city's flood pumps still work. They only needed the drains cleared. Every time they run, a ring of streets comes back out of the water."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.ark_pad.name
msgid "The Landing Pad"
msgstr ""

#: planets/verdance/data/codex.json:frontiers.ark_pad.hint
msgid "Find it in Cradle Returns."
msgstr ""

#: planets/verdance/data/codex.json:frontiers.ark_pad.desc
msgid "A ring of hexes in front of the base where the Cradle will set down. It has to be clean and Sustained before the ark will trust it."
msgstr ""

#: planets/verdance/data/codex.json:animals.cat.name planets/verdance/data/fauna.json:species[cat].name
msgid "Stray Cat"
msgstr ""

#: planets/verdance/data/codex.json:animals.cat.hint
msgid "Where: On clean city streets."
msgstr ""

#: planets/verdance/data/codex.json:animals.cat.desc
msgid "Old Town's cats never left. They know every warm engine block and sunny step, and they decided long ago that robots are furniture. Stop for a while and one may come over. Pet the same cat often enough and she'll move in at your base."
msgstr ""

#: planets/verdance/data/codex.json:animals.pigeon.name planets/verdance/data/fauna.json:species[pigeon].name
msgid "Pigeon"
msgstr ""

#: planets/verdance/data/codex.json:animals.pigeon.hint
msgid "Where: Clean pavement in the city."
msgstr ""

#: planets/verdance/data/codex.json:animals.pigeon.desc
msgid "Pigeons will live anywhere people once dropped crumbs. They peck between the cracks, bob their heads as they walk and burst into the air all at once if you fly through them."
msgstr ""

#: planets/verdance/data/codex.json:animals.sparrow.name planets/verdance/data/fauna.json:species[sparrow].name
msgid "Sparrow"
msgstr ""

#: planets/verdance/data/codex.json:animals.sparrow.hint
msgid "Where: Clean ground, city or wild."
msgstr ""

#: planets/verdance/data/codex.json:animals.sparrow.desc
msgid "Small, brown and bossy. Sparrows were the first birds to come back to swept streets, chirping from kerb to kerb."
msgstr ""

#: planets/verdance/data/codex.json:animals.rat.name planets/verdance/data/fauna.json:species[rat].name
msgid "Rat"
msgstr ""

#: planets/verdance/data/codex.json:animals.rat.hint
msgid "Where: Wherever the junk is still piled up."
msgstr ""

#: planets/verdance/data/codex.json:animals.rat.desc
msgid "Rats live in the gaps between the piles. They are not villains, just tenants: clean a hex and they pack up and move to the next heap."
msgstr ""

#: planets/verdance/data/codex.json:animals.rabbit.name planets/verdance/data/fauna.json:species[rabbit].name
msgid "Rabbit"
msgstr ""

#: planets/verdance/data/codex.json:animals.rabbit.hint
msgid "Where: Growing hexes."
msgstr ""

#: planets/verdance/data/codex.json:animals.rabbit.desc
msgid "Rabbits arrive as soon as there is something green to nibble. They hop, freeze, nibble, and zig-zag away if Lumi rushes them."
msgstr ""

#: planets/verdance/data/codex.json:animals.deer.name planets/verdance/data/fauna.json:species[deer].name
msgid "Roe Deer"
msgstr ""

#: planets/verdance/data/codex.json:animals.deer.hint
msgid "Where: The edges of Sustained ground."
msgstr ""

#: planets/verdance/data/codex.json:animals.deer.desc
msgid "Shy grazers that keep to the edge of the green, where they can see what's coming. Approach slowly; rush them and they bound away in long, graceful leaps."
msgstr ""

#: planets/verdance/data/codex.json:animals.fox.name planets/verdance/data/fauna.json:species[fox].name
msgid "Red Fox"
msgstr ""

#: planets/verdance/data/codex.json:animals.fox.hint
msgid "Where: Sustained and Thriving hexes."
msgstr ""

#: planets/verdance/data/codex.json:animals.fox.desc
msgid "A fox trots along the hedges, nose down, tail out. It watches Lumi with polite interest and keeps its distance."
msgstr ""

#: planets/verdance/data/codex.json:animals.bee.name planets/verdance/data/fauna.json:species[bee].name
msgid "Honeybee"
msgstr ""

#: planets/verdance/data/codex.json:animals.bee.hint
msgid "Where: Flowers on Sustained hexes."
msgstr ""

#: planets/verdance/data/codex.json:animals.bee.desc
msgid "Bees came back with the blooms. Every flower bed that stays watered gets its own little hum."
msgstr ""

#: planets/verdance/data/codex.json:animals.songbird.name planets/verdance/data/fauna.json:species[songbird].name
msgid "Robin"
msgstr ""

#: planets/verdance/data/codex.json:animals.songbird.hint
msgid "Where: Thriving hexes, by day."
msgstr ""

#: planets/verdance/data/codex.json:animals.songbird.desc
msgid "When a hex thrives, robins move in and sing. If you hear birdsong, something here is going very right."
msgstr ""

#: planets/verdance/data/codex.json:animals.firefly.name data/cosmetics.json:pieces[companion_firefly].name planets/verdance/data/fauna.json:species[firefly].name
#: data/style_parts.json:options.companion[firefly].name
msgid "Firefly"
msgstr ""

#: planets/verdance/data/codex.json:animals.firefly.hint
msgid "Where: Thriving hexes, at night."
msgstr ""

#: planets/verdance/data/codex.json:animals.firefly.desc
msgid "Tiny green lanterns over the grass after dark. They only come where the ground is fully alive."
msgstr ""

#: planets/verdance/data/codex.json:animals.fish.name planets/verdance/data/fauna.json:species[fish].name
msgid "Lake Fish"
msgstr ""

#: planets/verdance/data/codex.json:animals.fish.hint
msgid "Where: Clean lakes."
msgstr ""

#: planets/verdance/data/codex.json:animals.fish.desc
msgid "Once the water clears you can see them: small silver schools turning together over the sand. Come too close and they scatter."
msgstr ""

#: planets/verdance/data/codex.json:animals.duck.name planets/verdance/data/fauna.json:species[duck].name
msgid "Mallard"
msgstr ""

#: planets/verdance/data/codex.json:animals.duck.hint
msgid "Where: Clean lakes beside green shores."
msgstr ""

#: planets/verdance/data/codex.json:animals.duck.desc
msgid "Ducks paddle, dabble with their tails in the air and complain loudly about everything. A clean lake with a green shore is all they ask."
msgstr ""

#: planets/verdance/data/codex.json:animals.frog.name planets/verdance/data/fauna.json:species[frog].name
msgid "Green Frog"
msgstr ""

#: planets/verdance/data/codex.json:animals.frog.hint
msgid "Where: Lake shores once they're planted."
msgstr ""

#: planets/verdance/data/codex.json:animals.frog.desc
msgid "Frogs sit at the water's edge and sing in the evening. Get too close and plop: into the water they go."
msgstr ""

#: planets/verdance/data/codex.json:animals.lizard.name planets/verdance/data/fauna.json:species[lizard].name
msgid "Sand Lizard"
msgstr ""

#: planets/verdance/data/codex.json:animals.lizard.hint
msgid "Where: Clean ground in the Dust Flats."
msgstr ""

#: planets/verdance/data/codex.json:animals.lizard.desc
msgid "Lizards bask on swept ground between the solar arrays and vanish in a blink when a shadow falls on them."
msgstr ""

#: planets/verdance/data/codex.json:animals.fennec.name planets/verdance/data/fauna.json:species[fennec].name
msgid "Fennec Fox"
msgstr ""

#: planets/verdance/data/codex.json:animals.fennec.hint
msgid "Where: Planted ground in the Dust Flats."
msgstr ""

#: planets/verdance/data/codex.json:animals.fennec.desc
msgid "A tiny desert fox with enormous ears. It hears Lumi's hover fans long before it sees him."
msgstr ""

#: planets/verdance/data/codex.json:animals.seal.name planets/verdance/data/fauna.json:species[seal].name
msgid "Harbour Seal"
msgstr ""

#: planets/verdance/data/codex.json:animals.seal.hint
msgid "Where: The Frozen Port shoreline."
msgstr ""

#: planets/verdance/data/codex.json:animals.seal.desc
msgid "Seals haul out on the quay once it's clean, lounge in heaps, and flop back to the water if you come too close."
msgstr ""

#: planets/verdance/data/codex.json:animals.gull.name planets/verdance/data/fauna.json:species[gull].name
msgid "Herring Gull"
msgstr ""

#: planets/verdance/data/codex.json:animals.gull.hint
msgid "Where: Coasts and harbours."
msgstr ""

#: planets/verdance/data/codex.json:animals.gull.desc
msgid "Loud, white and opportunistic. Gulls wheel over the harbour and land wherever there's a clean bit of quay."
msgstr ""

#: planets/verdance/data/codex.json:animals.arctic_fox.name planets/verdance/data/fauna.json:species[arctic_fox].name
msgid "Arctic Fox"
msgstr ""

#: planets/verdance/data/codex.json:animals.arctic_fox.hint
msgid "Where: Planted ground at the Frozen Port."
msgstr ""

#: planets/verdance/data/codex.json:animals.arctic_fox.desc
msgid "White as the snow it hunts on. It shows up when the greenhouses do, curious about the warm air."
msgstr ""

#: planets/verdance/data/codex.json:animals.heron.name planets/verdance/data/fauna.json:species[heron].name
msgid "Grey Heron"
msgstr ""

#: planets/verdance/data/codex.json:animals.heron.hint
msgid "Where: Shallows in the Sunken City and wild lakes."
msgstr ""

#: planets/verdance/data/codex.json:animals.heron.desc
msgid "Herons stand perfectly still at the water's edge, then strike. They lift off slowly on huge grey wings when disturbed."
msgstr ""

#: planets/verdance/data/codex.json:animals.turtle.name planets/verdance/data/fauna.json:species[turtle].name
msgid "Pond Turtle"
msgstr ""

#: planets/verdance/data/codex.json:animals.turtle.hint
msgid "Where: Clean water in the Sunken City."
msgstr ""

#: planets/verdance/data/codex.json:animals.turtle.desc
msgid "Turtles cruise the drowned streets with their heads up, as if they've always lived here. Maybe they have."
msgstr ""

#: planets/verdance/data/codex.json:animals.crane.name planets/verdance/data/fauna.json:species[crane].name
msgid "Cradle Crane"
msgstr ""

#: planets/verdance/data/codex.json:animals.crane.hint
msgid "Where: The skies over Cradle Returns."
msgstr ""

#: planets/verdance/data/codex.json:animals.crane.desc
msgid "White cranes circle high over the landing city on slow wingbeats. The ark's seed vault carried their eggs; this is the first flock to fly free."
msgstr ""

#: planets/verdance/data/codex.json:homeward.charter.name
msgid "The Sleepers' Charter"
msgstr ""

#: planets/verdance/data/codex.json:homeward.charter.hint planets/verdance/data/codex.json:homeward.ledger_system.hint
msgid "Light the Cradle Returns beacon."
msgstr ""

#: planets/verdance/data/codex.json:homeward.charter.desc
msgid "When the Makers left Verdance, most of them went into the long sleep in the Cradle's lower decks. Their charter was one line long: wake us when the system can feed us. Not one world. All five. The Cradle has kept that promise for three hundred years, and it will not break it for anybody, even a very persuasive small robot."
msgstr ""

#: planets/verdance/data/codex.json:homeward.ledger_system.name
msgid "The Ledger, Inc."
msgstr ""

#: planets/verdance/data/codex.json:homeward.ledger_system.desc
msgid "The Ledger was never only Verdance's problem. It held mining rights to every world around the two suns: Ochre's sands, Tidewell's seabed, Rime's warm core, Anvil's whole crust. When the ore ran out it closed the books, kept the profits and left five planets under its trash. The audits never stopped. Nobody was left to read them."
msgstr ""

#: planets/verdance/data/codex.json:homeward.binary_suns.name
msgid "Hearth and Ember"
msgstr ""

#: planets/verdance/data/codex.json:homeward.binary_suns.hint
msgid "Open the solar-system map."
msgstr ""

#: planets/verdance/data/codex.json:homeward.binary_suns.desc
msgid "The Verdance system has two suns: Hearth, warm and white, and Ember, its small orange companion. Every world sees both. On Ochre they are huge and hot; from Rime they are two bright points, and the stars stay out all day."
msgstr ""

#: planets/verdance/data/codex.json:homeward.homecoming.name data/radio.json:songs[homecoming].name
msgid "Homecoming"
msgstr ""

#: planets/verdance/data/codex.json:homeward.homecoming.hint
msgid "Restore every world and launch home."
msgstr ""

#: planets/verdance/data/codex.json:homeward.homecoming.desc
msgid "Five worlds alive again. A rocket built from all of them. One seed planted in a bed with a yellow fence. The Cradle opened its bay for a small robot with a seedling tray, and below decks the Makers woke up to a green sky."
msgstr ""

#: planets/verdance/data/codex.json:sightings.first_light.name
msgid "First Light"
msgstr ""

#: planets/verdance/data/codex.json:sightings.first_light.hint
msgid "Build a Telescope and look through it."
msgstr ""

#: planets/verdance/data/codex.json:sightings.first_light.desc
msgid "The first look across the system from your own observatory. Two suns, a handful of worlds, and somewhere down there, your crews still at work."
msgstr ""

#: planets/verdance/data/codex.json:sightings.ledger_wreck.name
msgid "Ledger Wreck"
msgstr ""

#: planets/verdance/data/codex.json:sightings.ledger_wreck.hint
msgid "Through the telescope, on a world where the Ledger's drones came down."
msgstr ""

#: planets/verdance/data/codex.json:sightings.ledger_wreck.desc
msgid "A dump drone that never made it home, nose-down in the junk of another world. Its red eye still blinks. Even from here it looks embarrassed."
msgstr ""

#: data/cosmetics.json:slots[paint].hint data/cosmetics.json:targets.glim.slots[glim_shell].hint
msgid "Paint tins lie buried under ordinary trash."
msgstr ""

#: data/cosmetics.json:slots[pattern].name
msgid "Wear pattern"
msgstr ""

#: data/cosmetics.json:slots[pattern].hint
msgid "Old machines keep the marks of their work. Look for a wreck."
msgstr ""

#: data/cosmetics.json:slots[eye_shape].hint
msgid "Lens plates outlast the robots that wore them."
msgstr ""

#: data/cosmetics.json:slots[glow].hint data/cosmetics.json:targets.glim.slots[glim_glow].hint data/cosmetics.json:targets.crew.slots[crew_glow].hint
