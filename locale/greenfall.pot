msgstr ""

#: data/events.json:liveries[livery_neon].desc
msgid "A cyan glow ring under every robot in the fleet."
msgstr ""

#: data/events.json:liveries[livery_sunset].name
msgid "Sunset Underglow"
msgstr ""

#: data/events.json:liveries[livery_sunset].desc
msgid "Warm orange underglow for the whole crew."
msgstr ""

#: data/events.json:liveries[livery_pennant].name
msgid "Crew Pennants"
msgstr ""

#: data/events.json:liveries[livery_pennant].desc
msgid "Every robot flies a little Greenfall pennant."
msgstr ""

#: data/events.json:liveries[livery_halo].name
msgid "Holo Halos"
msgstr ""

#: data/events.json:liveries[livery_halo].desc
msgid "A slowly turning hologram halo over each robot. Very smug."
msgstr ""

#: data/events.json:trinkets[brass_compass].name
msgid "Brass Compass"
msgstr ""

#: data/events.json:trinkets[brass_compass].desc
msgid "Points north, mostly. Came wrapped in a sock in a supply crate."
msgstr ""

#: data/events.json:trinkets[tin_robot].name
msgid "Wind-up Tin Robot"
msgstr ""

#: data/events.json:trinkets[tin_robot].desc
msgid "Walks three steps and falls over. Lumi relates."
msgstr ""

#: data/events.json:trinkets[seed_locket].name
msgid "Seed Locket"
msgstr ""

#: data/events.json:trinkets[seed_locket].desc
msgid "A locket with one seed inside instead of a photo. Someone loved gardens."
msgstr ""

#: data/events.json:trinkets[snow_globe].name data/songs.json:songs[snow_globe].title
msgid "Snow Globe"
msgstr ""

#: data/events.json:trinkets[snow_globe].desc
msgid "A tiny city under glass, still clean. A promise, maybe."
msgstr ""

#: data/events.json:trinkets[crate_stencil].name
msgid "Cradle Crate Stencil"
msgstr ""

#: data/events.json:trinkets[crate_stencil].desc
msgid "The stencil used to paint every supply crate. WREN asked for it back. You said no."
msgstr ""

#: data/events.json:trinkets[golden_bolt].name
msgid "Golden Bolt"
msgstr ""

#: data/events.json:trinkets[golden_bolt].desc
msgid "Fell out of a surge hex, still warm. Fits nothing. Worth everything."
msgstr ""

#: data/events.json:trinkets[glow_shard].name
msgid "Surge Glass"
msgstr ""

#: data/events.json:trinkets[glow_shard].desc
msgid "A sliver of glass that kept the surge's glow. It hums when you hold it."
msgstr ""

#: data/events.json:trinkets[rain_jar].name
msgid "Jar of First Rain"
msgstr ""

#: data/events.json:trinkets[rain_jar].desc
msgid "Collected during the first rain in years. Do not drink. Do not open. Just look."
msgstr ""

#: data/events.json:trinkets[paper_boat].name
msgid "Paper Boat"
msgstr ""

#: data/events.json:trinkets[paper_boat].desc
msgid "Someone made it from a coupon. It sailed a whole puddle."
msgstr ""

#: data/events.json:trinkets[lucky_spanner].name
msgid "Lucky Spanner"
msgstr ""

#: data/events.json:trinkets[lucky_spanner].desc
msgid "Fixes any hiccup, if you hit the right spot. Usually the left side."
msgstr ""

#: data/events.json:trinkets[hiccup_tape].name
msgid "Diagnostic Tape"
msgstr ""

#: data/events.json:trinkets[hiccup_tape].desc
msgid "A printout of a robot hiccuping. It looks a lot like a song."
msgstr ""

#: data/events.json:trinkets[photo_glowtail_fox].name
msgid "Photo: Glowtail Fox"
msgstr ""

#: data/events.json:trinkets[photo_glowtail_fox].desc
msgid "Its tail glows when it's curious. It was very curious about Lumi."
msgstr ""

#: data/events.json:trinkets[photo_moss_deer].name
msgid "Photo: Moss Deer"
msgstr ""

#: data/events.json:trinkets[photo_moss_deer].desc
msgid "Moss grows on its antlers. Butterflies rest there like it's a tree."
msgstr ""

#: data/events.json:trinkets[photo_lantern_hedgehog].name
msgid "Photo: Lantern Hedgehog"
msgstr ""

#: data/events.json:trinkets[photo_lantern_hedgehog].desc
msgid "The tips of its spines glow amber at dusk. It ate a beetle on camera. Sorry."
msgstr ""

#: data/events.json:trinkets[photo_prism_heron].name
msgid "Photo: Prism Heron"
msgstr ""

#: data/events.json:trinkets[photo_prism_heron].desc
msgid "Its feathers split light into rainbows. It stood on one leg the whole time."
msgstr ""

#: data/events.json:trinkets[photo_velvet_hare].name
msgid "Photo: Velvet Hare"
msgstr ""

#: data/events.json:trinkets[photo_velvet_hare].desc
msgid "Soft as a whisper, quick as a rumour. The photo is a little blurry. Worth it."
msgstr ""

#: data/events.json:trinkets[crumb_bag].name
msgid "Crumb Bag"
msgstr ""

#: data/events.json:trinkets[crumb_bag].desc
msgid "A paper bag of crumbs and seed husks. The pigeons know the sound of it now."
msgstr ""

#: data/events.json:trinkets[pic_cat].name
msgid "Photo: Stray Cat"
msgstr ""

#: data/events.json:trinkets[pic_cat].desc
msgid "A photo from photo mode. Old Town's cats never left."
msgstr ""

#: data/events.json:trinkets[pic_pigeon].name
msgid "Photo: Pigeon"
msgstr ""

#: data/events.json:trinkets[pic_pigeon].desc
msgid "A photo from photo mode. Pigeons will live anywhere people once dropped crumbs."
msgstr ""

#: data/events.json:trinkets[pic_sparrow].name
msgid "Photo: Sparrow"
msgstr ""

#: data/events.json:trinkets[pic_sparrow].desc
msgid "A photo from photo mode. Small, brown and bossy."
msgstr ""

#: data/events.json:trinkets[pic_rat].name
msgid "Photo: Rat"
msgstr ""

#: data/events.json:trinkets[pic_rat].desc
msgid "A photo from photo mode. Rats live in the gaps between the piles."
msgstr ""

#: data/events.json:trinkets[pic_rabbit].name
msgid "Photo: Rabbit"
msgstr ""

#: data/events.json:trinkets[pic_rabbit].desc
msgid "A photo from photo mode. Rabbits arrive as soon as there is something green to nibble."
msgstr ""

#: data/events.json:trinkets[pic_deer].name
msgid "Photo: Roe Deer"
msgstr ""

#: data/events.json:trinkets[pic_deer].desc
msgid "A photo from photo mode. Shy grazers that keep to the edge of the green, where they can see what's coming."
msgstr ""

#: data/events.json:trinkets[pic_fox].name
msgid "Photo: Red Fox"
msgstr ""

#: data/events.json:trinkets[pic_fox].desc
msgid "A photo from photo mode. A fox trots along the hedges, nose down, tail out."
msgstr ""

#: data/events.json:trinkets[pic_bee].name
msgid "Photo: Honeybee"
msgstr ""

#: data/events.json:trinkets[pic_bee].desc
msgid "A photo from photo mode. Bees came back with the blooms."
msgstr ""

#: data/events.json:trinkets[pic_songbird].name
msgid "Photo: Robin"
msgstr ""

#: data/events.json:trinkets[pic_songbird].desc
msgid "A photo from photo mode. When a hex thrives, robins move in and sing."
msgstr ""

#: data/events.json:trinkets[pic_firefly].name
msgid "Photo: Firefly"
msgstr ""

#: data/events.json:trinkets[pic_firefly].desc
msgid "A photo from photo mode. Tiny green lanterns over the grass after dark."
msgstr ""

#: data/events.json:trinkets[pic_fish].name
msgid "Photo: Lake Fish"
msgstr ""

#: data/events.json:trinkets[pic_fish].desc
msgid "A photo from photo mode. Once the water clears you can see them: small silver schools turning together over the sand."
msgstr ""

#: data/events.json:trinkets[pic_duck].name
msgid "Photo: Mallard"
msgstr ""

#: data/events.json:trinkets[pic_duck].desc
msgid "A photo from photo mode. Ducks paddle, dabble with their tails in the air and complain loudly about everything."
msgstr ""

#: data/events.json:trinkets[pic_frog].name
msgid "Photo: Green Frog"
msgstr ""

#: data/events.json:trinkets[pic_frog].desc
msgid "A photo from photo mode. Frogs sit at the water's edge and sing in the evening."
msgstr ""

#: data/events.json:trinkets[pic_lizard].name
msgid "Photo: Sand Lizard"
msgstr ""

#: data/events.json:trinkets[pic_lizard].desc
msgid "A photo from photo mode. Lizards bask on swept ground between the solar arrays and vanish in a blink when a shadow falls on them."
msgstr ""

#: data/events.json:trinkets[pic_fennec].name
msgid "Photo: Fennec Fox"
msgstr ""

#: data/events.json:trinkets[pic_fennec].desc
msgid "A photo from photo mode. A tiny desert fox with enormous ears."
msgstr ""

#: data/events.json:trinkets[pic_seal].name
msgid "Photo: Harbour Seal"
msgstr ""

#: data/events.json:trinkets[pic_seal].desc
msgid "A photo from photo mode. Seals haul out on the quay once it's clean, lounge in heaps, and flop back to the water if you come too close."
msgstr ""

#: data/events.json:trinkets[pic_gull].name
msgid "Photo: Herring Gull"
msgstr ""

#: data/events.json:trinkets[pic_gull].desc
msgid "A photo from photo mode. Loud, white and opportunistic."
msgstr ""

#: data/events.json:trinkets[pic_arctic_fox].name
msgid "Photo: Arctic Fox"
msgstr ""

