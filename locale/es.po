msgstr "Una baliza que canta a través del frío extremo: lo que le faltaba a la Baliza del Arca de Verdance."

#: data/homeward.json:tech[heat_core].name
msgid "Heat Core"
msgstr "Núcleo térmico"

#: data/homeward.json:tech[heat_core].desc
