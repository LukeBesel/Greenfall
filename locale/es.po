msgstr "Musgo"

#: data/glim.json:shells[graphite].name data/style_parts.json:swatches[graphite].name
msgid "Graphite"
msgstr "Grafito"

#: data/glim.json:shells[blossom].name
msgid "Blossom"
msgstr "Flor"

#: data/glim.json:glows[cyan].name data/style_parts.json:swatches[cyan].name
msgid "Cyan"
msgstr "Cian"

#: data/glim.json:glows[ember].name data/solar_system.json:star_b.name
msgid "Ember"
msgstr "Ember"

#: data/glim.json:glows[leaf].name data/style_parts.json:options.chest[leaf].name
msgid "Leaf"
msgstr "Hoja"

#: data/glim.json:glows[violet].name data/style_parts.json:swatches[violet].name
msgid "Violet"
msgstr "Violeta"

#: data/glim.json:glows[rose].name
msgid "Rose"
msgstr "Rosa"

#: data/glim.json:tops[none].name
msgid "Nothing"
msgstr "Nada"

#: data/glim.json:tops[antenna].name data/style_parts.json:options.head[antenna].name
msgid "Antenna"
msgstr "Antena"

#: data/glim.json:tops[beanie].name
msgid "Little Beanie"
msgstr "Gorrito"

#: data/glim.json:tops[halo].name data/style_parts.json:options.head[halo].name
msgid "Halo"
msgstr "Aureola"

#: data/goals.json:goals[scoop_15].text
msgid "Scoop 15 pieces of junk"
msgstr "Recoge 15 trozos de chatarra"

#: data/goals.json:goals[dump_1].text
msgid "Empty your chest in the bin"
msgstr "Vacía tu compartimento en el cubo"

#: data/goals.json:goals[upgrade_1].text
msgid "Install a workbench upgrade"
msgstr "Instala una mejora del banco de trabajo"

#: data/goals.json:goals[baler_1].text
msgid "Install the Baler"
msgstr "Instala la empacadora"

#: data/goals.json:goals[bale_1].text
msgid "Compress your first bale"
msgstr "Prensa tu primera paca"

#: data/goals.json:goals[cash_1].text
msgid "Sell a bale at the scale"
msgstr "Vende una paca en la báscula"

#: data/goals.json:goals[lift_1].text
msgid "Lift Strength level 1"
msgstr "Fuerza de elevación nivel 1"

#: data/goals.json:goals[hex_1].text
msgid "Clean your first hex"
msgstr "Limpia tu primer hexágono"

#: data/goals.json:goals[perfect_1].text
msgid "Make a Perfect bale"
msgstr "Haz una paca perfecta"

#: data/goals.json:goals[upgrades_5].text
msgid "Install 5 upgrades"
msgstr "Instala 5 mejoras"

#: data/goals.json:goals[cash_10].text
msgid "Sell 10 bales"
msgstr "Vende 10 pacas"

#: data/goals.json:goals[compartment_3].text
msgid "Compartment Size level 3"
msgstr "Tamaño del compartimento nivel 3"

#: data/goals.json:goals[shards_1].text
msgid "Find a memory shard"
msgstr "Encuentra un fragmento de memoria"

#: data/goals.json:goals[hex_3].text
msgid "Clean 3 hexes"
msgstr "Limpia 3 hexágonos"

#: data/goals.json:goals[parts_2].text
msgid "Dig up 2 robot parts"
msgstr "Desentierra 2 piezas de robot"

#: data/goals.json:goals[earn_1k].text
msgid "Earn 1,000 cubes"
msgstr "Gana 1.000 cubos"

#: data/goals.json:goals[research_1].text
msgid "Finish a research project"
msgstr "Termina un proyecto de investigación"

#: data/goals.json:goals[hex_5].text
msgid "Clean 5 hexes"
msgstr "Limpia 5 hexágonos"

#: data/goals.json:goals[lift_2].text
msgid "Lift Strength level 2 (large junk)"
msgstr "Fuerza de elevación nivel 2 (chatarra grande)"

#: data/goals.json:goals[upgrades_12].text
msgid "Install 12 upgrades"
msgstr "Instala 12 mejoras"

#: data/goals.json:goals[earn_3k].text
msgid "Earn 3,000 cubes"
msgstr "Gana 3.000 cubos"

#: data/goals.json:goals[hex_7].text
msgid "Clean 7 hexes"
msgstr "Limpia 7 hexágonos"

#: data/goals.json:goals[pet_cat].text
msgid "Pet a stray cat"
msgstr "Acaricia a un gato callejero"

#: data/goals.json:goals[research_4].text
msgid "Finish 4 research projects"
msgstr "Termina 4 proyectos de investigación"

#: data/goals.json:goals[upgrades_20].text
msgid "Install 20 upgrades"
msgstr "Instala 20 mejoras"

#: data/goals.json:goals[hex_10].text data/radio.json:songs[verdance_sweep].hint
msgid "Clean 10 hexes"
msgstr "Limpia 10 hexágonos"

#: data/goals.json:goals[base_2].text
msgid "Upgrade the base to level 2"
msgstr "Mejora la base a nivel 2"

#: data/goals.json:goals[scoopie_1].text
msgid "Build a Scoopie"
msgstr "Construye un Scoopie"

#: data/goals.json:goals[zone_1].text
msgid "Paint a work zone (B Command)"
msgstr "Pinta una zona de trabajo (B Mando)"

#: data/goals.json:goals[haulbug_1].text data/objectives.json:objectives[haul].text
msgid "Build a Haul Bug"
msgstr "Construye un Haul Bug"

#: data/goals.json:goals[bales_20].text
msgid "Robots press 20 bales"
msgstr "Los robots prensan 20 pacas"

#: data/goals.json:goals[scoopie_2].text
