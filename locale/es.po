msgstr "El último lingote del Ledger, refundido como un anillo sencillo con una semilla grabada."

#: data/homeward.json:drive[0].name
msgid "Mk V Orbital"
msgstr "Mk V Orbital"

#: data/homeward.json:drive[0].desc
