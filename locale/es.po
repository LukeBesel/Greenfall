msgid "The duck squeaks a secret: \"%s\" unlocks the %s design."
msgstr "El pato chilla un secreto: «%s» desbloquea el diseño %s."

#: story/eggs.gd:835
msgid "The duck has taught you everything it knows. Quack."
msgstr "El pato te ha enseñado todo lo que sabe. Cuac."

