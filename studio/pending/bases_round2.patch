+func test_lantern_shaft_follows_the_lamp() -> void:
+	var lamp: MeshInstance3D = YardArt.street_lamp().mi(0.15)
+	add_child_autofree(lamp)
+	var shaft: MeshInstance3D = YardArt.lamp_shaft()
+	lamp.add_child(shaft)
+	assert_false(shaft.visible, "no shaft from a dark lamp")
+	YardArt.set_powered(lamp, true)
+	assert_true(shaft.visible)
+	YardArt.set_powered(lamp, false)
+	assert_false(shaft.visible)
+	assert_true(shaft.has_meta("no_collide"))
+	assert_eq(shaft.cast_shadow, GeometryInstance3D.SHADOW_CASTING_SETTING_OFF)
