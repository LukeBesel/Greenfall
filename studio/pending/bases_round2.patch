diff --git a/systems/camp/yard_shaft.gdshader b/systems/camp/yard_shaft.gdshader
new file mode 100644
index 00000000..ac96e8e2
--- /dev/null
+++ b/systems/camp/yard_shaft.gdshader
@@ -0,0 +1,21 @@
+shader_type spatial;
+// [art4b] The warm shaft of light a lit yard lantern throws up into the air (owner's world target:
+// the beacon lamp in the picture's centre). A soft additive cone: bright at the lamp, gone by the
+// top, brightest where you look through its middle. Drawn only while the lamp is lit.
+render_mode unshaded, blend_add, cull_disabled, depth_draw_never, shadows_disabled, fog_disabled;
+
+uniform vec4 tint : source_color = vec4(1.0, 0.7, 0.36, 1.0);
+uniform float strength = 0.3;
+uniform float height = 4.5;
+
+varying float h;
+
+void vertex() {
+	h = VERTEX.y / height + 0.5;
+}
+
+void fragment() {
+	float core = pow(abs(dot(normalize(NORMAL), normalize(VIEW))), 1.6);
+	float fall = pow(1.0 - clamp(h, 0.0, 1.0), 1.7) * smoothstep(0.0, 0.04, h);
+	ALBEDO = tint.rgb * strength * core * fall;
+}
