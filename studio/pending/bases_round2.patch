+func test_signal_tower_tiers_grow_and_keep_their_tip() -> void:
+	var last: float = 0.0
+	for t: int in [1, 2, 3, 4]:
+		var d: Dictionary = YardArt.signal_tower(t)
+		var mi: MeshInstance3D = (d["kit"] as YardArt.Kit).mi(0.15)
+		add_child_autofree(mi)
+		var tip: Vector3 = d["tip"]
+		assert_gt(tip.y, last - 0.001, "tier %d is no shorter than the one before" % t)
+		last = tip.y
+		assert_almost_eq(tip.x, 0.0, 0.001)
+		var ab: AABB = mi.mesh.get_aabb()
+		assert_lt(absf(ab.position.x), 1.5, "tier %d stays on its plinth (dishes aside)" % t)
+		assert_lt(_tris(mi.mesh), 34000, "tier %d triangles" % t)
+	assert_almost_eq((YardArt.signal_tower(1)["tip"] as Vector3).y, 0.265 + 3.0 + 0.3, 0.01)
