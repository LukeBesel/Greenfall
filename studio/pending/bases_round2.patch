@@ -213,6 +213,54 @@ class Kit:
 			pv.append(t * Vector3(cos(a) * r, sin(a) * r, 0))
 		b.tube(key_of(col, "paint"), pv, tube_r, 6, 0.0)
 
+	## An upright H-section post standing on `base`: two flanges facing +-Z and a web.
+	func hpost(base: Vector3, h: float, w: float, col: Color) -> void:
+		for s: float in [-1.0, 1.0]:
+			box(Vector3(w, h, 0.016), base + Vector3(0, h * 0.5, s * (w * 0.5 - 0.008)), col, Vector3.ZERO, 0.004)
+		box(Vector3(0.014, h, w - 0.03), base + Vector3(0, h * 0.5, 0), col, Vector3.ZERO, 0.003)
+
+	## An I-beam along X centred on `c`: two flanges and a web.
+	func ibeam_x(c: Vector3, length: float, hgt: float, wid: float, col: Color) -> void:
+		for s: float in [-1.0, 1.0]:
+			box(Vector3(length, 0.016, wid), c + Vector3(0, s * (hgt * 0.5 - 0.008), 0), col, Vector3.ZERO, 0.004)
+		box(Vector3(length, hgt - 0.03, 0.014), c, col, Vector3.ZERO, 0.003)
+
+	## An I-beam along Z centred on `c`.
+	func ibeam_z(c: Vector3, length: float, hgt: float, wid: float, col: Color) -> void:
+		for s: float in [-1.0, 1.0]:
+			box(Vector3(wid, 0.016, length), c + Vector3(0, s * (hgt * 0.5 - 0.008), 0), col, Vector3.ZERO, 0.004)
+		box(Vector3(0.014, hgt - 0.03, length), c, col, Vector3.ZERO, 0.003)
+
+	## A corrugated sheet lying flat (size = across the ribs, along them), ribs along local Z.
+	func corrugated(size: Vector2, pos: Vector3, col: Color, rot: Vector3 = Vector3.ZERO, pitch: float = 0.09) -> void:
+		push(ProcMesh.xf(pos, rot))
+		box(Vector3(size.x, 0.008, size.y), Vector3.ZERO, col, Vector3.ZERO, 0.002)
+		var n: int = maxi(1, int(size.x / pitch))
+		for i: int in n:
+			box(Vector3(pitch * 0.5, 0.02, size.y), Vector3(-size.x * 0.5 + (float(i) + 0.5) * size.x / float(n), 0.012, 0), col, Vector3.ZERO, 0.008)
+		pop()
+
+	## A corrugated wall sheet standing in the YZ plane (hgt up, length along Z), ribs upright, both faces.
+	func corrugated_wall(hgt: float, length: float, pos: Vector3, col: Color, pitch: float = 0.1) -> void:
+		box(Vector3(0.008, hgt, length), pos, col, Vector3.ZERO, 0.002)
+		var n: int = maxi(1, int(length / pitch))
+		for i: int in n:
+			box(Vector3(0.04, hgt, pitch * 0.5), pos + Vector3(0, 0, -length * 0.5 + (float(i) + 0.5) * length / float(n)), col, Vector3.ZERO, 0.01)
+
+	## A flat bar from a to e lying against a face with outward normal `nrm`.
+	func strap(a: Vector3, e: Vector3, width: float, col: Color, nrm: Vector3) -> void:
+		var y: Vector3 = (e - a).normalized()
+		var z: Vector3 = (nrm - y * nrm.dot(y)).normalized()
+		var x: Vector3 = y.cross(z)
+		b.box(key_of(col, "paint"), Vector3(width, a.distance_to(e), 0.01), _t(Transform3D(Basis(x, y, z), (a + e) * 0.5)), 0.003)
+
+	## A hanging chain from a down to e (alternating flat links).
