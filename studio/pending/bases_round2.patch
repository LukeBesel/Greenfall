+		_shaft_mesh.cap_bottom = false
+	var m := MeshInstance3D.new()
+	m.name = "Shaft"
+	m.mesh = _shaft_mesh
+	m.material_override = _shaft_mat
+	m.position = Vector3(0, LAMP_HEAD_Y + 0.25 + height * 0.5, 0)
