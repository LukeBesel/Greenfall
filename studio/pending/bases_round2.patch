+func test_far_base_quay_shares_the_mesh_and_stays_dark() -> void:
+	var start: Node3D = OutpostPad.build()
+	var far: Node3D = OutpostPad.build("generic")
+	add_child_autofree(start)
+	add_child_autofree(far)
+	var a: MeshInstance3D = start.get_node("CleanPad")
+	var b: MeshInstance3D = far.get_node("CleanPad")
+	assert_eq(a.mesh, b.mesh, "one mesh for every base")
+	assert_ne(OutpostPad.deck_material("start"), OutpostPad.deck_material("generic"), "its own maps: no landing ring or bin bay on a far base")
+	assert_true(b.has_meta("no_collide"))
+	OutpostPad.set_powered(get_tree(), true)
+	assert_true(bool(a.get_meta("pad_powered")), "the start yard's generator lights the start pad")
+	assert_false(bool(b.get_meta("pad_powered")), "and no other base's")
+	OutpostPad.set_powered(get_tree(), false)
