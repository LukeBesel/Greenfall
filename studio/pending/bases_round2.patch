@@ -80,3 +80,88 @@ func test_lamp_head_and_wear_states() -> void:
 	assert_eq(YardArt.state_for(0.72), "broken")
 	assert_eq(YardArt.state_for(0.15), "repaired", "working yard machines are used, not showroom-new")
 	assert_eq(YardArt.state_for(0.05), "restored")
+
+
+func _tris(m: Mesh) -> int:
+	var t: int = 0
+	for s: int in m.get_surface_count():
+		var idx: Variant = m.surface_get_arrays(s)[Mesh.ARRAY_INDEX]
+		if idx is PackedInt32Array:
+			@warning_ignore("integer_division")
+			t += (idx as PackedInt32Array).size() / 3
+	return t
+
+
+func test_remodelled_structures_stay_inside_their_footprints() -> void:
+	# [art4b] The lean-to, generator, Bot Bay and signal tower were remodelled: their colliders and
+	# E spots did not move, so the models must still stand where those are.
+	var gen: MeshInstance3D = YardArt.generator().mi(0.15)
+	add_child_autofree(gen)
+	var g: AABB = gen.mesh.get_aabb()
+	assert_gt(g.position.z, -0.45, "generator back (collider 0.85 deep; only its cable trails out in front)")
+	assert_lt(g.end.y, 1.6, "generator height")
+	assert_gt(g.position.x, -1.7, "only its cable runs off toward the lean-to")
+	var bay: MeshInstance3D = YardArt.bot_bay().mi(0.12)
+	add_child_autofree(bay)
+	var b: AABB = bay.mesh.get_aabb()
+	assert_almost_eq(b.size.x, 3.25, 0.2, "Bot Bay width (BotBay.SIZE.x 3.2)")
+	assert_lt(b.end.z, 1.35, "nothing past the console at the bay's mouth")
+	assert_gt(b.position.z, -1.5)
+	var parts: Array = [YardArt.shack_frame(), YardArt.shack_roof(), YardArt.shack_side(), YardArt.shack_bulb()]
+	for kit: YardArt.Kit in parts:
+		var mi: MeshInstance3D = kit.mi(0.2)
+		add_child_autofree(mi)
+		assert_gt(mi.mesh.get_surface_count(), 0, "a lean-to part")
+	var back: MeshInstance3D = YardArt.shack_back().mi(0.18)
+	add_child_autofree(back)
+	assert_almost_eq(back.mesh.get_aabb().size.x, 3.4, 0.15, "the back wall is as wide as its collider (3.3)")
+	var total: int = _tris(gen.mesh) + _tris(bay.mesh)
+	assert_lt(_tris(gen.mesh), 30000, "generator under the machine budget")
+	assert_lt(_tris(bay.mesh), 32000, "Bot Bay triangles")
+	gut.p("generator %d tris, Bot Bay %d tris (%d)" % [_tris(gen.mesh), _tris(bay.mesh), total])
