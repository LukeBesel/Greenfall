 "artists": [
  {
   "id": "farewell",
   "home": "verdance",
   "name": "The Cradle Farewell Orchestra",
   "genre": "Orchestral",
   "bio": "Played one last concert on the launch pad while the ark boarded. Half of them missed the flight on purpose, so the encore was very long."
  },
  {
   "id": "compactors",
   "home": "verdance",
   "name": "The Compactors",
   "genre": "Garage pop",
   "bio": "A four-piece that rehearsed inside a broken trash compactor for the acoustics. They swear the walls only closed in on them once, during a drum solo."
  },
  {
   "id": "rustbucket",
   "home": "verdance",
   "name": "Lil' Rustbucket",
   "genre": "Chiptune",
   "bio": "A retired sweeper bot who refused to stop making beats. Every track was recorded on its own diagnostic beeper, between error codes."
  },
  {
   "id": "recycle_bin",
   "home": "verdance",
   "name": "DJ Recycle Bin",
   "genre": "Lofi beats",
   "bio": "Only samples sounds from the city dump: lids, crinkles, a fridge door with real soul. Released three albums and never once got out of bed for them."
  },
  {
   "id": "pianissimo",
   "home": "verdance",
   "name": "Professor Pianissimo",
   "genre": "Quiet piano",
   "bio": "Composes only for empty rooms and sleeping cities. His neighbours filed forty-one noise complaints, all saying the music was too soft to hear properly."
  },
  {
   "id": "two_suns",
   "home": "ochre",
   "name": "Two Suns Tango Orchestra",
   "genre": "Desert dance band",
   "bio": "Ochre's hardest-working band: with two suns there is no shade and no siesta, so they just kept playing. The sunglasses are part of the uniform."
  },
  {
   "id": "mirage_bros",
   "home": "ochre",
   "name": "The Mirage Brothers",
   "genre": "Heat-haze ambient",
   "bio": "Nobody is sure how many Mirage Brothers there are. On a hot day the crowd counted seven; on a cold one, just Gary."
  },
  {
   "id": "salty_buoys",
   "home": "tidewell",
   "name": "The Salty Buoys",
   "genre": "Island pop",
   "bio": "A beach band that played on floating junk rafts, drifting between islands mid-song. Their tour schedule depended entirely on the tide."
  },
  {
   "id": "barnacle_trio",
   "home": "tidewell",
   "name": "Barnacle Bossa Trio",
   "genre": "Bossa and lofi",
   "bio": "Three mellow players who refused to evacuate until the set was finished. The set was four hours long. They caught the last pod, still humming."
  },
  {
   "id": "streetlights",
   "home": "rime",
   "name": "Static & the Streetlights",
   "genre": "Icy synthpop",
   "bio": "A synth duo who powered their gigs by plugging into whichever harbour lamp still worked. The power company billed them for the whole ice shelf."
  },
  {
   "id": "mittens",
   "home": "rime",
   "name": "Mittens McKenzie",
   "genre": "Frozen piano",
   "bio": "Rime's beloved pianist, who played every concert in mittens. Critics called it muffled genius. Mittens called it frostbite prevention."
  },
  {
   "id": "smelter",
   "home": "anvil",
   "name": "Smelter Skelter",
   "genre": "Foundry industrial",
   "bio": "Brooding Anvil band who tuned their drums to the furnace roar. The Ledger tried to buy their catalogue; they melted the contract down and played the slag."
  },
  {
   "id": "ledger_audio",
   "home": "anvil",
   "name": "Ledger Brand Audio",
   "genre": "Corporate",
   "bio": "The Ledger's in-house jingle studio. Every song is copyrighted, trademarked and billed per listen. Credited as \"Ledger Brand Audio, all rights extracted\"."
  }
 ],
