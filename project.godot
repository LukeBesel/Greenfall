; Engine configuration file.
; Godot 4.7.2

config_version=5

[application]

config/name="Greenfall"
config/description="A bright, cozy incremental game about a rusty cleanup robot healing a planet."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/project_settings_override="user://renderer_override.cfg"

[autoload]

EventBus="*res://autoload/EventBus.gd"
Settings="*res://autoload/Settings.gd"
GameState="*res://autoload/GameState.gd"
Economy="*res://autoload/Economy.gd"
SaveManager="*res://autoload/SaveManager.gd"
SteamService="*res://steam/steam_service.gd"
Audio="*res://autoload/Audio.gd"
Story="*res://autoload/Story.gd"
Vfx="*res://art/vfx.gd"
DevHooks="*res://autoload/DevHooks.gd"
CradleBoot="*res://systems/cradle_boot.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray()

[greenfall]

steam/app_id=480
steam/demo_app_id=480
steam/cloud_mode="remote_storage"

[input_devices]

pointing/emulate_touch_from_mouse=false

[internationalization]

locale/translations=PackedStringArray("res://locale/de.po", "res://locale/es.po", "res://locale/pseudo.po")
locale/fallback="en"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
rendering_device/fallback_to_vulkan=true
rendering_device/fallback_to_opengl3=true

environment/defaults/default_clear_color=Color(0.55, 0.45, 0.7, 1)
textures/vram_compression/import_etc2_astc=true
